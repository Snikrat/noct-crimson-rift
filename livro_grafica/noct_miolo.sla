        <PAGEOBJECT XPOS="151.023622047244" YPOS="35361.4173228347" OwnPage="101" ItemID="962249913" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="35361.4173228347" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="962708105" BACKITEM="961888009"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="35361.4173228347" OwnPage="102" ItemID="962708105" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="35361.4173228347" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="962383673" BACKITEM="962249913"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="36053.3858267717" OwnPage="103" ItemID="962383673" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="36053.3858267717" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="962708105"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="36138.4251968504" OwnPage="104" ItemID="964832169" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="36138.4251968504" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="968718457" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 13"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Men­ti­ra"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="N"/>
                <ITEXT CH="oct su­biu da água com a pági­na no bol­so e uma per­gun­ta pa­ra ca­da de­grau."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ti­nha ido até aque­la ca­te­dral atrás de res­pos­tas. Ti­nha en­con­tra­do o úni­co ho­mem vi­vo que sa­bia mais da fen­da do que ele, e o ho­mem ti­nha vi­ra­do um man­to va­zio no chão an­tes de res­pon­der me­ta­de. Mas não ti­nha ido lon­ge. Na ru­í­na, ao la­do do man­to, on­de Noct não ti­nha olha­do di­rei­to an­tes, ha­via go­tas es­cu­ras no chão. San­gue do na­riz do Cus­tó­dio. Elas sa­í­am do cír­cu­lo apa­ga­do, des­ci­am a es­ca­da em es­pi­ral, cru­za­vam a na­ve en­tre os ban­cos tom­ba­dos e pa­ra­vam di­an­te de uma por­ta atrás do al­tar prin­ci­pal."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A por­ta do ma­pa. "/>
                <ITEXT CPARENT="c_it" CH="Aqui­lo que mo­ra aqui se ali­men­ta de cul­pa; não en­trar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nu­ma fo­lha sol­ta do re­gis­tro, com uma le­tra mais ve­lha que a do úl­ti­mo cus­tó­dio, aqui­lo ti­nha no­me. "/>
                <ITEXT CPARENT="c_it" CH="O Cei­fa­dor."/>
                <ITEXT CH=" Não era de­mô­nio, nem san­to, nem ho­mem. Era uma coi­sa que a fen­da ti­nha dei­xa­do na ca­te­dral sé­cu­los an­tes, quan­do os fi­éis ain­da vi­nham se con­fes­sar, e que ti­nha cres­ci­do co­men­do o que eles dei­xa­vam ali: cul­pa. Não ma­ta­va nin­guém de ca­ra. Co­lhia. En­con­tra­va aqui­lo de que ca­da um mais se cul­pa­va e pu­xa­va, de­va­gar, até a pes­soa se des­fa­zer so­zi­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cus­tó­dio ti­nha me­do de­le. Era por is­so que nun­ca ti­nha des­ci­do até o la­go: no ma­pa, o ca­mi­nho pa­ra a por­ta pas­sa­va por trás da­que­le san­tuá­rio. E mes­mo as­sim, fe­ri­do, sem o man­to, ti­nha cor­ri­do jus­to pa­ra lá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não pen­sou em vol­tar. Nem por um se­gun­do. Pen­sou na lis­ta, no re­gis­tro, na pági­na ar­ran­ca­da, em to­das as per­gun­tas que um man­to va­zio não res­pon­dia. Pen­sou nu­ma fi­ta ver­me­lha com o nó tor­to do la­do es­quer­do. Ele que­ria a Mi­ra de vol­ta. Se pa­ra is­so ti­ves­se que pas­sar por uma coi­sa que co­mia cul­pa, ia pas­sar. Cul­pa era o que não lhe fal­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Abriu a por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O San­tuá­rio do Cei­fa­dor fi­ca­va no co­ra­ção da ca­te­dral, atrás do al­tar prin­ci­pal, on­de os fi­éis de an­ti­ga­men­te nun­ca ti­nham ti­do per­mis­são pa­ra en­trar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era uma sa­la re­don­da e al­ta, sem ja­ne­las, ilu­mi­na­da por to­chas que quei­ma­vam com uma cha­ma de um bran­co azu­la­do, fria, que não es­quen­ta­va na­da. No cen­tro, ou­tro al­tar, me­nor, de pe­dra ne­gra. E di­an­te do al­tar, imó­vel, de cos­tas pa­ra a por­ta, ha­via uma fi­gu­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Al­ta. Mui­to al­ta. En­vol­ta num man­to es­cu­ro que ca­ía até o chão e se es­pa­lha­va por ele co­mo água pa­ra­da. Não se via a ca­be­ça, só o ca­puz. Não se vi­am as mãos, só a pon­ta de uma foi­ce enor­me, apoi­a­da no chão ao la­do do al­tar, a lâ­mi­na cur­va bri­lhan­do fra­co à luz das to­chas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou na por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As go­tas de san­gue se­gui­am pe­lo chão até o al­tar ne­gro. O ras­tro aca­ba­va na bei­ra da ra­cha­du­ra, sob o al­tar. De­pois, na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to de­le não pul­sou. Fi­cou qui­e­ta. Qui­e­ta de­mais, do jei­to que um ani­mal fi­ca qui­e­to quan­do sen­te um pre­da­dor mai­or por per­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A por­ta do san­tuá­rio se fe­chou so­zi­nha atrás de­le, sem fa­zer ba­ru­lho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­gu­ra não se vi­rou. Mas fa­lou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Mais um que ou­viu a fen­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz não vi­nha de ne­nhum lu­gar es­pe­cífi­co. Vi­nha das pa­re­des, do chão, das cha­mas fri­as das to­chas. Era uma voz que não era de ho­mem nem de mu­lher, nem ve­lha nem jo­vem, e Noct te­ve a im­pres­são ab­sur­da de que, se pres­tas­se aten­ção, ia re­co­nhe­cer al­gu­ma coi­sa ne­la. Um tim­bre. Uma in­fle­xão. Co­mo uma músi­ca que vo­cê ou­viu quan­do cri­an­ça e não lem­bra de on­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fe­chou os pu­nhos. Abriu a bo­ca pa­ra di­zer al­gu­ma coi­sa, al­go se­co, al­go afi­a­do, do ti­po que ele sem­pre ti­nha pron­to pa­ra cri­a­tu­ras gran­des que acha­vam que po­di­am as­sus­tá-lo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cei­fa­dor se vi­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via ros­to den­tro do ca­puz. Ha­via es­cu­ro. Um es­cu­ro que olha­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E do es­cu­ro veio a fra­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela gri­tou seu no­me an­tes de mor­rer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de­pois, mais bai­xo, nu­ma voz pe­que­na que qua­se era de­la:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— "/>
                <ITEXT CPARENT="c_it" CH="Noct."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O mun­do não pa­rou. O mun­do não fez na­da. As to­chas con­ti­nu­a­ram quei­man­do, o al­tar con­ti­nuou ne­gro, o chão con­ti­nuou chão."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Foi Noct que pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tu­do ne­le pa­rou de uma vez: a res­pi­ra­ção, os pen­sa­men­tos, o sar­cas­mo, a ar­ma­du­ra in­tei­ra que ele ti­nha pas­sa­do anos cons­tru­in­do pla­ca por pla­ca. Tu­do caiu no chão do san­tuá­rio ao mes­mo tem­po, com um ba­ru­lho que só ele ou­viu."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela gri­tou seu no­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele viu. Não quis ver, e viu mes­mo as­sim. Uma fi­gu­ra pe­que­na num lu­gar es­cu­ro, di­an­te de uma por­ta. Gri­tan­do. Gri­tan­do "/>
                <ITEXT CPARENT="c_it" CH="o no­me de­le"/>
                <ITEXT CH=". Cha­man­do por ele, no fim, quan­do mais pre­ci­sou, e ele não es­ta­va lá, ele es­ta­va dor­min­do, e ela ti­nha ido so­zi­nha e ti­nha gri­ta­do o no­me de­le e ele não ti­nha ou­vi­do, ele não ti­nha ou­vi­do, "/>
                <ITEXT CPARENT="c_it" CH="ele não ti­nha ou­vi­do..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão a bra­sa acor­dou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não co­mo an­tes. Não co­mo uma fa­gu­lha nos de­dos ou um ca­lor no pei­to. Acor­dou co­mo um in­cên­dio acor­da nu­ma ca­sa de ma­dei­ra se­ca: de uma vez, por in­tei­ro, sem pe­dir per­mis­são a nin­guém. Su­biu do pei­to pa­ra os om­bros, dos om­bros pa­ra os bra­ços, pa­ra o pes­co­ço, pa­ra os olhos. Uma au­ra car­me­sim se acen­deu em vol­ta do cor­po de­le, tão for­te que as cha­mas bran­cas das to­chas se do­bra­ram pa­ra lon­ge, com me­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não sen­tiu na­da dis­so. Não sen­tiu o ca­lor. Não sen­tiu a au­ra. Não sen­tiu as unhas cra­va­das nas pal­mas das mãos até san­grar den­tro das lu­vas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­tiu só uma coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E dis­se uma pa­la­vra só. Sem ne­nhu­ma iro­nia, sem ne­nhum des­vio, sem ne­nhu­ma das de­fe­sas que ele sem­pre usa­va. Uma pa­la­vra nua, bai­xa, ter­rí­vel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Men­ti­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Por­que, se não fos­se men­ti­ra, não ha­via mais nin­guém pa­ra tra­zer de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Cei­fa­dor não res­pon­deu. Er­gueu a foi­ce."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="E Noct foi."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não lu­tou do jei­to que lu­ta­va. Não ha­via eco­no­mia, nem cál­cu­lo, nem a pa­ciên­cia de apren­der o rit­mo do ini­mi­go an­tes de ata­car. Ha­via só ve­lo­ci­da­de, e for­ça, e uma rai­va tão gran­de que não ca­bia den­tro de­le e trans­bor­da­va em fa­gu­lhas ver­me­lhas a ca­da gol­pe. Jab, cross, chu­te, up­per­cut, e de no­vo, e de no­vo, mais rápi­do do que ele ja­mais ti­nha se mo­vi­do, ca­da so­co dei­xan­do um ras­tro car­me­sim no ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cei­fa­dor de­sa­pa­re­cia. Su­mia num re­de­mo­i­nho de man­to es­cu­ro e re­a­pa­re­cia do ou­tro la­do da sa­la, a foi­ce já em mo­vi­men­to. Lan­ça­va ma­gi­as que su­bi­am do chão co­mo mãos es­que­léti­cas. Noct não des­vi­a­va de me­ta­de de­las. Dei­xa­va acer­tar. A dor não im­por­ta­va. A dor era com­bus­tí­vel."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="So­frer fun­ci­o­na"/>
                <ITEXT CH=", sus­sur­rou al­gu­ma coi­sa den­tro de­le, com uma sa­tis­fa­ção hor­rí­vel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ou­viu. E não li­gou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cei­fa­dor re­cuou, pe­la pri­mei­ra vez. Re­cuou até o al­tar ne­gro, a foi­ce er­gui­da di­an­te do cor­po co­mo um es­cu­do, o man­to ras­ga­do em vá­rios lu­ga­res. A voz veio de no­vo, das pa­re­des, das cha­mas, e des­ta vez ha­via al­go ne­la que pa­re­cia qua­se di­ver­são."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Va­mos ver o que vo­cê es­con­de aí den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E es­ten­deu a mão. Uma mão de os­so, lon­ga, sain­do da man­ga do man­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ten­deu-a na di­re­ção da ca­be­ça de Noct."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O san­tuá­rio su­miu."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="36745.3543307087" OwnPage="105" ItemID="968718457" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="36745.3543307087" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="968786745" BACKITEM="964832169"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="36745.3543307087" OwnPage="106" ItemID="968786745" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="36745.3543307087" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="969336089" BACKITEM="968718457"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="37437.3228346457" OwnPage="107" ItemID="969336089" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="37437.3228346457" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="962260777" BACKITEM="968786745"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="37437.3228346457" OwnPage="108" ItemID="962260777" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="37437.3228346457" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="969336089"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="38214.3307086615" OwnPage="109" ItemID="910258169" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="38214.3307086615" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="982855561" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 14"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Eu só acen­di a luz"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="E"/>
                <ITEXT CH="le es­ta­va na es­ta­ção."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não nu­ma es­ta­ção qual­quer. "/>
                <ITEXT CPARENT="c_it" CH="Na"/>
                <ITEXT CH=" es­ta­ção. Re­co­nhe­ceu an­tes de en­xer­gar di­rei­to: o chei­ro de fer­ro mo­lha­do, o ran­gi­do do lam­pi­ão, o qua­dro de ho­rá­rios tor­to na pa­re­de. Mas es­ta­va tu­do er­ra­do. O chão da pla­ta­for­ma flu­tu­a­va no es­cu­ro, sol­to, co­mo uma ilha. Os tri­lhos sa­í­am da bei­ra e iam pa­ra ci­ma, pa­ra o la­do, pa­ra lu­gar ne­nhum. Pe­da­ços de ou­tros lu­ga­res boi­a­vam em vol­ta: a me­sa da co­zi­nha pe­que­na, com uma xí­ca­ra fria em ci­ma; um pe­da­ço de te­lha­do com a chu­va cain­do só ne­le; a bei­ra de uma ca­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no meio da pla­ta­for­ma, ilu­mi­na­do pe­lo úni­co lam­pi­ão, o ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As du­as pon­tas. O la­do es­quer­do va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do, os pu­nhos ain­da fe­cha­dos, a au­ra car­me­sim ain­da ace­sa em vol­ta de­le, e en­ten­deu on­de es­ta­va an­tes de a voz di­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz veio de to­dos os la­dos. De den­tro de­le, in­clu­si­ve."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Bem-vin­do à sua ca­be­ça, Noct."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cei­fa­dor apa­re­ceu sen­ta­do no ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No la­do di­rei­to. No lu­gar de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A foi­ce apoi­a­da no om­bro. O ca­puz vi­ra­do pa­ra o la­do es­quer­do va­zio, co­mo quem olha pa­ra al­guém que não es­tá lá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu só acen­di a luz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Noct não avan­çou. Não con­se­guia. Ha­via uma coi­sa que a voz ti­nha di­to, lá fo­ra, que ain­da es­ta­va den­tro de­le co­mo um an­zol, e ca­da mo­vi­men­to pu­xa­va a li­nha."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O Cei­fa­dor se le­van­tou de­va­gar. An­dou até a bei­ra da pla­ta­for­ma, até on­de os tri­lhos co­me­ça­vam e su­mi­am no es­cu­ro, e fi­cou olhan­do pa­ra eles."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela cha­mou uma se­gun­da vez — dis­se, sem se vi­rar. — Mais bai­xo. Na se­gun­da, já sa­bia que vo­cê não vi­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não dis­se na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não con­se­guia. Ca­da pa­la­vra en­tra­va ne­le e en­con­tra­va lu­gar, co­mo se o lu­gar es­ti­ves­se ali es­pe­ran­do ha­via anos. Um lu­gar es­cu­ro, di­an­te de uma por­ta, e ela so­zi­nha, e o no­me de­le sain­do da bo­ca de­la du­as ve­zes. Ele nem pre­ci­sa­va ima­gi­nar. Já ti­nha ima­gi­na­do. Em mil noi­tes no ban­co, sem nun­ca dei­xar o pen­sa­men­to ir até o fim, ele já ti­nha ima­gi­na­do exa­ta­men­te aqui­lo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ago­ra al­guém ti­nha ido até o fim por ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cei­fa­dor se vi­rou pa­ra ele. O es­cu­ro den­tro do ca­puz pa­re­cia sor­rir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê es­ta­va dor­min­do. Não es­ta­va?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ca­la a bo­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Saiu rou­co, que­bra­do. Noct não re­co­nhe­ceu a pró­pria voz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu não ti­ro na­da de nin­guém. — O Cei­fa­dor abriu os bra­ços, mos­tran­do a es­ta­ção em vol­ta, os pe­da­ços de me­mó­ria boi­an­do no es­cu­ro. — Só mos­tro o que vo­cês já per­de­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E avan­çou com a foi­ce."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Lu­tar den­tro da pró­pria ca­be­ça era di­fe­ren­te."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O chão mu­da­va. Uma ho­ra era a pla­ta­for­ma; ou­tra, o pi­so da co­zi­nha; ou­tra, a pe­dra mo­lha­da do po­ço de Pe­dra­ve­lha. Quan­do Noct pu­la­va, às ve­zes ca­ía num pe­da­ço de te­lha­do on­de cho­via, e a chu­va era a mes­ma da­que­la úl­ti­ma noi­te, pa­ci­en­te, in­sis­ten­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E o Cei­fa­dor fa­la­va. En­tre um gol­pe e ou­tro, su­min­do e re­a­pa­re­cen­do, fa­la­va com aque­la voz que vi­nha de den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O la­do es­quer­do do ban­co. Ain­da va­zio?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu. Ba­teu mais for­te. O pu­nho pas­sou pe­lo man­to e en­con­trou ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— A fi­ta no seu pul­so. — A voz veio de trás de­le, per­to, qua­se no ou­vi­do. — Pra lem­brar de vol­tar... pra quem?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se vi­rou com um cross que te­ria que­bra­do uma pa­re­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não fa­la de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cei­fa­dor já não es­ta­va lá. Es­ta­va do ou­tro la­do, per­to da me­sa da co­zi­nha, e ti­nha al­gu­ma coi­sa nos de­dos de os­so. Um pa­pel. Do­bra­do em qua­tro. Es­ta­va len­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— "/>
                <ITEXT CPARENT="c_it" CH="Vol­to lo­go."/>
                <ITEXT CH=" — A voz imi­tou ou­tra voz, só um pou­co, só o su­fi­ci­en­te. — Quan­tas ve­zes vo­cê leu es­se bi­lhe­te?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não dis­se na­da. A mão de­le foi até o bol­so. O bi­lhe­te es­ta­va lá. Cla­ro que es­ta­va. Aque­le era só uma có­pia, uma lem­bran­ça do bi­lhe­te, mas a mão foi con­fe­rir mes­mo as­sim, e o Cei­fa­dor viu, e riu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão dis­se a pa­la­vra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— "/>
                <ITEXT CPARENT="c_it" CH="Ra­po­si­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O es­cu­ro in­tei­ro es­tre­me­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ain­da cha­ma ela as­sim, quan­do nin­guém es­tá ou­vin­do?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do no meio da pla­ta­for­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nin­guém sa­bia da­que­la pa­la­vra. Nin­guém além de­la. Era a úl­ti­ma coi­sa de­la que ele ain­da ti­nha só pa­ra si, a úl­ti­ma que não ti­nha si­do vis­ta por es­tra­nhos, per­gun­ta­da por re­li­gi­o­sas, li­da por ma­gos em re­gis­tros fri­os. E ago­ra es­ta­va ali, na bo­ca de uma coi­sa sem ros­to, sen­do re­pe­ti­da com zom­ba­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não res­pon­deu. Não ti­nha res­pos­ta. Fi­cou só olhan­do pa­ra o Cei­fa­dor com uma ex­pres­são que não era rai­va, que era al­go mais es­cu­ro e mais qui­e­to do que rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A au­ra car­me­sim em vol­ta de­le mu­dou de cor. Fi­cou mais es­cu­ra. Mais fun­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ca­da gol­pe seu tem gos­to de me­do — dis­se o Cei­fa­dor, er­guen­do a foi­ce. — Con­ti­nua."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct sor­riu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era o sor­ri­so de can­to. Não era o sor­ri­so da adre­na­li­na, de quem en­con­tra uma coi­sa gran­de e se sen­te vi­vo. Era ou­tro. Um que ele nun­ca ti­nha usa­do. Um que não pa­re­cia de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão en­go­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele não lem­brou do res­to da lu­ta, de­pois."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Lem­brou de pe­da­ços. A foi­ce se par­tin­do con­tra o an­te­bra­ço de­le. O chão da pla­ta­for­ma ra­chan­do sob um so­co que er­rou o al­vo. A voz do Cei­fa­dor fi­can­do mais fra­ca, mais dis­tan­te, mas ain­da fa­lan­do, sem­pre fa­lan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela não es­tá aqui. Vo­cê es­tá. So­zi­nho, co­mo sem­pre quis pa­re­cer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a pró­pria voz res­pon­den­do, bai­xa, sem ar, sem na­da hu­ma­no den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Men­ti­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A es­ta­ção de­sa­bou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pla­ta­for­ma se par­tiu em pe­da­ços, o ban­co caiu no es­cu­ro, a me­sa da co­zi­nha, a chu­va, a ca­ma, tu­do foi cain­do, gi­ran­do, su­min­do, e de re­pen­te ha­via de no­vo o chão du­ro do san­tuá­rio sob os jo­e­lhos de­le, e as to­chas de cha­ma fria, e o al­tar ne­gro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E o Cei­fa­dor, ca­í­do no chão, o man­to ras­ga­do, a foi­ce par­ti­da ao la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ain­da fa­la­va. A voz já não vi­nha das pa­re­des nem das cha­mas; vi­nha só de­le, fra­ca, rou­ca, co­mo ven­to pas­san­do por um os­so par­ti­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu men­ti."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou com o pu­nho no ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nun­ca vi a sua Mi­ra. — Um som que po­dia ser ri­so. — Nun­ca ou­vi nin­guém gri­tar o seu no­me. Eu só pro­cu­ro a men­ti­ra que ca­da um já con­ta pa­ra si mes­mo, e re­pi­to com a voz cer­ta. Vo­cê acre­di­tou na ho­ra. Por­que é exa­ta­men­te o que vo­cê te­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois dis­so, na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não se me­xia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct con­ti­nuou ba­ten­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele não sou­be quan­to tem­po."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Sa­bia que o Cei­fa­dor já ti­nha pa­ra­do de se me­xer. Sa­bia que os os­sos den­tro do man­to es­ta­vam par­ti­dos, que o te­ci­do es­ta­va ras­ga­do em vá­rios lu­ga­res. Sa­bia que não ha­via mais mo­ti­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Con­ti­nuou mes­mo as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Jab. Cross. So­co pa­ra bai­xo, con­tra o chão, con­tra o man­to, con­tra a coi­sa que ti­nha di­to "/>
                <ITEXT CPARENT="c_it" CH="ra­po­si­nha"/>
                <ITEXT CH=". A au­ra car­me­sim quei­man­do em vol­ta de­le co­mo uma fo­guei­ra. A res­pi­ra­ção sain­do em gol­fa­das cur­tas, ani­mais. As mãos san­gran­do den­tro das lu­vas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a bra­sa no pei­to de­le can­tan­do. Can­tan­do de ale­gria. Ali­men­tan­do-se de ca­da gol­pe co­mo uma coi­sa fa­min­ta que não co­mia ha­via mui­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em al­gum mo­men­to ele pa­rou. Não por­que de­ci­diu. Por­que os bra­ços pa­ra­ram de obe­de­cer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou de jo­e­lhos ao la­do do cor­po do Cei­fa­dor, ofe­gan­te, olhan­do pa­ra as pró­prias mãos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Elas tre­mi­am."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Men­tiu — dis­se, de olhos fe­cha­dos. — Men­tiu an­tes. Ou men­tiu ago­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não sa­bia qual. Não que­ria sa­ber. Se ti­nha men­ti­do ago­ra, ela ti­nha mor­ri­do gri­tan­do o no­me de­le. Se ti­nha men­ti­do an­tes, ele con­ti­nu­a­va sem sa­ber de na­da, e o gri­to con­ti­nu­a­va lá den­tro do mes­mo jei­to, por­que não ti­nha si­do o Cei­fa­dor quem o pôs ali. Os dois jei­tos do­í­am no mes­mo lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O san­tuá­rio não res­pon­deu. As to­chas fri­as quei­ma­vam. O si­lên­cio era enor­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E den­tro des­se si­lên­cio, de­va­gar, Noct per­ce­beu uma coi­sa. Uma coi­sa que ele sa­bia há mui­to tem­po e nun­ca ti­nha per­mi­ti­do que che­gas­se até a su­per­fície."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Per­ce­beu que ti­nha gos­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não só a bra­sa. Ele. Ti­nha gos­ta­do de ca­da gol­pe. Ti­nha gos­ta­do da for­ça, da rai­va, da sen­sa­ção de ser tão gran­de e tão ter­rí­vel que na­da no mun­do po­dia to­car ne­le. Ti­nha gos­ta­do de trans­for­mar a dor em al­gu­ma coi­sa que ba­tia de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­nha gos­ta­do de usar o no­me de­la co­mo com­bus­tí­vel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele abriu os olhos e olhou pa­ra o chão, pa­ra o man­to ras­ga­do, pa­ra as pró­prias mãos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E a fen­da gos­tou de ca­da gol­pe — dis­se, sem ne­nhu­ma ar­ma­du­ra. A voz qua­se não saiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma pau­sa. Lon­ga."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Eu tam­bém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ten­tou se le­van­tar."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="As per­nas não vi­e­ram. Ele man­dou, e elas não vi­e­ram, e ele caiu de cos­tas no chão do san­tuá­rio, ao la­do do man­to ras­ga­do, e fi­cou ali, olhan­do pa­ra ci­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi aí que co­me­çou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pri­mei­ro o pei­to. Uma mão in­vi­sí­vel aper­tan­do por den­tro, de­va­gar, co­mo quem tor­ce um pa­no mo­lha­do. O ar en­tra­va até a me­ta­de e pa­ra­va. Ele pu­xa­va, e o ar pa­ra­va no mes­mo lu­gar, e ele pu­xa­va de no­vo, mais rápi­do, mais cur­to, e ca­da pu­xa­da tra­zia me­nos. O co­ra­ção dis­pa­rou sem mo­ti­vo ne­nhum, ba­ten­do con­tra as cos­te­las co­mo uma coi­sa pre­sa que­ren­do sair. As mãos for­mi­ga­ram. De­pois os bra­ços. De­pois a bo­ca. O suor frio des­ceu pe­la nu­ca, e o chão de pe­dra, que não se me­xia, co­me­çou a cair, e ele ca­ía jun­to, dei­ta­do, pa­ra­do, cain­do."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Con­ta até qua­tro"/>
                <ITEXT CH=", dis­se a voz da Ir­mã Lí­via, de mui­to lon­ge."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não con­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não quis. Não ha­via na­da do ou­tro la­do do qua­tro que ele qui­ses­se al­can­çar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no meio da­qui­lo, sem pa­rar, as du­as fra­ses. "/>
                <ITEXT CPARENT="c_it" CH="Ela gri­tou seu no­me an­tes de mor­rer."/>
                <ITEXT CH=" "/>
                <ITEXT CPARENT="c_it" CH="Eu men­ti."/>
                <ITEXT CH=" Uma em ci­ma da ou­tra, re­ve­zan­do, co­mo as du­as pon­tas de um ban­co. E em­bai­xo das du­as, a que nin­guém ti­nha di­to e que era a pi­or, por­que era de­le. Fos­se qual fos­se a ver­da­de, na­que­la noi­te ela ti­nha ido so­zi­nha. E ele es­ta­va dor­min­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O aper­to pas­sou, em al­gum mo­men­to. Não por­que ele fez al­gu­ma coi­sa. Pas­sou co­mo pas­sa a chu­va. E dei­xou atrás de si um can­sa­ço tão gran­de que nem era can­sa­ço: era o cor­po de­sis­tin­do de to­das as coi­sas ao mes­mo tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fi­cou dei­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No san­tuá­rio não ha­via ja­ne­las, e as to­chas fri­as nun­ca se apa­ga­vam, e por is­so não ha­via dia nem noi­te. Ha­via só o te­to. Uma cú­pu­la es­cu­ra, al­ta, com ra­cha­du­ras fi­nas on­de a luz azu­la­da não che­ga­va di­rei­to. Noct apren­deu ca­da uma de­las."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Os di­as pas­sa­ram do jei­to que pas­sam pa­ra quem es­tá pre­so: pe­lo cor­po. A fo­me veio, fi­cou, can­sou e foi em­bo­ra. A água do can­til aca­bou, e a se­de veio e não foi. A bar­ba cres­ceu e co­me­çou a co­çar, e ele não co­çou. O san­gue nas lu­vas se­cou, ra­chou, vi­rou pó. Uma vez a au­ra car­me­sim acen­deu so­zi­nha, fra­ca, sem mo­ti­vo, e apa­gou de no­vo, e ele não sen­tiu na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não cho­rou. Ti­nha cho­ra­do na ca­te­dral, de jo­e­lhos, e aqui­lo pa­re­cia ter acon­te­ci­do com ou­tra pes­soa. O ros­to não fa­zia na­da. Quem en­tras­se ia achar que ele es­ta­va mor­to, se não fos­se o pei­to su­bin­do e des­cen­do, de­va­gar, igual à coi­sa que res­pi­ra­va em­bai­xo do al­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não que­ria le­van­tar. Não que­ria lu­tar, nem pro­cu­rar, nem sa­ber. Que­ria que aca­bas­se. Não sa­bia di­rei­to o quê. Tu­do. A bus­ca, a bra­sa, a per­gun­ta, o ba­ru­lho den­tro da ca­be­ça. Que­ria que al­guém vi­es­se e ter­mi­nas­se aqui­lo por ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Per­deu a con­ta dos di­as. Qua­tro, tal­vez. Cin­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi aí que ou­viu o me­tal."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pas­sos pe­sa­dos na na­ve, lá fo­ra. Ar­ma­du­ra ve­lha ba­ten­do em ar­ma­du­ra ve­lha. Uma pon­ta de es­pa­da ris­can­do a pe­dra a ca­da pas­so, co­mo um ve­lho que usa a ben­ga­la pa­ra sa­ber on­de es­tá o chão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A por­ta do san­tuá­rio se abriu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não vi­rou a ca­be­ça. Não pre­ci­sa­va. Co­nhe­cia aque­le pas­so. Ti­nha dan­ça­do com ele nu­ma tri­lha es­trei­ta, en­tre ra­í­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia Er­ran­te pa­rou ao la­do de­le e olhou pa­ra bai­xo. De per­to, o el­mo ti­nha mus­go nas jun­tas. Fi­cou um tem­po as­sim, olhan­do, sem di­zer na­da, do jei­to que de­via ter fi­ca­do anos olhan­do pa­ra a mes­ma tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Faz mui­to tem­po que eu não saio da­que­le bos­que — dis­se, por fim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Uma mo­ça su­biu a tri­lha. So­zi­nha. Com uma man­ta gran­de de­mais pra ela, a pon­ta ar­ras­tan­do na la­ma. — O el­mo se in­cli­nou um pou­co. — Eu er­gui a es­pa­da, co­mo er­go pra to­do mun­do. Ela não re­cuou. Tre­mia in­tei­ra, e não re­cuou. Per­gun­tou se eu ti­nha vis­to um ho­mem de lu­vas que foi pra ca­te­dral e não vol­tou. — Uma pau­sa. — Per­gun­tou do jei­to de quem já ti­nha per­gun­ta­do pra to­do mun­do, e nin­guém ti­nha vis­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu dis­se que não. Ela fi­cou ali pa­ra­da um tem­po, aper­tan­do a man­ta no pei­to, co­mo se fos­se a úni­ca coi­sa que ain­da se­gu­ra­va ela de pé. De­pois dis­se: "/>
                <ITEXT CPARENT="c_it" CH="En­tão al­guém tem que ir ver. Eu não sei lu­tar."/>
                <ITEXT CH=" — A voz de­le bai­xou. — Faz mui­tos anos que nin­guém me pe­de pra ir a lu­gar ne­nhum. Só pra fi­car."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O no­me veio an­tes de ele que­rer. Fi­cou ali, no pei­to, no lu­gar on­de as du­as fra­ses re­ve­za­vam. Ocu­pou um pe­da­ço pe­que­no."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Dis­se que vo­cê ti­nha man­da­do ela vol­tar. Que ela vol­tou, e sen­tou no ban­co, e es­pe­rou. — Uma pau­sa. — E que vo­cê não apa­re­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia se aga­chou, de­va­gar, com o ba­ru­lho de quem tem as jun­tas chei­as de fer­ru­gem, e pôs no chão, ao la­do da ca­be­ça de Noct, um pão em­bru­lha­do num pa­no e um can­til cheio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela man­dou is­so tam­bém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra o te­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vai em­bo­ra. — A voz saiu de um lu­gar que não era usa­do ha­via di­as."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia não foi. Cra­vou a es­pa­da na pe­dra, co­mo ti­nha fei­to na tri­lha, e se apoi­ou no ca­bo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Lá no bos­que, eu te pe­di um fim — dis­se. — Vo­cê me ne­gou. Dis­se: pe­de pra ou­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Si­lên­cio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão eu tam­bém não vou te dar o seu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu fi­quei anos de pé na­que­la tri­lha — con­ti­nuou o Vi­gia. — Es­pe­ran­do. Es­que­ci pe­lo quê, es­que­ci por quem. Achei que guar­dar era is­so: fi­car pa­ra­do no mes­mo lu­gar até o mo­ti­vo apo­dre­cer. — A voz de­le era rou­ca, sem pres­sa. — Vo­cê es­tá fa­zen­do a mes­ma coi­sa. Só que dei­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não é a mes­ma coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não. É pi­or. Eu pe­lo me­nos es­ta­va de pé."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct abriu os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê me dis­se pra con­ti­nu­ar guar­dan­do a tri­lha. Eu con­ti­nu­ei. E um dia a tri­lha te­ve uma mo­ça ne­la, so­zi­nha, por cau­sa de um ho­mem que ela mal co­nhe­ce. — Ele se in­cli­nou um pou­co mais so­bre o ca­bo da es­pa­da. — Não sei o que te der­ru­bou. Não pre­ci­so sa­ber. Mas a coi­sa que te der­ru­bou ain­da es­tá aí em­bai­xo, res­pi­ran­do. E a mo­ça ou­ve ela. Me con­tou na tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu. Não pre­ci­sa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou na mo­ça en­ro­la­da na man­ta de­le, per­gun­tan­do "/>
                <ITEXT CPARENT="c_it" CH="E vol­ta?"/>
                <ITEXT CH=". Na mo­ça que ti­nha bai­xa­do a voz, co­mo quem tem ver­go­nha, pa­ra con­tar que às ve­zes ou­via al­guém cha­man­do do ou­tro la­do de uma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou no re­gis­tro do Cus­tó­dio. Nos no­mes de quem nin­guém sen­tia fal­ta. Em quan­tos ain­da iam ou­vir aqui­lo, de noi­te, nu­ma ca­ma, com al­guém do la­do di­zen­do que era can­sa­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou que já ti­nha si­do o ho­mem que vi­ra­va pa­ra o ou­tro la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não que­ria ser de no­vo. Não que­ria que mais nin­guém acor­das­se nu­ma ma­nhã com um bi­lhe­te na me­sa e uma per­gun­ta pa­ra o res­to da vi­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O que é aqui­lo? — dis­se, pa­ra o te­to. — Lá em­bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não sei — dis­se o Vi­gia. — Mas vo­cê não vai des­co­brir daí do chão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou mais um tem­po dei­ta­do. De­pois, de­va­gar, en­cheu o pei­to. Um, dois, três, qua­tro. Se­gu­rou. Sol­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fez de no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na ter­cei­ra vez, o ar foi até o fim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se sen­tou. A ca­be­ça gi­rou, o san­tuá­rio gi­rou jun­to, e o Vi­gia não es­ten­deu a mão, e Noct fi­cou gra­to por is­so. Pe­gou o can­til e be­beu até do­er. De­sem­bru­lhou o pão. Era pão da vi­la, já meio du­ro, e ele co­meu sen­ta­do no chão, ao la­do do man­to ras­ga­do do Cei­fa­dor, sem sen­tir gos­to ne­nhum, até a úl­ti­ma mi­ga­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela es­tá es­pe­ran­do em Pe­dra­ve­lha? — per­gun­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— No ban­co. — O Vi­gia ar­ran­cou a es­pa­da da pe­dra. — Dis­se que fi­ca lá até vo­cê vol­tar ou até ela can­sar. Pe­lo jei­to, não can­sa fácil."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct qua­se sor­riu. Não che­gou lá. Mas qua­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia já ti­nha se vi­ra­do pa­ra a por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ei."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O el­mo pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pra quem vo­cê guar­da a tri­lha, ago­ra?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia pen­sou um tem­po. De­pois res­pon­deu sem se vi­rar, a voz um pou­co me­nos rou­ca do que an­tes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pra quem so­be por ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E foi em­bo­ra, a pon­ta da es­pa­da ris­can­do a pe­dra, um pas­so de ca­da vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou sen­ta­do no meio do san­tuá­rio, com mi­ga­lhas no co­lo e a fi­ta no pul­so. A per­gun­ta de sem­pre con­ti­nu­a­va lá den­tro, on­de sem­pre es­te­ve. Mas ago­ra ha­via ou­tra ao la­do de­la. Mai­or, mais fria, e que fi­nal­men­te ca­bia nas mãos de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="O que é es­sa por­ta. E co­mo se fe­cha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="En­tre os res­tos do man­to, ha­via um li­vro. Gros­so, en­ca­der­na­do em cou­ro es­cu­ro, com um fe­cho de os­so. O gri­mó­rio do Cei­fa­dor."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct o pe­gou. Sen­tiu as pági­nas pul­sa­rem con­tra os de­dos, no mes­mo rit­mo da bra­sa. Não abriu. Guar­dou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois sou­be uma coi­sa, sem sa­ber co­mo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra a pa­re­de do san­tuá­rio, on­de um dos vei­os ver­me­lhos da ca­te­dral se alar­ga­va até vi­rar uma pa­re­de in­tei­ra de cris­tal car­me­sim, igual à que ele ti­nha en­con­tra­do no fun­do do po­ço de Pe­dra­ve­lha. Igual à que ti­nha di­to "/>
                <ITEXT CPARENT="c_it" CH="ain­da não"/>
                <ITEXT CH="."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele an­dou até ela. Es­ten­deu a mão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pa­re­de não re­sis­tiu. A mão de­le en­trou no cris­tal co­mo en­tra na água, e de­pois o bra­ço, e de­pois ele in­tei­ro, num pas­so rápi­do, e quan­do saiu do ou­tro la­do es­ta­va num cor­re­dor que não exis­tia an­tes, ou que sem­pre ti­nha exis­ti­do e só ago­ra o dei­xa­va pas­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As pa­re­des car­me­sim ti­nham dei­xa­do de ser pa­re­des pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou do ou­tro la­do e olhou pa­ra trás, pa­ra a pa­re­de ver­me­lha que ti­nha aca­ba­do de atra­ves­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sa­bia o que aqui­lo sig­ni­fi­ca­va. Sig­ni­fi­ca­va que a fen­da o re­co­nhe­cia ago­ra. Que ti­nha vis­to o que ele fez no san­tuá­rio, sen­ti­do o gos­to, e de­ci­di­do que ele era de­la o su­fi­ci­en­te pa­ra pas­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quem guar­da­va aque­la por­ta ti­nha en­con­tra­do o no­me de­le na lis­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O cor­re­dor era cur­to. Fa­zia uma cur­va por trás da pa­re­de e ter­mi­na­va em­bai­xo do al­tar ne­gro, do la­do de den­tro da pe­dra."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ali, a pe­dra es­ta­va quen­te. Mui­to quen­te. E ha­via uma ra­cha­du­ra, fi­na, ver­me­lha, a mes­ma on­de ter­mi­na­va o ras­tro do Cus­tó­dio, que des­cia por bai­xo da ca­te­dral, por bai­xo de tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se aga­chou e en­cos­tou a mão na pe­dra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­tiu. Lá em­bai­xo, mui­to em­bai­xo, al­gu­ma coi­sa su­bia e des­cia. De­va­gar. Em si­lên­cio. Co­mo um pei­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tem al­gu­ma coi­sa res­pi­ran­do aí em­bai­xo — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E fi­cou ali, aga­cha­do, com a mão na pe­dra quen­te, por mui­to mais tem­po do que pre­ci­sa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não es­ta­va pen­san­do no que ha­via lá em­bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va pen­san­do em uma es­tra­da que des­cia pa­ra o oes­te. Nu­ma fi­gu­ra pe­que­na en­ro­la­da nu­ma man­ta es­cu­ra. Na per­gun­ta que ela ti­nha fei­to e que ele não ti­nha res­pon­di­do."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="E vol­ta?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra as pró­prias mãos, ain­da su­jas do que ti­nha fei­to no san­tuá­rio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Des­sa vez a res­pos­ta não veio em for­ma de me­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá em­bai­xo, aque­la coi­sa res­pi­ra­va de­bai­xo de uma ca­te­dral, de­bai­xo de uma ser­ra, de­bai­xo de uma vi­la on­de uma mo­ça en­ro­la­da nu­ma man­ta ou­via al­guém cha­man­do. Nin­guém ti­nha fe­cha­do aqui­lo. Os san­tos ti­nham de­sis­ti­do, o Cus­tó­dio ti­nha ali­men­ta­do a por­ta com no­mes, e a por­ta ti­nha con­ti­nu­a­do cha­man­do, ge­ra­ção de­pois de ge­ra­ção, quem ti­nha per­di­do al­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Pri­mei­ro eu en­ten­do o que vo­cê é"/>
                <ITEXT CH=", pen­sou, com a mão na pe­dra quen­te. "/>
                <ITEXT CPARENT="c_it" CH="De­pois eu te fe­cho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era pro­mes­sa. Ele não pro­me­tia na­da pa­ra nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas se le­van­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Fim da Par­te IV."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="38129.2913385827" OwnPage="110" ItemID="982855561" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="38129.2913385827" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="982954713" BACKITEM="910258169"/>
