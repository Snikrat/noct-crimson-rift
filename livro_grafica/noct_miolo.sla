        <PAGEOBJECT XPOS="151.023622047244" YPOS="13910.3937007874" OwnPage="39" ItemID="873814569" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="13910.3937007874" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="873768057" BACKITEM="873912953"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="13910.3937007874" OwnPage="40" ItemID="873768057" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="13910.3937007874" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="876515161" BACKITEM="873814569"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="14602.3622047244" OwnPage="41" ItemID="876515161" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="14602.3622047244" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="876870489" BACKITEM="873768057"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="14602.3622047244" OwnPage="42" ItemID="876870489" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="14602.3622047244" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="875506825" BACKITEM="876515161"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="15294.3307086614" OwnPage="43" ItemID="875506825" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="15294.3307086614" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="876870489"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="15379.3700787402" OwnPage="44" ItemID="873278681" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="15379.3700787402" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="882717705" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 5"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Bo­ni­ta, ou de­co­ra­ção"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="N"/>
                <ITEXT CH="o al­to do bos­que, on­de as ár­vo­res fi­ca­vam mais ve­lhas e mais tor­tas e a tri­lha se es­trei­ta­va até vi­rar qua­se um bo­a­to, ha­via um ho­mem es­pe­ran­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct não o viu che­gar. Is­so, por si só, já era ra­ro o bas­tan­te pa­ra ser in­te­res­san­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em um mo­men­to a tri­lha es­ta­va va­zia. No se­guin­te, ha­via uma lâ­mi­na en­cos­ta­da no pes­co­ço de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fria. Fir­me. Afi­a­da o su­fi­ci­en­te pa­ra que ele sen­tis­se o fio sem que ele cor­tas­se, o que exi­gia uma mão mui­to pre­ci­sa ou mui­to can­sa­da. Tal­vez as du­as coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mais um pas­so e a con­ver­sa ter­mi­na­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não deu o pas­so. Tam­bém não re­cuou. Bai­xou os olhos de­va­gar, até en­con­trar a lâ­mi­na: uma es­pa­da lon­ga, de aço es­cu­ro, sem en­fei­tes, com a guar­da gas­ta no lu­gar on­de um po­le­gar ti­nha des­can­sa­do por anos. De­pois su­biu os olhos pe­la lâ­mi­na, pe­lo bra­ço, pe­la ar­ma­du­ra amas­sa­da e co­ber­ta de mus­go nas jun­tas, até o el­mo fe­cha­do de on­de o ob­ser­va­va al­guém que ele não con­se­guia ver."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou a lâ­mi­na. De­pois a pes­soa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Bo­ni­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Dei­xou a pa­la­vra pen­du­ra­da no ar, só o su­fi­ci­en­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vai usar ou é de­co­ra­ção?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="De den­tro do el­mo veio um som que po­dia ter si­do uma ri­sa­da, se a pes­soa que o fez ain­da lem­bras­se co­mo se ri. A lâ­mi­na não se me­xeu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Guar­dei es­ta tri­lha — dis­se o ho­mem, e a voz de­le era rou­ca, en­fer­ru­ja­da, co­mo uma por­ta que nin­guém abre há anos — até es­que­cer pa­ra quem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pen­sou nis­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou em fi­car de pé to­dos os di­as no mes­mo lu­gar, com a mes­ma es­pa­da, es­pe­ran­do a mes­ma coi­sa. Pen­sou em fa­zer is­so por tan­to tem­po que o mo­ti­vo se dis­sol­via, co­mo açú­car em água, até so­brar só o hábi­to. Fi­car de pé por­que o cor­po não sa­be mais fa­zer ou­tra coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou que co­nhe­cia aqui­lo me­lhor do que gos­ta­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pa­re­ce can­sa­ti­vo — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia Er­ran­te, pois era as­sim que os vi­a­jan­tes o cha­ma­vam quan­do fa­la­vam de­le em voz bai­xa nas ta­ver­nas, abai­xou a es­pa­da um pal­mo. Não o su­fi­ci­en­te pa­ra que Noct es­ti­ves­se se­gu­ro. O su­fi­ci­en­te pa­ra que os dois pu­des­sem con­ver­sar sem que um de­les ti­ves­se que en­go­lir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um du­e­lo — dis­se o Vi­gia. — Até a mor­te. Um de nós não sai des­ta tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct o es­tu­dou. O ho­mem não es­ta­va pe­din­do di­nhei­ro. Não es­ta­va pe­din­do pas­sa­gem, nem no­me, nem le­al­da­de. Es­ta­va pe­din­do uma coi­sa que nin­guém ti­nha pe­di­do a Noct em mui­to tem­po, e que ele en­ten­dia bem de­mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va pe­din­do um fim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa atrás das cos­te­las se me­xeu, cu­ri­o­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Vo­cê po­de sim­ples­men­te pas­sar"/>
                <ITEXT CH=", dis­se a par­te da ca­be­ça de­le que fa­zia con­tas. "/>
                <ITEXT CPARENT="c_it" CH="Ele não vai te im­pe­dir. Ele não quer te im­pe­dir. Ele quer só que al­guém ter­mi­ne o que ele não con­se­gue ter­mi­nar so­zi­nho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ou­tra par­te, a que gos­ta­va de coi­sas gran­des e pe­ri­go­sas, já es­ta­va fe­chan­do os pu­nhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Vi­gia lu­ta­va co­mo um ho­mem que ti­nha es­que­ci­do tu­do, me­nos aqui­lo."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não ha­via des­per­dí­cio ne­le. Ca­da gol­pe sa­ía do an­te­ri­or co­mo água de um rio, sem pres­sa e sem pau­sa, e ter­mi­na­va exa­ta­men­te on­de ele que­ria que ter­mi­nas­se, nem um de­do além. Noct blo­que­ou o pri­mei­ro, des­vi­ou do se­gun­do, sen­tiu o ter­cei­ro pas­sar tão per­to da ore­lha que o brin­co ti­lin­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O sor­ri­so de can­to veio. Cla­ro que veio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct ata­cou de vol­ta, e por al­guns mi­nu­tos os dois dan­ça­ram na tri­lha es­trei­ta, en­tre ra­í­zes e pe­dras, aço con­tra pu­nho, sem pa­la­vras. Era bom. Era "/>
                <ITEXT CPARENT="c_it" CH="mui­to"/>
                <ITEXT CH=" bom. Era o ti­po de lu­ta que ele não ti­nha há me­ses, a mai­o­ria das coi­sas que ele en­fren­ta­va eram bi­chos com fo­me ou ho­mens com pres­sa. Is­so aqui era uma con­ver­sa. Uma per­gun­ta fei­ta com a lâ­mi­na e res­pon­di­da com os pu­nhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão a bra­sa acor­dou de ver­da­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi num mo­men­to pe­que­no. O Vi­gia o pe­gou de ras­pão no bra­ço, um cor­te ra­so, na­da. A dor veio quen­te, lim­pa, e atrás de­la veio ou­tra coi­sa. Um ca­lor que su­biu do pei­to pa­ra os om­bros, dos om­bros pa­ra as mãos. A vi­são de Noct fi­cou um tom mais ver­me­lha nas bor­das. Os gol­pes de­le fi­ca­ram mais rápi­dos. Mais pe­sa­dos. Mais..."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele viu a aber­tu­ra. O Vi­gia ti­nha bai­xa­do a guar­da um ins­tan­te pa­ra re­cu­pe­rar o pé nu­ma raiz. Era uma aber­tu­ra per­fei­ta, lar­ga, na al­tu­ra do pes­co­ço, on­de a ar­ma­du­ra não co­bria. Um gol­pe ali e a lu­ta aca­ba­va. Um gol­pe ali e aca­ba­va tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pu­nho de Noct já es­ta­va a ca­mi­nho, as fa­gu­lhas car­me­sim ace­sas nos nós dos de­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa can­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não sou­be de on­de veio o pen­sa­men­to. Não da voz rou­ca do Vi­gia, que ti­nha pe­di­do o con­trá­rio. De al­gum lu­gar mais an­ti­go, mais fun­do, de uma pro­mes­sa que ele não se dei­xa­va lem­brar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pu­nho pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­rou a um de­do do pes­co­ço do Vi­gia. Exa­ta­men­te on­de a lâ­mi­na do Vi­gia ti­nha pa­ra­do, no co­me­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="On­tem ele ti­nha ju­ra­do ma­tar to­dos. Ho­je o pu­nho pa­rou so­zi­nho, e ele não sa­bia qual das du­as coi­sas o as­sus­ta­va mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os dois fi­ca­ram imó­veis. O ver­me­lho nas bor­das da vi­são de Noct pul­sou uma vez, du­as, co­mo al­guém ba­ten­do nu­ma por­ta, e de­pois re­cuou, con­tra­ri­a­do, de vol­ta pa­ra o lu­gar de on­de ti­nha vin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct es­ta­va res­pi­ran­do co­mo se ti­ves­se cor­ri­do qui­lô­me­tros. A mão ain­da fe­cha­da tre­mia. Ele não dei­xou o Vi­gia ver. Ou achou que não dei­xou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia abai­xou a pró­pria es­pa­da. Len­ta­men­te, ele a cra­vou na ter­ra da tri­lha e se apoi­ou no ca­bo, co­mo um ve­lho se apoia num ca­ja­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ain­da sa­be pa­rar — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­rou de den­tro da ar­ma­du­ra uma bol­sa de cou­ro e a jo­gou aos pés de Noct. Mo­e­das. Mais do que um ho­mem que guar­da uma tri­lha es­que­ci­da te­ria mo­ti­vo pa­ra jun­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Le­ve is­to. Vo­cê vai pre­ci­sar mais do que eu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pe­gou a bol­sa. Pe­sou na mão. Não agra­de­ceu, por­que agra­de­cer se­ria ad­mi­tir que aqui­lo sig­ni­fi­ca­va al­gu­ma coi­sa, e sig­ni­fi­ca­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia já ti­nha se vi­ra­do. An­da­va de vol­ta pa­ra o seu lu­gar na tri­lha, pa­ra o mes­mo tre­cho de ter­ra on­de pro­va­vel­men­te es­pe­ra­va há anos, os pés en­con­tran­do as mes­mas mar­cas no chão que os pés de­le ti­nham fei­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou olhan­do pa­ra as cos­tas de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou em mil coi­sas pa­ra di­zer. Coi­sas es­per­tas, coi­sas afi­a­das, do ti­po que ele sem­pre ti­nha pron­tas. "/>
                <ITEXT CPARENT="c_it" CH="Boa sor­te es­pe­ran­do nin­guém. Se lem­brar pa­ra quem guar­da, me avi­sa. Be­la ar­ma­du­ra, pe­na do mus­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não dis­se ne­nhu­ma de­las."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Con­ti­nue guar­dan­do a tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Saiu sem ne­nhu­ma iro­nia. Ele mes­mo se sur­preen­deu com is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Al­guém tem que lem­brar pa­ra quem"/>
                <ITEXT CH=", pen­sou. A mão já es­ta­va na fi­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Vi­gia pa­rou. Não se vi­rou. Mas fi­cou pa­ra­do tem­po su­fi­ci­en­te pa­ra que Noct sou­bes­se que ti­nha ou­vi­do. Que, de al­gum jei­to, nu­ma tri­lha es­que­ci­da no al­to de um bos­que, um ho­mem que ti­nha es­que­ci­do pa­ra quem guar­da­va ti­nha re­ce­bi­do, de um es­tra­nho, uma ra­zão pa­ra con­ti­nu­ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ou tal­vez fos­se o con­trá­rio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Já es­ta­va qua­se de vol­ta ao seu lu­gar quan­do fa­lou de no­vo, sem se vi­rar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê te­ve a chan­ce de me ma­tar. Não o fez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu sei o que vo­cê pe­diu. Pe­de pra ou­tro — dis­se Noct, de la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O el­mo se in­cli­nou um pou­co, co­mo quem con­cor­da com uma coi­sa que não pre­ci­sa­va ser di­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Os sa­que­a­do­res guar­dam a ser­ra. Na ca­te­dral, pro­cu­re a por­ta mar­ca­da pe­lo crâ­nio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois dis­so, não dis­se mais na­da. Vol­tou a ser par­te da tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct abriu as mãos, sa­cu­diu os de­dos e su­biu em di­re­ção à ser­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No bra­ço, o cor­te ra­so ar­dia. Não amar­rou. Dei­xou ar­der. Era uma dor lim­pa, ho­nes­ta, que vi­nha de um lu­gar on­de ele sa­bia o que ti­nha acon­te­ci­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ou­tra dor, a que ti­nha su­bi­do jun­to com o ver­me­lho e qua­se fe­cha­do o pu­nho no pes­co­ço de um ho­mem, ele não sa­bia de on­de vi­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ti­nha me­do de sa­ber."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="15986.2992125984" OwnPage="45" ItemID="882717705" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="15986.2992125984" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="882693641" BACKITEM="873278681"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="15986.2992125984" OwnPage="46" ItemID="882693641" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="15986.2992125984" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="883090921" BACKITEM="882717705"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="16678.2677165354" OwnPage="47" ItemID="883090921" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="16678.2677165354" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="882589817" BACKITEM="882693641"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="16678.2677165354" OwnPage="48" ItemID="882589817" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="16678.2677165354" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="885520425" BACKITEM="883090921"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="17370.2362204725" OwnPage="49" ItemID="885520425" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="17370.2362204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="882589817"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="17455.2755905512" OwnPage="50" ItemID="853626569" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="17455.2755905512" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="894845305" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 6"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="On­de o céu ain­da al­can­ça a vi­la"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="O"/>
                <ITEXT CH=" Ga­to po­dia es­pe­rar. Na lis­ta, um no­me ain­da não ti­nha o cír­cu­lo de en­tre­gue, e o Vi­gia ti­nha di­to on­de os sa­que­a­do­res fi­ca­vam."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A ser­ra era fei­ta de pe­dra e de ven­to, e de na­da mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via ár­vo­res além de uma ou ou­tra, re­tor­ci­das, agar­ra­das às fen­das da ro­cha co­mo al­guém que se re­cu­sa a sol­tar uma mão. O ca­mi­nho su­bia em zi­gue-za­gue, es­trei­to, com a mon­ta­nha de um la­do e o va­zio do ou­tro. O ven­to vi­nha de bai­xo, do va­le, e tra­zia o chei­ro do bos­que e, por bai­xo de­le, uma coi­sa me­táli­ca e do­ce que Noct já ti­nha apren­di­do a re­co­nhe­cer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fen­da. Sem­pre um pou­co mais per­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nu­ma cur­va do ca­mi­nho, ele pa­rou e olhou pa­ra trás."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá em­bai­xo, pe­que­na co­mo um brin­que­do es­que­ci­do, es­ta­va Pe­dra­ve­lha. Os te­lha­dos es­cu­ros. A tor­re tor­ta. A pra­ça, e no meio de­la um pon­ti­nho que po­dia ser o po­ço, e ao la­do de­le um tra­ço que po­dia ser um ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ain­da dá pra ver a vi­la da­qui — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ven­to pas­sou por ele e foi em­bo­ra sem dar opi­ni­ão. O céu, ali em ci­ma, era enor­me, de um cin­za cla­ro que qua­se che­ga­va a ser azul, e pa­re­cia des­cer até to­car os te­lha­dos lá em­bai­xo. Era bo­ni­to. Do jei­to que coi­sas gran­des e in­di­fe­ren­tes são bo­ni­tas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct sen­tiu uma coi­sa se me­xer no pei­to que não era a bra­sa. Uma coi­sa mais ma­cia, mais pe­ri­go­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Lu­gar bo­ni­to. — Vi­rou as cos­tas pa­ra a vis­ta. — Me­lhor ir em­bo­ra an­tes que vi­re im­por­tan­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O acam­pa­men­to dos Des­gar­ra­dos fi­ca­va num pla­tô lar­go, per­to do to­po."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct o ou­viu an­tes de vê-lo: ri­sa­das al­tas, o ba­ru­lho de gar­ra­fas, o es­ta­lo de uma fo­guei­ra que nin­guém es­con­di­do acen­de­ria. Os Des­gar­ra­dos não que­ri­am se es­con­der. Que­ri­am ser vis­tos. Era as­sim que ban­dos co­mo aque­le fun­ci­o­na­vam: o me­do dos ou­tros era me­ta­de do tra­ba­lho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se apro­xi­mou pe­lo al­to, por ci­ma das pe­dras, e olhou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Qua­tro ou cin­co ho­mens em vol­ta de uma fo­guei­ra. Bar­ra­cas de lo­na re­men­da­da. Cai­xas em­pi­lha­das com se­los de fa­zen­das di­fe­ren­tes, co­mo no es­con­de­ri­jo do bos­que. E no meio de tu­do, sen­ta­do nu­ma ca­dei­ra de ma­dei­ra que al­guém ti­nha car­re­ga­do mon­ta­nha aci­ma só pa­ra que ele ti­ves­se on­de sen­tar, um ho­mem lar­go, de ca­puz es­cu­ro, com pla­cas de aço amas­sa­das so­bre o pei­to e os om­bros e uma ca­pa ver­me­lha des­bo­ta­da cain­do pe­las cos­tas. En­cos­ta­da na ca­dei­ra, uma ci­mi­tar­ra lar­ga, cur­va co­mo um sor­ri­so ruim. Aos pés de­le, en­ro­la­da com cui­da­do, uma re­de de cor­da com pe­sos de chum­bo nas pon­tas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ca­pi­tão dos Des­gar­ra­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ao la­do da ca­dei­ra, amar­ra­do a uma es­ta­ca, ha­via um ra­paz. Não po­dia ter mais de de­zes­seis anos. O ros­to es­ta­va in­cha­do de um la­do, e ele olha­va fi­xo pa­ra o chão com a con­cen­tra­ção fe­roz de quem de­ci­diu que, se não olhar pa­ra nin­guém, tal­vez nin­guém o ve­ja."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na lis­ta que Noct car­re­ga­va no bol­so, ha­via um no­me sem cír­cu­lo ao la­do. Ain­da não en­tre­gue."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não sa­bia se era ele. Não pre­ci­sa­va sa­ber."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa não se me­xeu. Foi ou­tra coi­sa que se me­xeu, mais fria, mais an­ti­ga, uma coi­sa que não ti­nha na­da a ver com fen­das nem com por­tas. Uma coi­sa que acor­da­va sem­pre que al­guém gran­de ma­chu­ca­va al­guém pe­que­no, e que Noct nun­ca ti­nha con­se­gui­do fa­zer dor­mir, por mais que ten­tas­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele des­ceu das pe­dras e en­trou no acam­pa­men­to pe­la fren­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Os ho­mens o vi­ram e se le­van­ta­ram, mãos in­do pa­ra as fa­cas. O Ca­pi­tão er­gueu dois de­dos e to­dos pa­ra­ram. Era um bom tru­que. Noct re­gis­trou: o ho­mem ti­nha au­to­ri­da­de de ver­da­de, não só ta­ma­nho."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O Ca­pi­tão olhou pa­ra ele de ci­ma a bai­xo. Olhou pa­ra as lu­vas. Olhou pa­ra a fi­ta. Sor­riu por bai­xo do ca­puz, o sor­ri­so de quem já cal­cu­lou quan­to va­le o que es­tá ven­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão é vo­cê que an­dou es­tra­gan­do meus ra­pa­zes lá em­bai­xo. — Ba­teu no bra­ço da ca­dei­ra. — E sol­tou mi­nha en­co­men­da da car­ro­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vai ban­car o he­rói?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="A per­gun­ta veio cheia de de­bo­che, do ti­po que se faz pa­ra ou­vir a res­pos­ta e rir de­la. O acam­pa­men­to in­tei­ro fi­cou qui­e­to, es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pen­sou na per­gun­ta de ver­da­de. Nin­guém nun­ca acre­di­ta­va, mas ele sem­pre pen­sa­va nas per­gun­tas de ver­da­de."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="He­rói."/>
                <ITEXT CH=" He­róis eram pes­so­as que acre­di­ta­vam em al­gu­ma coi­sa. Que ti­nham um mo­ti­vo gran­de, lim­po, es­cri­to em le­tras dou­ra­das. Que sal­va­vam o mun­do por­que o mun­do me­re­cia ser sal­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não acha­va que o mun­do me­re­cia na­da. O mun­do ti­nha le­va­do a úni­ca coi­sa que ele... O mun­do não me­re­cia na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ca­pi­tão riu. Os ho­mens ri­ram jun­to, ali­vi­a­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra o ra­paz amar­ra­do na es­ta­ca. Olhou por um tem­po. O ra­paz le­van­tou os olhos do chão, só por um ins­tan­te, e en­con­trou os de­le, e ha­via ne­les um pe­di­do que o ga­ro­to nem sa­bia que es­ta­va fa­zen­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct vol­tou a olhar pa­ra o Ca­pi­tão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Só não gos­to de vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As ri­sa­das mor­re­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Foi uma lu­ta feia, co­mo lu­tas na bei­ra de um pe­nhas­co cos­tu­mam ser."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O Ca­pi­tão se le­van­tou de­va­gar, pe­gou a ci­mi­tar­ra e fez um ges­to cur­to pa­ra os ho­mens de­le, que já vi­nham com as fa­cas. Eles pa­ra­ram. Ele não que­ria aju­da. Que­ria pla­teia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vi­vo va­le mais — dis­se, gi­ran­do a lâ­mi­na cur­va no pul­so. — Mas mor­to tam­bém ser­ve."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não hou­ve dan­ça, co­mo com o Vi­gia. Não hou­ve per­gun­ta e res­pos­ta. O Ca­pi­tão lu­ta­va co­mo um co­mer­ci­an­te: sem des­per­dí­cio, sem pres­sa, sem­pre me­din­do o pre­ço. De per­to, a ci­mi­tar­ra des­cia por ci­ma em ta­lhos pe­sa­dos. Na meia dis­tân­cia, ele se lan­ça­va nu­ma es­to­ca­da com­pri­da, o cor­po in­tei­ro atrás da pon­ta. E quan­do Noct re­cu­a­va pa­ra res­pi­rar, a mão li­vre ia até a re­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pri­mei­ra veio sem avi­so. Abriu no ar co­mo uma flor de cor­da e caiu em ci­ma de­le, os pe­sos de chum­bo ba­ten­do nos om­bros, e de re­pen­te Noct es­ta­va en­ros­ca­do, len­to, ca­da mo­vi­men­to cus­tan­do o do­bro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Uma re­de — dis­se, pu­xan­do as cor­das. — Sé­rio?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era as­sim que eles fa­zi­am, en­ten­deu. Com Tes­sa. Com o ra­paz da es­ta­ca. Com to­dos os no­mes da lis­ta. Não era pre­ci­so ser fra­co pa­ra aca­bar na lis­ta. Bas­ta­va ou­vir a fen­da e cair de­bai­xo de uma re­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ras­gou a re­de e le­van­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ca­pi­tão fa­la­va en­quan­to lu­ta­va. Não pa­ra Noct, exa­ta­men­te. Pa­ra os ho­mens de­le, pa­ra a ser­ra, pa­ra o pra­zer de se ou­vir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O Cus­tó­dio pa­ga por ca­be­ça. A sua va­le o do­bro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ele vai pe­dir des­con­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um ta­lho pas­sou ren­te ao ros­to. Noct en­trou por bai­xo e acer­tou um jab nas cos­te­las, e sen­tiu a pla­ca de aço ce­der um pou­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Quem ou­ve a fen­da não dor­me di­rei­to — dis­se o Ca­pi­tão, re­cu­an­do sem per­der o fô­le­go. — Eu só aju­do a dor­mir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu. Ba­teu de no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Cor­re, ga­ro­to — dis­se o Ca­pi­tão ao ra­paz da es­ta­ca, rin­do, sem ti­rar os olhos de Noct. — Os ou­tros tam­bém cor­re­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Quan­tos vo­cê ven­deu?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ca­pi­tão deu de om­bros, co­mo quem fa­la do pre­ço do tri­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Per­di a con­ta. No­me não pa­ga co­mi­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou meio se­gun­do. "/>
                <ITEXT CPARENT="c_it" CH="Di­nhei­ro pa­ga co­mi­da"/>
                <ITEXT CH=", ele mes­mo ti­nha di­to, mais de uma vez, com o mes­mo dar de om­bros. Não dis­se na­da. Não ha­via na­da ne­le, na­que­le ins­tan­te, que cou­bes­se nu­ma fra­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi o meio se­gun­do que o Ca­pi­tão que­ria. O ca­bo da ci­mi­tar­ra acer­tou Noct no om­bro, com o pe­so do cor­po in­tei­ro atrás, e o jo­gou con­tra uma pe­dra com for­ça su­fi­ci­en­te pa­ra que o mun­do fi­cas­se bran­co por um se­gun­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nes­se se­gun­do, a bra­sa su­biu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct a sen­tiu vin­do, quen­te, an­si­o­sa, co­mo um cão pu­xan­do a co­lei­ra. Bas­ta­va dei­xar. Bas­ta­va abrir a mão e ela fa­ria o res­to, e se­ria rápi­do, e se­ria fácil, e se­ria mui­to, mui­to bom."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se lem­brou do Vi­gia. "/>
                <ITEXT CPARENT="c_it" CH="Ain­da sa­be pa­rar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Se­gu­rou a co­lei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Le­van­tou-se com a pró­pria for­ça, cus­piu san­gue na pe­dra e vol­tou do jei­to an­ti­go: com os pu­nhos, com os pés, com a ca­be­ça. O Ca­pi­tão sen­tiu a di­fe­ren­ça. Re­cuou dois pas­sos se­gui­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E per­deu a pa­ciên­cia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ba­teu o pé no chão com for­ça, e o gri­to saiu rou­co, de quem não es­tá acos­tu­ma­do a pre­ci­sar dos ou­tros."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Che­ga de brin­ca­dei­ra. RA­PA­ZES!"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um dos ho­mens des­ceu as pe­dras cor­ren­do, fa­ca na mão. O Ca­pi­tão não es­pe­rou por ele. Pas­sou a gi­rar a ci­mi­tar­ra em vol­ta do cor­po, em var­ri­das lar­gas e bai­xas, ca­da vez mais rápi­das, co­mo se qui­ses­se cor­tar o ar em fa­ti­as e Noct jun­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct dei­xou o ca­pan­ga che­gar pri­mei­ro. Um co­to­ve­lo, um chu­te na do­bra do jo­e­lho, e o ho­mem ro­lou pe­la en­cos­ta e não su­biu mais. De­pois es­pe­rou a var­ri­da se­guin­te, con­tou o tem­po de­la co­mo ti­nha con­ta­do os gol­pes do Vi­gia, e en­trou no meio do gi­ro, on­de a lâ­mi­na não al­can­ça­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O cru­za­do acer­tou o Ca­pi­tão no quei­xo. O up­per­cut o ti­rou do chão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele caiu de cos­tas na pe­dra, a ci­mi­tar­ra lon­ge, o ca­puz ca­í­do pa­ra trás. Ten­tou le­van­tar uma vez. Não con­se­guiu. O pei­to su­bia e des­cia rápi­do de­mais, e al­gu­ma coi­sa ne­le, lá den­tro, ti­nha que­bra­do na que­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou de pé di­an­te de­le, os pu­nhos fe­cha­dos ao la­do do cor­po. Não ba­teu de no­vo. Não pre­ci­sa­va, e não que­ria des­co­brir o que a bra­sa fa­ria se ele co­me­ças­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ca­pi­tão olhou pa­ra ci­ma. Riu, um ri­so mo­lha­do, sem gra­ça ne­nhu­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— A lis­ta... tá no es­con­de­ri­jo. — Tos­siu. — Ele vai man­dar ou­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A mão de Noct foi até o bol­so de den­tro, on­de a lis­ta do­bra­da em qua­tro fa­zia pe­so jun­to do bi­lhe­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Que man­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ca­pi­tão não res­pon­deu. Fi­cou olhan­do pa­ra o céu cin­zen­to mais um tem­po, e de­pois pa­rou de olhar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os ho­mens que ain­da es­ta­vam no acam­pa­men­to já ti­nham su­mi­do ser­ra abai­xo, sem olhar pa­ra trás."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pe­gou a ci­mi­tar­ra ca­í­da, foi até a es­ta­ca e cor­tou as cor­das do ra­paz. O ga­ro­to caiu de jo­e­lhos, es­fre­gan­do os pul­sos exa­ta­men­te co­mo Tes­sa ti­nha fei­to, e olhou pa­ra ci­ma com a bo­ca aber­ta, pro­cu­ran­do pa­la­vras."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pe­dra­ve­lha — dis­se Noct, an­tes que ele en­con­tras­se al­gu­ma. — Des­ce a tri­lha. Não pa­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ga­ro­to cor­reu. Não agra­de­ceu. Noct fi­cou gra­to por is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No pon­to mais al­to da ser­ra ha­via uma pe­dra."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Gran­de, acha­ta­da, li­sa de um la­do, on­de ge­ra­ções de vi­a­jan­tes ti­nham pa­ra­do pa­ra des­can­sar e, co­mo fa­zem os vi­a­jan­tes, dei­xa­do seus no­mes. Ha­via cen­te­nas de­les, ris­ca­dos uns so­bre os ou­tros, gas­tos pe­lo ven­to até vi­ra­rem uma tex­tu­ra, uma pe­le de pe­dra fei­ta de gen­te que pas­sou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não ia pa­rar. Ti­nha um om­bro ma­chu­ca­do, um cor­te no bra­ço e ne­nhum in­te­res­se em no­mes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­rou mes­mo as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­tre os no­mes gas­tos, mais fun­do, mais re­cen­te, al­guém ti­nha gra­va­do uma fra­se:"/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Se eu me per­der, pro­cu­re on­de o céu ain­da al­can­ça a vi­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele co­nhe­cia aque­la le­tra. O mes­mo jei­to de afun­dar de­mais no co­me­ço de ca­da pa­la­vra, co­mo quem tem me­do de que o ven­to apa­gue. Ela ti­nha su­bi­do até ali. So­zi­nha, de ma­dru­ga­da. E ele nun­ca sou­be."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­via ter es­cri­to aqui­lo anos an­tes de qual­quer Des­gar­ra­do su­bir a ser­ra, quan­do aque­la tri­lha era só uma tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­tão era is­so. A la­ma nas bo­tas. As olhei­ras. O jei­to de es­tar lon­ge sem sair de ca­sa. Ela sa­ía. De ma­dru­ga­da, en­quan­to ele dor­mia, ela sa­ía, e vol­ta­va an­tes que ele acor­das­se. Era pa­ra cá que ela vi­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pa­ra lon­ge de­le. Não por can­sa­ço, co­mo ele ti­nha de­ci­di­do so­zi­nho, olhan­do pa­ra ela do ou­tro la­do da me­sa. Vi­nha pa­ra cá. Su­bia uma ser­ra no es­cu­ro, com frio, so­zi­nha, atrás de um ba­ru­lho que ele ti­nha cha­ma­do de can­sa­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Atrás de quê? O que uma pes­soa pro­cu­ra no pon­to mais al­to de uma ser­ra, de ma­dru­ga­da, com uma fo­lha do­bra­da no bol­so? E por que es­cre­ver "/>
                <ITEXT CPARENT="c_it" CH="se eu me per­der"/>
                <ITEXT CH=", co­mo quem já sa­be que po­de?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ten­tou ima­gi­nar a ce­na e não con­se­guiu. Não sa­bia se ela ti­nha me­do. Não sa­bia quan­tas ve­zes ti­nha su­bi­do até ali en­quan­to ele dor­mia do ou­tro la­do da ser­ra, achan­do que sa­bia tu­do de­la. Ela es­ta­va in­do a al­gum lu­gar, um pou­co mais lon­ge a ca­da ma­dru­ga­da, e ele es­ta­va ocu­pa­do de­mais achan­do que era can­sa­ço pa­ra per­ce­ber que não era em­bo­ra. Era "/>
                <ITEXT CPARENT="c_it" CH="a al­gum lu­gar"/>
                <ITEXT CH="."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele dor­mia. To­das as ve­zes. E de dia, quan­do ela es­ta­va lon­ge den­tro de ca­sa, não per­gun­tou. Nem uma vez."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Se me le­va­rem"/>
                <ITEXT CH=", ela não ti­nha es­cri­to. Ti­nha es­cri­to "/>
                <ITEXT CPARENT="c_it" CH="se eu me per­der"/>
                <ITEXT CH=". Co­mo quem vai so­zi­nha, por von­ta­de pró­pria, até um lu­gar de on­de tal­vez não dê pa­ra vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pei­to aper­tou do jei­to de sem­pre, de den­tro pa­ra fo­ra, sem avi­so. O ven­to con­ti­nuou ba­ten­do. Ele fi­cou pa­ra­do di­an­te da pe­dra, e por um mo­men­to a fal­ta de­la foi tão con­cre­ta que te­ve pe­so, ta­ma­nho, um lu­gar ao la­do de­le na ro­cha, va­zio, exa­ta­men­te do ta­ma­nho de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="On­de vo­cê es­tá?"/>
                <ITEXT CH=", pen­sou. "/>
                <ITEXT CPARENT="c_it" CH="Aon­de vo­cê foi, que nem a pe­dra sa­be?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os de­dos de­le en­con­tra­ram a fi­ta no pul­so. Des­ta vez ele per­ce­beu. Des­ta vez dei­xou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Vi­rou-se, de­va­gar, e olhou pa­ra o va­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá es­ta­va Pe­dra­ve­lha, pe­que­na, dis­tan­te. E o céu, enor­me, des­cen­do até to­car os te­lha­dos. Era exa­ta­men­te o que a fra­se di­zia. O úl­ti­mo lu­gar, su­bin­do a ser­ra, de on­de ain­da se via a vi­la. O pon­to mais al­to an­tes de tu­do fi­car lon­ge de­mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela sem­pre es­co­lhia os lu­ga­res al­tos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Te­lha­dos. Mu­ros. O to­po da es­ca­da da es­ta­ção, de on­de da­va pa­ra ver os tri­lhos su­min­do na ne­bli­na. Ele re­cla­ma­va, di­zia que ela ia cair, e ela res­pon­dia que de ci­ma as coi­sas pa­re­ci­am me­no­res, e que às ve­zes era só dis­so que uma pes­soa pre­ci­sa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê sem­pre es­co­lhia os lu­ga­res al­tos — dis­se Noct, e a voz não ti­nha ne­nhu­ma ar­ma­du­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via nin­guém ali pa­ra ou­vir. Só a pe­dra, o ven­to e o céu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não ti­nha es­cri­to "/>
                <ITEXT CPARENT="c_it" CH="ve­nha atrás de mim"/>
                <ITEXT CH=". Ti­nha es­cri­to "/>
                <ITEXT CPARENT="c_it" CH="on­de o céu ain­da al­can­ça a vi­la"/>
                <ITEXT CH=". On­de ain­da dá pa­ra ver a ca­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Ain­da es­tou pro­cu­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Sen­tou-se na bei­ra da pe­dra, as per­nas pa­ra o va­zio, e dei­xou que a lem­bran­ça vi­es­se, por­que não ti­nha mais for­ça pa­ra em­pur­rá-la pa­ra lon­ge."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CPARENT="c_it" CH="Co­mo vo­cê aguen­ta?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ti­nha per­gun­ta­do is­so a ela uma vez. Não lem­bra­va do con­tex­to. Uma se­ma­na ruim, tal­vez. Um mês ruim. Ela ti­nha per­di­do al­gu­ma coi­sa, ou al­guém, e ele não sa­bia co­mo aju­dar, e quan­do ele não sa­bia co­mo aju­dar fi­ca­va ir­ri­ta­do, e quan­do fi­ca­va ir­ri­ta­do fa­zia per­gun­tas as­sim, que pa­re­ci­am acu­sa­ções."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não se ofen­deu. Nun­ca se ofen­dia com as coi­sas cer­tas."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não aguen­to tu­do. Só ho­je."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="E ama­nhã?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela deu de om­bros. Sor­riu da­que­le jei­to que trans­for­ma­va qual­quer tra­gé­dia num in­con­ve­ni­en­te pas­sa­gei­ro, co­mo chu­va num dia de fei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ama­nhã a gen­te vê. Um dia de ca­da vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na pe­dra, so­zi­nho, Noct re­pe­tiu a fra­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um dia de ca­da vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Saiu do jei­to que sem­pre sa­ía: co­mo uma or­dem. Co­mo uma cor­da pa­ra se se­gu­rar num pe­nhas­co. "/>
                <ITEXT CPARENT="c_it" CH="So­bre­vi­ve até ama­nhã. Só is­so. De­pois a gen­te vê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não sa­bia, ain­da, que uma fra­se po­de mu­dar de sig­ni­fi­ca­do sem mu­dar ne­nhu­ma pa­la­vra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não sa­bia de mui­ta coi­sa, ain­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Do ou­tro la­do da pe­dra, a ser­ra des­cia pa­ra les­te, em di­re­ção a uma pas­sa­gem es­trei­ta que al­guém ti­nha blo­que­a­do com ro­chas e que, se­gun­do o Fo­ras­tei­ro, só abria pe­lo la­do do vi­gia. Mais adi­an­te, pa­ra o nor­te, uns tri­lhos ve­lhos sa­í­am de en­tre as pe­dras e su­mi­am na ne­bli­na, co­ber­tos de ma­to."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct pa­rou di­an­te dos tri­lhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa não dis­se na­da. O ven­to não dis­se na­da. Os tri­lhos es­ta­vam ali, en­fer­ru­ja­dos, qui­e­tos, le­van­do a al­gum lu­gar que a ne­bli­na não dei­xa­va ver."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sa­bia exa­ta­men­te que ti­po de lu­gar era. Sa­bia pe­lo chei­ro. Sa­bia pe­lo jei­to co­mo as per­nas de­le ti­nham pa­ra­do so­zi­nhas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não le­vam a lu­gar ne­nhum que im­por­te — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E foi a men­ti­ra mais fácil que ele con­tou na­que­le dia, por­que não ha­via nin­guém ali pa­ra ver a so­bran­ce­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Vi­rou as cos­tas pa­ra os tri­lhos e pa­ra a pas­sa­gem fe­cha­da, des­ceu de vol­ta pe­lo bos­que e to­mou o ca­mi­nho de les­te, pa­ra o pân­ta­no e pa­ra o ce­mi­té­rio, e pa­ra a coi­sa gran­de e pe­ri­go­sa que o es­pe­ra­va além de­les."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Atrás de­le, na ne­bli­na, os tri­lhos con­ti­nu­a­ram es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Eles ti­nham pa­ciên­cia. Tri­lhos sem­pre têm."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Fim da Par­te II."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="18062.2047244095" OwnPage="51" ItemID="894845305" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="18062.2047244095" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="895411561" BACKITEM="853626569"/>
