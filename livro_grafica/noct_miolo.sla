        <PAGEOBJECT XPOS="621.574803149606" YPOS="51968.6614173229" OwnPage="150" ItemID="1031497449" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="51968.6614173229" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1033578777" BACKITEM="1031460409"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="52660.6299212599" OwnPage="151" ItemID="1033578777" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="52660.6299212599" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1033647849" BACKITEM="1031497449"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="52660.6299212599" OwnPage="152" ItemID="1033647849" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="52660.6299212599" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1034071241" BACKITEM="1033578777"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="53352.5984251969" OwnPage="153" ItemID="1034071241" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="53352.5984251969" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1033647849"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="53457.4803149607" OwnPage="154" ItemID="961929113" PTYPE="4" WIDTH="334.488188976378" HEIGHT="226.771653543307" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" copath="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" gXpos="621.574803149606" gYpos="53457.4803149607" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Parte VI"/>
                <para PARENT="parte_num"/>
                <ITEXT CH="A Fenda"/>
                <para PARENT="parte"/>
                <ITEXT CH="Toda história de porta termina do mesmo jeito: alguém precisa decidir de que lado vai ficar. O que os contos esquecem de dizer é que, às vezes, a porta também tem uma opinião."/>
                <trail PARENT="parte_epi"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="771.811023622047" YPOS="53712.5984251969" OwnPage="154" ItemID="1035798185" PTYPE="2" WIDTH="34.0157480314961" HEIGHT="34.0157480314961" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.0354330708661417" LOCALSCY="0.0354330708661417" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="emblema_cinza.png" IRENDER="0" EMBEDDED="0" path="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" copath="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" gXpos="771.811023622047" gYpos="53712.5984251969" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="54129.6062992127" OwnPage="156" ItemID="1035773433" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="54129.6062992127" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1039792489" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 20"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="En­tão eu sou uma ja­zi­da"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" ra­po­sa o le­vou de vol­ta a Pe­dra­ve­lha."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não de ver­da­de, tal­vez. Tal­vez ela só ti­ves­se ido na mes­ma di­re­ção que ele, e ele ti­ves­se es­co­lhi­do acre­di­tar que es­ta­va sen­do gui­a­do. De qual­quer jei­to, quan­do Noct atra­ves­sou a úl­ti­ma pa­re­de car­me­sim, sain­do das Águas Ve­la­das, e su­biu a tri­lha da ser­ra de vol­ta, a ra­po­sa es­ta­va sem­pre um pou­co à fren­te. Pa­ran­do, olhan­do pa­ra trás, se­guin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Su­miu na bei­ra da vi­la. Exa­ta­men­te on­de, na pri­mei­ra noi­te, ela ti­nha pa­ra­do na bei­ra da luz do lam­pi­ão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não en­trou na pra­ça de uma vez. Fi­cou na úl­ti­ma ca­sa, na som­bra, e olhou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era de ma­nhã ce­do. A pra­ça es­ta­va qua­se va­zia. O mar­te­lo de Brom ain­da não ti­nha co­me­ça­do. E no ban­co per­to do po­ço, sen­ta­da na pon­ta es­quer­da, en­ro­la­da nu­ma man­ta es­cu­ra, ha­via uma fi­gu­ra pe­que­na, de olhos fe­cha­dos, co­chi­lan­do sen­ta­da co­mo quem pas­sou a noi­te acor­da­da es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do na som­bra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou tem­po de­mais. E de­pois, sem de­ci­dir, atra­ves­sou a pra­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela abriu os olhos an­tes de ele che­gar, co­mo quem dor­me com um ou­vi­do acor­da­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê vol­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ain­da não — dis­se ele, com o sar­cas­mo de sem­pre. — Só pas­sei pra ver se vo­cê obe­de­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Obe­de­ci. — Ela pu­xou a man­ta mais pa­ra ci­ma. — Tá mais bai­xo. O cha­ma­do. Des­de on­tem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Bom."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Saiu cal­mo. Mais cal­mo do que ele es­pe­ra­va. Tes­sa fi­cou olhan­do pa­ra ele, a ca­be­ça um pou­co in­cli­na­da, do jei­to que se olha pa­ra uma coi­sa co­nhe­ci­da que mu­dou de lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê tá di­fe­ren­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou de la­do. Pa­ra o po­ço, pa­ra a for­ja ain­da fria, pa­ra qual­quer coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Lem­brei de uma coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Boa ou ruim?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fe­chou os olhos. Chu­va no te­lha­do. Uma voz no es­cu­ro. Uma so­bran­ce­lha que não co­çou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Uma pro­mes­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa não per­gun­tou qual. Fez que sim de­va­gar, co­mo se aqui­lo fos­se res­pos­ta su­fi­ci­en­te, e en­cos­tou a ca­be­ça na ma­dei­ra do ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Des­sa vez vo­cê apa­re­ceu — dis­se, já de olhos fe­cha­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em pou­cos mi­nu­tos es­ta­va co­chi­lan­do de no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou de pé na fren­te do ban­co. O la­do di­rei­to es­ta­va li­vre."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não sen­tou. Não ain­da. Ha­via uma coi­sa que ele pre­ci­sa­va fa­zer an­tes. Ha­via uma por­ta, e ele sa­bia que ti­nha que olhar pa­ra ela de fren­te an­tes de po­der sen­tar num ban­co e dei­xar al­guém fi­car do ou­tro la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sa­bia exa­ta­men­te pa­ra on­de ir. Não pre­ci­sou pro­cu­rar, nem per­gun­tar, nem pen­sar: a bra­sa pu­xa­va, e des­ta vez ele dei­xou. Vi­rou-se pa­ra o la­do oes­te da vi­la, on­de a rua ter­mi­na­va nu­ma en­cos­ta de pe­dra, e na en­cos­ta es­ta­va a bo­ca da mi­na ve­lha, a mes­ma da pri­mei­ra noi­te. Só que ago­ra es­ta­va ta­pa­da por uma pa­re­de de cris­tal ver­me­lho, trans­lúci­do, pul­san­do de­va­gar. Igual à do fun­do do po­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele atra­ves­sou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="As Mi­nas da Fen­da eram mais an­ti­gas do que a vi­la."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ga­le­ri­as es­trei­tas, es­co­ra­das com vi­gas de ma­dei­ra es­cu­ra, des­ci­am na pe­dra em to­das as di­re­ções. Tri­lhos pe­que­nos, de va­go­ne­te, cor­ri­am pe­lo chão. Lam­pa­ri­nas pen­du­ra­das nas vi­gas, to­das apa­ga­das. E nas pa­re­des, por to­da par­te, cris­tais. Ver­me­lhos, de to­dos os ta­ma­nhos, bro­tan­do da pe­dra co­mo co­gu­me­los de­pois da chu­va, emi­tin­do uma luz fra­ca e pul­san­te que era a úni­ca luz que ha­via ali."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pas­sou a mão por um de­les. Es­ta­va quen­te. Ba­tia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão ele viu os mi­nei­ros."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­vam nas ga­le­ri­as, es­pa­lha­dos, imó­veis. Al­guns com a pi­ca­re­ta er­gui­da, no meio de um gol­pe. Al­guns ajo­e­lha­dos di­an­te de um veio. Al­guns en­cos­ta­dos na pa­re­de, co­mo se ti­ves­sem pa­ra­do pa­ra des­can­sar. E to­dos co­ber­tos de cris­tal. Não pre­sos ne­le. "/>
                <ITEXT CPARENT="c_it" CH="Fei­tos"/>
                <ITEXT CH=" de­le, ou qua­se: o cris­tal ti­nha cres­ci­do so­bre a pe­le, so­bre a rou­pa, so­bre os olhos, até que não so­brou mui­to de gen­te por bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do ele pas­sou, al­guns vi­ra­ram a ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­va­gar. Com um ran­gi­do de vi­dro. Os olhos de cris­tal o se­gui­ram pe­lo cor­re­dor, e um de­les, um ho­mem al­to com a pi­ca­re­ta no om­bro, deu um pas­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­tão ou­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Os mi­nei­ros não fo­ram em­bo­ra — dis­se Noct, olhan­do de la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ho­mem de cris­tal er­gueu a pi­ca­re­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Só pa­ra­ram de ca­var."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele não usou a for­ma de ra­po­sa con­tra eles."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não sa­bia ex­pli­car por quê. Tal­vez por­que ain­da não con­fi­as­se ne­la, não com­ple­ta­men­te, não de­pois do san­tuá­rio. Tal­vez por­que aque­les ho­mens ti­nham si­do gen­te um dia, e ele não que­ria que a pri­mei­ra coi­sa que fi­zes­se com o pre­sen­te de­la fos­se que­brar mi­nei­ros. Lu­tou com os pu­nhos, co­mo sem­pre. Os cris­tais es­ta­la­vam e se par­ti­am e, por bai­xo de­les, não ha­via na­da. Só mais cris­tal, e uma né­voa páli­da, can­sa­da, que es­ca­pa­va pe­las ra­cha­du­ras e se des­fa­zia no ar com al­go pa­re­ci­do com alí­vio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No fun­do da mi­na mais fun­da, nu­ma sa­la pe­que­na es­ca­va­da na ro­cha, ele en­con­trou a me­sa do ca­pa­taz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma me­sa sim­ples, um ban­qui­nho, uma lam­pa­ri­na apa­ga­da. E em ci­ma da me­sa, um diá­rio. A ca­pa de cou­ro es­ta­va co­ber­ta de uma ca­ma­da fi­na de pó ver­me­lho. Noct a abriu na úl­ti­ma pági­na es­cri­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="O veio can­ta quan­do al­guém na vi­la cho­ra. Man­dei pa­rar de ca­var. Nin­guém pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele leu du­as ve­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou na vi­la lá em ci­ma. Nas ja­ne­las fe­cha­das, nas som­bras que se afas­ta­vam, no si­lên­cio de lu­gar on­de mui­ta gen­te já ti­nha cho­ra­do e nin­guém mais ti­nha for­ças pa­ra fa­zer ba­ru­lho. Pen­sou no veio ver­me­lho cres­cen­do em­bai­xo da­qui­lo tu­do, ali­men­ta­do por ca­da lágri­ma, can­tan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou na pági­na do Cus­tó­dio. "/>
                <ITEXT CPARENT="c_it" CH="Res­pon­de à au­sên­cia de quem foi ama­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Cres­ce com per­da — dis­se, som­brio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra as pró­prias mãos. Pa­ra a bra­sa que mo­ra­va ne­le des­de a ma­nhã do bi­lhe­te. Que ti­nha cres­ci­do a ca­da noi­te no ban­co, a ca­da vez que os de­dos en­con­tra­vam a fi­ta. Que ti­nha fi­ca­do enor­me no san­tuá­rio, quan­do ele achou que ela ti­nha gri­ta­do o no­me de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O sar­cas­mo veio so­zi­nho, co­mo sem­pre vi­nha quan­do a ver­da­de era gran­de de­mais pa­ra ser di­ta de ou­tro jei­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão eu sou uma ja­zi­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os mi­nei­ros de cris­tal que ain­da es­ta­vam de pé, nas ga­le­ri­as dis­tan­tes, vi­ra­ram a ca­be­ça na di­re­ção da voz de­le. To­dos ao mes­mo tem­po. Com um ran­gi­do de vi­dro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Co­mo se re­co­nhe­ces­sem um co­le­ga."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Is­so era pra me as­sus­tar?"/>
                <ITEXT CH=", ela te­ria di­to. "/>
                <ITEXT CPARENT="c_it" CH="Ten­ta de no­vo ama­nhã."/>
                <ITEXT CH=" Noct qua­se riu. Qua­se."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="54736.5354330709" OwnPage="157" ItemID="1039792489" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="54736.5354330709" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1039307113" BACKITEM="1035773433"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="54736.5354330709" OwnPage="158" ItemID="1039307113" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="54736.5354330709" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1039560313" BACKITEM="1039792489"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="55428.5039370079" OwnPage="159" ItemID="1039560313" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="55428.5039370079" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1039288665" BACKITEM="1039307113"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="55428.5039370079" OwnPage="160" ItemID="1039288665" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="55428.5039370079" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1039560313"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="56205.5118110237" OwnPage="161" ItemID="1039644329" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="56205.5118110237" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1048616457" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 21"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="No mes­mo rit­mo"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="O"/>
                <ITEXT CH=" ca­mi­nho pa­ra o co­ra­ção de tu­do co­me­ça­va no fun­do da mi­na."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Atrás da me­sa do ca­pa­taz, o veio não ter­mi­na­va. Con­ti­nu­a­va, es­trei­to, des­cen­do pe­la ro­cha, ca­da vez mais gros­so, ca­da vez mais ver­me­lho, co­mo uma raiz que sa­be on­de es­tá a água. Os mi­nei­ros ti­nham ca­va­do até ali e pa­ra­do. O res­to do ca­mi­nho nin­guém ti­nha aber­to. Ti­nha se aber­to so­zi­nho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se­guiu o veio. Pa­ra bai­xo. Por bai­xo da vi­la, por bai­xo do po­ço, por bai­xo da pra­ça on­de uma fi­gu­ra co­chi­la­va num ban­co. O pul­so nas pa­re­des foi fi­can­do mais for­te a ca­da pas­so, e a bra­sa no pei­to de­le res­pon­dia, ba­ti­da por ba­ti­da. No fim, o veio se abria nu­ma ra­cha­du­ra es­trei­ta, ver­ti­cal, de bor­das bri­lhan­tes, co­mo um olho que fi­nal­men­te acor­dou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do di­an­te de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pen­sou em vol­tar. Pen­sou nu­ma pra­ça va­zia de ma­nhã ce­do, num ban­co, nu­ma fi­gu­ra co­chi­lan­do sen­ta­da, de olhos fe­cha­dos, que ti­nha di­to "/>
                <ITEXT CPARENT="c_it" CH="des­sa vez vo­cê apa­re­ceu"/>
                <ITEXT CH="."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E foi por is­so que atra­ves­sou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Do ou­tro la­do, ha­via um co­ra­ção."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não de car­ne. De pe­dra, de cris­tal, de luz. Uma ca­ver­na enor­me, de te­to tão al­to que se per­dia no es­cu­ro, e pa­re­des co­ber­tas de vei­os ver­me­lhos que con­ver­gi­am to­dos pa­ra o mes­mo pon­to, co­mo ra­í­zes que pro­cu­ram água. E tu­do, as pa­re­des, o chão, o ar, pul­sa­va. De­va­gar. Fun­do. Uma ba­ti­da, uma pau­sa, ou­tra ba­ti­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou na en­tra­da, sen­tin­do o chão pul­sar sob as bo­tas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ba­te — dis­se, olhan­do de la­do. — Co­mo um co­ra­ção."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão ele pres­tou aten­ção. Con­tou as ba­ti­das. Con­tou as de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Eram as mes­mas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pa­re­ci­das. As mes­mas. Ca­da vez que o co­ra­ção de­le ba­tia, a ca­ver­na ba­tia jun­to. Ca­da vez que ele pren­dia a res­pi­ra­ção, o pul­so das pa­re­des fi­ca­va sus­pen­so, es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to de­le não pul­sou. Era a bra­sa que es­ta­va pul­san­do a ca­ver­na in­tei­ra. Ou a ca­ver­na que pul­sa­va a bra­sa. Ele não sou­be di­zer qual das du­as era o eco."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...No mes­mo rit­mo que o meu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O chão do Co­ra­ção não era con­fi­á­vel."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ra­cha­du­ras fi­nas cor­ta­vam a pe­dra em to­das as di­re­ções, e quan­do ele pi­sa­va per­to de uma, ela acen­dia. De­pois a do la­do. De­pois a se­guin­te. E en­tão ex­plo­di­am, uma atrás da ou­tra, nu­ma se­quên­cia de ja­tos de luz ver­me­lha que su­bi­am do chão co­mo fo­gos de ar­ti­fí­cio de uma fes­ta mui­to er­ra­da. Noct atra­ves­sou o pri­mei­ro tre­cho pu­lan­do de pe­dra em pe­dra, con­tan­do o rit­mo das ex­plo­sões, que era, cla­ro, o rit­mo do co­ra­ção de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele po­dia di­tar o rit­mo, per­ce­beu, no meio do ca­mi­nho. Se res­pi­ras­se mais de­va­gar, as ex­plo­sões de­mo­ra­vam mais. Se fi­cas­se com me­do, elas ace­le­ra­vam."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele res­pi­rou de­va­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No meio da ca­ver­na, dei­ta­do nu­ma de­pres­são do chão, ha­via uma coi­sa dor­min­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­re­cia um cão. Um cão gran­de, ma­gro, sem pe­le, a car­ne ex­pos­ta co­ber­ta de cris­tais car­me­sim que cres­ci­am das cos­tas co­mo es­pi­nhos. Dor­mia en­ro­la­do, a res­pi­ra­ção len­ta, e ca­da vez que res­pi­ra­va os cris­tais bri­lha­vam um pou­co mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pas­sou por ele em si­lên­cio. A coi­sa não acor­dou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não sa­bia, ain­da, que ela só acor­da­va com uma coi­sa. Ia des­co­brir em bre­ve."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No fun­do da ca­ver­na, per­to de on­de os vei­os to­dos con­ver­gi­am, ha­via uma pe­dra li­sa."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="E na pe­dra ha­via le­tras."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não en­ta­lha­das com fer­ra­men­ta. Ris­ca­das. Fun­do, com for­ça, com al­gu­ma coi­sa pon­tu­da e uma mão que não tre­mia. Uma le­tra pe­que­na, in­cli­na­da pa­ra a di­rei­ta, com o "/>
                <ITEXT CPARENT="c_it" CH="a"/>
                <ITEXT CH=" fe­cha­do em ci­ma de um jei­to que pou­ca gen­te fa­zia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma le­tra que ele co­nhe­cia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ti­nha vis­to aque­la le­tra em lis­tas de com­pras gru­da­das na por­ta. Em bi­lhe­tes dei­xa­dos na me­sa. Num bi­lhe­te, es­pe­ci­al­men­te. Do­bra­do uma vez só, por­que ela não ti­nha pa­ciên­cia pa­ra do­brar coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou di­an­te da pe­dra. Não con­se­guia res­pi­rar di­rei­to. A ca­ver­na in­tei­ra sus­pen­deu o pul­so, es­pe­ran­do, jun­to com ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Leu."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="A por­ta cha­ma de noi­te. Se eu res­pon­der com rai­va, ela abre pra to­do mun­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não dis­se na­da. Por mui­to tem­po, não dis­se na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O co­ra­ção de­le ba­teu. A ca­ver­na ba­teu jun­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ti­nha es­ta­do ali. Na­que­le lu­gar, di­an­te da­que­la pe­dra. Ti­nha pe­ga­do o pri­mei­ro trem, atra­ves­sa­do o la­go e des­ci­do até ali, por al­gum ca­mi­nho que ele não co­nhe­cia. So­zi­nha. E ti­nha pa­ra­do ali, e pen­sa­do, e es­cri­to aqui­lo na pe­dra. Não pa­ra nin­guém. Pa­ra ela mes­ma. Pa­ra lem­brar."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Se eu res­pon­der com rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela tam­bém ti­nha rai­va. Ele nun­ca ti­nha pen­sa­do nis­so. Nun­ca ti­nha pen­sa­do que ela, que ria de tu­do, que trans­for­ma­va tra­gé­dias em chu­va de fei­ra, tam­bém ti­nha al­gu­ma coi­sa den­tro de­la que a por­ta po­dia usar. E que ela ti­nha des­ci­do até ali sa­ben­do dis­so. E ti­nha es­co­lhi­do não res­pon­der com rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­nha es­co­lhi­do o quê, en­tão?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pas­sou os de­dos pe­las le­tras. A pe­dra es­ta­va quen­te. As le­tras es­ta­vam fri­as."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê es­te­ve aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Per­to do te­to da ca­ver­na, al­to, pre­so en­tre dois vei­os gros­sos, ha­via um cris­tal mai­or que os ou­tros."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Es­ta­va ra­cha­do. Uma ra­cha­du­ra fi­na, de ci­ma a bai­xo, co­mo a lan­ter­na do Ve­lá­rio. E den­tro de­le, sus­pen­sa no meio da luz ver­me­lha, co­mo uma fo­lha pre­sa no ge­lo, ha­via uma fi­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct a viu do chão. Es­ca­lou até lá, de­va­gar, o car­me­sim ris­can­do a pon­ta dos de­dos e pren­den­do na pe­dra, e fi­cou pen­du­ra­do di­an­te do cris­tal, olhan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era uma fi­ta co­mo a de­le. Do mes­mo te­ci­do. Da mes­ma cor de bra­sa que es­que­ceu de apa­gar. Pa­ra­da no ar, den­tro do cris­tal, sem to­car em na­da, co­mo se ti­ves­se ca­í­do de al­gum lu­gar e o tem­po ti­ves­se pa­ra­do no meio da que­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra o pró­prio pul­so. A de­le es­ta­va lá, com o nó tor­to do la­do es­quer­do, on­de ela ti­nha amar­ra­do nu­ma noi­te de chu­va. Era a ou­tra. Ela ti­nha du­as, e só ti­nha da­do uma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A do ca­be­lo. A da­que­la ma­nhã."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não to­cou no cris­tal."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm — dis­se, som­brio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E des­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A sa­í­da do Co­ra­ção fi­ca­va atrás de uma pa­re­de."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não uma pa­re­de ver­me­lha e trans­lúci­da, das que dei­xa­vam ele pas­sar. Uma pa­re­de de cris­tal gros­so, es­cu­ro, qua­se ne­gro, com vei­os ver­me­lhos por den­tro. Ele en­cos­tou a mão, co­mo fa­zia com as ou­tras. A pa­re­de não ce­deu. Ten­tou os pu­nhos. As fa­gu­lhas es­ta­la­ram con­tra o cris­tal e não dei­xa­ram nem uma mar­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do di­an­te da pa­re­de, res­pi­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sa­bia o que ela que­ria. Sa­bia des­de que ti­nha che­ga­do. A ca­ver­na ba­tia no rit­mo de­le, as ra­cha­du­ras ex­plo­di­am no rit­mo de­le, e aque­la pa­re­de só ia ce­der pa­ra uma coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fe­chou os olhos e pen­sou ne­la. Na ri­sa­da de­la. Na tes­ta en­cos­ta­da nas cos­tas de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A for­ma de ra­po­sa se acen­deu em vol­ta de­le, su­a­ve, ver­me­lha. As cau­das de luz se abri­ram atrás de­le em le­que, e as pon­tas de ener­gia su­bi­ram no al­to da ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no meio da ca­ver­na, na de­pres­são do chão, a coi­sa que dor­mia abriu os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Fa­min­to da Fen­da se le­van­tou. Os cris­tais nas cos­tas de­le se acen­de­ram to­dos ao mes­mo tem­po. Ele fa­re­jou o ar, vi­rou a ca­be­ça sem pe­le na di­re­ção de Noct, e Noct en­ten­deu na ho­ra: a coi­sa não ti­nha acor­da­do com ba­ru­lho, nem com chei­ro de gen­te. Ti­nha acor­da­do com "/>
                <ITEXT CPARENT="c_it" CH="aqui­lo"/>
                <ITEXT CH=". Com a for­ma. Com aqui­lo de que ela era fei­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele es­ta­va fa­min­to "/>
                <ITEXT CPARENT="c_it" CH="dis­so"/>
                <ITEXT CH="."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se vi­rou pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Des­cul­pa — dis­se, e qua­se sor­riu. — Não é pra vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi uma lu­ta cur­ta. A for­ma de ra­po­sa era rápi­da, mais rápi­da do que ele ja­mais ti­nha si­do, e quan­do ele avan­çou con­tra o Fa­min­to, não cor­reu: atra­ves­sou o es­pa­ço num ris­co de luz ver­me­lha, co­mo uma ra­po­sa atra­ves­sa um cam­po. O Fa­min­to caiu. Os cris­tais se apa­ga­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E com o mes­mo im­pul­so, sem pa­rar, Noct se lan­çou con­tra a pa­re­de de cris­tal ne­gro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ex­plo­diu em mil pe­da­ços."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Do ou­tro la­do, ha­via ca­lor. Ca­lor de ver­da­de, de for­na­lha, de in­cên­dio. Um cor­re­dor de pe­dra ver­me­lha des­cen­do, des­cen­do mui­to, de on­de vi­nha um chei­ro de en­xo­fre e um som que não era ne­nhum som que ele co­nhe­cia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou na bei­ra do cor­re­dor, a for­ma de ra­po­sa ain­da ace­sa, as cau­das de luz ba­lan­çan­do atrás de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra trás uma vez. Pa­ra a pe­dra com a le­tra de­la. Pa­ra o cris­tal ra­cha­do lá no al­to, com a fi­ta pa­ra­da den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E des­ceu pa­ra o Aves­so."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="56120.4724409449" OwnPage="162" ItemID="1048616457" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="56120.4724409449" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1049032761" BACKITEM="1039644329"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="56812.4409448819" OwnPage="163" ItemID="1049032761" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="56812.4409448819" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1039359257" BACKITEM="1048616457"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="56812.4409448819" OwnPage="164" ItemID="1039359257" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="56812.4409448819" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1049028649" BACKITEM="1049032761"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="57504.409448819" OwnPage="165" ItemID="1049028649" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="57504.409448819" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1051848553" BACKITEM="1039359257"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="57504.409448819" OwnPage="166" ItemID="1051848553" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="57504.409448819" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1049028649"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="58281.4173228347" OwnPage="167" ItemID="985634377" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="58281.4173228347" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1055950345" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 22"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Me sin­to em ca­sa"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="O"/>
                <ITEXT CH=" Aves­so não ti­nha céu."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ti­nha um te­to, em al­gum lu­gar mui­to aci­ma, de pe­dra ver­me­lha e es­cu­ra, e de­le pen­di­am cor­ren­tes que não pren­di­am na­da. Ti­nha um chão de ro­cha ra­cha­da, por on­de cor­ri­am ri­os len­tos de uma coi­sa que bri­lha­va co­mo la­va e chei­ra­va a me­tal quei­ma­do. E ti­nha ca­lor. Um ca­lor que não vi­nha de lu­gar ne­nhum e de to­dos os lu­ga­res, que en­tra­va pe­la rou­pa, pe­la pe­le, pe­los os­sos, e se ins­ta­la­va lá den­tro co­mo se ti­ves­se si­do con­vi­da­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct saiu do cor­re­dor e pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A for­ma de ra­po­sa ti­nha se apa­ga­do no ca­mi­nho. As cau­das de luz ti­nham se do­bra­do de vol­ta pa­ra den­tro de­le, uma por uma, e as pon­tas de ener­gia no al­to da ca­be­ça ti­nham su­mi­do. Mas a bra­sa no pei­to não ti­nha di­mi­nu­í­do. Des­de o la­go, já não pa­re­cia uma fe­ri­da. Ali, pa­re­cia ou­tra coi­sa: não do­ía, não quei­ma­va, não pe­dia na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va tran­qui­la. Co­mo um bi­cho que fi­nal­men­te che­gou na to­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão é is­so do ou­tro la­do da fen­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou em vol­ta. Os ri­os de la­va. As cor­ren­tes va­zi­as. Os de­mô­nios pe­que­nos que se mo­vi­am ao lon­ge, en­tre as ro­chas, e que pa­ra­vam quan­do o vi­am, e que não o ata­ca­vam lo­go, co­mo se pre­ci­sas­sem de um se­gun­do pa­ra de­ci­dir se ele era pre­sa ou pa­ren­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a pi­or par­te: ele tam­bém pre­ci­sou de um se­gun­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...E eu me sin­to em ca­sa. — Fez uma pau­sa. — Is­so de­via me pre­o­cu­par."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="De­via"/>
                <ITEXT CH=", pen­sou. "/>
                <ITEXT CPARENT="c_it" CH="De­via mui­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pre­o­cu­pou tan­to quan­to de­via. E is­so pre­o­cu­pou mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Atra­ves­sar o Aves­so foi a coi­sa mais fácil e a mais di­fícil que ele já ti­nha fei­to."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Fácil, por­que tu­do ali obe­de­cia à bra­sa. A ener­gia da fen­da en­chia o ar co­mo umi­da­de an­tes da chu­va, e a bra­sa den­tro de­le cres­cia so­zi­nha, sem que ele pre­ci­sas­se apa­nhar nem ba­ter. Ca­da so­co sa­ía com mais fa­gu­lha. Ca­da sal­to ia mais al­to. As pa­re­des ver­me­lhas se abri­am pa­ra ele an­tes mes­mo de ele pen­sar em atra­ves­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Di­fícil, por­que era fácil."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Por­que, no meio de uma lu­ta con­tra três de­mô­nios de chi­fres tor­tos, ele se pe­gou rin­do. Não o ri­so cur­to de sem­pre, o que ele da­va quan­do al­guém di­zia uma coi­sa idi­o­ta. Um ri­so de ver­da­de, aber­to, com os den­tes de fo­ra, en­quan­to o pu­nho de­le atra­ves­sa­va a ca­ra de um de­mô­nio e as fa­gu­lhas ver­me­lhas ex­plo­di­am no ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele pa­rou no meio do gol­pe. O de­mô­nio caiu. Noct fi­cou olhan­do pa­ra a pró­pria mão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os nós dos de­dos san­gra­vam. As fa­gu­lhas ain­da dan­ça­vam ne­les, ale­gres, fa­min­tas."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não"/>
                <ITEXT CH=", pen­sou. "/>
                <ITEXT CPARENT="c_it" CH="Is­so não sou eu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas uma par­te de­le, pe­que­na e ho­nes­ta, per­gun­tou: "/>
                <ITEXT CPARENT="c_it" CH="tem cer­te­za?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele res­pi­rou fun­do. To­cou a fi­ta no pul­so. Aper­tou até sen­tir o nó."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não abre com rai­va. Abre lem­bran­do de mim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E se­guiu em fren­te, mais de­va­gar des­sa vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No fun­do do Aves­so, nu­ma pla­ta­for­ma de pe­dra que flu­tu­a­va so­bre um rio de la­va, ha­via uma luz bran­ca."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct a viu de lon­ge. Não sa­bia o que era. Sa­bia só que era fria, e que era de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Aque­le era o úl­ti­mo lu­gar on­de ele es­pe­ra­va en­con­trar al­gu­ma coi­sa de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sal­tou até a pla­ta­for­ma. A luz bran­ca flu­tu­a­va no ar, cal­ma, in­di­fe­ren­te ao ca­lor, ao en­xo­fre, aos gri­tos ao lon­ge. Era a úni­ca coi­sa fria no Aves­so in­tei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct es­ten­deu a mão e a to­cou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CPARENT="c_it" CH="Ela saiu an­tes de ama­nhe­cer."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ele lem­bra­va dis­so, mas lem­bra­va er­ra­do. Lem­bra­va co­mo uma coi­sa que ti­nha acon­te­ci­do com ele, de olhos aber­tos. E não ti­nha si­do as­sim. Ele es­ta­va dor­min­do. Era es­sa a ver­da­de. Ele es­ta­va dor­min­do quan­do ela saiu, e não ou­viu a por­ta, e não ou­viu os pas­sos, e não ou­viu na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do acor­dou, a ca­sa es­ta­va em si­lên­cio. O la­do de­la da ca­ma es­ta­va frio. E na me­sa da co­zi­nha, em­bai­xo da xí­ca­ra que ela ti­nha usa­do e não ti­nha la­va­do, por­que ela nun­ca la­va­va a xí­ca­ra, ha­via um bi­lhe­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Do­bra­do uma vez só. Por­que ela não ti­nha pa­ciên­cia pa­ra do­brar coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele abriu."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Vol­to lo­go. Não faz na­da idi­o­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era só is­so. Sem as­si­na­tu­ra, por­que não pre­ci­sa­va. Sem ex­pli­ca­ção, por­que ela nun­ca ex­pli­ca­va. Ele leu, e re­vi­rou os olhos, e pen­sou "/>
                <ITEXT CPARENT="c_it" CH="a gen­te con­ver­sa quan­do vo­cê vol­tar"/>
                <ITEXT CH=", e guar­dou o bi­lhe­te no bol­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Do­bra­do em qua­tro. Por­que ele ti­nha pa­ciên­cia pa­ra do­brar coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A luz bran­ca se apa­gou."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct es­ta­va de jo­e­lhos na pla­ta­for­ma, no meio do Aves­so, e a mão de­le es­ta­va no bol­so de den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O bi­lhe­te es­ta­va ali. Sem­pre es­te­ve, des­de aque­la ma­nhã, no mes­mo bol­so, pa­ra não fi­car lon­ge de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­rou o pa­pel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va ve­lho. Ama­re­la­do nas do­bras, gas­to nas pon­tas, a tin­ta um pou­co bor­ra­da num can­to on­de uma vez ti­nha ca­í­do uma go­ta de al­gu­ma coi­sa. Ele nun­ca sou­be de quê. Chu­va, tal­vez. Ele pre­fe­ria acre­di­tar que era chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Des­do­brou. Uma vez. Du­as."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Vol­to lo­go. Não faz na­da idi­o­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele nun­ca ti­nha si­do idi­o­ta o su­fi­ci­en­te pa­ra jo­gar aqui­lo fo­ra. Era a úni­ca re­gra de­la que ele ti­nha cum­pri­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct leu de no­vo. E de no­vo. A le­tra pe­que­na, in­cli­na­da pa­ra a di­rei­ta, com o "/>
                <ITEXT CPARENT="c_it" CH="a"/>
                <ITEXT CH=" fe­cha­do em ci­ma. A mes­ma le­tra da pe­dra no Co­ra­ção da Fen­da."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="A por­ta cha­ma de noi­te."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Vol­to lo­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ti­nha es­cri­to as du­as coi­sas. Uma pa­ra a pe­dra e uma pa­ra ele. E só uma de­las era ver­da­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê dis­se que vol­ta­va lo­go — dis­se ele, bai­xi­nho, pa­ra o pa­pel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Aves­so não res­pon­deu. O ca­lor con­ti­nuou en­tran­do pe­los os­sos. Lá lon­ge, no fim do sa­lão de pe­dra, uma coi­sa enor­me se me­xeu no es­cu­ro, e o chão in­tei­ro tre­meu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct do­brou o bi­lhe­te. Em qua­tro. Guar­dou no bol­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E le­van­tou a ca­be­ça pa­ra o fim do Aves­so, on­de fi­ca­va o tro­no."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não foi até lá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ain­da não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Por­que, de re­pen­te, ele sou­be aon­de pre­ci­sa­va ir an­tes. An­tes do tro­no, an­tes da por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A es­ta­ção."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O úni­co lu­gar on­de ele nun­ca, em to­dos aque­les anos, ti­nha ti­do co­ra­gem de vol­tar."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="58196.377952756" OwnPage="168" ItemID="1055950345" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="58196.377952756" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1055527577" BACKITEM="985634377"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="58888.346456693" OwnPage="169" ItemID="1055527577" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="58888.346456693" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1055976681" BACKITEM="1055950345"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="58888.346456693" OwnPage="170" ItemID="1055976681" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="58888.346456693" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1056048137" BACKITEM="1055527577"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="59580.31496063" OwnPage="171" ItemID="1056048137" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="59580.31496063" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1055976681"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="59665.3543307087" OwnPage="172" ItemID="1057827833" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="59665.3543307087" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1063282809" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 23"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="O trem ain­da atra­sa"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="H"/>
                <ITEXT CH="á lu­ga­res que a gen­te evi­ta por tan­to tem­po que eles co­me­çam a cres­cer no es­cu­ro. Fi­cam mai­o­res do que são. Mais lon­ge do que são. Vi­ram uma por­ta que a gen­te ju­ra que não vai abrir, não por­que es­tá tran­ca­da, mas por­que sa­be exa­ta­men­te o que tem do ou­tro la­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Pa­ra Noct, es­se lu­gar era uma es­ta­ção de trem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele vol­tou pe­lo ca­mi­nho mais lon­go."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Saiu do Aves­so pe­lo mes­mo ca­mi­nho por on­de ti­nha en­tra­do: o Co­ra­ção, o veio, as ga­le­ri­as da mi­na. Saiu na en­cos­ta oes­te de Pe­dra­ve­lha. Cru­zou a vi­la sem pa­rar na pra­ça. Não olhou pa­ra o ban­co. Sa­bia que se olhas­se, ia sen­tar. E se sen­tas­se, não ia mais le­van­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Su­biu a ser­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na cur­va mais al­ta da tri­lha, on­de a ne­bli­na sem­pre fi­ca­va pre­sa en­tre as pe­dras, ha­via uma pas­sa­gem que ele vi­nha evi­tan­do ha­via anos. Uma tri­lha es­trei­ta, de cas­ca­lho e ma­to, que des­cia pa­ra o ou­tro la­do da mon­ta­nha. Ele co­nhe­cia aque­la tri­lha. Ti­nha an­da­do por ela cen­te­nas de ve­zes, nu­ma ou­tra vi­da, com al­guém re­cla­man­do do frio ao la­do de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Des­de que ti­nha che­ga­do a Pe­dra­ve­lha, sem­pre que pas­sa­va por ali, ele se­guia re­to, de olhos na tri­lha de ci­ma, co­mo se ela não exis­tis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ago­ra pa­rou na en­tra­da. Olhou pa­ra o chão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ma­to ti­nha fe­cha­do as bor­das. Nin­guém des­cia por ali ha­via mui­to tem­po. Mas o ca­mi­nho ain­da es­ta­va lá, do jei­to que ele lem­bra­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sa­bia aon­de aque­la tri­lha da­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se­guiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A es­ta­ção não ti­nha mu­da­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Is­so foi o pi­or. Ele ti­nha es­pe­ra­do ru­í­na, ma­to, ra­cha­du­ras ver­me­lhas, de­mô­nios. Al­gu­ma coi­sa que tor­nas­se o lu­gar di­fe­ren­te, ou­tro lu­gar, um lu­gar on­de aqui­lo não ti­nha acon­te­ci­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas era a mes­ma es­ta­ção. A mes­ma pla­ta­for­ma de tá­bu­as gas­tas. Os mes­mos dois pos­tes de luz, um em ca­da pon­ta, que acen­di­am so­zi­nhos quan­do es­cu­re­cia e pis­ca­vam co­mo se es­ti­ves­sem can­sa­dos. As mes­mas cai­xas em­pi­lha­das per­to do fim, o mes­mo bar­ril que nin­guém nun­ca le­vou em­bo­ra. E a chu­va. Uma chu­va fi­na, sem pres­sa, que ca­ía so­bre os tri­lhos e fa­zia o fer­ro bri­lhar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ne­nhum de­mô­nio. Ne­nhum ini­mi­go. Ne­nhum som além da chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fen­da não ti­nha che­ga­do ali. Ou ti­nha, e não ti­nha acha­do na­da pa­ra usar. Por­que ali não ha­via rai­va. Só es­pe­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct su­biu na pla­ta­for­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Es­ta­ção — dis­se, pa­ra nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pa­la­vra não saiu in­tei­ra. O pei­to fe­chou no meio de­la, co­mo uma por­ta ba­ten­do com o ven­to. O ar en­tra­va ra­so e não che­ga­va a lu­gar ne­nhum. As tá­bu­as da pla­ta­for­ma pa­re­ce­ram se in­cli­nar pa­ra o la­do dos tri­lhos. Os de­dos for­mi­ga­vam den­tro das lu­vas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele co­nhe­cia aqui­lo. Ti­nha co­nhe­ci­do aqui­lo em quar­tos alu­ga­dos, em bei­ras de es­tra­da, no meio de fei­ras chei­as de gen­te, sem mo­ti­vo e sem avi­so, por anos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pu­xou o ar de­va­gar. Qua­tro. Se­gu­rou. Sol­tou mais de­va­gar do que ti­nha pu­xa­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na ter­cei­ra vez, a pla­ta­for­ma vol­tou pa­ra o lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra os tri­lhos, que su­mi­am na ne­bli­na dos dois la­dos. Va­zi­os. Sem luz ne­nhu­ma vin­do de lon­ge."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...O trem ain­da atra­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No meio da pla­ta­for­ma ha­via um qua­dro de ho­rá­rios."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ma­dei­ra es­cu­ra, pre­ga­da num pos­te, com as ho­ras es­cri­tas em giz nu­ma le­tra de fun­ci­o­ná­rio can­sa­do. Ele lem­bra­va da­que­le qua­dro. Mi­ra lia os ho­rá­rios em voz al­ta, to­das as ve­zes, mes­mo sa­ben­do que ne­nhum trem ja­mais ti­nha che­ga­do na ho­ra. Lia co­mo quem lê uma pro­fe­cia em que não acre­di­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ago­ra os ho­rá­rios es­ta­vam ris­ca­dos. To­dos. Um por um, com tra­ços de giz gros­so, co­mo se al­guém ti­ves­se de­ci­di­do que aque­las ho­ras não exis­ti­am mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="To­dos, me­nos um."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pri­mei­ro trem da ma­nhã."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou olhan­do pa­ra aque­la li­nha. A úni­ca que ti­nha so­bra­do. A ho­ra do trem que pas­sa­va quan­do ain­da era es­cu­ro, quan­do to­do mun­do ain­da dor­mia. Qua­se to­do mun­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pon­tu­al co­mo sem­pre — dis­se, com a voz mais se­ca que con­se­guiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não fun­ci­o­nou. Nin­guém es­ta­va ou­vin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele an­dou até o fim da pla­ta­for­ma."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="De­va­gar. Con­tan­do as tá­bu­as, co­mo ela con­ta­va as ra­po­sas na bei­ra dos tri­lhos. Uma. Du­as. Dez. Vin­te. Não ha­via ra­po­sa ne­nhu­ma ali ago­ra. Só a chu­va, e a ne­bli­na, e o ba­ru­lho dos pró­prios pas­sos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na pon­ta, on­de a pla­ta­for­ma aca­ba­va e co­me­ça­va a la­ma, ele pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E olhou pa­ra bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As pe­ga­das es­ta­vam ali. Não po­di­am es­tar. Fa­zia anos, e ti­nha cho­vi­do mil ve­zes na­que­la la­ma. Mas es­ta­vam. Pe­que­nas, de bo­ta, com o cal­ca­nhar um pou­co mais fun­do do la­do es­quer­do, por­que ela sem­pre pi­sa­va tor­to quan­do an­da­va rápi­do. Iam da pla­ta­for­ma até a bei­ra dos tri­lhos. Pa­ra­vam ali, bem na bei­ra, co­mo se ela ti­ves­se fi­ca­do um tem­po em pé, es­pe­ran­do al­gu­ma coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de­pois..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois, na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ne­nhu­ma pe­ga­da vol­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou olhan­do pa­ra aque­le lu­gar por mui­to tem­po. A chu­va cain­do nas pe­ga­das, en­chen­do ca­da uma de água, co­mo pe­que­nos la­gos pa­ra­dos. Ele pen­sou no La­go Ve­la­do. Na lan­ter­na. No car­ce­rei­ro que ti­nha guar­da­do o úl­ti­mo ins­tan­te de­la e não ti­nha que­ri­do de­vol­ver."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sa­bia, ago­ra, o que ti­nha acon­te­ci­do. A es­ta­ção. O pri­mei­ro trem. O la­go. A pe­dra. A por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas sa­ber não era a mes­ma coi­sa que ver."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ver as pe­ga­das de­la in­do só pa­ra um la­do, nu­ma la­ma que ele po­dia to­car, nu­ma es­ta­ção on­de eles ti­nham sen­ta­do jun­tos tan­tas ve­zes que ele ti­nha per­di­do a con­ta, era co­mo le­var um so­co que ele mes­mo ti­nha da­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê dis­se que vol­ta­va lo­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A chu­va con­ti­nuou cain­do. Os tri­lhos con­ti­nu­a­ram va­zi­os. Ne­nhum trem apa­re­ceu na ne­bli­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O bi­lhe­te pe­sa­va no bol­so co­mo uma pe­dra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ali per­to, em­bai­xo do pos­te da­que­la pon­ta, ha­via um ban­co."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Um ban­co de fer­ro es­cu­ro e tá­bu­as gas­tas, com dois lu­ga­res e uma pe­dri­nha ver­me­lha no al­to do en­cos­to. Igual ao de Pe­dra­ve­lha. Igual a to­dos os ban­cos de to­das as es­ta­ções do mun­do. Ele ti­nha pas­sa­do por ele ao che­gar e não ti­nha olha­do. Ago­ra olhou."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela sem­pre sen­ta­va à es­quer­da. Ele, à di­rei­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Nun­ca com­bi­na­ram. Só fi­cou as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em to­dos os ou­tros ban­cos, nos anos de­pois, ele ti­nha sen­ta­do sem­pre na pon­ta da di­rei­ta, sem pen­sar por quê, e dei­xa­do a ou­tra va­zia. Nun­ca ti­nha li­ga­do uma coi­sa à ou­tra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct an­dou até o ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­tou à di­rei­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O la­do es­quer­do fi­cou va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A chu­va ba­tia no te­lha­do da pla­ta­for­ma. O pos­te em ci­ma de­le pis­cou uma vez e se fir­mou. E ele lem­brou de uma coi­sa que não lem­bra­va fa­zia mui­to tem­po: de co­mo, quan­do o trem atra­sa­va, ela en­cos­ta­va a ca­be­ça no om­bro de­le. E di­zia que era por cau­sa do frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E al­gu­ma coi­sa, den­tro de­le, co­me­çou a ce­der."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não de uma vez. De­va­gar, co­mo ge­lo de bei­ra de rio no fim do in­ver­no. Pri­mei­ro os om­bros, que ele car­re­ga­va er­gui­dos fa­zia tan­to tem­po que ti­nha es­que­ci­do que eram de­le. De­pois as mãos, que se abri­ram so­zi­nhas em ci­ma dos jo­e­lhos, os nós dos de­dos ain­da es­fo­la­dos, sem na­da pa­ra se­gu­rar. De­pois o pei­to. A bra­sa ali den­tro não se apa­gou. Só pa­rou de quei­mar e co­me­çou a aque­cer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O cor­po, que vi­nha do­en­do des­de o Aves­so, aqui­e­tou. Não sa­rou. Aqui­e­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão, ali, so­zi­nho no la­do di­rei­to de um ban­co de es­ta­ção, Noct sen­tiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um pe­so no om­bro es­quer­do. Le­ve. De uma ca­be­ça en­cos­ta­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não es­ta­va lá, ele sa­bia. Não ti­nha nin­guém. Ele não vi­rou o ros­to pa­ra con­fe­rir, por­que sa­bia o que ia ver, e não que­ria ver."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não es­ta­va frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nun­ca ti­nha es­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi ali que ele cho­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não do jei­to dos ou­tros di­as, quan­do o cho­ro vi­nha pre­so na gar­gan­ta e sa­ía co­mo rai­va. Cho­rou sem ba­ru­lho, de olhos fe­cha­dos, com a chu­va no te­lha­do da pla­ta­for­ma fa­zen­do o ba­ru­lho por ele. Cho­rou os anos. As es­ta­ções de ou­tras ci­da­des on­de ti­nha pro­cu­ra­do por ela, to­das me­nos aque­la. Os ban­cos on­de ti­nha dei­xa­do a ou­tra pon­ta va­zia sem sa­ber por quê. A ma­nhã em que ti­nha dor­mi­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu es­ta­va dor­min­do — dis­se, bai­xi­nho, pa­ra o la­do es­quer­do do ban­co. — Eu não ou­vi vo­cê sair."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A chu­va con­ti­nuou cain­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E aqui­lo, di­to em voz al­ta, não so­ou co­mo con­fis­são. So­ou só co­mo ver­da­de. Uma coi­sa que ti­nha acon­te­ci­do, e que ele po­dia, en­fim, dei­xar ter acon­te­ci­do. Ele ti­nha dor­mi­do. Ela ti­nha ido. Não era a mes­ma coi­sa que ele ter dei­xa­do ela ir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­ta­do ali, no la­do di­rei­to de um ban­co mo­lha­do, Noct se per­do­ou um pou­co. Só um pou­co. O su­fi­ci­en­te pa­ra res­pi­rar in­tei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou sen­ta­do. A chu­va caiu. O trem não veio. E pe­la pri­mei­ra vez des­de a ma­nhã do bi­lhe­te, ele não ten­tou fa­zer o tem­po pas­sar mais rápi­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do fi­nal­men­te se le­van­tou, foi por­que de­ci­diu, e não por­que não aguen­ta­va mais fi­car."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra o la­do es­quer­do do ban­co. Va­zio. Mo­lha­do de chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um dia de ca­da vez — dis­se, de olhos fe­cha­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E vol­tou pa­ra a tri­lha da ser­ra. Pa­ra Pe­dra­ve­lha. Pa­ra a fen­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­ra o tro­no."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="60272.283464567" OwnPage="173" ItemID="1063282809" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="60272.283464567" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1063094921" BACKITEM="1057827833"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="60272.283464567" OwnPage="174" ItemID="1063094921" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="60272.283464567" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1063471769" BACKITEM="1063282809"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="60964.251968504" OwnPage="175" ItemID="1063471769" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="60964.251968504" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1063262873" BACKITEM="1063094921"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="60964.251968504" OwnPage="176" ItemID="1063262873" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="60964.251968504" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1066208937" BACKITEM="1063471769"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="61656.220472441" OwnPage="177" ItemID="1066208937" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="61656.220472441" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1063262873"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="61741.2598425198" OwnPage="178" ItemID="1067206425" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="61741.2598425198" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1071377961" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 24"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="O Tro­no"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="O"/>
                <ITEXT CH=" tro­no do Aves­so não era uma ca­dei­ra."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct ti­nha ima­gi­na­do uma ca­dei­ra. Uma coi­sa al­ta, de os­sos ou de fer­ro, com al­guém sen­ta­do ne­la de per­nas cru­za­das, co­mo nas his­tó­rias que a avó de al­guém con­ta­va pa­ra as­sus­tar cri­an­ças. Mas o sa­lão no fim do Aves­so era só um sa­lão. Enor­me, re­don­do, de pa­re­des ver­me­lhas e te­to per­di­do no es­cu­ro. Du­as pla­ta­for­mas de pe­dra flu­tu­a­vam per­to das pa­re­des, uma de ca­da la­do. E no cen­tro, on­de o chão afun­da­va nu­ma ba­cia ra­sa de pe­dra der­re­ti­da, ha­via uma coi­sa dor­min­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não, não dor­min­do. Es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era gran­de. Mai­or que o Ga­to, mai­or que o Cei­fa­dor, mai­or que qual­quer coi­sa vi­va que ele já ti­nha vis­to. Uma mas­sa de car­ne es­cu­ra e bri­lhan­te, meio líqui­da, meio sóli­da, que es­cor­ria e se re­fa­zia o tem­po to­do, co­mo ce­ra de ve­la no meio do fo­go. Ti­nha chi­fres. Ti­nha bra­ços, ou coi­sas que fa­zi­am pa­pel de bra­ços, e num de­les se­gu­ra­va uma lâ­mi­na do ta­ma­nho de um por­tão. E ti­nha olhos. Mui­tos, ou só dois que se me­xi­am rápi­do de­mais. Aber­tos. Olhan­do pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Atrás de Noct, a en­tra­da do sa­lão se fe­chou com um es­tron­do de pe­dra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não se vi­rou pa­ra olhar. Já sa­bia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Por­tei­ro se er­gueu."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="De­va­gar, sem pres­sa ne­nhu­ma, co­mo se ti­ves­se to­do o tem­po do mun­do. E tal­vez ti­ves­se. A mas­sa de car­ne es­cu­ra su­biu, e su­biu, até os chi­fres qua­se to­ca­rem o te­to, e a voz de­le, quan­do veio, não veio da bo­ca. Veio do chão. Das pa­re­des. Do pei­to de Noct, on­de a bra­sa de re­pen­te se en­co­lheu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê car­re­ga a au­sên­cia de­la co­mo uma lâ­mi­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu lo­go. Olhou pa­ra os pró­prios pu­nhos. Não ti­nha lâ­mi­na ne­nhu­ma. Nun­ca te­ve. Ti­nha lu­vas gas­tas, re­for­ça­das por um fer­rei­ro que não fa­zia per­gun­tas, e um car­me­sim que acen­dia nos de­dos quan­do pre­ci­sa­va, e nós dos de­dos que san­gra­vam fácil."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas en­ten­deu o que a coi­sa que­ria di­zer. En­ten­deu bem de­mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As fa­gu­lhas car­me­sim se acen­de­ram nos pu­nhos de­le, so­zi­nhas. Os olhos de­le ar­de­ram ver­me­lhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Foi vo­cê que abriu a fen­da?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="A coi­sa riu. Não com som. Com o chão, que tre­meu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Foi a sua dor que des­tran­cou a por­ta. Eu só en­trei."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct sen­tiu aqui­lo en­trar ne­le co­mo uma fa­ca fria. "/>
                <ITEXT CPARENT="c_it" CH="A sua dor."/>
                <ITEXT CH=" Não a de Pe­dra­ve­lha. Não a do mun­do. A "/>
                <ITEXT CPARENT="c_it" CH="de­le"/>
                <ITEXT CH=". A ma­nhã do bi­lhe­te, a me­sa va­zia, o gri­to que ele ti­nha en­go­li­do. Ele ti­nha des­tran­ca­do aqui­lo. Ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas de­pois pen­sou nu­ma pe­dra no Co­ra­ção da Fen­da. "/>
                <ITEXT CPARENT="c_it" CH="Se eu res­pon­der com rai­va, ela abre pra to­do mun­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E pen­sou: "/>
                <ITEXT CPARENT="c_it" CH="en­tão eu não vou res­pon­der com rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não fun­ci­o­nou to­tal­men­te. Ele ain­da es­ta­va com rai­va. Mas a rai­va fi­cou qui­e­ta, um pou­co, den­tro do pei­to, e o que su­biu no lu­gar de­la foi ou­tra coi­sa. Mais fria. Mais tei­mo­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sor­riu. Tor­to. Do jei­to que ela odi­a­va e ado­ra­va ao mes­mo tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão eu fe­cho com vo­cê den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A coi­sa in­cli­nou a ca­be­ça. Os olhos to­dos se vi­ra­ram ao mes­mo tem­po, co­mo se olhas­sem atra­vés de­le, pa­ra lon­ge, pa­ra ci­ma, pa­ra uma vi­la no al­to da ser­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela tam­bém ou­ve a por­ta — dis­se. — A da man­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O sor­ri­so de Noct su­miu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um dia ela vem. Igual à ou­tra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As fa­gu­lhas nos pu­nhos de­le fi­ca­ram bran­cas de tão quen­tes. A bra­sa no pei­to su­biu até a gar­gan­ta, e por um se­gun­do in­tei­ro ele foi só rai­va, do jei­to que a fen­da gos­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela não vem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão pen­sou nu­ma mar­gem de la­go, num re­fle­xo sem atra­so, num sor­ri­so de can­to. A rai­va não foi em­bo­ra. Mas as­sen­tou, co­mo po­ei­ra de­pois de uma por­ta ba­ti­da, e o que fi­cou em­bai­xo de­la era fir­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu dis­se pra ela es­pe­rar. — A voz saiu bai­xa. — E des­sa vez al­guém ou­viu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A lu­ta foi lon­ga."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A lâ­mi­na do Por­tei­ro des­cia co­mo um por­tão cain­do, e ca­da gol­pe abria ra­cha­du­ras no chão que bri­lha­vam por se­gun­dos de­pois. Quan­do Noct se afas­ta­va, a coi­sa an­da­va atrás de­le, sem pres­sa, a mas­sa es­cu­ra es­cor­ren­do e se re­fa­zen­do a ca­da pas­so. E quan­do ele fi­ca­va lon­ge de­mais, ela se aga­cha­va, e sal­ta­va, e o sa­lão in­tei­ro su­mia na som­bra de­la an­tes de ela cair no chão com um pe­so que fa­zia os den­tes de­le ba­te­rem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E às ve­zes ela só le­van­ta­va o bra­ço, e do te­to ca­ía fo­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Chu­va de fo­go. Go­tas gros­sas e ver­me­lhas, que ca­í­am em li­nhas, que quei­ma­vam on­de to­ca­vam."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct riu sem que­rer, no meio da­qui­lo. Pen­sou nu­ma fei­ra em Pe­dra­ve­lha, nu­ma bar­ra­ca de pas­tel, nu­ma voz ao la­do de­le di­zen­do "/>
                <ITEXT CPARENT="c_it" CH="com chu­va, é só mais um dia de fei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pu­lou en­tre as go­tas. Su­biu nu­ma das pla­ta­for­mas. Des­ceu de ci­ma com o cal­ca­nhar na ca­be­ça da coi­sa, e as fa­gu­lhas ex­plo­di­ram, e a mas­sa es­cu­ra se en­co­lheu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No meio da lu­ta, ele per­ce­beu uma coi­sa: o Por­tei­ro ti­nha ra­zão so­bre uma par­te. "/>
                <ITEXT CPARENT="c_it" CH="A dor de­le era com­bus­tí­vel."/>
                <ITEXT CH=" Ca­da gol­pe que ele le­va­va fa­zia a bra­sa cres­cer no pei­to. Ca­da gol­pe que ele da­va tam­bém. A fen­da gos­ta­va da­qui­lo. Co­mia da­qui­lo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E quan­do a bra­sa che­gou à gar­gan­ta, ele não a sol­tou com rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fe­chou os olhos. Pen­sou nu­ma tes­ta en­cos­ta­da nas cos­tas de­le. Nu­ma ri­sa­da bai­xa, no es­cu­ro. Num bi­lhe­te do­bra­do uma vez só."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A for­ma de ra­po­sa se acen­deu em vol­ta de­le, su­a­ve e ver­me­lha, as cau­das de luz aber­tas em le­que, as pon­tas de luz su­bin­do no al­to da ca­be­ça. E o Por­tei­ro re­cuou um pas­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Por­que aqui­lo, aque­la for­ma, não era fei­ta da dor de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era fei­ta do que ti­nha so­bra­do do se­lo de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ain­da não sa­bia dis­so. Ia sa­ber em ins­tan­tes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O úl­ti­mo gol­pe não foi bo­ni­to."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Foi um cru­za­do, sim­ples, de pu­nho fe­cha­do, com o pe­so in­tei­ro do cor­po atrás. O mes­mo gol­pe que ele ti­nha da­do mil ve­zes em mil ban­di­dos. Só que des­sa vez as fa­gu­lhas não fo­ram ver­me­lhas de rai­va. Fo­ram ver­me­lhas de bra­sa. Da cor de uma fi­ta amar­ra­da num pul­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pu­nho en­trou na mas­sa es­cu­ra. E a mas­sa es­cu­ra pa­rou de se re­fa­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Por­tei­ro fi­cou pa­ra­do no cen­tro da ba­cia de pe­dra der­re­ti­da, olhan­do pa­ra ele. De­pois co­me­çou a es­cor­rer. Pri­mei­ro os chi­fres. De­pois os bra­ços. De­pois a lâ­mi­na, que caiu no chão com um ba­ru­lho de si­no ra­cha­do e se des­fez em fu­ma­ça. A coi­sa to­da foi des­cen­do, des­cen­do, até vi­rar só uma po­ça es­cu­ra no chão do sa­lão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a po­ça se­cou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Aves­so es­tre­me­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não co­mo an­tes, não de ame­a­ça. De ou­tro jei­to. Co­mo uma ca­sa enor­me que per­deu uma vi­ga e ain­da não de­ci­diu se vai cair. As cor­ren­tes ba­lan­ça­ram no te­to. Os ri­os de la­va fi­ca­ram mais len­tos. Os gri­tos ao lon­ge pa­ra­ram. Atrás de­le, a pe­dra que ti­nha fe­cha­do a en­tra­da ra­chou de ci­ma a bai­xo e caiu, e o cor­re­dor por on­de ele ti­nha des­ci­do apa­re­ceu de no­vo, es­cu­ro e com­pri­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou de pé no meio do sa­lão, ofe­gan­te, a for­ma de ra­po­sa se apa­gan­do de­va­gar em vol­ta de­le, as cau­das de luz se do­bran­do de vol­ta pa­ra den­tro. Os pu­nhos san­gra­vam. O cor­po in­tei­ro do­ía."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no cen­tro do sa­lão, on­de an­tes es­ta­va a coi­sa, a por­ta con­ti­nu­a­va aber­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não ti­nha vis­to an­tes. O Por­tei­ro es­ta­va em ci­ma de­la, co­brin­do, co­mo uma tam­pa. Era is­so que ele guar­da­va, o tem­po to­do. Mas ago­ra ela es­ta­va ali, à vis­ta: uma ra­cha­du­ra ver­ti­cal no pró­prio ar, da al­tu­ra de uma por­ta, de bor­das ver­me­lhas e bri­lhan­tes. A mes­ma da bei­ra da vi­la. A mes­ma do fun­do da mi­na. A ori­gi­nal. Res­pi­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra ela, can­sa­do de­mais pa­ra ter me­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Aca­bou?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="A por­ta res­pon­deu."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="62348.188976378" OwnPage="179" ItemID="1071377961" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="62348.188976378" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1071438873" BACKITEM="1067206425"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="62348.188976378" OwnPage="180" ItemID="1071438873" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="62348.188976378" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1071009145" BACKITEM="1071377961"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="63040.157480315" OwnPage="181" ItemID="1071009145" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="63040.157480315" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1071476729" BACKITEM="1071438873"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="63040.157480315" OwnPage="182" ItemID="1071476729" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="63040.157480315" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1071009145"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="63817.1653543308" OwnPage="183" ItemID="1074329097" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="63817.1653543308" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1081029353" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 25"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="A voz da por­ta"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" voz da por­ta não era co­mo a do Por­tei­ro."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não vi­nha do chão nem das pa­re­des. Não fa­zia na­da tre­mer. Era uma voz bai­xa, qua­se gen­til, que pa­re­cia vir de mui­to per­to, de den­tro do ou­vi­do, co­mo al­guém que se in­cli­na pa­ra con­tar um se­gre­do no meio de uma fes­ta ba­ru­lhen­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a pri­mei­ra coi­sa que ela dis­se foi:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela me ou­viu pri­mei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não se me­xeu. Não con­se­guiu. Fi­cou pa­ra­do di­an­te da ra­cha­du­ra no ar, os pu­nhos ain­da san­gran­do, a bo­ca aber­ta sem na­da pa­ra sair de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Mi­ra ou­via o cha­ma­do an­tes de vo­cê — con­ti­nuou a voz, sem pres­sa. — Veio so­zi­nha até es­ta por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="So­zi­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele pen­sou nas pe­ga­das na la­ma da es­ta­ção. In­do, só in­do. Pen­sou na pe­dra no Co­ra­ção da Fen­da. "/>
                <ITEXT CPARENT="c_it" CH="A por­ta cha­ma de noi­te."/>
                <ITEXT CH=" Pen­sou em to­das as noi­tes em que ela fi­cou acor­da­da en­quan­to ele dor­mia. Em to­das as ve­zes que ela olhou pe­la ja­ne­la e ele achou que fos­se só can­sa­ço. Em to­das as ma­dru­ga­das em que o la­do es­quer­do da ca­ma es­fri­ou e ele nem acor­dou. Em to­dos os di­as em que a achou dis­tan­te e es­pe­rou que ela con­tas­se, na ho­ra de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela es­ta­va ou­vin­do. E pro­cu­ran­do. To­do aque­le tem­po. Uma por­ta cha­man­do por ela, de noi­te, e ela não ti­nha di­to na­da. Pa­ra não as­sus­tá-lo. Pa­ra não fa­zer de­le um idi­o­ta que ia atrás."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Es­ta por­ta."/>
                <ITEXT CH=" E de re­pen­te ele en­ten­deu que era uma só. A ra­cha­du­ra na bei­ra da vi­la, res­pi­ran­do nas noi­tes de chu­va. A fen­da que des­cia sob o al­tar da ca­te­dral. O Co­ra­ção que ba­tia no rit­mo de­le. Não eram vá­rias por­tas. Eram fen­das da mes­ma, va­zan­do em lu­ga­res di­fe­ren­tes, co­mo a mes­ma dor apa­re­ce em lu­ga­res di­fe­ren­tes do cor­po. E a por­ta era aque­la, ali na fren­te de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E a fe­chou — dis­se a por­ta. — Com o pró­prio no­me. Com o pró­prio cor­po."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="O se­lo pe­de um no­me em tro­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pági­na mo­lha­da ain­da es­ta­va no bol­so de­le, do­bra­da em qua­tro, jun­to do bi­lhe­te. Ele ti­nha li­do aque­la fra­se cem ve­zes sem en­ten­der. En­ten­dia ago­ra. O Cus­tó­dio ti­nha pas­sa­do anos dan­do no­mes à por­ta. No­mes de gen­te que nin­guém pro­cu­ra­va, ar­ras­ta­da até o cír­cu­lo amar­ra­da nu­ma car­ro­ça. E a por­ta en­go­lia to­dos e con­ti­nu­a­va com fo­me, por­que um no­me que nin­guém cha­ma não pe­sa na­da. Pen­sou no man­to va­zio na ca­te­dral, e no ras­tro de san­gue que aca­ba­va na bei­ra da ra­cha­du­ra. O úl­ti­mo no­me que o Cus­tó­dio ti­nha da­do à por­ta era o de­le. Não se­gu­rou na­da. Nin­guém sen­tiu fal­ta. E um no­me da­do à por­ta vai se apa­gan­do das coi­sas. Das mar­cas, das lápi­des, das pa­re­des. Por is­so os no­mes ras­pa­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ti­nha da­do o de­la. Por von­ta­de pró­pria. Um no­me que al­guém ia cha­mar to­dos os di­as, de ma­nhã, no es­cu­ro, em to­dos os ban­cos do ca­mi­nho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a por­ta fi­cou cheia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct bai­xou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­ra o chão. Pa­ra as mãos. Pa­ra a fi­ta car­me­sim no pul­so, que ain­da era de­la, co­mo o bi­lhe­te no bol­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela dei­xou um bi­lhe­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era uma res­pos­ta. Era só a úni­ca coi­sa que ele sa­bia di­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A por­ta es­pe­rou um pou­co. Co­mo quem dei­xa uma pes­soa res­pi­rar an­tes da próxi­ma no­tí­cia ruim."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="— A por­ta co­me­çou a se abrir quan­do vo­cê ten­tou es­que­cê-la. A sua dor tem o for­ma­to da cha­ve."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão tu­do en­cai­xou. A ma­nhã do bi­lhe­te. A me­sa va­zia. O gri­to que ele ti­nha en­go­li­do e que ti­nha des­ci­do até o fun­do do pei­to e acen­di­do uma bra­sa ali. Os de­mô­nios sain­do pe­la ra­cha­du­ra, uma ra­cha­du­ra que le­vou anos pa­ra abrir. O mun­do in­tei­ro ra­chan­do em ver­me­lho a par­tir de Pe­dra­ve­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não ti­nha aber­to a por­ta. Ela ti­nha fe­cha­do, e ele, sem que­rer, sem sa­ber, só de ten­tar não sen­tir fal­ta de­la, ti­nha des­tran­ca­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Cla­ro que ti­nha. O se­lo era fei­to da fal­ta de­la, e nin­guém no mun­do sen­tia aque­la fal­ta do ta­ma­nho exa­to de­le. Só que ele ti­nha pas­sa­do anos fu­gin­do de­la. Sem pen­sar ne­la de pro­pósi­to. Sem vol­tar à es­ta­ção. Fa­zen­do da dor rai­va, e da rai­va tra­ba­lho. Não ti­nha si­do a dor que abriu a por­ta. Ti­nha si­do ca­da dia em que ele ten­tou não sen­tir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O po­der que vo­cê car­re­ga — dis­se a voz, mais bai­xo ain­da — é o que so­brou do se­lo de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu cha­mei os dois — dis­se a por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct le­van­tou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Os dois?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê e ela. Na mes­ma ca­sa, de­bai­xo da mes­ma chu­va. Eu cha­mo quem vai fi­car so­zi­nho, e na­que­la ca­sa ha­via dois que iam fi­car. Ela ia per­der vo­cê. Vo­cê ia per­der ela. A mes­ma au­sên­cia, dei­ta­da dos dois la­dos da mes­ma ca­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela ou­viu pri­mei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela sem­pre ou­via pri­mei­ro. — Ha­via qua­se um sor­ri­so na voz. — Vo­cê sa­be dis­so me­lhor do que eu. A chu­va co­me­çan­do an­tes de co­me­çar. O trem atra­san­do an­tes de atra­sar. Vo­cê men­tin­do an­tes de abrir a bo­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A mão de­le su­biu até a so­bran­ce­lha. Pa­rou no meio do ca­mi­nho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela sa­bia que o que sen­tia vi­nha an­tes. Que ain­da não ti­nha acon­te­ci­do. Que ain­da da­va tem­po. — A voz bai­xou. — E veio no seu lu­gar. Po­dia ter si­do vo­cê. Vo­cê te­ria vin­do com rai­va, e eu te­ria me aber­to pa­ra o mun­do in­tei­ro, e nin­guém te­ria me fe­cha­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Por que ela não me acor­dou?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Por­que vo­cê te­ria vin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Si­lên­cio. A ra­cha­du­ra tre­meu, co­mo cha­ma de ve­la quan­do al­guém pas­sa per­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela me deu o no­me in­tei­ro — con­ti­nuou a por­ta. — Por von­ta­de pró­pria. Nin­guém nun­ca ti­nha me da­do na­da por von­ta­de pró­pria. E eu fi­quei cheia, pe­la pri­mei­ra vez em mais tem­po do que es­ta vi­la tem de pe­dra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma pau­sa. Qua­se de má von­ta­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Mas não veio tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra a ra­cha­du­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Uma fa­gu­lha fi­cou do la­do de lá. Em vo­cê. Fin­ca­da, pe­que­na, quen­te, co­mo uma cha­ve es­que­ci­da na fe­cha­du­ra. Se­lo ne­nhum faz is­so. Um no­me da­do é um no­me da­do, in­tei­ro. Eu já en­go­li cen­te­nas, e ne­nhum dei­xou na­da pa­ra trás."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E o de­la dei­xou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O de­la não sa­bia fi­car lon­ge de vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz dis­se aqui­lo sem cru­el­da­de ne­nhu­ma. Com uma coi­sa que, nu­ma pes­soa, ele te­ria cha­ma­do de es­pan­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu não en­ten­do — dis­se a por­ta. — E eu en­ten­do qua­se tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma pau­sa lon­ga, co­mo quem ten­ta lem­brar da úl­ti­ma vez que dis­se aqui­lo, e não con­se­gue."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu es­ta­va aqui an­tes des­ta vi­la. An­tes da ser­ra. An­tes da pri­mei­ra pe­dra es­fri­ar e da pri­mei­ra es­tre­la acen­der no es­cu­ro. Quan­do ain­da não ha­via na­da no mun­do pa­ra ser per­di­do, eu já es­ta­va es­pe­ran­do. Não fui fei­ta. Não fui aber­ta. Eu sou o aves­so de tu­do o que exis­te, e tu­do o que exis­te um dia aca­ba do meu la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ra­cha­du­ra res­pi­rou de­va­gar, e o ar do sa­lão res­pi­rou jun­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— To­da au­sên­cia que já hou­ve pas­sou por mim. To­do no­me que al­guém dei­xou de cha­mar, eu guar­dei. Os que fo­ram em­bo­ra, os que não vol­ta­ram, os que nin­guém pro­cu­rou. Eu sou o lu­gar pa­ra on­de vai o que fal­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A luz dou­ra­da lá den­tro tre­meu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E nun­ca, em to­do es­se tem­po, uma au­sên­cia se re­cu­sou a ser in­tei­ra. Ela es­ta­va aqui, co­mi­go, do ou­tro la­do de tu­do. E con­ti­nu­a­va lá, com vo­cê. Num pul­so. Num ban­co. Nu­ma bra­sa atrás das cos­te­las. Nos dois lu­ga­res ao mes­mo tem­po. Eu não te­nho no­me pa­ra is­so. Is­so não de­ve­ria ser pos­sí­vel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— É, sim — dis­se Noct, bai­xi­nho. — Sem­pre foi."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele en­ten­deu. Ou achou que en­ten­dia, o que, per­to da­que­la por­ta, da­va no mes­mo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tem gen­te que fi­ca jun­ta mes­mo não es­tan­do jun­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não por pro­mes­sa, nem por tei­mo­sia. Por al­gu­ma coi­sa mais an­ti­ga do que as du­as, que não pe­de li­cen­ça ao tem­po, nem à dis­tân­cia, nem à pró­pria pa­re­de do mun­do. Uma li­nha fi­na, in­vi­sí­vel, amar­ra­da de um pul­so a ou­tro, que ne­nhu­ma por­ta con­se­gue cor­tar in­tei­ra. Po­de es­ti­car até qua­se ar­re­ben­tar. Po­de pas­sar anos es­que­ci­da no es­cu­ro. E con­ti­nua lá, mor­na, pu­xan­do de le­ve, co­mo quem lem­bra a uma mão que ela já se­gu­rou ou­tra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nin­guém de fo­ra nun­ca en­ten­deu os dois. Uma ga­ro­ta que ria de tu­do e um ra­paz que não ria de na­da. Ela, que con­ta­va ra­po­sas na bei­ra dos tri­lhos. Ele, que con­ta­va as sa­í­das de ca­da lu­gar on­de en­tra­va. Ela o cha­ma­va de bo­bo. Ele a cha­ma­va de ra­po­si­nha. E mes­mo as­sim ca­bi­am num ban­co de dois lu­ga­res co­mo se o mun­do ti­ves­se fei­to o ban­co pri­mei­ro, e eles de­pois, só pa­ra ocu­pá-lo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não fa­zia sen­ti­do. Vis­to de fo­ra, nun­ca faz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ti­nha ido. Ti­nha da­do o no­me in­tei­ro, tu­do o que uma pes­soa po­de dar a uma por­ta. E ain­da as­sim uma par­te de­la ti­nha fi­ca­do do la­do de cá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Por­que não sa­bia fi­car lon­ge de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E a cha­ve? — per­gun­tou ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Gi­rou so­zi­nha. Ca­da vez que vo­cê ten­tou es­que­cer. — A voz fi­cou mui­to bai­xa. — A cha­ve era de­la. E ela não que­ria ser es­que­ci­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou a mão em vol­ta do pul­so. Em vol­ta da fi­ta. Do nó tor­to do la­do es­quer­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra os pu­nhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As fa­gu­lhas car­me­sim que acen­di­am nos nós dos de­dos. A bra­sa que cres­cia no pei­to a ca­da gol­pe. As cau­das de luz que se abri­am atrás de­le quan­do ele pen­sa­va ne­la. A for­ma que ti­nha fei­to o Fa­min­to acor­dar, o Por­tei­ro re­cu­ar, a pa­re­de de cris­tal ex­plo­dir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Aqui­lo era ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não uma lem­bran­ça. Não um sím­bo­lo. "/>
                <ITEXT CPARENT="c_it" CH="Ela"/>
                <ITEXT CH=". O que ti­nha so­bra­do de­la, do se­lo que ela ti­nha fei­to com o pró­prio no­me e o pró­prio cor­po, ra­cha­do nos anos em que ele fu­giu da fal­ta de­la, e gru­da­do ne­le co­mo po­ei­ra de bra­sa gru­da­da na rou­pa. Foi quan­do o se­lo ra­chou que vi­e­ram as pa­re­des de cris­tal, o Fa­min­to, o Por­tei­ro. An­tes, o ca­mi­nho até a por­ta era só es­cu­ro e des­ci­da. Por is­so ela ti­nha che­ga­do ali so­zi­nha, num dia só."/>
                <para PARENT="corpo"/>
                <ITEXT CH="To­do aque­le tem­po, ele es­ta­va lu­tan­do com o que so­brou de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="To­do aque­le tem­po, ela es­ta­va lu­tan­do com ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os olhos. E de re­pen­te, sem avi­so, o pe­so de anos saiu de ci­ma dos om­bros de­le de uma vez só, e ele qua­se caiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão não foi por mi­nha cau­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ti­nha car­re­ga­do is­so. Des­de a ma­nhã do bi­lhe­te. A cer­te­za si­len­ci­o­sa, nun­ca di­ta em voz al­ta, nem pa­ra ele mes­mo, de que ti­nha fei­to al­gu­ma coi­sa er­ra­da. De que ela ti­nha ido em­bo­ra por cau­sa de­le. Do sar­cas­mo, da gros­se­ria, das men­ti­ras com a so­bran­ce­lha co­çan­do. De que, se ele ti­ves­se si­do ou­tra pes­soa, ela te­ria vol­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não foi por sua cau­sa que ela foi — dis­se a por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a voz mu­dou. Fi­cou mais quen­te. Mais próxi­ma. Qua­se fa­mi­li­ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Mas é por sua cau­sa que eu ain­da exis­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Noct abriu os olhos."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A ra­cha­du­ra no ar ti­nha mu­da­do. As bor­das ain­da eram ver­me­lhas, mas lá den­tro, on­de an­tes só ha­via es­cu­ro, ago­ra ha­via luz. Uma luz dou­ra­da, de fim de tar­de, de lam­pi­ão de es­ta­ção. E den­tro da luz, bor­ra­do, co­mo uma coi­sa vis­ta atra­vés de vi­dro mo­lha­do, ha­via um ban­co. De fer­ro es­cu­ro e tá­bu­as gas­tas. Com dois lu­ga­res."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no la­do es­quer­do, al­guém sen­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não con­se­guia ver o ros­to. Nun­ca ia con­se­guir ver o ros­to. Mas via o ca­be­lo, e via uma fi­ta amar­ra­da ne­le, da cor de bra­sa que es­que­ceu de apa­gar. E via o jei­to de sen­tar, meio tor­to, com um pé em ci­ma do ban­co, que ela sa­bia que ele odi­a­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Fi­que — dis­se a voz da por­ta, e ago­ra era qua­se a voz de­la. Qua­se. — Aqui den­tro, ela ain­da es­tá es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct deu um pas­so pa­ra a fren­te sem per­ce­ber."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de­pois pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra a fi­gu­ra no ban­co. Pa­ra a fi­ta no ca­be­lo. Pa­ra o pé em ci­ma do as­sen­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou na pe­dra no Co­ra­ção da Fen­da. "/>
                <ITEXT CPARENT="c_it" CH="A por­ta cha­ma de noi­te."/>
                <ITEXT CH=" Pen­sou nas lem­bran­ças que vi­e­ram pe­lo ca­mi­nho, nu­ma pra­ça, num te­lha­do, num bos­que, na ser­ra, num pân­ta­no, num ce­mi­té­rio, nu­ma ca­te­dral, no fun­do de um la­go, no Aves­so. E em ne­nhu­ma de­las ela fi­ca­va qui­e­ta es­pe­ran­do por ele. Ela ria, ela co­bra­va, ela pe­ga­va as men­ti­ras de­le no ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­gu­ra no ban­co es­pe­ra­va com uma pa­ciên­cia que ela nun­ca te­ve."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão me mos­tra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz da por­ta fi­cou em si­lên­cio por um ins­tan­te. Co­mo quem não es­pe­ra­va o pe­di­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois a luz dou­ra­da se abriu, de­va­gar, do jei­to que se abre uma por­ta pa­ra al­guém que ba­teu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E pu­xou."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="63732.125984252" OwnPage="184" ItemID="1081029353" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="63732.125984252" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1080588873" BACKITEM="1074329097"/>
