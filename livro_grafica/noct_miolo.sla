        <PAGEOBJECT XPOS="151.023622047244" YPOS="29825.6692913386" OwnPage="85" ItemID="939180905" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="29825.6692913386" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="910492009" BACKITEM="939188233"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="29825.6692913386" OwnPage="86" ItemID="910492009" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="29825.6692913386" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="935999385" BACKITEM="939180905"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="30517.6377952756" OwnPage="87" ItemID="935999385" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="30517.6377952756" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="910492009"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="30622.5196850394" OwnPage="88" ItemID="941737929" PTYPE="4" WIDTH="334.488188976378" HEIGHT="226.771653543307" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" copath="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" gXpos="621.574803149606" gYpos="30622.5196850394" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Parte IV"/>
                <para PARENT="parte_num"/>
                <ITEXT CH="O Domínio do Ceifador"/>
                <para PARENT="parte"/>
                <ITEXT CH="Dizem que a Morte não mente. É verdade. A Morte não precisa mentir. Ela só precisa encontrar a mentira que você já conta para si mesmo e repeti-la com a sua voz."/>
                <trail PARENT="parte_epi"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="771.811023622047" YPOS="30877.6377952756" OwnPage="88" ItemID="941810633" PTYPE="2" WIDTH="34.0157480314961" HEIGHT="34.0157480314961" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.0354330708661417" LOCALSCY="0.0354330708661417" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="emblema_cinza.png" IRENDER="0" EMBEDDED="0" path="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" copath="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" gXpos="771.811023622047" gYpos="30877.6377952756" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="31294.6456692914" OwnPage="90" ItemID="941761785" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="31294.6456692914" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="948702409" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 11"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Até os san­tos de­sis­ti­ram"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" ca­te­dral es­ta­va de pé por tei­mo­sia."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não ha­via ou­tra ex­pli­ca­ção. O te­lha­do ti­nha ca­í­do em três lu­ga­res, e pe­los bu­ra­cos o céu cin­zen­to olha­va pa­ra den­tro co­mo um pa­ren­te que che­gou tar­de ao ve­ló­rio. As co­lu­nas es­ta­vam ra­cha­das de ci­ma a bai­xo. Me­ta­de dos vi­trais ti­nha vi­ra­do ca­cos no chão, e a ou­tra me­ta­de ain­da es­ta­va pre­sa às ja­ne­las, con­tan­do his­tó­rias de san­tos que nin­guém mais lem­bra­va em co­res que nin­guém mais via."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em Pe­dra­ve­lha nin­guém fa­la­va de­la. Não era proi­bi­do. Era pi­or: era es­que­ci­do de pro­pósi­to. Quan­do Noct per­gun­tou, Ze­no mu­dou de as­sun­to no meio da fra­se, a mu­lher do pão fe­chou a ja­ne­la, e Brom ba­teu o mar­te­lo com mais for­ça, co­mo quem não ou­viu. Só Tes­sa ti­nha di­to al­gu­ma coi­sa, lá no bos­que, com os pul­sos ain­da mar­ca­dos: um ho­mem que guar­da­va al­go lá em­bai­xo e pa­ga­va por quem ou­vis­se a fen­da. Nin­guém que en­trou ti­nha vol­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct en­ten­deu, olhan­do pa­ra ela, por que a vi­la pre­fe­ria não lem­brar. Um dia as pes­so­as ti­nham su­bi­do até ali pa­ra re­zar. De­pois al­gu­mas pa­ra­ram de vol­tar. De­pois to­das pa­ra­ram de ir. A ca­te­dral fi­cou pa­ra o Cus­tó­dio e pa­ra quem era tra­zi­do até ele, e o res­to da vi­la apren­deu a olhar pa­ra ou­tro la­do do ho­ri­zon­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E nas pa­re­des, por bai­xo da pe­dra, al­gu­ma coi­sa pul­sa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou no meio da na­ve, en­tre fi­lei­ras de ban­cos tom­ba­dos, e olhou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Eram vei­os. Fi­nos, ver­me­lhos, cor­ren­do pe­las pa­re­des co­mo ra­í­zes de uma ár­vo­re que cres­ces­se pa­ra den­tro da pe­dra em vez de pa­ra fo­ra de­la. Acen­di­am e apa­ga­vam de­va­gar, to­dos jun­tos, num rit­mo que ele re­co­nhe­ceu an­tes de que­rer re­co­nhe­cer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O rit­mo do zum­bi­do. O rit­mo da bra­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— A fen­da pul­sa nas pa­re­des — dis­se bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra ci­ma, pa­ra o al­tar no fun­do, on­de uma es­tá­tua de san­to se­gu­ra­va as mãos em ora­ção. A ca­be­ça da es­tá­tua ti­nha ca­í­do e ro­la­do até o pri­mei­ro de­grau. As mãos con­ti­nu­a­vam jun­tas, re­zan­do pa­ra nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Até os san­tos da­qui de­sis­ti­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele ou­viu os pas­sos an­tes de ou­vir a voz."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Le­ves, apres­sa­dos, o ti­po de pas­so que ten­ta não fa­zer ba­ru­lho e fa­lha por­que es­tá com pres­sa de­mais. Vi­nham da por­ta da ca­te­dral, atrás de­le. Noct não se vi­rou de ime­di­a­to. Ele sa­bia quem era. Sa­bia pe­lo pe­so, pe­lo rit­mo, pe­lo jei­to que o co­ra­ção de­le afun­dou meio pal­mo no pei­to an­tes de a ca­be­ça dar o no­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Vi­rou-se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa es­ta­va na por­ta, ofe­gan­te, ain­da en­ro­la­da na man­ta de­le. Ti­nha la­ma até os jo­e­lhos e uma fo­lha se­ca pre­sa no ca­be­lo. Pa­re­cia ter atra­ves­sa­do a ser­ra cor­ren­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pro­va­vel­men­te ti­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu te se­gui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Al­gu­ma coi­sa acon­te­ceu den­tro de­le que ele não sou­be no­me­ar. Fa­zia anos que nin­guém ia atrás de­le. Nin­guém atra­ves­sa­va ser­ra ne­nhu­ma pa­ra sa­ber se ele es­ta­va bem. Ele não sa­bia o que fa­zer com aqui­lo, en­tão fez o que sem­pre fa­zia com o que não sa­bia car­re­gar: en­du­re­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­ta pra vi­la — dis­se, e a voz saiu du­ra, mais du­ra do que ele usa­va com sa­que­a­do­res."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa não se me­xeu. Olha­va pa­ra as pa­re­des, pa­ra os vei­os ver­me­lhos, com uma ex­pres­são que ele co­nhe­cia. Já ti­nha vis­to aque­la ex­pres­são num ros­to que ele não ia des­cre­ver."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O cha­ma­do é mais for­te aqui — dis­se ela. — E vo­cê en­trou so­zi­nho. Nin­guém en­tra aqui so­zi­nho e vol­ta. — Ela pu­xou a man­ta mais pa­ra per­to. — E eu tam­bém pre­ci­so sa­ber o que é."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela tam­bém pre­ci­sa­va sa­ber"/>
                <ITEXT CH=", pen­sou Noct, e o pen­sa­men­to veio tão rápi­do que ele não con­se­guiu fe­char a por­ta. "/>
                <ITEXT CPARENT="c_it" CH="Ela tam­bém ou­via. Ela tam­bém ia so­zi­nha atrás do que ou­via."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Aqui vo­cê atra­pa­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi cru­el. Ele sa­bia que era cru­el en­quan­to di­zia. Era exa­ta­men­te por is­so que di­zia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa o olhou de ver­da­de, en­tão. Por mui­to tem­po. E ele viu, com uma cla­re­za que o dei­xou fu­ri­o­so, que a fra­se não ti­nha ma­chu­ca­do on­de ele mi­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê me deu a sua man­ta e foi em­bo­ra sem na­da nas cos­tas. — Ela aper­tou a lã con­tra o pei­to. — Eu fi­quei pen­san­do em vo­cê pas­san­do frio num lu­gar des­ses. Só is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ca­te­dral fi­cou em si­lên­cio. Os vei­os nas pa­re­des pul­sa­ram, uma vez, co­mo se tam­bém es­pe­ras­sem a res­pos­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct sen­tiu a ar­ma­du­ra in­tei­ra se fe­char em vol­ta de­le, pla­ca por pla­ca, co­mo fa­zia sem­pre. A ex­pres­são de­le não mu­dou. A mão não foi até a fi­ta, nem até a so­bran­ce­lha. Ele ti­nha anos de práti­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu não sin­to frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa fi­cou pa­ra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O si­lên­cio de­la du­rou mais do que qual­quer res­pos­ta. E en­tão ela des­vi­ou os olhos, e al­gu­ma coi­sa no ros­to de­la se fe­chou tam­bém, não com rai­va, com can­sa­ço, com a de­ci­são de quem en­ten­de que não vai ga­nhar uma dis­cus­são com uma pa­re­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tá — dis­se. — Eu vol­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Vi­rou-se e saiu pe­la por­ta da ca­te­dral."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não foi atrás de­la. Não dis­se na­da. Fi­cou pa­ra­do no meio da na­ve, en­tre os ban­cos tom­ba­dos, olhan­do pa­ra a por­ta va­zia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de­pois an­dou até a por­ta. De­va­gar. Sem fa­zer ba­ru­lho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De lá da­va pa­ra ver a es­tra­da que des­cia pa­ra o oes­te, de vol­ta pa­ra o ce­mi­té­rio, pa­ra a ser­ra, pa­ra Pe­dra­ve­lha. Uma fi­gu­ra pe­que­na an­da­va por ela, en­ro­la­da nu­ma man­ta es­cu­ra, os om­bros en­co­lhi­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fi­cou olhan­do até ela su­mir na cur­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só en­tão vol­tou pa­ra den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A lem­bran­ça es­ta­va no fun­do da na­ve, atrás do al­tar, num lu­gar on­de a luz dos vi­trais não che­ga­va."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não era um ob­je­to. Era um lu­gar on­de a me­mó­ria de­le ti­nha fi­ca­do pre­sa, co­mo um len­ço es­que­ci­do nu­ma ca­dei­ra. Ele sen­tia quan­do che­ga­va per­to. O ar fi­ca­va mais es­pes­so, o zum­bi­do mais al­to, e de re­pen­te ele es­ta­va em ou­tro lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va na co­zi­nha pe­que­na. Era de noi­te. Ela es­ta­va sen­ta­da à me­sa, com as mãos em vol­ta de uma xí­ca­ra que ti­nha es­fri­a­do há mui­to tem­po, olhan­do pa­ra a ja­ne­la es­cu­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Nas úl­ti­mas se­ma­nas, Mi­ra ou­via um zum­bi­do que nin­guém mais ou­via. E an­da­va lon­ge, mes­mo sen­ta­da ali, do ou­tro la­do da me­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele lem­bra­va do jei­to co­mo ela in­cli­na­va a ca­be­ça, às ve­zes, no meio de uma fra­se. Co­mo al­guém que es­cu­ta uma músi­ca vin­do de ou­tro quar­to. Ele per­gun­ta­va o que foi, e ela di­zia que na­da, e vol­ta­va pa­ra a fra­se, mas sem­pre um pou­co mais de­va­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na­que­la noi­te, ela não dis­se que na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Pa­re­ce al­guém cha­man­do do ou­tro la­do de uma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele es­ta­va can­sa­do. Ti­nha pas­sa­do o dia es­col­tan­do a car­ro­ça de al­guém que pa­ga­va pou­co e re­cla­ma­va mui­to. Ele es­ta­va can­sa­do e ela es­ta­va es­tra­nha e ele não ti­nha es­pa­ço na ca­be­ça pa­ra mais uma coi­sa es­tra­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="É can­sa­ço"/>
                <ITEXT CH=", ele dis­se. "/>
                <ITEXT CPARENT="c_it" CH="Vo­cê pre­ci­sa dor­mir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela olhou pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E sor­riu. Do jei­to que sor­ria quan­do ele es­ta­va er­ra­do e ela não ia dis­cu­tir. Um sor­ri­so pe­que­no, gen­til, cheio de uma pa­ciên­cia que ele não me­re­cia, e que ele só foi en­ten­der mui­to tem­po de­pois que era tam­bém um adeus."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Atrás do al­tar, na ca­te­dral, Noct es­ta­va de jo­e­lhos. Não lem­bra­va de ter se ajo­e­lha­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu dis­se que era can­sa­ço — dis­se pa­ra o chão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ar não vol­tou. En­trou cur­to, ra­so, pre­so em al­gum lu­gar en­tre a gar­gan­ta e o pei­to, e o co­ra­ção co­me­çou a ba­ter rápi­do de­mais, co­mo se qui­ses­se sair por on­de o ar não en­tra­va. As mãos tre­mi­am. O chão da ca­te­dral pa­re­cia lon­ge e per­to ao mes­mo tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só per­ce­beu que es­ta­va cho­ran­do quan­do uma go­ta caiu na pe­dra, en­tre as mãos de­le. De­pois ou­tra. Não fa­zia som ne­nhum. Ele nem sa­bia que ain­da sa­bia fa­zer aqui­lo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele con­tou. Qua­tro pa­ra den­tro. Se­gu­rou. Mais de­va­gar pa­ra fo­ra. Do jei­to que uma mu­lher de hábi­to cin­za ti­nha mos­tra­do per­to de um po­ço, fa­lan­do de ou­tra coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Odi­ou que fun­ci­o­nas­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os vei­os ver­me­lhos na pa­re­de pul­sa­ram em vol­ta de­le. Uma vez, du­as, três. Co­mo al­guém ba­ten­do nu­ma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se le­van­tou. Pas­sou as cos­tas da lu­va no ros­to. Lim­pou os jo­e­lhos. Olhou pa­ra ci­ma, pa­ra o al­to da ca­te­dral, on­de uma es­ca­da es­trei­ta su­bia por den­tro da pa­re­de até uma por­ta de ma­dei­ra es­cu­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na por­ta ha­via uma mar­ca en­ta­lha­da. Uma ca­vei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A mes­ma do de­se­nho a car­vão na lis­ta dos sa­que­a­do­res."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="31901.5748031496" OwnPage="91" ItemID="948702409" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="31901.5748031496" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="948545225" BACKITEM="941761785"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="31901.5748031496" OwnPage="92" ItemID="948545225" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="31901.5748031496" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="948722649" BACKITEM="948702409"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="32593.5433070866" OwnPage="93" ItemID="948722649" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="32593.5433070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="948806041" BACKITEM="948545225"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="32593.5433070866" OwnPage="94" ItemID="948806041" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="32593.5433070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="948722649"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="33370.5511811024" OwnPage="95" ItemID="951505353" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="33370.5511811024" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="959353337" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 12"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Uma ora­ção pa­ra a fen­da"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" por­ta com a ca­vei­ra da­va pa­ra ci­ma."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Uma es­ca­da em es­pi­ral, es­trei­ta, úmi­da, su­bia por den­tro da pa­re­de da ca­te­dral e sa­ía no te­lha­do, on­de o ven­to cor­ta­va co­mo uma lâ­mi­na fria. E da­li, por uma pas­sa­re­la de pe­dra que al­guém ti­nha cons­tru­í­do so­bre o va­zio, che­ga­va-se à ru­í­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No pas­sa­do, aqui­lo ti­nha si­do uma ca­pe­la pe­que­na, em­po­lei­ra­da no al­to da ca­te­dral co­mo um ni­nho. Ago­ra era ou­tra coi­sa. Os vi­trais ti­nham si­do ta­pa­dos com te­ci­do es­cu­ro. O al­tar es­ta­va co­ber­to de ve­las pre­tas, to­das ace­sas, to­das pin­gan­do ce­ra na mes­ma di­re­ção, co­mo se hou­ves­se um ven­to que só elas sen­ti­am. No chão, de­se­nha­do com al­gu­ma coi­sa que não era tin­ta, ha­via um cír­cu­lo enor­me, cheio de sím­bo­los que Noct não sa­bia ler e que, ain­da as­sim, fa­zi­am a bra­sa no pei­to de­le se en­co­lher."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no cen­tro do cír­cu­lo, ajo­e­lha­do, ha­via um ho­mem re­zan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pa­ra um san­to. Não pa­ra ne­nhum deus que Noct co­nhe­ces­se. Re­za­va de olhos fe­cha­dos, com as mãos aber­tas vi­ra­das pa­ra o al­to, e a ora­ção de­le não ti­nha pa­la­vras, só um mur­mú­rio rit­ma­do, bai­xo, que su­bia e des­cia no mes­mo com­pas­so dos vei­os ver­me­lhos nas pa­re­des."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No mes­mo com­pas­so da fen­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou na en­tra­da da ru­í­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Aqui a fen­da tem al­guém pra re­zar por ela — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fe­chou os pu­nhos. As fa­gu­lhas car­me­sim es­ta­la­ram nos nós dos de­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Va­mos aca­bar com a ora­ção."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Cus­tó­dio abriu os olhos."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Era mais ve­lho do que Noct es­pe­ra­va, e mais ma­gro. Ves­tia um man­to es­cu­ro de ma­go, bor­da­do com os mes­mos sím­bo­los do cír­cu­lo no chão. O ros­to era com­pri­do, páli­do, com olhei­ras fun­das de quem não dor­me há anos, e os olhos ti­nham uma cal­ma ter­rí­vel, uma cal­ma de quem já de­ci­diu tu­do o que ha­via pa­ra de­ci­dir e ago­ra só exe­cu­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele olhou pa­ra Noct. In­cli­nou a ca­be­ça, co­mo quem es­cu­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E sor­riu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nin­guém so­be até aqui an­dan­do — dis­se. Ti­nha uma voz su­a­ve, qua­se gen­til, de pro­fes­sor. — Os que che­gam a es­te cír­cu­lo che­gam amar­ra­dos. Vo­cê não es­tá amar­ra­do. — Os olhos de­le des­ce­ram de­va­gar: as lu­vas, os nós dos de­dos es­fo­la­dos, a fi­ta no pul­so. — En­tão foi vo­cê. A car­ro­ça no bos­que. O acam­pa­men­to na ser­ra. O Ca­pi­tão me de­via três en­tre­gas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Quem é vo­cê? — O Cus­tó­dio per­gun­tou sem pres­sa, com uma cu­ri­o­si­da­de ver­da­dei­ra, qua­se afe­tuo­sa, co­mo quem en­con­tra um in­se­to ra­ro no jar­dim. — Um mer­ce­ná­rio, pe­lo jei­to das mãos. Mas mer­ce­ná­rios vêm por di­nhei­ro, e nin­guém pa­ga um ho­mem pa­ra su­bir até aqui. Quem te man­dou?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nin­guém. — O Cus­tó­dio re­pe­tiu a pa­la­vra co­mo quem pro­va um vi­nho. Olhou pa­ra a fi­ta de no­vo, mais tem­po. — Ah. En­tão não é por di­nhei­ro. É por al­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A mão de Noct fi­cou pa­ra­da ao la­do do cor­po. Ele não dei­xou que ela fos­se até a fi­ta. O Cus­tó­dio viu mes­mo as­sim, e o sor­ri­so de­le fi­cou um pou­co mais lar­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E vo­cê ou­viu a fen­da — dis­se, co­mo quem che­ga ao fim de uma con­ta. — En­tão per­ten­ce ao se­lo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As pa­la­vras ca­í­ram em Noct co­mo água ge­la­da."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Per­ten­ce."/>
                <ITEXT CH=" Co­mo um ob­je­to. Co­mo um no­me nu­ma lis­ta, com um cír­cu­lo ao la­do. Co­mo uma mo­ça amar­ra­da nu­ma car­ro­ça, um ra­paz amar­ra­do nu­ma es­ta­ca. Co­mo al­guém que saiu an­tes de ama­nhe­cer por­que uma por­ta a cha­ma­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to de­le su­biu de uma vez, quen­te, fu­ri­o­sa. Ele não a se­gu­rou. Não des­ta vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não per­ten­ço a na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão, an­tes que pu­des­se se im­pe­dir, saiu a per­gun­ta que ele vi­nha car­re­gan­do des­de o bos­que."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Uma mu­lher. Anos atrás. Usa­va uma fi­ta ver­me­lha no ca­be­lo. Igual a es­ta. Ou­via a fen­da an­tes de to­do mun­do. — A voz fa­lhou nu­ma pa­la­vra, e ele a obri­gou a con­ti­nu­ar. — Ela pas­sou por aqui?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cus­tó­dio o olhou com uma cu­ri­o­si­da­de qua­se gen­til."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pas­sa­ram tan­tas. — In­cli­nou a ca­be­ça. — Eu não guar­do ros­tos, ra­paz. Guar­do no­mes. Se ela veio, es­tá es­cri­ta. Eu não per­co nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Eu não per­co nin­guém."/>
                <ITEXT CH=" Noct ti­nha per­di­do. Aque­le ho­mem, não."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Eu ma­to"/>
                <ITEXT CH=", ti­nha pro­me­ti­do a si mes­mo no bos­que, com a lis­ta na mão. "/>
                <ITEXT CPARENT="c_it" CH="O ho­mem da ca­te­dral. Quem pa­gou. Quem car­re­gou. To­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ho­mem da ca­te­dral es­ta­va ali, a qua­tro pas­sos, sor­rin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Cus­tó­dio lu­ta­va sem se me­xer mui­to."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não pre­ci­sa­va. Er­guia uma mão e o ar se do­bra­va, e es­fe­ras de luz ro­xa e do­en­te sa­í­am do cír­cu­lo e vo­a­vam na di­re­ção de Noct. Er­guia a ou­tra e o chão em­bai­xo dos pés de­le acen­dia, e Noct ti­nha meio se­gun­do pa­ra pu­lar an­tes que a pe­dra ex­plo­dis­se em fo­go frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct apren­deu o rit­mo, co­mo apren­dia to­dos. A ca­da du­as ma­gi­as, o ma­go pre­ci­sa­va de fô­le­go. A ca­da três, bai­xa­va as mãos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nes­se in­ter­va­lo, Noct en­tra­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Jab. Cross. Um chu­te no jo­e­lho que fez o ma­go do­brar. Um so­co as­cen­den­te que o le­van­tou do chão. E a ca­da gol­pe, a ca­da fa­gu­lha car­me­sim que es­ta­la­va con­tra o man­to bor­da­do, os sím­bo­los do cír­cu­lo no chão pis­ca­vam e en­fra­que­ci­am, co­mo ve­las num ven­to for­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ba­tia com tu­do o que vi­nha guar­dan­do des­de o bos­que. Com os pul­sos mar­ca­dos de Tes­sa. Com o ra­paz da es­ta­ca. Com ca­da no­me ris­ca­do na lis­ta, ca­da pe­que­no cír­cu­lo de en­tre­gue. Com as ma­dru­ga­das em que ela sa­ía so­zi­nha pa­ra um mun­do on­de exis­tia gen­te co­mo aque­le ho­mem, en­quan­to ele dor­mia do ou­tro la­do da ca­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Cus­tó­dio caiu de jo­e­lhos no cen­tro do pró­prio cír­cu­lo. O san­gue es­cor­ria do na­riz de­le. Ain­da sor­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê acha que é di­fe­ren­te — dis­se, ofe­gan­te. — To­dos acham. Mas a fen­da co­nhe­ce vo­cê. Ela co­nhe­ce o for­ma­to da sua..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não o dei­xou ter­mi­nar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct er­gueu o pu­nho. A bra­sa ti­nha su­bi­do até os olhos, e ele via o mun­do por trás de um véu ver­me­lho, e no meio do véu aque­le ros­to cal­mo, san­gran­do, es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Eu ma­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Se­ria fácil. Se­ria a coi­sa mais fácil que ele ti­nha fei­to em anos. E não ia de­vol­ver na­da. Um ho­mem mor­to não ia di­zer se ela ti­nha pas­sa­do por ali. Um ho­mem mor­to não ia di­zer coi­sa ne­nhu­ma, e ele ia vol­tar pa­ra o ban­co com mais um si­lên­cio no bol­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pu­nho des­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O úl­ti­mo so­co que­brou o cír­cu­lo. Não o ho­mem; o cír­cu­lo. Os sím­bo­los no chão se apa­ga­ram to­dos ao mes­mo tem­po, com um som de vi­dro es­ta­lan­do, e as ve­las pre­tas no al­tar se apa­ga­ram jun­to, e por um ins­tan­te a ru­í­na fi­cou com­ple­ta­men­te es­cu­ra e com­ple­ta­men­te si­len­ci­o­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do os olhos de Noct se acos­tu­ma­ram, o Cus­tó­dio não es­ta­va mais lá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só o man­to, ca­í­do no chão, va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Atrás do al­tar ha­via uma por­ta pe­que­na, e atrás da por­ta, o ar­qui­vo do Cus­tó­dio."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Es­tan­tes. Pra­te­lei­ras do chão ao te­to, chei­as de li­vros, per­ga­mi­nhos, ca­der­nos amar­ra­dos com bar­ban­te. E em ci­ma de uma me­sa, aber­to, um re­gis­tro gros­so, es­cri­to à mão com aque­la le­tra ca­pri­cha­da e fria que Noct já co­nhe­cia da lis­ta dos sa­que­a­do­res."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele leu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="An­tes dos no­mes, nas pri­mei­ras fo­lhas, o Cus­tó­dio ti­nha es­cri­to por que fa­zia aqui­lo. Com a mes­ma le­tra fria, co­mo quem pres­ta con­tas a al­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ca­te­dral não ti­nha si­do er­gui­da pa­ra deus ne­nhum. Ti­nha si­do er­gui­da em ci­ma de uma ra­cha­du­ra, sé­cu­los an­tes, no pon­to da re­gi­ão on­de o cha­ma­do era mais al­to, por gen­te que acha­va que re­za bas­ta­va pa­ra fe­char uma por­ta. Não bas­tou. Os fi­éis re­za­ram por ge­ra­ções, e a por­ta con­ti­nuou cha­man­do, e de tem­pos em tem­pos al­guém da vi­la ou­via e su­mia. Os que cui­da­vam da ca­te­dral pas­sa­ram a se cha­mar cus­tó­dios. Guar­di­ões da por­ta. Ele era o úl­ti­mo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ti­nha pa­ra­do de re­zar. Ti­nha es­tu­da­do a por­ta co­mo se es­tu­da um bi­cho, e che­ga­do a uma con­clu­são: ela cha­ma­va pes­so­as por­que que­ria pes­so­as. Bas­ta­va dar a ela o que pe­dia, do jei­to cer­to, com o no­me es­cri­to no se­lo, e ela se fe­cha­ria sa­tis­fei­ta. En­tão ele pas­sou a bus­car quem ou­via. De pre­fe­rên­cia quem nin­guém iria pro­cu­rar: an­da­ri­lhos, ór­fãos, gen­te sem ca­sa. Pa­ga­va sa­que­a­do­res pa­ra tra­zer. Amar­ra­va no cír­cu­lo. Es­cre­via o no­me. E a por­ta le­va­va."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Nin­guém sen­te fal­ta"/>
                <ITEXT CH=", ti­nha es­cri­to nu­ma mar­gem, co­mo quem ano­ta uma van­ta­gem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct sen­tiu o es­tô­ma­go vi­rar. Não era mal­da­de, o que es­ta­va ali. Era pi­or. Era um ho­mem con­ven­ci­do de que es­ta­va sal­van­do a vi­la, um no­me de ca­da vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No fim do pre­fá­cio ha­via um ma­pa de­se­nha­do à mão. A ca­te­dral. O san­tuá­rio atrás do al­tar prin­ci­pal, com uma ano­ta­ção pe­que­na: "/>
                <ITEXT CPARENT="c_it" CH="aqui­lo que mo­ra aqui se ali­men­ta de cul­pa; não en­trar"/>
                <ITEXT CH=". E em­bai­xo de tu­do, uma se­ta des­cen­do pa­ra a água, até um la­go, e de­pois do la­go, mais fun­do, um cír­cu­lo es­cu­ro sem no­me. Ao la­do, a le­tra fria: "/>
                <ITEXT CPARENT="c_it" CH="As águas le­vam à por­ta."/>
                <ITEXT CH=" E, mais em­bai­xo, me­nor, co­mo quem adia uma coi­sa há mui­to tem­po: "/>
                <ITEXT CPARENT="c_it" CH="Ain­da não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O re­gis­tro des­cre­via gen­te cap­tu­ra­da. Da­tas. No­mes. Des­cri­ções se­cas, clíni­cas, de pes­so­as que ou­vi­am a fen­da e ti­nham si­do tra­zi­das até ali, até o cír­cu­lo, até o se­lo. Noct não leu as des­cri­ções. Leu os no­mes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um por um, com o de­do, pági­na por pági­na, do jei­to que ti­nha li­do a lis­ta no bos­que, só que mais de­va­gar, por­que aqui­lo po­dia ser o fim da pro­cu­ra ou o co­me­ço de ou­tra. A mão co­me­çou a tre­mer na ter­cei­ra pági­na. Ele a se­gu­rou com a ou­tra e con­ti­nuou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O no­me de­la não es­ta­va ali."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Leu de no­vo, do co­me­ço. Não es­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O alí­vio veio e não fi­cou. Atrás de­le veio a ou­tra coi­sa, a que sem­pre vi­nha: se ela não ti­nha pas­sa­do pe­las mãos da­que­le ho­mem, en­tão ti­nha ido so­zi­nha. Por von­ta­de pró­pria. Pa­ra on­de, nin­guém ti­nha es­cri­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na mar­gem de uma das úl­ti­mas pági­nas, uma ano­ta­ção, su­bli­n­ha­da du­as ve­zes:"/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="A ener­gia car­me­sim não obe­de­ce ao nos­so se­lo. Res­pon­de à au­sên­cia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fran­ziu a tes­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Au­sên­cia de quê?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Vi­rou a pági­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pági­na se­guin­te ti­nha si­do ar­ran­ca­da. Res­ta­va só a bor­da ras­ga­da, pre­sa à cos­tu­ra, e al­gu­mas le­tras sol­tas que não for­ma­vam pa­la­vra ne­nhu­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fi­cou olhan­do pa­ra a bor­da ras­ga­da por um bom tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Cla­ro que foi — dis­se, bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No fun­do do ar­qui­vo, en­tre du­as es­tan­tes, ha­via ou­tra por­ta."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Des­ta vez não ti­nha ca­vei­ra. Ti­nha água. Es­cor­ria por bai­xo de­la, fria, lím­pi­da, e quan­do Noct a abriu, viu que do ou­tro la­do não ha­via sa­la ne­nhu­ma. Ha­via um ras­go no ar. Ver­ti­cal, es­trei­to, ver­me­lho nas bor­das, e por ele vi­nha um chei­ro de pa­pel mo­lha­do e de pe­dra an­ti­ga."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele atra­ves­sou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Do ou­tro la­do, es­ta­va de­bai­xo d'água. Ou qua­se. Um sa­lão imen­so, de co­lu­nas al­tas e ja­ne­las de igre­ja tin­gi­das de azul, inun­da­do até a cin­tu­ra. Es­tan­tes e mais es­tan­tes, tom­ba­das, afun­da­das, os li­vros boi­an­do co­mo pei­xes mor­tos. Ve­las ace­sas em ci­ma das es­tan­tes que ain­da es­ta­vam de pé, quei­man­do sem se im­por­tar com a água. Go­tei­ras cain­do do te­to, uma, ou­tra, ou­tra, num rit­mo que não era o da fen­da, o que, ali, era qua­se um alí­vio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra ci­ma, pa­ra as ja­ne­las azuis, pa­ra a água que es­cor­ria pe­las pa­re­des."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O Cus­tó­dio guar­da­va tu­do — dis­se. — Até a água."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de­pois, mais sé­rio, olhan­do pa­ra as es­tan­tes afun­da­das:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— A pági­na ar­ran­ca­da tem que es­tar aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Os li­vros mor­de­ram."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ele já de­via ter es­pe­ra­do. Na­da que per­ten­ces­se ao Cus­tó­dio era só o que pa­re­cia. Os gri­mó­rios que boi­a­vam na água se abri­ram quan­do ele pas­sou, as pági­nas se eri­çan­do co­mo den­tes, e sal­ta­ram pa­ra ci­ma de­le com um ba­ter de ca­pas que so­a­va co­mo asas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct os en­fren­tou com os pu­nhos e com mui­ta ir­ri­ta­ção. Ha­via al­go de pro­fun­da­men­te ofen­si­vo em ser ata­ca­do por li­te­ra­tu­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do o úl­ti­mo gri­mó­rio caiu na água, fe­cha­do e qui­e­to, ele en­con­trou a pági­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va pre­sa no al­to de uma es­tan­te, lon­ge da água, co­mo se al­guém a ti­ves­se pos­to ali de pro­pósi­to pa­ra que não se per­des­se. Ou pa­ra que al­guém a en­con­tras­se. Es­ta­va in­cha­da de umi­da­de, a tin­ta bor­ra­da nas bor­das, mas o meio ain­da era le­gí­vel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era a con­ti­nu­a­ção da ano­ta­ção. A mes­ma le­tra fria."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="...res­pon­de à au­sên­cia de quem foi ama­do. O se­lo pe­de um no­me em tro­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Os no­mes que tra­go não bas­tam. A por­ta en­go­le to­dos e con­ti­nua com fo­me. Tal­vez por­que nin­guém os pro­cu­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Se­ria pre­ci­so um no­me da­do de li­vre von­ta­de. Um no­me que fi­zes­se fal­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Nin­guém vem de li­vre von­ta­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct leu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E não dis­se na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via na­da, den­tro de­le, que pu­des­se vi­rar pa­la­vra. A fra­se en­trou ne­le co­mo a né­voa fria en­tra­va, sem pe­dir li­cen­ça, e se aco­mo­dou num lu­gar fun­do, per­to da bra­sa, e fi­cou ali, pe­sa­da."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Au­sên­cia de quem foi ama­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa ne­le ti­nha apa­re­ci­do de­pois. De­pois do bi­lhe­te. De­pois da ma­nhã em que ela não vol­tou. Ele sem­pre sou­be dis­so. Nun­ca ti­nha dei­xa­do o pen­sa­men­to ir até o fim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pen­sa­men­to foi até o fim, ago­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="En­tão é is­so que eu car­re­go. Não um po­der. Um bu­ra­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de­pois, mais de­va­gar, a ou­tra me­ta­de da fra­se."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="O se­lo pe­de um no­me em tro­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um no­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou num ban­co de es­ta­ção. Nu­ma le­tra que ele co­nhe­cia. Num ris­co de al­tu­ra nu­ma tor­re, ao la­do de um no­me ras­pa­do com tan­to cui­da­do que só so­bra­va a ci­ca­triz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou em coi­sas que não ti­nha per­mis­são pa­ra pen­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela olha­va pe­la ja­ne­la de noi­te. E eu di­zia que era can­sa­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Abriu os olhos. Do­brou a pági­na mo­lha­da em qua­tro e guar­dou no bol­so de den­tro. Jun­to do bi­lhe­te. Jun­to do pa­no com o nó car­me­sim. Jun­to da lis­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pa­pel mo­lha­do não pro­va na­da — dis­se, pa­ra nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz saiu fir­me. A mão, não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Aci­ma de­le, mui­to aci­ma, atra­vés da água e da pe­dra e das pa­re­des da ca­te­dral, al­gu­ma coi­sa gran­de acor­dou. Ele sen­tiu. Sen­tiu co­mo se sen­te um tro­vão an­tes de ou­vi-lo. Sen­tiu no chão, na água, nas cos­te­las."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Al­gu­ma coi­sa no san­tuá­rio da ca­te­dral ti­nha aca­ba­do de per­ce­ber que ele es­ta­va ali."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E es­ta­va es­pe­ran­do."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="33285.5118110237" OwnPage="96" ItemID="959353337" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="33285.5118110237" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="959325641" BACKITEM="951505353"/>
