        <PAGEOBJECT XPOS="151.023622047244" YPOS="26365.8267716536" OwnPage="75" ItemID="924181961" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="26365.8267716536" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="927250537" BACKITEM="924373801"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="26365.8267716536" OwnPage="76" ItemID="927250537" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="26365.8267716536" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="927159593" BACKITEM="924181961"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="27057.7952755906" OwnPage="77" ItemID="927159593" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="27057.7952755906" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="927189545" BACKITEM="927250537"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="27057.7952755906" OwnPage="78" ItemID="927189545" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="27057.7952755906" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="927159593"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="27834.8031496063" OwnPage="79" ItemID="884811385" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="27834.8031496063" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="936736025" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 10"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="A man­ta"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="I"/>
                <ITEXT CPARENT="c_it" CH="n­ter­lú­dio em Pe­dra­ve­lha"/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Des­sa vez tam­bém não ti­nha pla­ne­ja­do vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era o que di­zia a si mes­mo en­quan­to atra­ves­sa­va o ce­mi­té­rio de no­vo, en­quan­to cru­za­va a pas­sa­gem da ser­ra que ago­ra fi­ca­va aber­ta, en­quan­to des­cia a tri­lha de pe­dra com as mãos no­vas, as mãos que agar­ra­vam pe­dra, en­fi­a­das nos bol­sos. Ti­nha vol­ta­do por­que ha­via uma joia no bol­so de­le e um ho­mem de cha­péu es­pe­ran­do por ela. Por­que pre­ci­sa­va de su­pri­men­tos. Por­que as lu­vas no­vas ti­nham sa­í­do cha­mus­ca­das do Co­vil. Por­que o ca­mi­nho pa­ra a ca­te­dral pas­sa­va, de um jei­to ou de ou­tro, per­to da vi­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ti­nha vol­ta­do por ne­nhum ou­tro mo­ti­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A so­bran­ce­lha de­le co­çou. Ele não co­çou de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Pe­dra­ve­lha o re­ce­beu do jei­to de sem­pre: qui­e­ta, des­con­fi­a­da, com som­bras se afas­tan­do das ja­ne­las. Mas ha­via uma di­fe­ren­ça, pe­que­na, que ele no­tou an­tes de sa­ber que es­ta­va no­tan­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O ra­paz da ser­ra es­ta­va sen­ta­do na so­lei­ra da ca­sa da mu­lher do pão, des­cas­can­do ba­ta­tas. Ti­nha um olho ain­da ro­xo e as mãos de­sa­jei­ta­das de quem nun­ca des­cas­cou ba­ta­ta na vi­da. Quan­do viu Noct pas­sar, le­van­tou a ca­be­ça, abriu a bo­ca, e fe­chou de no­vo, por­que Noct ti­nha ba­lan­ça­do a ca­be­ça uma vez, de le­ve, no ges­to uni­ver­sal de "/>
                <ITEXT CPARENT="c_it" CH="não pre­ci­sa"/>
                <ITEXT CH="."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ra­paz vol­tou pa­ra as ba­ta­tas. Noct con­ti­nuou an­dan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Su­biu pri­mei­ro até a pla­ta­for­ma do Fo­ras­tei­ro, pe­los te­lha­dos, ago­ra com o car­me­sim nas pon­tas dos de­dos. Dei­xou a co­lei­ra em ci­ma da cai­xa, ao la­do da ma­çã do dia. O Fo­ras­tei­ro gi­rou a joia con­tra a luz por mui­to tem­po, co­mo quem con­fe­re se uma coi­sa ain­da é a mes­ma de­pois de mui­tos anos, guar­dou no ca­sa­co e pa­gou sem con­tar as mo­e­das."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­tou in­tei­ro — dis­se. — Qua­se nin­guém vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não per­gun­tou pa­ra que ele que­ria aqui­lo. Des­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E per­to do po­ço, en­cos­ta­da na bei­ra do ban­co, es­ta­va Tes­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela es­ta­va di­fe­ren­te. Não no ros­to, nem na rou­pa. Di­fe­ren­te do jei­to que as pes­so­as fi­cam quan­do dor­mem em lu­gar se­gu­ro por al­gu­mas noi­tes se­gui­das: os om­bros mais bai­xos, a res­pi­ra­ção mais fun­da. Os pul­sos ain­da ti­nham as mar­cas ver­me­lhas das cor­das, des­bo­tan­do pa­ra um ro­xo ama­re­la­do. Ela es­ta­va com os bra­ços cru­za­dos, abra­çan­do o pró­prio cor­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra ele. Uma ex­pres­são atra­ves­sou o ros­to de­la, rápi­da de­mais pa­ra que ele con­se­guis­se no­me­ar, e de­pois su­miu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Achei que vo­cê não ia vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pas­sei por aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela er­gueu uma so­bran­ce­lha. Era evi­den­te que nin­guém "/>
                <ITEXT CPARENT="c_it" CH="pas­sa­va"/>
                <ITEXT CH=" por Pe­dra­ve­lha. Pe­dra­ve­lha não fi­ca­va no ca­mi­nho de lu­gar ne­nhum. Pe­dra­ve­lha era o lu­gar on­de os ca­mi­nhos de­sis­ti­am."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas ela não dis­se is­so. Es­fre­gou os bra­ços e olhou pa­ra o céu, que es­ta­va fi­can­do es­cu­ro e azul e frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Faz frio nes­sa vi­la à noi­te. Nin­guém avi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra ela de la­do. Pa­ra os bra­ços cru­za­dos. Pa­ra a rou­pa fi­na de quem saiu de ca­sa sem sa­ber que não ia vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E foi só is­so que dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ain­da ha­via luz quan­do ele en­trou na tor­re."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Con­ti­nu­a­va sem es­ca­da. As mes­mas vi­gas, as mes­mas sa­liên­cias, a mes­ma pa­re­de li­sa a par­tir da ter­cei­ra, po­li­da pe­la chu­va que en­tra­va pe­lo bu­ra­co do si­no. Da ou­tra vez, a pa­re­de ti­nha ven­ci­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fle­xi­o­nou os de­dos. O car­me­sim acen­deu nas pon­tas das lu­vas em ris­cos fi­nos e cur­vos e en­trou na pe­dra li­sa co­mo em ma­dei­ra ma­cia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Su­biu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A meio ca­mi­nho, nu­ma sa­liên­cia lar­ga o bas­tan­te pa­ra des­can­sar, en­con­trou os ris­cos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­vam na pe­dra da pa­re­de, na al­tu­ra dos olhos de­le: mar­cas de al­tu­ra, do ti­po que pais fa­zem em ba­ten­tes de por­ta pa­ra ver os fi­lhos cres­ce­rem. Só que não eram de cri­an­ça, ou não só. Eram du­as co­lu­nas. Ao la­do de ca­da uma, um no­me, ras­pa­do com tan­to cui­da­do que só so­bra­va a ci­ca­triz das le­tras."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um dos ris­cos fi­ca­va bem mais bai­xo que o ou­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do di­an­te de­les por mui­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via ne­nhu­ma ra­zão pa­ra aqui­lo sig­ni­fi­car al­gu­ma coi­sa. Uma tor­re ve­lha, nu­ma vi­la ve­lha, on­de ge­ra­ções de pes­so­as ti­nham su­bi­do e me­di­do e ido em­bo­ra. Du­as pes­so­as, uma mais al­ta, uma mais bai­xa. Mi­lha­res de pes­so­as no mun­do eram exa­ta­men­te as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só que ele lem­bra­va de uma tar­de de fei­ra. De uma es­ca­da que ain­da ti­nha de­graus. De uma voz di­zen­do "/>
                <ITEXT CPARENT="c_it" CH="fi­ca qui­e­to, dei­xa eu me­dir"/>
                <ITEXT CH=", e de um ca­ni­ve­te que não era de­le ris­can­do a pe­dra na al­tu­ra da ca­be­ça de­le, e de­pois, bem mais em­bai­xo, na al­tu­ra da de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Pra gen­te lem­brar que es­te­ve aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os de­dos de­le en­con­tra­ram a fi­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm — dis­se, e su­biu mais rápi­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Lá no al­to, o si­no es­ta­va ra­cha­do de ci­ma a bai­xo, co­mo se al­guém o ti­ves­se to­ca­do for­te de­mais uma úni­ca vez."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Atrás de­le, nu­ma fres­ta en­tre a pe­dra e a ma­dei­ra, ha­via um em­bru­lho. Um pa­no do­bra­do, com mo­e­das den­tro. Não mui­tas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pa­no es­ta­va amar­ra­do com um nó car­me­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Igual ao da fi­ta. O mes­mo nó, um pou­co tor­to, do la­do es­quer­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não dis­se na­da. Con­tou as mo­e­das. Da­vam uma pas­sa­gem de trem, nem uma a mais. Era o di­nhei­ro que ela guar­da­va. Fi­cou com o pa­no na mão, sen­tin­do o pe­so das mo­e­das, olhan­do pa­ra o nó co­mo um ho­mem olha pa­ra uma pa­la­vra nu­ma lín­gua que ele qua­se fa­la. Quan­do fi­nal­men­te guar­dou as mo­e­das no bol­so, guar­dou o pa­no tam­bém. Do­bra­do em qua­tro. No bol­so de den­tro. Jun­to do bi­lhe­te e da lis­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ao la­do do si­no ha­via uma lu­ne­ta de la­tão, ver­de de tem­po, apon­ta­da pa­ra fo­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele olhou por ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pe­dra­ve­lha in­tei­ra ca­bia ali den­tro: a pra­ça, o po­ço, o ban­co. A ser­ra de pe­dra cin­zen­ta. O bos­que, es­cu­ro e den­so. Mais lon­ge, o bri­lho ole­o­so do pân­ta­no. Além de­le, cru­zes, lápi­des, ár­vo­res sem fo­lhas. E, além de tu­do, aque­le ver­me­lho sem no­me no ho­ri­zon­te, res­pi­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Da­li de ci­ma, as pes­so­as na pra­ça eram pon­tos. A mu­lher do pão, Brom, Lí­via. Ze­no, sen­ta­do num de­grau, o ca­ja­do atra­ves­sa­do nos jo­e­lhos. E, per­to do po­ço, uma fi­gu­ra pe­que­na de bra­ços cru­za­dos, olhan­do pa­ra a es­tra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Da­qui nin­guém pa­re­ce ter me­do — dis­se Noct."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ven­to pas­sou pe­lo si­no ra­cha­do e ti­rou de­le um som que não era bem um som. Uma no­ta que­bra­da, bai­xa, que du­rou mais do que de­ve­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct afas­tou o olho da lu­ne­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Da­qui nin­guém pa­re­ce na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Tes­sa dor­mia num quar­ti­nho nos fun­dos da ca­sa de Ze­no, des­co­briu ele na­que­la tar­de, por uma fra­se sol­ta do ve­lho. Não ti­nha ca­ma. Ti­nha um mon­te de pa­lha e um co­ber­tor que já ti­nha si­do gros­so nu­ma dé­ca­da an­te­ri­or."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct pas­sou a noi­te no ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­tou nu­ma pon­ta. O ou­tro la­do fi­cou va­zio. Os de­dos en­con­tra­ram a fi­ta. A pra­ça fi­cou qui­e­ta, o lam­pi­ão ran­geu, o ven­to pas­sou e foi em­bo­ra, e ele fi­cou ali sen­ta­do tem­po de­mais pa­ra al­guém que di­zia só pre­ci­sar de cin­co mi­nu­tos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não pen­sou em Tes­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou que a noi­te es­ta­va fria. Pen­sou que a man­ta de vi­a­gem de­le era gros­sa, de lã es­cu­ra, do­bra­da em ro­lo nas cos­tas, e que ele não sen­tia frio fa­zia anos, não do jei­to que as ou­tras pes­so­as sen­ti­am. A bra­sa no pei­to de­le cui­da­va dis­so. Era uma das pou­cas coi­sas úteis que ela fa­zia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou que não pre­ci­sa­va da man­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou nis­so de um jei­to mui­to práti­co, mui­to ra­ci­o­nal, sem ne­nhu­ma emo­ção en­vol­vi­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="An­tes de ama­nhe­cer, ele se le­van­tou. De­sa­mar­rou a man­ta. Do­brou em qua­tro, com cui­da­do, do jei­to que ele do­bra­va as coi­sas que im­por­ta­vam, e foi até os fun­dos da ca­sa de Ze­no. A ja­ne­li­nha do quar­to es­ta­va aber­ta uma fres­ta. Lá den­tro, Tes­sa dor­mia en­co­lhi­da na pa­lha, o co­ber­tor fi­no pu­xa­do até o quei­xo, tre­men­do um pou­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele dei­xou a man­ta do­bra­da no pa­ra­pei­to, on­de ela ia ver quan­do acor­das­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não dei­xou bi­lhe­te. Não ha­via na­da pa­ra es­cre­ver."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Atrás do po­ço, no es­cu­ro, uma ra­po­sa o olhou pas­sar. Quan­do ele olhou di­rei­to, não ha­via na­da ali. Vol­tou pa­ra o ban­co sem na­da nas cos­tas, sen­tou na mes­ma pon­ta e fi­cou es­pe­ran­do o sol, com os bra­ços cru­za­dos no ar frio da ma­nhã, sen­tin­do um frio que a bra­sa não con­se­guia al­can­çar di­rei­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm — dis­se, pa­ra nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va can­sa­do. Era só is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Tes­sa o en­con­trou no meio da ma­nhã, per­to da for­ja de Brom, on­de ele ti­nha dei­xa­do as lu­vas cha­mus­ca­das as­sim que a for­ja abriu."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Es­ta­va en­ro­la­da na man­ta. A man­ta fi­ca­va enor­me ne­la: co­bria os om­bros, os bra­ços, as mãos, e a pon­ta ar­ras­ta­va qua­se no chão. Ela pa­re­cia uma cri­an­ça brin­can­do de se es­con­der de­bai­xo do co­ber­tor de um adul­to, ou um pas­sa­ri­nho que ti­nha de­ci­di­do mo­rar den­tro de um ni­nho de lã."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­rou na fren­te de­le. Le­van­tou um pou­co a pon­ta da man­ta, mos­tran­do o ta­ma­nho de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— É sua?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra a man­ta. Pa­ra a lã gas­ta, mar­ca­da por anos de es­tra­da, pa­ra a pon­ta cha­mus­ca­da que o Ga­to In­fer­nal ti­nha quei­ma­do. Olhou por um tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Era."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa fi­cou qui­e­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela en­ten­deu. Ele viu que ela en­ten­deu. En­ten­deu que ele não ia ad­mi­tir na­da, que não ia di­zer que ti­nha vis­to o frio de­la, que não ia ex­pli­car por que um ho­mem co­mo ele ti­nha pas­sa­do a noi­te sem a man­ta. En­ten­deu que a úni­ca ma­nei­ra de acei­tar aque­le pre­sen­te era acei­tar tam­bém a men­ti­ra que vi­nha em­bru­lha­da ne­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela acei­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Obri­ga­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê já dis­se is­so uma vez. — Ele vi­rou o ros­to pa­ra a for­ja, on­de Brom ba­tia fer­ro e fin­gia não es­tar ou­vin­do. — Che­ga."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa sor­riu. Não com a bo­ca to­da, só com um can­to, e ele não sou­be di­zer se ela ti­nha apren­di­do aqui­lo com ele ou se as pes­so­as sim­ples­men­te sor­ri­am as­sim quan­do es­ta­vam ten­tan­do não sor­rir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela fi­cou ali mais um tem­po, en­ro­la­da na man­ta de­le, olhan­do Brom tra­ba­lhar. Noct fi­cou tam­bém. Não ti­nha mo­ti­vo pa­ra fi­car. Brom ain­da ia de­mo­rar com as lu­vas, e ele po­dia es­pe­rar em qual­quer lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou mes­mo as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Quan­do as lu­vas fi­ca­ram pron­tas, re­for­ça­das de no­vo, ele as cal­çou e fe­chou os pu­nhos e sen­tiu a fa­gu­lha car­me­sim es­ta­lar en­tre os nós dos de­dos, obe­di­en­te."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Tes­sa ain­da es­ta­va lá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê vai pra ca­te­dral — dis­se ela. Não era bem uma per­gun­ta. — Não vai?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra les­te. Além do ce­mi­té­rio, além do Co­vil, ha­via uma ca­te­dral. Ele nun­ca a ti­nha vis­to, mas sa­bia que es­ta­va lá, do mes­mo jei­to que se sa­be on­de fi­ca um den­te do­en­do. Era de lá que vi­nha a or­dem es­cri­ta na lis­ta do bol­so de­le. "/>
                <ITEXT CPARENT="c_it" CH="En­tre­gar os que ou­vi­rem a fen­da ao Cus­tó­dio da ca­te­dral."/>
                <ITEXT CH=" Era de lá que vi­nha, ca­da vez mais for­te, o zum­bi­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E, mais per­to que o zum­bi­do, a ou­tra coi­sa. A lis­ta no bol­so, li­nha por li­nha, on­de o no­me de­la não es­ta­va. A pe­dra da ser­ra, com a le­tra de­la, es­cri­ta nas ma­dru­ga­das em que ele dor­mia. Uma mu­lher que ou­via a fen­da an­tes de to­do mun­do, nu­ma ter­ra on­de um ho­mem de ca­te­dral pa­ga­va por quem ou­vis­se. Ele ti­nha pro­cu­ra­do o no­me de­la du­as ve­zes e não ti­nha acha­do. Is­so não que­ria di­zer na­da. Lis­tas se per­dem. No­mes se ris­cam."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Se ele en­cos­tou ne­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa su­biu quen­te até a gar­gan­ta. Noct fe­chou os pu­nhos den­tro das lu­vas e es­pe­rou que ela des­ces­se, con­tan­do até qua­tro, co­mo Lí­via ti­nha en­si­na­do. Des­ceu. Não to­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Da ou­tra vez vo­cê não pro­me­teu e vol­tou. — Ela pu­xou a man­ta mais pa­ra ci­ma. — E des­sa vez? Vol­ta?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="A per­gun­ta veio sim­ples, di­re­ta, sem ne­nhum en­fei­te, e por is­so mes­mo atra­ves­sou a ar­ma­du­ra de­le co­mo uma agu­lha atra­ves­sa um te­ci­do."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="E vol­ta?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Da ou­tra vez ele não ti­nha pro­me­ti­do na­da, e mes­mo as­sim ti­nha vol­ta­do. Era is­so que o as­sus­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não olhou pa­ra ela. Olhou de la­do, pa­ra a for­ja, pa­ra o fo­go, pa­ra qual­quer coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ho­je pri­mei­ro — dis­se. — Ama­nhã de­pois."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa cru­zou os bra­ços de­bai­xo da man­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Is­so não é uma res­pos­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sen­tiu o can­to da bo­ca se me­xer. Dei­xou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Per­cep­ti­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E foi em­bo­ra an­tes que ela pu­des­se di­zer mais al­gu­ma coi­sa, an­tes que ele pu­des­se ou­vir mais al­gu­ma coi­sa, an­tes que aque­la per­gun­ta sim­ples, "/>
                <ITEXT CPARENT="c_it" CH="e vol­ta?"/>
                <ITEXT CH=", pu­des­se se ins­ta­lar em al­gum lu­gar den­tro de­le e co­me­çar a cri­ar ra­í­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tar­de de­mais. Já ti­nha cri­a­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sen­tiu as ra­í­zes o ca­mi­nho in­tei­ro até o fim da vi­la. Sen­tiu quan­do pas­sou pe­lo ban­co, e quan­do pas­sou pe­lo po­ço, e quan­do che­gou na úl­ti­ma ca­sa e olhou pa­ra trás, só uma vez, só de la­do, e viu uma fi­gu­ra pe­que­na en­ro­la­da nu­ma man­ta es­cu­ra gran­de de­mais, pa­ra­da na pra­ça, olhan­do pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não ace­nou. Ela tam­bém não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas ela fi­cou ali até ele su­mir na es­tra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ele sa­bia, por­que olhou pa­ra trás mais uma vez quan­do achou que ela não ia ver."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Is­so é um pro­ble­ma"/>
                <ITEXT CH=", pen­sou Noct, des­cen­do a tri­lha sem a man­ta, com o ven­to frio nos bra­ços e uma coi­sa mor­na, pe­ri­go­sa, no pei­to, que não era a bra­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Is­so é exa­ta­men­te o ti­po de pro­ble­ma que eu não pos­so ter."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Fim da Par­te III."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
