        <PAGEOBJECT XPOS="621.574803149606" YPOS="43665.0393700788" OwnPage="126" ItemID="999797705" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="43665.0393700788" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="999358537" BACKITEM="999824505"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="44357.0078740158" OwnPage="127" ItemID="999358537" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="44357.0078740158" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="999727145" BACKITEM="999797705"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="44357.0078740158" OwnPage="128" ItemID="999727145" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="44357.0078740158" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1002579881" BACKITEM="999358537"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="45048.9763779528" OwnPage="129" ItemID="1002579881" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="45048.9763779528" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1002228665" BACKITEM="999727145"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="45048.9763779528" OwnPage="130" ItemID="1002228665" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="45048.9763779528" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1002242057" BACKITEM="1002579881"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="45740.9448818898" OwnPage="131" ItemID="1002242057" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="45740.9448818898" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1002228665"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="45825.9842519685" OwnPage="132" ItemID="1004369657" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="45825.9842519685" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1007794793" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 16"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Pa­ra quem nin­guém lem­bra"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="D"/>
                <ITEXT CH="e­pois que a Tes­sa su­miu en­tre as ár­vo­res, Noct se­guiu a mar­gem até on­de ela ter­mi­na­va."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ter­mi­na­va nu­ma es­ca­da. De­graus de pe­dra, gas­tos no meio, que des­ci­am di­re­to pa­ra den­tro da água. E a água, em vez de en­go­lir a es­ca­da, se abria em vol­ta de­la co­mo uma cor­ti­na: du­as pa­re­des li­sas e pa­ra­das, e en­tre elas um cor­re­dor que des­cia, des­cia, até uma luz azul que vi­nha de lu­gar ne­nhum."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se in­cli­nou na bei­ra e olhou pa­ra bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pri­mei­ro viu um te­lha­do. Pon­tu­do, de ar­dó­sia es­cu­ra, com uma cruz tor­ta no al­to. De­pois uma tor­re pe­que­na, sem si­no. De­pois vi­trais apa­ga­dos, pa­re­des de pe­dra cin­zen­ta sem uma go­ta de água ne­las, e uma por­ta de ma­dei­ra, aber­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma ca­pe­la. Se­ca, in­tac­ta, no fun­do de um la­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele cal­çou as lu­vas que a Tes­sa ti­nha tra­zi­do. Ser­vi­ram co­mo se al­guém ti­ves­se me­di­do as mãos de­le de olho. Fle­xi­o­nou os de­dos uma vez, sen­tiu a cos­tu­ra fir­me so­bre os nós, e des­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As pa­re­des de água dos dois la­dos não se me­xi­am. Pei­xes páli­dos pas­sa­vam do ou­tro la­do de­las, de­va­gar, olhan­do pa­ra ele com olhos sem cor."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A por­ta da ca­pe­la es­ta­va aber­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele en­trou e olhou pa­ra ci­ma. O te­to era al­to, em ar­co, e atra­vés dos vi­trais não se via céu. Via-se a su­per­fície do la­go, lá no al­to, co­mo um céu de pra­ta pa­ra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ca­pe­la — dis­se. — No fun­do de um la­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou em vol­ta, pa­ra os ban­cos va­zi­os, pa­ra o al­tar no fun­do, pa­ra a luz azul fria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Al­guém re­zou mui­to er­ra­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Os san­tos es­ta­vam nas pa­re­des, ca­da um num ni­cho de pe­dra, ca­da um com as mãos na po­si­ção de sem­pre: aben­ço­an­do, re­zan­do, apon­tan­do pa­ra ci­ma. Eram es­tá­tu­as bo­ni­tas, bem es­cul­pi­das, de mãos de­li­ca­das e rou­pas com do­bras tão per­fei­tas que pa­re­ci­am te­ci­do de ver­da­de."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ne­nhum ti­nha ros­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ti­nham si­do que­bra­dos. Noct che­gou per­to de um e olhou. Os ros­tos ti­nham si­do ras­pa­dos, com uma fer­ra­men­ta fi­na, com pa­ciên­cia, ca­ma­da por ca­ma­da, até a pe­dra fi­car li­sa on­de an­tes ha­via olhos e bo­ca e na­riz. O tra­ba­lho era de­li­ca­do. Não ha­via uma las­ca fo­ra do lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele pas­sou o po­le­gar pe­la pe­dra li­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não foi rai­va — dis­se, des­con­fi­a­do. — Foi ca­pri­cho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Al­guém ti­nha fei­to aqui­lo com cui­da­do. Com amor, qua­se. Co­mo se apa­gar os ros­tos fos­se uma for­ma de pro­te­gê-los. Co­mo se fos­se me­lhor um san­to sem ros­to do que um san­to que al­guém pu­des­se re­co­nhe­cer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pen­sou num ros­to que ele nun­ca ti­nha mos­tra­do pa­ra nin­guém. Que guar­da­va só pa­ra ele, co­mo a pa­la­vra ra­po­si­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­rou a mão da es­tá­tua."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O al­tar es­ta­va par­ti­do ao meio."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Uma ra­cha­du­ra lim­pa, de ci­ma a bai­xo, co­mo se al­guém ti­ves­se da­do um úni­co gol­pe com uma for­ça im­pos­sí­vel. As du­as me­ta­des ti­nham se afas­ta­do um pal­mo uma da ou­tra, e no meio de­las não ha­via na­da, só o chão de pe­dra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No vão en­tre as du­as me­ta­des, o chão pul­sa­va. De­va­gar. A bra­sa ne­le res­pon­deu, e por um ins­tan­te as ve­las apa­ga­das pa­re­ce­ram mais es­cu­ras."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em vol­ta do al­tar, em fi­lei­ras, ha­via ve­las. De­ze­nas de­las. Cen­te­nas. To­das apa­ga­das, os pa­vi­os pre­tos e fri­os, a ce­ra en­du­re­ci­da em es­cor­ri­dos an­ti­gos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="To­das me­nos uma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va no al­to, nu­ma pra­te­lei­ra de pe­dra aci­ma do al­tar, on­de só se che­ga­va es­ca­lan­do. Noct es­ca­lou. O car­me­sim acen­deu na pon­ta dos de­dos, en­trou na pe­dra da pa­re­de e o se­gu­rou, e ele su­biu até fi­car de fren­te pa­ra a ve­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va ace­sa. A cha­ma pe­que­na, fir­me, sem tre­mer, em­bo­ra não hou­ves­se ven­to pa­ra fa­zê-la tre­mer. A ce­ra ain­da es­cor­ria, fres­ca, mor­na. Al­guém a ti­nha acen­di­do há pou­co tem­po. Ou a ve­la ti­nha de­ci­di­do, so­zi­nha, con­ti­nu­ar ace­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va so­zi­nha lá em ci­ma, lon­ge das ou­tras. Co­mo se aque­le sem­pre ti­ves­se si­do o lu­gar de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em­bai­xo de­la, ris­ca­do na pe­dra com uma le­tra pe­que­na e cui­da­do­sa, ha­via uma fra­se."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Pa­ra quem nin­guém lem­bra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pen­du­ra­do na pa­re­de, olhan­do pa­ra a ve­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não dis­se na­da. Por mui­to tem­po, não dis­se na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou no véu bran­co na mar­gem, úmi­do, sem na­da bor­da­do. Pen­sou nu­ma lem­bran­ça que ele não ti­nha, uma que es­ta­va fal­tan­do, cu­jo lu­gar ele sen­tia co­mo se sen­te o lu­gar de um den­te que caiu. Pen­sou que tal­vez hou­ves­se coi­sas que nem ele lem­bra­va. Que tal­vez hou­ves­se, em al­gum lu­gar de­le, uma noi­te in­tei­ra que ti­nha si­do apa­ga­da com cui­da­do, com ca­pri­cho, co­mo os ros­tos dos san­tos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E pen­sou que al­guém, ou al­gu­ma coi­sa, man­ti­nha uma ve­la ace­sa por aque­la noi­te."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela te­ria acen­di­do as ou­tras"/>
                <ITEXT CH=", pen­sou. "/>
                <ITEXT CPARENT="c_it" CH="To­das. Só pra ne­nhu­ma fi­car so­zi­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra a cha­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Des­ceu da pa­re­de. Não apa­gou a ve­la. Não to­cou ne­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No can­to mais es­cu­ro da ca­pe­la, ha­via um con­fes­si­o­ná­rio."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ma­dei­ra es­cu­ra, ve­lha, com uma cor­ti­na pu­í­da na en­tra­da. Na la­te­ral, en­ta­lha­da na ma­dei­ra, ha­via uma ins­cri­ção, mas o tem­po e a umi­da­de ti­nham gas­to as le­tras até vi­ra­rem só sul­cos, som­bras de pa­la­vras. Noct pas­sou os de­dos por elas, ten­tan­do ler pe­lo to­que."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não con­se­guiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era uma fra­se cur­ta. Três ou qua­tro pa­la­vras, tal­vez. Ele sen­tiu o for­ma­to de­las sob os de­dos e te­ve a im­pres­são, ab­sur­da, de que se as les­se ia en­ten­der al­gu­ma coi­sa im­por­tan­te. Que a fra­se ti­nha si­do es­cri­ta pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As le­tras não dei­xa­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ain­da não"/>
                <ITEXT CH=", pa­re­cia di­zer a ma­dei­ra. Co­mo a pa­re­de ver­me­lha no fun­do do po­ço ti­nha di­to, an­tes do san­tuá­rio. Só que a pa­re­de, no fim, ti­nha dei­xa­do ele pas­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct dei­xou a mão cair."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Saiu da ca­pe­la pe­la por­ta do fun­do, que da­va pa­ra uma es­ca­da que su­bia de vol­ta pa­ra fo­ra da água. An­tes de sair, olhou pa­ra trás uma vez. Pa­ra os ban­cos va­zi­os. Pa­ra os san­tos sem ros­to. Pa­ra a úni­ca ve­la ace­sa, lá no al­to, quei­man­do so­zi­nha pa­ra al­guém de quem nin­guém lem­bra­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A cha­ma não tre­meu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele tam­bém não. Por fo­ra."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
