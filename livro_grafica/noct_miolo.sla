        <PAGEOBJECT XPOS="151.023622047244" YPOS="42281.1023622048" OwnPage="121" ItemID="988061289" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="42281.1023622048" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="988478425"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="42385.9842519685" OwnPage="122" ItemID="990232585" PTYPE="4" WIDTH="334.488188976378" HEIGHT="226.771653543307" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" copath="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" gXpos="621.574803149606" gYpos="42385.9842519685" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Parte V"/>
                <para PARENT="parte_num"/>
                <ITEXT CH="As Águas Veladas"/>
                <para PARENT="parte"/>
                <ITEXT CH="Existe um lugar onde vão parar as coisas que escolhemos esquecer. Não é um lugar triste. É um lugar paciente. Tudo o que está lá ainda espera ser lembrado, e nenhuma delas tem pressa."/>
                <trail PARENT="parte_epi"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="771.811023622047" YPOS="42641.1023622048" OwnPage="122" ItemID="990935577" PTYPE="2" WIDTH="34.0157480314961" HEIGHT="34.0157480314961" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.0354330708661417" LOCALSCY="0.0354330708661417" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="emblema_cinza.png" IRENDER="0" EMBEDDED="0" path="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" copath="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" gXpos="771.811023622047" gYpos="42641.1023622048" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="43058.1102362205" OwnPage="124" ItemID="988057113" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="43058.1102362205" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="999824505" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 15"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="O re­fle­xo atra­sa­do"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" ra­cha­du­ra sob o al­tar des­cia por mui­to tem­po."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct des­ceu com ela. Pri­mei­ro por pe­dra quen­te, de­pois por pe­dra mor­na, de­pois por pe­dra fria e úmi­da, até que a luz ver­me­lha das bor­das foi fi­can­do mais fra­ca e o ar co­me­çou a chei­rar a fo­lha mo­lha­da. Quan­do os pés de­le fi­nal­men­te to­ca­ram chão fir­me, não ha­via mais ca­te­dral em ci­ma de­le. Ha­via céu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um céu bran­co, sem sol, sem nu­vem, sem ho­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E em­bai­xo de­le, um la­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não se via a ou­tra mar­gem. A água se es­ten­dia até su­mir nu­ma né­voa páli­da, per­fei­ta­men­te li­sa, sem uma on­da, sem uma ru­ga, co­mo um es­pe­lho que al­guém ti­ves­se es­que­ci­do no chão. À bei­ra de­la, ár­vo­res se­cas, de ga­lhos fi­nos e bran­cos, sem ne­nhu­ma fo­lha. As fo­lhas es­ta­vam to­das no chão, e na água, boi­an­do. Pa­ra­das. Ne­nhu­ma se me­xia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou na mar­gem e olhou pa­ra a água."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Água pa­ra­da — dis­se. — De no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra o pró­prio re­fle­xo. Lá es­ta­va ele, sem a man­ta, can­sa­do, a bar­ba de di­as por fa­zer, o san­gue nas lu­vas se­co até vi­rar pó, a fi­ta no pul­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Vi­rou a ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O re­fle­xo vi­rou a ca­be­ça tam­bém. Meio se­gun­do de­pois."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou mui­to pa­ra­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Le­van­tou a mão. Es­pe­rou. O re­fle­xo le­van­tou a mão. De­pois."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...O meu re­fle­xo es­tá atra­sa­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A água não ex­pli­cou. A água, ali, não ex­pli­ca­va na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Cha­ma­va-se Mar­gem das Fo­lhas Pa­ra­das. Ele sou­be o no­me sem que nin­guém dis­ses­se, do jei­to que se sa­be o no­me das coi­sas nos so­nhos."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="An­dou por ela de­va­gar, com as fo­lhas mor­tas es­ta­lan­do sob as bo­tas. Era o úni­co som. Não ha­via ven­to. Não ha­via pás­sa­ros. A pró­pria res­pi­ra­ção de­le pa­re­cia al­ta de­mais, qua­se in­de­cen­te, co­mo al­guém tos­sin­do num ve­ló­rio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ali não ha­via dia. O céu bran­co não es­cu­re­cia nun­ca, e o tem­po só pas­sa­va no cor­po. Ele an­dou até as per­nas pe­di­rem pa­ra pa­rar, dor­miu en­cos­ta­do nu­ma ár­vo­re se­ca, acor­dou com fo­lhas mor­tas gru­da­das no ros­to e o pes­co­ço du­ro, e an­dou de no­vo. Foi um dia, pe­lo me­nos. Tal­vez mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E quan­to mais ele an­da­va, mais for­te fi­ca­va o car­me­sim. A bra­sa não dor­mia mais. Fi­ca­va ace­sa atrás das cos­te­las, quen­te, sem que ele cha­mas­se, e às ve­zes des­cia so­zi­nha até os nós dos de­dos e acen­dia as fa­gu­lhas no cou­ro das lu­vas. Por bai­xo da água pa­ra­da, mui­to fun­do, al­gu­ma coi­sa pul­sa­va. De­va­gar. No mes­mo rit­mo da coi­sa que res­pi­ra­va em­bai­xo do al­tar, só que mais per­to ago­ra. Mais for­te. Ca­da vez que pul­sa­va, a bra­sa ne­le res­pon­dia, co­mo um eco res­pon­den­do a quem cha­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nos ga­lhos se­cos, pre­sos co­mo rou­pas num va­ral, ha­via véus."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Véus de fu­ne­ral, fi­nos, bran­cos, cin­zen­tos, al­guns qua­se trans­pa­ren­tes. Pen­di­am sem ba­lan­çar. E em ca­da um, bor­da­do com li­nha es­cu­ra, ha­via um no­me. Não de gen­te. De coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="O chei­ro do ca­fé."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="A músi­ca da fes­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="O no­me da rua."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pas­sou os de­dos por um de­les, sem que­rer. O te­ci­do era frio e úmi­do, e quan­do ele to­cou, sen­tiu, por meio se­gun­do, um chei­ro que não es­ta­va no ar. Ca­fé. Fres­co, for­te, de al­gum lu­gar que ele não co­nhe­cia, de al­gu­ma ma­nhã que não era de­le. E de­pois o chei­ro su­miu, e ele fi­cou com a sen­sa­ção de ter es­que­ci­do al­gu­ma coi­sa sem sa­ber o quê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­rou a mão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Coi­sas que al­guém es­que­ceu — dis­se bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Num ga­lho mais al­to, so­zi­nho, lon­ge dos ou­tros, ha­via um véu di­fe­ren­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ti­nha na­da bor­da­do. Era li­so, bran­co. E es­ta­va úmi­do, mais úmi­do que os ou­tros, co­mo se ti­ves­se si­do pen­du­ra­do ali há pou­co tem­po. Co­mo se al­guém ain­da es­ti­ves­se de­ci­din­do o que bor­dar ne­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou em­bai­xo do ga­lho e olhou pa­ra ci­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não to­cou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou ali o tem­po de uma res­pi­ra­ção in­tei­ra, e de­pois ou­tra, olhan­do pa­ra aque­le véu em bran­co. Sa­bia, de al­gum jei­to, com a par­te mais fun­da de­le, que aque­le véu era de­le. Que ha­via al­gu­ma coi­sa que ele ti­nha es­que­ci­do, e que o lu­gar des­sa coi­sa es­ta­va ali, es­pe­ran­do o no­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não to­cou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Se­guiu em fren­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="As cri­a­tu­ras da­que­le lu­gar não ata­ca­vam co­mo as ou­tras."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A pri­mei­ra que ele en­con­trou es­ta­va en­co­lhi­da en­tre du­as ár­vo­res, uma for­ma páli­da e trans­lúci­da, me­nor que uma cri­an­ça. Quan­do ele che­gou per­to, ela co­me­çou a cho­rar. Não al­to. Um cho­ro bai­xo, con­tí­nuo, de­ses­pe­ra­do, de quem per­deu al­gu­ma coi­sa e não lem­bra mais o que era."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um La­men­to. Era as­sim que eles se cha­ma­vam, ou era as­sim que ele re­sol­veu cha­má-los."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não que­ria ba­ter na­qui­lo. Ba­teu mes­mo as­sim, por­que o cho­ro ti­nha al­gu­ma coi­sa que pu­xa­va, que ge­la­va, que fa­zia os pés de­le fi­ca­rem pe­sa­dos e a von­ta­de de con­ti­nu­ar an­dan­do fi­car pe­que­na. Quan­do o La­men­to se des­fez, o si­lên­cio que fi­cou foi pi­or."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois vi­e­ram ou­tras coi­sas. Bol­sas páli­das pen­du­ra­das nos ga­lhos, chei­as de uma luz rou­ba­da, que su­ga­vam o ca­lor de­le quan­do ele pas­sa­va por bai­xo e o de­vol­vi­am quan­do es­tou­ra­vam. E uma vez, uma vez só, uma coi­sa mui­to pi­or."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele a viu de lon­ge."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma si­lhu­e­ta. De cos­tas pa­ra ele, na bei­ra da água, a uns cin­quen­ta pas­sos. Pe­que­na. Os om­bros de al­guém que ele co­nhe­cia. A ca­be­ça in­cli­na­da de um jei­to que ele co­nhe­cia. Co­mo al­guém que es­cu­ta uma músi­ca vin­do de ou­tro quar­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou de res­pi­rar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não cor­reu. Nun­ca sou­be de on­de ti­rou a for­ça pa­ra não cor­rer. Fi­cou pa­ra­do, olhan­do, en­quan­to tu­do den­tro de­le gri­ta­va, e de­pois, de­va­gar, mui­to de­va­gar, bai­xou os olhos pa­ra a água aos pés da si­lhu­e­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via re­fle­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A água, que re­fle­tia tu­do, que re­fle­tia até ele com meio se­gun­do de atra­so, não re­fle­tia aque­la fi­gu­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sol­tou o ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A si­lhu­e­ta se vi­rou. Não ti­nha ros­to. Ti­nha só a for­ma, a ideia de al­guém, e quan­do per­ce­beu que ele ti­nha vis­to, se lan­çou con­tra ele com a fo­me de quem foi des­co­ber­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct a des­truiu em três gol­pes. Não sen­tiu pra­zer ne­nhum. Não sen­tiu a bra­sa can­tar. Sen­tiu só um can­sa­ço imen­so, e uma rai­va fria, qui­e­ta, con­tra o lu­gar que ti­nha fei­to aqui­lo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois dis­so, ca­da vez que via uma si­lhu­e­ta de cos­tas na mar­gem, ele olha­va pri­mei­ro pa­ra a água."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sem­pre olha­va pa­ra a água."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No fim da mar­gem, on­de as ár­vo­res se­cas ter­mi­na­vam e o chão des­cia até a bei­ra, ele pa­rou pa­ra des­can­sar."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Sen­tou-se nu­ma pe­dra. Olhou pa­ra o la­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O re­fle­xo de­le es­ta­va lá, sen­ta­do na mes­ma pe­dra, meio se­gun­do atra­sa­do. Ele fi­cou olhan­do pa­ra o re­fle­xo, por­que não ti­nha mais na­da pa­ra olhar, e o re­fle­xo fi­cou olhan­do de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão, por um ins­tan­te, só um ins­tan­te, ha­via al­guém sen­ta­do ao la­do do re­fle­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="À es­quer­da de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma for­ma pe­que­na, en­cos­ta­da no om­bro do re­fle­xo. A ca­be­ça in­cli­na­da. Co­mo se es­ti­ves­se com frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não se vi­rou pa­ra olhar pa­ra o la­do es­quer­do da pe­dra. Sa­bia que não ha­via nin­guém ali. Sem­pre sou­be. Era a re­gra mais an­ti­ga de­le: nun­ca olhar pa­ra o la­do va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas na água, o la­do não es­ta­va va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fi­cou olhan­do, sem res­pi­rar, até a ima­gem tre­mer e su­mir, co­mo sem­pre so­mem as coi­sas que a gen­te olha de­mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O re­fle­xo fi­cou so­zi­nho de no­vo. Meio se­gun­do atra­sa­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só is­so. "/>
                <ITEXT CPARENT="c_it" CH="Não."/>
                <ITEXT CH=" Co­mo quem fe­cha uma por­ta com o pé."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas a por­ta não fe­chou di­rei­to. E ele sa­bia. E fi­cou sen­ta­do na pe­dra mui­to tem­po, com os olhos fe­cha­dos, ou­vin­do o si­lên­cio do la­go pa­ra­do, sen­tin­do, no om­bro es­quer­do, um pe­so que não es­ta­va lá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Quan­do abriu os olhos, ha­via al­guém sen­ta­do na mar­gem."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Mais adi­an­te, on­de as ár­vo­res se­cas aca­ba­vam e a água en­cos­ta­va na ter­ra sem fa­zer ba­ru­lho. Uma fi­gu­ra pe­que­na, os pés qua­se na água pa­ra­da, en­ro­la­da nu­ma man­ta es­cu­ra. Tre­men­do. E não era de frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se le­van­tou de­va­gar. O co­ra­ção de­le ba­teu uma vez, for­te, con­tra as cos­te­las."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Olha a água pri­mei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou. Ha­via re­fle­xo. Um re­fle­xo in­tei­ro, sem atra­so ne­nhum, en­ro­la­do nu­ma man­ta, de ca­be­lo es­cu­ro pre­so de qual­quer jei­to, tre­men­do jun­to com ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O alí­vio veio, e lo­go atrás de­le veio a rai­va, e a rai­va che­gou pri­mei­ro na bo­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê de­via es­tar em Pe­dra­ve­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não se vi­rou lo­go. Fi­cou olhan­do pa­ra o la­go, pa­ra a né­voa on­de a água su­mia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O Vi­gia vol­tou. — A voz de­la era bai­xa. — Des­ceu a tri­lha de­va­gar, do jei­to que ele an­da, e pa­rou no meio da pra­ça, e a vi­la in­tei­ra fi­cou olhan­do. Ele me con­tou o que viu. Que vo­cê es­ta­va dei­ta­do no chão. Que qua­se não fa­la­va. — Ela aper­tou a man­ta nos om­bros. — Eu que­ria sa­ber co­mo vo­cê es­ta­va. Só is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Co­mo vo­cê che­gou aqui?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pe­los tri­lhos da ser­ra. Eles des­cem até per­to da­qui. — Ela deu de om­bros den­tro da man­ta. — Eu só fui se­guin­do o que eu ou­via."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct sen­tiu o es­tô­ma­go ge­lar. Ela não sa­bia lu­tar. Ti­nha des­ci­do tu­do aqui­lo so­zi­nha, gui­a­da pe­la mes­ma coi­sa que ele vi­nha so­can­do ha­via di­as, e na­da ti­nha en­cos­ta­do ne­la. Co­mo se a coi­sa não qui­ses­se ma­chu­cá-la. Só qui­ses­se que ela che­gas­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­tão se vi­rou. Os olhos es­ta­vam ver­me­lhos de quem não dor­me. Ti­rou de den­tro da man­ta um em­bru­lho de pa­no e es­ten­deu pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lu­vas. No­vas, de cou­ro es­cu­ro, com pla­cas nos nós dos de­dos e uma cos­tu­ra gros­sa, fir­me, de quem não que­ria que elas abris­sem nun­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O Brom fez. Eu pe­di. — Ela olhou pa­ra as mãos de­le, pa­ra o cou­ro ra­cha­do, pa­ra o san­gue que já ti­nha vi­ra­do pó. — As su­as tão aca­ban­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pe­gou. Fi­cou com elas na mão um tem­po, sem cal­çar, sem di­zer na­da, por­que qual­quer coi­sa que dis­ses­se ia sair er­ra­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E obri­ga­da pe­la man­ta — dis­se ela. — De no­vo. Ela ain­da es­quen­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu não sin­to frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa sor­riu. Não de can­to. Um sor­ri­so in­tei­ro, can­sa­do, o pri­mei­ro des­se ta­ma­nho que ele via ne­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê já dis­se is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois o sor­ri­so foi em­bo­ra, de­va­gar, e ela olhou pa­ra a água de no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ele me cha­mou no ca­mi­nho. — A voz bai­xou mais. — Com a voz da mi­nha mãe."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tá mais al­to ago­ra. Pa­re­ce al­guém cha­man­do do ou­tro la­do de uma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As mes­mas pa­la­vras. Pe­la se­gun­da vez na bo­ca de­la, e pe­la ter­cei­ra na vi­da de­le. E de re­pen­te ele não es­ta­va mais na mar­gem do la­go. Es­ta­va na co­zi­nha pe­que­na, de noi­te, e ela es­ta­va sen­ta­da à me­sa, com uma xí­ca­ra fria en­tre as mãos, di­zen­do aqui­lo bai­xi­nho, olhan­do pa­ra a ja­ne­la es­cu­ra. E ele, do ou­tro la­do da me­sa, can­sa­do, sem pen­sar du­as ve­zes, res­pon­dia: "/>
                <ITEXT CPARENT="c_it" CH="é can­sa­ço. Vo­cê pre­ci­sa dor­mir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A mão de­le su­biu até a so­bran­ce­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­rou no meio do ca­mi­nho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa viu. Ele viu que ela viu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— To­do mun­do diz que é can­sa­ço. Vo­cê tam­bém vai di­zer?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Abriu os olhos. Olhou pa­ra ela de fren­te, sem des­vi­ar pa­ra o la­go, pa­ra as ár­vo­res, pa­ra qual­quer coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu acre­di­to em vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa fi­cou olhan­do pa­ra ele co­mo quem es­pe­ra o res­to da fra­se. A pi­a­da. O "/>
                <ITEXT CPARENT="c_it" CH="mas"/>
                <ITEXT CH=". O sar­cas­mo que sem­pre vi­nha de­pois, pa­ra des­fa­zer o que ele ti­nha aca­ba­do de di­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não veio ne­nhum."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não sa­bia o que fa­zer com aqui­lo. A por­ta con­ti­nu­a­va cha­man­do, e ela con­ti­nu­a­va ou­vin­do, e acre­di­tar não fe­cha­va por­ta ne­nhu­ma. Fe­char ia ser tra­ba­lho de­le. Mas uma vez, nu­ma noi­te que ele não po­dia des­fa­zer, al­guém ti­nha di­to aque­las pa­la­vras pa­ra ele, e ele ti­nha des­vi­a­do os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Des­sa vez, não des­vi­ou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­ta pro ban­co — dis­se. — Es­pe­ra lá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Da úl­ti­ma vez vo­cê não apa­re­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele olhou de la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­to. Não faz na­da idi­o­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa sor­riu de can­to. Se le­van­tou, aper­tou a man­ta nos om­bros e foi em­bo­ra pe­la mar­gem, de­va­gar, olhan­do pa­ra a água an­tes de ca­da pas­so, do jei­to que ele ti­nha apren­di­do a fa­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou olhan­do até ela su­mir en­tre as ár­vo­res se­cas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não sa­bia de on­de ti­nha ti­ra­do aque­la fra­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sa­bia."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
