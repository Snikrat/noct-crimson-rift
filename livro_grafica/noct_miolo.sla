        <PAGEOBJECT XPOS="621.574803149606" YPOS="47209.9212598426" OwnPage="136" ItemID="1009277145" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="47209.9212598426" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1013322201" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 17"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Um pas­sa­gei­ro"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" es­ca­da da ca­pe­la não de­vol­veu Noct à mar­gem. De­vol­veu-o à chu­va."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ele saiu num pe­nhas­co al­to, de pe­dra es­cu­ra, e a chu­va o atin­giu de uma vez, fria, pe­sa­da, cons­tan­te. Não era a chu­va pa­ci­en­te do te­lha­do. Era uma chu­va que não ti­nha co­me­ça­do e não ia ter­mi­nar, que sim­ples­men­te "/>
                <ITEXT CPARENT="c_it" CH="era"/>
                <ITEXT CH=", co­mo o ven­to é nu­ma mon­ta­nha ou o sal é no mar. O céu em ci­ma era cin­za-chum­bo, bai­xo, e des­pe­ja­va água sem pres­sa e sem pau­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou en­char­ca­do em se­gun­dos. Não se im­por­tou. Es­ta­va olhan­do pa­ra o chão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sob os pés de­le, meio en­ter­ra­dos na la­ma, ha­via tri­lhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­fer­ru­ja­dos, tor­tos, com ma­to cres­cen­do en­tre os dor­men­tes. Vi­nham de al­gum lu­gar atrás de­le, de den­tro da né­voa, e se­gui­am em fren­te, na di­re­ção da bei­ra do pe­nhas­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele co­nhe­cia aque­les tri­lhos. Ti­nha vi­ra­do as cos­tas pa­ra eles no al­to da ser­ra, di­as atrás, di­zen­do que não le­va­vam a lu­gar ne­nhum que im­por­tas­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Os tri­lhos vêm dar aqui — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Se­guiu-os com os olhos até o fim. Até on­de o pe­nhas­co aca­ba­va e o ar co­me­ça­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E o res­to do ca­mi­nho caiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Os tri­lhos aca­ba­vam no ar."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não ha­via pon­te. Não ha­via es­ta­ção. Ha­via só o fim do pe­nhas­co e os tri­lhos con­ti­nu­an­do além de­le por al­guns me­tros, sem na­da em­bai­xo, tor­ci­dos pa­ra bai­xo co­mo de­dos que ten­ta­ram se agar­rar a al­gu­ma coi­sa e não con­se­gui­ram. Mais adi­an­te, uma tor­re de fer­ro, al­ta e fi­na, se er­guia da pe­dra. De lá sa­ía um ca­bo gros­so que an­ti­ga­men­te le­va­va um bon­de por ci­ma do va­zio. O ca­bo es­ta­va par­ti­do. A pon­ta ba­lan­ça­va na chu­va, de­va­gar, pa­ra lá e pa­ra cá, sem bon­de ne­nhum."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou olhan­do pa­ra o ca­bo ba­lan­çan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Li­nha de­sa­ti­va­da — dis­se, e o sar­cas­mo saiu fra­co, mo­lha­do, sem for­ça. — Avi­sa­ram tar­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Per­to da tor­re, en­cos­ta­da na pe­dra, ha­via uma ca­bi­ne."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Pe­que­na, de ma­dei­ra, com o te­to afun­da­do de um la­do. A ca­bi­ne do si­na­lei­ro, no fim da li­nha. A por­ta es­ta­va aber­ta, ba­ten­do de le­ve com o ven­to. Noct en­trou pa­ra fu­gir da chu­va, e a chu­va en­trou jun­to pe­lo te­to que­bra­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá den­tro ha­via uma ca­dei­ra, uma me­sa, uma lam­pa­ri­na apa­ga­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E na pa­re­de, es­cri­to à mão com car­vão, o úl­ti­mo ho­rá­rio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não quis ler. Leu mes­mo as­sim, por­que os olhos de­le já es­ta­vam lá an­tes que ele pu­des­se im­pe­dir."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Pri­mei­ro trem da ma­nhã. Um pas­sa­gei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A le­tra era tor­ta. A le­tra de al­guém com so­no. A le­tra de um ho­mem que, nu­ma ma­nhã de chu­va, ti­nha vis­to des­cer do trem uma úni­ca pes­soa, pe­que­na, so­zi­nha, e ti­nha acha­do aqui­lo nor­mal o su­fi­ci­en­te pa­ra ano­tar sem pen­sar du­as ve­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do di­an­te da pa­re­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A chu­va ca­ía pe­lo te­to que­bra­do e es­cor­ria pe­lo ros­to de­le, e nin­guém, nem ele mes­mo, po­de­ria di­zer o que era chu­va e o que não era."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pas­sou os de­dos pe­la pa­la­vra. "/>
                <ITEXT CPARENT="c_it" CH="Um."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um pas­sa­gei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ti­nha vin­do até ali so­zi­nha. Ti­nha su­bi­do no trem an­tes de ama­nhe­cer, com o bi­lhe­te dei­xa­do na me­sa e a pro­mes­sa ain­da quen­te na bo­ca de­le, e ti­nha vin­do até aque­le pe­nhas­co, até aque­la chu­va, até aque­le la­go. So­zi­nha. En­quan­to ele dor­mia. Na­que­la ma­nhã, a li­nha ain­da che­ga­va in­tei­ra até o pe­nhas­co. O res­to ti­nha ca­í­do de­pois."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um — dis­se ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz não ti­nha na­da. Nem sar­cas­mo, nem rai­va, nem tris­te­za. Era só a pa­la­vra, nua, so­zi­nha, co­mo o pas­sa­gei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do o trem atra­sa­va, ela con­ta­va ra­po­sas. "/>
                <ITEXT CPARENT="c_it" CH="Uma. Du­as."/>
                <ITEXT CH=" Na­que­la ma­nhã, o trem che­gou na ho­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele saiu da ca­bi­ne e foi até a bei­ra do pe­nhas­co."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O ven­to em­pur­ra­va a chu­va de la­do, e ele te­ve que fir­mar os pés na pe­dra pa­ra não es­cor­re­gar. Olhou pa­ra bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá em­bai­xo, mui­to em­bai­xo, es­ta­va o la­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O mes­mo la­go, ou ou­tra par­te de­le, imen­so, cin­zen­to, es­ten­di­do até a né­voa. A chu­va ca­ía so­bre ele com to­da a for­ça, mi­lhões de go­tas por se­gun­do, uma cor­ti­na in­tei­ra de água des­pen­can­do do céu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E o la­go não se me­xia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nem uma on­da. Nem um cír­cu­lo. As go­tas ca­í­am e de­sa­pa­re­ci­am na su­per­fície co­mo se ca­ís­sem num es­pe­lho, sem dei­xar mar­ca, sem fa­zer ba­ru­lho. A água per­ma­ne­cia li­sa, per­fei­ta­men­te li­sa, per­fei­ta­men­te pa­ra­da, de­bai­xo da tem­pes­ta­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct es­trei­tou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— A chu­va não me­xe na água."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era er­ra­do. Era o ti­po de coi­sa er­ra­da que a ca­be­ça de­le re­gis­tra­va an­tes de en­ten­der, do jei­to que re­gis­tra­va uma fa­ca es­con­di­da sob a me­sa ou um sor­ri­so que não che­ga­va aos olhos. Uma água que na­da per­tur­ba. Que na­da to­ca. Que guar­da tu­do o que cai ne­la e não de­vol­ve nem uma on­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma água que guar­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no fun­do de­la, lon­ge, lá em­bai­xo, qua­se in­vi­sí­vel atra­vés da chu­va, ha­via uma luz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pe­que­na. Fra­ca. Ama­re­la­da, co­mo a luz de uma lan­ter­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­ra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra a luz por mui­to tem­po. A bra­sa, que vi­nha ace­sa des­de a mar­gem, res­pon­den­do a ca­da pul­so da fen­da, se ca­lou de re­pen­te. Fi­cou qui­e­ta, es­tra­nha­men­te qui­e­ta, co­mo fi­ca uma pes­soa di­an­te de um lu­gar on­de en­ter­rou al­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os de­dos de­le en­con­tra­ram a fi­ta no pul­so. En­char­ca­da. A cor não ti­nha des­bo­ta­do. Nun­ca des­bo­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ao la­do da tor­re de fer­ro, ha­via uma tri­lha es­trei­ta que des­cia pe­la fa­ce do pe­nhas­co, em zi­gue-za­gue, até a bei­ra do la­go lá em­bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele to­mou a tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não olhou pa­ra trás, pa­ra a ca­bi­ne, pa­ra a pa­re­de, pa­ra a pa­la­vra "/>
                <ITEXT CPARENT="c_it" CH="um"/>
                <ITEXT CH=". Não pre­ci­sa­va. Ela es­ta­va es­cri­ta ne­le ago­ra, em al­gum lu­gar fun­do, jun­to do bi­lhe­te e da fi­ta e de to­das as ou­tras coi­sas que ele car­re­ga­va por­que não ha­via on­de pou­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Des­ceu pe­la chu­va na di­re­ção da luz pa­ra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a ca­da pas­so, fi­ca­va mais cla­ro pa­ra ele que aque­la luz es­ta­va es­pe­ran­do por ele ha­via mui­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E que ele a co­nhe­cia."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="47816.8503937008" OwnPage="137" ItemID="1013322201" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="47816.8503937008" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1013690345" BACKITEM="1009277145"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="47816.8503937008" OwnPage="138" ItemID="1013690345" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="47816.8503937008" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1013612025" BACKITEM="1013322201"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="48508.8188976378" OwnPage="139" ItemID="1013612025" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="48508.8188976378" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1013690345"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="48593.8582677166" OwnPage="140" ItemID="1015513353" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="48593.8582677166" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1021084633" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 18"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="O Car­ce­rei­ro"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="O"/>
                <ITEXT CH=" La­go Ve­la­do não ti­nha mar­gem em­bai­xo do pe­nhas­co. Ti­nha um chão."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct des­ceu a úl­ti­ma cur­va da tri­lha e pôs o pé na água, es­pe­ran­do afun­dar, e não afun­dou. A su­per­fície o se­gu­rou co­mo vi­dro. Li­sa, sóli­da, fria atra­vés da so­la da bo­ta. Ele deu ou­tro pas­so. E ou­tro. A chu­va ti­nha pa­ra­do, ou não che­ga­va até ali; o céu em ci­ma era o mes­mo bran­co sem ho­ra da mar­gem das fo­lhas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele an­dou so­bre o la­go na di­re­ção da luz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em­bai­xo dos pés de­le, atra­vés da água trans­pa­ren­te, via coi­sas. Coi­sas pe­que­nas, es­que­ci­das, afun­da­das ali ha­via mui­to tem­po e con­ser­va­das per­fei­ta­men­te, co­mo in­se­tos em âm­bar. Uma xí­ca­ra. Uma cha­ve. Um sa­pa­to de cri­an­ça. Uma car­ta fe­cha­da. Um ra­mo de flo­res se­cas que ain­da ti­nha cor."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E, mais fun­do, no cen­tro do la­go, a luz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era uma lan­ter­na. Ve­lha, de fer­ro, com vi­dros ama­re­la­dos. Boi­a­va pa­ra­da a al­guns me­tros abai­xo da su­per­fície, pre­sa ao fun­do por uma cor­ren­te gros­sa. Den­tro de­la, uma cha­ma pe­que­na, que não tre­mia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou em ci­ma de­la. Olhou pa­ra bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to de­le não pul­sou. Do­eu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="— Vol­ta."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A voz veio de trás de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se vi­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ha­via al­guém de pé so­bre o la­go, a uns dez pas­sos. Al­to, ma­gro, en­vol­to da ca­be­ça aos pés num véu de fu­ne­ral cin­zen­to, lon­go, pe­sa­do, que ar­ras­ta­va na água sem mo­lhar. Não se via o ros­to. Nu­ma das mãos, se­gu­ra­va uma cha­ve de fer­ro do ta­ma­nho de um bra­ço. Na ou­tra, uma cor­ren­te, que des­cia até a água e su­mia ne­la, na di­re­ção da lan­ter­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O car­ce­rei­ro. O Ve­lá­rio. Noct não sa­bia de on­de vi­nha o no­me, mas o no­me es­ta­va ali, na ca­be­ça de­le, co­mo se sem­pre ti­ves­se es­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Aqui em­bai­xo não tem na­da seu — dis­se a fi­gu­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz era bai­xa, can­sa­da. Não era ame­a­ça­do­ra. Era qua­se gen­til. A voz de al­guém pe­din­do a uma cri­an­ça que se afas­te de um fo­gão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E era fa­mi­li­ar. Mui­to fa­mi­li­ar. Mais fa­mi­li­ar que a do Cei­fa­dor, mais fa­mi­li­ar que qual­quer voz que ele ti­nha ou­vi­do na vi­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra a fi­gu­ra ve­la­da. De­pois pa­ra a lan­ter­na em­bai­xo dos pés. De­pois pa­ra a cor­ren­te que li­ga­va os dois."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­gra­ça­do — dis­se, des­con­fi­a­do. — Pa­re­ce meu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Ve­lá­rio não lu­ta­va pa­ra ma­tar. Noct per­ce­beu is­so no pri­mei­ro mi­nu­to."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Lu­ta­va pa­ra afas­tar. A cha­ve enor­me vi­nha em ar­cos lar­gos, len­tos, que em­pur­ra­vam mais do que cor­ta­vam. As cor­ren­tes su­bi­am da água e se en­ro­la­vam nos tor­no­ze­los de­le, não pa­ra der­ru­bá-lo, mas pa­ra se­gu­rá-lo lon­ge do cen­tro do la­go. O véu su­mia e re­a­pa­re­cia atrás de­le, sem­pre en­tre ele e a lan­ter­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E às ve­zes o Ve­lá­rio er­guia a mão va­zia, e o mun­do es­cu­re­cia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não co­mo noi­te. Co­mo es­que­ci­men­to. A vi­são de Noct se apa­ga­va nas bor­das, e mãos de som­bra su­bi­am da água em vol­ta de­le, e por al­guns se­gun­dos ele não lem­bra­va on­de es­ta­va, nem por quê, nem quem era a fi­gu­ra ve­la­da. Só lem­bra­va de lu­tar. O cor­po lem­bra­va por ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ba­teu. Jab, cross, chu­te. As fa­gu­lhas car­me­sim es­ta­la­vam con­tra o véu e o ras­ga­vam aos pou­qui­nhos, e por bai­xo do véu não ha­via san­gue, ha­via né­voa, a mes­ma né­voa páli­da que es­ca­pa­va das cri­a­tu­ras da mar­gem quan­do se des­fa­zi­am."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na me­ta­de da lu­ta, o Ve­lá­rio se ajo­e­lhou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não de dor. Ajo­e­lhou-se so­bre o la­go e abra­çou al­gu­ma coi­sa con­tra o pei­to, e Noct viu que era a lan­ter­na, que ti­nha su­bi­do da água até as mãos do Ve­lá­rio, a cor­ren­te pen­du­ra­da. O car­ce­rei­ro a se­gu­ra­va co­mo se se­gu­ra um be­bê, ou uma coi­sa que vai que­brar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a lan­ter­na ra­chou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um es­ta­lo fi­no. Um ris­co no vi­dro ama­re­la­do, de ci­ma a bai­xo. A luz lá den­tro tre­meu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê não quer lem­brar — dis­se o Ve­lá­rio, sem ti­rar os olhos da lan­ter­na. — Eu sou a pro­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu. Não ha­via na­da a di­zer con­tra is­so. Era ver­da­de, e os dois sa­bi­am."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O véu ras­gou."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Caiu do Ve­lá­rio co­mo pe­le ve­lha, de­va­gar, e se es­pa­lhou na água em vol­ta de­le. E o que es­ta­va em­bai­xo não era um mons­tro. Era uma fi­gu­ra ma­gra, des­pi­da, cin­zen­ta, de bra­ços lon­gos e cor­po de al­guém que não co­me há mui­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no lu­gar do ros­to, ha­via um es­pe­lho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se viu ne­le. Viu o pró­prio ros­to, can­sa­do, su­jo, com san­gue se­co no can­to da bo­ca. Viu nos pró­prios olhos o que o Cei­fa­dor ti­nha cha­ma­do de me­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Des­pi­do se le­van­tou. Ago­ra se mo­via rápi­do. Sal­ta­va, e quan­do ca­ía so­bre o la­go a su­per­fície in­tei­ra es­tre­me­cia. Cha­ma­va gai­o­las de fer­ro que des­pen­ca­vam do céu bran­co. Cha­ma­va uma ma­ré ver­me­lha que su­bia pe­lo vi­dro da água co­mo san­gue nu­ma to­a­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E fa­la­va. En­tre os gol­pes. Com a voz de Noct."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela pe­diu uma coi­sa. Vo­cê vai odi­ar lem­brar o quê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu. Ba­teu mais for­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu guar­dei pra vo­cê não ter que car­re­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nin­guém pe­diu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Saiu rou­co. Sem ne­nhu­ma ar­ma­du­ra. Ali, con­tra aque­la coi­sa com o ros­to de­le, não ha­via ar­ma­du­ra pos­sí­vel. Não se usa sar­cas­mo con­tra um es­pe­lho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Se vo­cê lem­brar — dis­se o Des­pi­do, sal­tan­do pa­ra trás, a lan­ter­na ra­cha­da pen­du­ra­da na mão —, vai ter que cum­prir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou um ins­tan­te."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Cum­prir."/>
                <ITEXT CH=" Ha­via uma coi­sa que ele ti­nha que cum­prir. Ele sa­bia dis­so. Sem­pre ti­nha sa­bi­do. Sen­tia o for­ma­to de­la no pei­to co­mo se sen­te o for­ma­to de uma pa­la­vra na pon­ta da lín­gua. Uma pro­mes­sa. Fei­ta nu­ma noi­te de chu­va. Que ele ti­nha es­que­ci­do de pro­pósi­to, ou que al­guém ti­nha es­que­ci­do por ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— To­da noi­te vo­cê che­ga per­to — dis­se o es­pe­lho. — E vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não dis­se na­da. Era ver­da­de. To­da noi­te, no ban­co, com os de­dos na fi­ta, ele che­ga­va per­to. E vol­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Des­pi­do pa­rou de lu­tar por um se­gun­do. Fi­cou de pé no meio do la­go, o es­pe­lho no lu­gar do ros­to re­fle­tin­do Noct, a lan­ter­na ra­cha­da nas mãos. E dis­se, mais bai­xo, qua­se com pe­na:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela sa­bia que po­dia não vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O la­go in­tei­ro fi­cou em si­lên­cio."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela sa­bia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela sa­bia. Na úl­ti­ma noi­te, acor­da­da, com a chu­va no te­lha­do. Ela sa­bia que po­dia não vol­tar. E ti­nha di­to al­gu­ma coi­sa a ele. E ele ti­nha pro­me­ti­do al­gu­ma coi­sa. E de­pois ti­nha es­con­di­do aqui­lo tão fun­do que nem ele con­se­guia mais achar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct deu um pas­so na di­re­ção do Des­pi­do. De­pois ou­tro. A bra­sa não es­ta­va can­tan­do. Es­ta­va ca­la­da, es­pe­ran­do, co­mo ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Me de­vol­ve."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O úl­ti­mo tre­cho da lu­ta foi no es­cu­ro."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Quan­do o Des­pi­do já mal se aguen­ta­va, quan­do o cor­po cin­zen­to já tre­mia e a né­voa es­ca­pa­va de­le por to­dos os ras­gos, o Ve­lá­rio er­gueu a lan­ter­na ra­cha­da aci­ma da ca­be­ça e dis­se du­as pa­la­vras."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não olha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E o mun­do apa­gou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct lu­tou sem ver na­da. Lu­tou pe­lo som, pe­lo ven­to dos gol­pes pas­san­do per­to, pe­lo frio das cor­ren­tes na pe­le. Lu­tou com o cor­po in­tei­ro, com a me­mó­ria dos mús­cu­los, com a tei­mo­sia que era a úni­ca coi­sa que sem­pre ti­nha so­bra­do ne­le quan­do to­do o res­to aca­ba­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não sol­tou a bra­sa. Não des­ta vez. Ti­nha apren­di­do, no san­tuá­rio, o que a bra­sa fa­zia quan­do ele a sol­ta­va com rai­va: ba­tia por ele, e ele es­que­cia de pa­rar. E ca­da gol­pe era da fen­da, não de­le. Lu­tou com o que era de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no es­cu­ro, en­tre um gol­pe e ou­tro, ele ou­viu uma coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não o Ve­lá­rio. Uma chu­va. Fra­ca, dis­tan­te, co­mo se vi­es­se de ou­tro lu­gar. Ba­ten­do num te­lha­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O úl­ti­mo so­co acer­tou al­gu­ma coi­sa que não re­sis­tiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A luz vol­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Des­pi­do es­ta­va de jo­e­lhos no meio do la­go."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não ata­ca­va mais. Não fa­la­va mais. Se­gu­ra­va a lan­ter­na ra­cha­da com as du­as mãos con­tra o pei­to, e o es­pe­lho no lu­gar do ros­to es­ta­va ra­cha­do tam­bém, com uma li­nha fi­na no meio que di­vi­dia o re­fle­xo de Noct em dois."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou de pé di­an­te de­le. Ofe­gan­te. Sem le­van­tar a mão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ve­lá­rio olhou pa­ra ele por mui­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão, de­va­gar, co­mo quem de­sis­te de uma coi­sa que fez du­ran­te anos e não sa­be mais fa­zer ou­tra, er­gueu a lan­ter­na. Le­vou as mãos até a por­ti­nho­la de vi­dro. E a abriu, ele mes­mo, com os pró­prios de­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão lem­bra — dis­se, com a voz de Noct. — E não diz que eu não avi­sei."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A luz saiu da lan­ter­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não co­mo fo­go. Co­mo um fio. Uma fi­ta de luz ama­re­la e quen­te, que se de­sen­ro­lou no ar de­va­gar, fa­zen­do cur­vas, e flu­tuou até Noct. Ele não se me­xeu. A fi­ta de luz en­con­trou o pul­so di­rei­to de­le e se en­ro­lou ali, uma vol­ta, du­as, por ci­ma da fi­ta car­me­sim de Mi­ra. As du­as fi­ca­ram jun­tas, uma so­bre a ou­tra, ver­me­lho e dou­ra­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ve­lá­rio se des­fez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não em cin­zas, nem em né­voa. Sim­ples­men­te dei­xou de es­tar lá, do jei­to que um pen­sa­men­to dei­xa de es­tar lá quan­do vo­cê fi­nal­men­te o pen­sa até o fim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era ele. Sem­pre ti­nha si­do ele. A par­te de­le que, nu­ma ma­nhã de chu­va, ti­nha de­ci­di­do que era mais fácil es­que­cer do que car­re­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A lan­ter­na va­zia caiu na água e boi­ou, aber­ta, pa­ra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E Noct, so­zi­nho no meio do la­go, olhou pa­ra o pró­prio pul­so, pa­ra as du­as fi­tas, e sen­tiu a lem­bran­ça su­bir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não co­mo as ou­tras, aos pe­da­ços, pe­din­do li­cen­ça. Su­biu in­tei­ra. De uma vez. Co­mo água quan­do se abre uma com­por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os jo­e­lhos de­le ce­de­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ele es­ta­va de vol­ta à úl­ti­ma noi­te."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="49200.7874015749" OwnPage="141" ItemID="1021084633" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="49200.7874015749" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1021315913" BACKITEM="1015513353"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="49200.7874015749" OwnPage="142" ItemID="1021315913" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="49200.7874015749" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1021224313" BACKITEM="1021084633"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="49892.7559055119" OwnPage="143" ItemID="1021224313" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="49892.7559055119" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1015552953" BACKITEM="1021315913"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="49892.7559055119" OwnPage="144" ItemID="1015552953" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="49892.7559055119" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1024134441" BACKITEM="1021224313"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="50584.7244094489" OwnPage="145" ItemID="1024134441" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="50584.7244094489" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1015552953"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="50669.7637795276" OwnPage="146" ItemID="1020866665" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="50669.7637795276" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1031600073" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 19"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Lem­bran­do de vo­cê"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" úl­ti­ma noi­te. Chu­va no te­lha­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não uma chu­va de tem­pes­ta­de. Uma chu­va pa­ci­en­te, que ba­tia co­mo al­guém que tem a noi­te in­tei­ra e sa­be que vai ser aten­di­do. Ele se lem­bra­va de­la ago­ra. Lem­bra­va do som exa­to, do rit­mo, da go­tei­ra no can­to do quar­to que pin­ga­va nu­ma pa­ne­la que ela ti­nha pos­to ali se­ma­nas an­tes e que ne­nhum dos dois ti­nha ti­ra­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mi­ra es­ta­va acor­da­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele tam­bém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta­va de cos­tas pa­ra ela, os olhos aber­tos no es­cu­ro, ca­la­do, do jei­to que fi­ca­va quan­do não que­ria con­ver­sar. O si­lên­cio fun­ci­o­na­va com to­do mun­do. Nun­ca ti­nha fun­ci­o­na­do com ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela fi­cou um tem­po ca­la­da. Ele sen­tia o ca­lor de­la nas cos­tas, sem que ela en­cos­tas­se. Sen­tia que ela es­ta­va olhan­do pa­ra o te­to, ou pa­ra a nu­ca de­le, ou pa­ra a chu­va na ja­ne­la. Sen­tia o zum­bi­do, tam­bém, ou acha­va que sen­tia; era a pri­mei­ra vez que pen­sa­va nis­so, ali, den­tro da lem­bran­ça, e per­ce­beu que na­que­la noi­te tal­vez ti­ves­se ou­vi­do. Só um pou­co. Só por bai­xo da chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ti­nha de­ci­di­do que era can­sa­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pro­me­te uma coi­sa — dis­se ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não per­gun­tou se ele es­ta­va acor­da­do. Sa­bia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não se vi­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— De­pen­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela riu bai­xo pe­lo na­riz. A ri­sa­da que ela da­va quan­do ele es­ta­va sen­do exa­ta­men­te quem ele era."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois en­fi­ou o pé ge­la­do na pan­tur­ri­lha de­le, de pro­pósi­to, co­mo fa­zia to­da noi­te. Ele re­cla­mou bai­xo, co­mo re­cla­ma­va to­da noi­te. E não ti­rou a per­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tá ge­la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tá. — Ela não ti­rou. — É pra is­so que eu te­nho vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pra es­quen­tar pé."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tre ou­tras coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Quais?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ain­da tô fa­zen­do a lis­ta. — Uma pau­sa. — Tá fi­can­do com­pri­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele qua­se sor­riu. De cos­tas, no es­cu­ro, on­de ela não po­dia ver. Ela sou­be mes­mo as­sim. Ela sem­pre sa­bia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Se eu de­mo­rar pra vol­tar — dis­se ela, e a voz não riu mais —, vo­cê con­ti­nua an­dan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O quar­to fi­cou mui­to qui­e­to. Só a chu­va. Só a go­tei­ra na pa­ne­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sen­tiu al­gu­ma coi­sa se fe­char no pei­to. Uma coi­sa fria. Ele não quis sa­ber, na­que­la noi­te, o que era."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Achou que era can­sa­ço fa­lan­do. Achou que ela con­ta­ria na ho­ra de­la. E fez o que sem­pre fa­zia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— An­dar eu já sei."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não. — Ela se me­xeu na ca­ma, che­gou mais per­to, en­cos­tou a tes­ta nas cos­tas de­le, en­tre os om­bros. — Con­ti­nua. Co­me, dor­me, bri­ga com al­guém. Um dia de ca­da vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela es­pe­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­pe­rou com aque­la pa­ciên­cia que ele não me­re­cia, a tes­ta en­cos­ta­da nas cos­tas de­le, res­pi­ran­do de­va­gar, até que fi­cou cla­ro que ele não ia di­zer na­da, por­que se dis­ses­se ia ter que per­gun­tar "/>
                <ITEXT CPARENT="c_it" CH="por quê"/>
                <ITEXT CH=", e se per­gun­tas­se "/>
                <ITEXT CPARENT="c_it" CH="por quê"/>
                <ITEXT CH=" ela ia res­pon­der, e ele não que­ria ou­vir a res­pos­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­tão ela con­ti­nuou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E ou­tra. Se um dia vo­cê ou­vir uma por­ta cha­man­do... não abre com rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A chu­va ba­teu no te­lha­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Rai­va abre tu­do. Abre lem­bran­do de mim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fi­cou mui­to tem­po ca­la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois vi­rou-se, fi­nal­men­te, na ca­ma. Fi­cou de fren­te pa­ra ela no es­cu­ro. Não via o ros­to de­la di­rei­to; só o con­tor­no, a som­bra, o bri­lho dos olhos re­fle­tin­do a pou­ca luz que en­tra­va pe­la ja­ne­la. Ela es­ta­va es­pe­ran­do. Sem­pre es­pe­ra­va por ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ele dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Pro­me­to, ra­po­si­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A mão de­le não foi até a so­bran­ce­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela viu. Cla­ro que viu. Sor­riu no es­cu­ro, e ele sen­tiu o sor­ri­so mais do que viu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não co­çou — dis­se ela, bai­xi­nho. — Tá ven­do? Vo­cê con­se­gue."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela pas­sou a pon­ta do de­do pe­la so­bran­ce­lha de­le, de­va­gar, de uma pon­ta à ou­tra, co­mo quem con­fe­re uma coi­sa que aca­bou de con­ser­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Bo­bo — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele dei­xou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vai dor­mir ago­ra? — per­gun­tou ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Se vo­cê dei­xar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu sem­pre dei­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê con­ver­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Con­ver­so. — Ela riu de no­vo, bai­xi­nho. — Al­guém nes­sa ca­sa tem que con­ver­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Va­mos con­ver­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— So­bre o quê?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Qual­quer coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ela fa­lou. Da fei­ra, do ho­mem das ma­çãs que sem­pre er­ra­va o tro­co a fa­vor de­la, da go­tei­ra que ne­nhum dos dois ia con­ser­tar nun­ca, de uma ra­po­sa que ti­nha vis­to na bei­ra da es­tra­da na­que­la tar­de e que ti­nha fi­ca­do olhan­do pa­ra ela co­mo quem co­nhe­ce a gen­te. Fa­lou bai­xi­nho, sem pres­sa, pu­lan­do de um as­sun­to pa­ra ou­tro do jei­to que só ela pu­la­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ele fi­cou ou­vin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele, que não con­ver­sa­va com nin­guém. Que res­pon­dia ao mun­do com "/>
                <ITEXT CPARENT="c_it" CH="hm"/>
                <ITEXT CH=" e com si­lên­cio, e acha­va que a mai­or par­te das pa­la­vras era des­per­dí­cio. Com ela era di­fe­ren­te. Com ela ele fi­ca­va acor­da­do de pro­pósi­to, só pa­ra ou­vir. Per­gun­ta­va coi­sas que não pre­ci­sa­va sa­ber, só pa­ra ela con­ti­nu­ar. Era a par­te do dia de que ele mais gos­ta­va, e nun­ca ti­nha di­to is­so em voz al­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pre­ci­sa­va. Ela sa­bia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pu­xou a man­ta de­le, a es­cu­ra, de vi­a­gem, que ela vi­via rou­ban­do, e co­briu os dois até o quei­xo. En­cos­tou a ca­be­ça no om­bro de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— É por cau­sa do frio — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu não sin­to frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu sei."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou mes­mo as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele vi­rou um pou­co o ros­to e deu um bei­jo na tes­ta de­la. De­mo­ra­do, de­sa­jei­ta­do, do jei­to de quem não ti­nha mui­ta práti­ca e não es­ta­va nem aí. Ela não dis­se na­da. Mas ele sen­tiu o sor­ri­so de­la de no­vo, en­cos­ta­do no om­bro de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E os dois fi­ca­ram ali, ou­vin­do a chu­va e a go­tei­ra na pa­ne­la, até que ele dor­miu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele dor­miu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E quan­do acor­dou, ha­via um bi­lhe­te na me­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="De vol­ta ao la­go."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct es­ta­va de jo­e­lhos so­bre a água pa­ra­da, no cen­tro do La­go Ve­la­do, com a lan­ter­na va­zia boi­an­do ao la­do e as du­as fi­tas no pul­so. A mão es­quer­da es­ta­va fe­cha­da so­bre elas, aper­tan­do, co­mo se ti­ves­se me­do de que fos­sem em­bo­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via nin­guém ali. Ne­nhum Ve­lá­rio, ne­nhum re­fle­xo atra­sa­do, ne­nhu­ma si­lhu­e­ta de cos­tas. Só o céu bran­co e o la­go e ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a lem­bran­ça, in­tei­ra, vi­va, de­vol­vi­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela sa­bia. Ela sa­bia que po­dia não vol­tar. E não ti­nha pe­di­do pa­ra ele ir jun­to. Não ti­nha pe­di­do pa­ra ele sal­vá-la. Não ti­nha pe­di­do na­da pa­ra ela mes­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­nha pe­di­do pa­ra ele con­ti­nu­ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ele ti­nha pas­sa­do to­do aque­le tem­po an­dan­do, sim. Mas an­dan­do co­mo quem fo­ge. An­dan­do pa­ra não pa­rar. Usan­do a rai­va co­mo com­bus­tí­vel, co­mo le­nha, co­mo a úni­ca coi­sa que ain­da quei­ma­va. Ti­nha fei­to exa­ta­men­te o que ela pe­diu pa­ra ele não fa­zer. Ti­nha dei­xa­do a rai­va abrir ca­mi­nho. No san­tuá­rio, so­bre o cor­po do Cei­fa­dor, ti­nha dei­xa­do ela abrir tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Rai­va abre tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os olhos. A voz saiu sem ne­nhu­ma ar­ma­du­ra, sem na­da, rou­ca, par­ti­da no meio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu pro­me­ti."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="E en­tão a bra­sa su­biu."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ele sen­tiu ela vin­do. Do pei­to, do lu­gar fun­do on­de mo­ra­va, su­bin­do co­mo sem­pre su­bia. Quen­te, enor­me, fa­min­ta. A mes­ma for­ça que ti­nha quei­ma­do no san­tuá­rio, que ti­nha se ali­men­ta­do de ca­da gol­pe, que ti­nha can­ta­do de ale­gria en­quan­to ele ba­tia num cor­po que já não se me­xia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não a em­pur­rou pa­ra bai­xo. Tam­bém não a sol­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou ne­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não na au­sên­cia. Não no bi­lhe­te, nem nas pe­ga­das que não vol­ta­vam, nem no pas­sa­gei­ro úni­co do pri­mei­ro trem. Pen­sou "/>
                <ITEXT CPARENT="c_it" CH="ne­la"/>
                <ITEXT CH=". Na ri­sa­da pe­lo na­riz. No "/>
                <ITEXT CPARENT="c_it" CH="ten­ta de no­vo ama­nhã"/>
                <ITEXT CH=". No jei­to que ela pe­ga­va as men­ti­ras de­le pe­la so­bran­ce­lha. Nas ra­po­sas que ela con­ta­va na bei­ra dos tri­lhos. Na tes­ta en­cos­ta­da nas cos­tas de­le nu­ma noi­te de chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Abriu a por­ta lem­bran­do de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a ener­gia car­me­sim su­biu, e des­ta vez ele não dei­xou ela to­mar con­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela obe­de­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não co­mo um cão pu­xan­do a co­lei­ra. Co­mo uma mão que se­gu­ra ou­tra. A au­ra ver­me­lha se acen­deu em vol­ta do cor­po de­le, mas não quei­mou, não trans­bor­dou, não can­tou. Fi­cou. Fir­me, quen­te, qui­e­ta, do ta­ma­nho exa­to que ele que­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E atrás de­le, por um ins­tan­te, ela se des­do­brou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As fa­gu­lhas car­me­sim se jun­ta­ram nas cos­tas de­le e se abri­ram pa­ra trás, em le­que, uma, du­as, mui­tas, lon­gas e su­a­ves e de pon­tas bran­cas. Co­mo uma cau­da. Co­mo mui­tas cau­das. No al­to da ca­be­ça, a ener­gia su­biu em du­as pon­tas fi­nas, cur­vas, que não eram de os­so, eram de luz. Pe­los bra­ços, pe­los om­bros, uma pe­la­gem de ener­gia ver­me­lha e fi­na se acen­deu e fi­cou, res­pi­ran­do jun­to com ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct abriu os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O mun­do es­ta­va mais níti­do. Mais len­to. Ele ou­via a água pa­ra­da co­mo se ela ti­ves­se som. Sen­tia o chei­ro do céu bran­co. Os olhos de­le, re­fle­ti­dos na su­per­fície do la­go, es­ta­vam ver­me­lhos, e bri­lha­vam, e não ti­nham me­do ne­nhum."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra o pró­prio re­fle­xo. Pa­ra a cau­da de ener­gia aber­ta atrás de­le co­mo um le­que de fo­go. Pa­ra as ore­lhas pon­tu­das de luz que ti­nham sur­gi­do na ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­ra a for­ma que aqui­lo tu­do ti­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não dis­se o no­me do ani­mal. Não pre­ci­sa­va. A for­ma es­ta­va ali, no la­go, olhan­do de vol­ta pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E, des­ta vez, o re­fle­xo não es­ta­va atra­sa­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se le­van­tou. Fe­chou os pu­nhos. A ener­gia cor­reu pe­los bra­ços até os nós dos de­dos e fi­cou ali, pron­ta, obe­di­en­te, quen­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Lem­bran­do de vo­cê, en­tão — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E pe­la pri­mei­ra vez des­de a ma­nhã do bi­lhe­te, a bra­sa no pei­to de­le não pa­re­ceu uma fe­ri­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­re­ceu um pre­sen­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="An­tes de ir em­bo­ra, ele pa­rou ao la­do da lan­ter­na."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ela boi­a­va na água pa­ra­da, aber­ta, va­zia, o vi­dro ra­cha­do. Não ha­via mais na­da den­tro. Tu­do o que ela guar­da­va es­ta­va ago­ra en­ro­la­do no pul­so de­le, por ci­ma da fi­ta de Mi­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra ela por um tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de­pois, mais bai­xo, pa­ra nin­guém, pa­ra ela, pa­ra o la­go:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Con­ti­nua an­dan­do. Tá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No ca­mi­nho de vol­ta, ele pas­sou pe­la ca­pe­la no fun­do do la­go."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Os san­tos sem ros­to ain­da es­ta­vam lá. A ve­la ain­da quei­ma­va, so­zi­nha, no al­to. E o con­fes­si­o­ná­rio, no can­to mais es­cu­ro, ain­da ti­nha a ins­cri­ção gas­ta na ma­dei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pas­sou os de­dos por ela, co­mo da ou­tra vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E des­ta vez, as le­tras dei­xa­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ti­nham mu­da­do. Era ele que ti­nha mu­da­do. Ele leu pe­lo to­que, pa­la­vra por pa­la­vra, de­va­gar:"/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela não es­ta­va com me­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do di­an­te do con­fes­si­o­ná­rio, com a mão na ma­dei­ra, a for­ma de ra­po­sa ain­da ace­sa em vol­ta de­le, su­a­ve, ver­me­lha, as cau­das de luz aber­tas no es­cu­ro da ca­pe­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu sei."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E era ver­da­de. Ago­ra, ele sa­bia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na mar­gem do la­go, quan­do ele saiu, uma ra­po­sa de ver­da­de es­ta­va pa­ra­da en­tre as ár­vo­res se­cas. Pe­que­na, rui­va, a pon­ta da cau­da bran­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhan­do pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não fu­giu. Ele tam­bém não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois de um tem­po, ela se vi­rou e su­miu en­tre as ár­vo­res, na di­re­ção de on­de a fen­da pul­sa­va mais for­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct a se­guiu."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Fim da Par­te V."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="51276.6929133859" OwnPage="147" ItemID="1031600073" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="51276.6929133859" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1031238873" BACKITEM="1020866665"/>
