        <PAGEOBJECT XPOS="151.023622047244" YPOS="65116.0629921261" OwnPage="187" ItemID="1080888969" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="65116.0629921261" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1084411289" BACKITEM="1081278937"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="65116.0629921261" OwnPage="188" ItemID="1084411289" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="65116.0629921261" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1084548793" BACKITEM="1080888969"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="65808.0314960631" OwnPage="189" ItemID="1084548793" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="65808.0314960631" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1084445641" BACKITEM="1084411289"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="65808.0314960631" OwnPage="190" ItemID="1084445641" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="65808.0314960631" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1084548793"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="66585.0393700788" OwnPage="191" ItemID="959074889" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="66585.0393700788" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1090477785" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 26"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Pe­dra­ve­lha do Eco"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" pri­mei­ra coi­sa que ele sen­tiu foi que não es­ta­va cain­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="De­via es­tar. O chão ti­nha su­mi­do de­bai­xo das bo­tas no ins­tan­te em que ele atra­ves­sou a por­ta, e o es­tô­ma­go ti­nha da­do aque­le pu­lo de quem er­ra um de­grau no es­cu­ro. Mas não hou­ve que­da. Hou­ve só uma mu­dan­ça de pe­so, co­mo se o mun­do ti­ves­se gi­ra­do meia vol­ta em tor­no de­le e de­pois de­ci­di­do que ele es­ta­va cer­to on­de es­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct abriu os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Pe­dra­ve­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era a pra­ça. Ele co­nhe­cia ca­da pe­dra de­la, ca­da ra­cha­du­ra, ca­da de­grau gas­to. Co­nhe­cia o jei­to co­mo a luz da ma­nhã ba­tia pri­mei­ro na tor­re e de­pois es­cor­ria pe­los te­lha­dos. Co­nhe­cia o po­ço, a for­ja, a ca­sa de Ze­no com a ja­ne­li­nha dos fun­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só que tu­do es­ta­va no te­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As ca­sas pen­di­am lá em ci­ma, de ca­be­ça pa­ra bai­xo, com as cha­mi­nés apon­tan­do pa­ra ele co­mo de­dos. A tor­re des­cia do al­to fei­to uma es­ta­lac­ti­te, o si­no ra­cha­do pa­ra­do na pon­ta, sem ba­lan­çar. O po­ço sa­ía do céu, a bo­ca vi­ra­da pa­ra bai­xo, e de den­tro de­le não ca­ía na­da. Nem água, nem pe­dra, nem som."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em­bai­xo dos pés de­le não ha­via pra­ça. Ha­via pe­da­ços de­la. Pla­ta­for­mas sol­tas de pe­dra, flu­tu­an­do so­bre um abis­mo ver­me­lho que res­pi­ra­va de­va­gar, do mes­mo jei­to que a ra­cha­du­ra res­pi­ra­va nas noi­tes de chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E so­bre tu­do, uma luz dou­ra­da. De fim de tar­de. De lam­pi­ão de es­ta­ção. Uma luz que não vi­nha de lu­gar ne­nhum e não mu­da­va nun­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Mais qui­e­ta — dis­se ele, pa­ra nin­guém. — Com­bi­na mais co­mi­go do que de­via."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele an­dou."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Pu­lou de uma pla­ta­for­ma pa­ra a ou­tra, com cui­da­do, olhan­do pa­ra bai­xo an­tes de ca­da sal­to do jei­to que ti­nha apren­di­do no la­go. O abis­mo ver­me­lho não pu­xa­va. Não cha­ma­va. Só es­pe­ra­va, pa­ci­en­te, co­mo quem sa­be que tem tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pri­mei­ra si­lhu­e­ta es­ta­va on­de Ze­no sem­pre fi­ca­va. Sen­ta­da num de­grau que não exis­tia mais, o ca­ja­do atra­ves­sa­do nos jo­e­lhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era ele. Era o for­ma­to de­le. Os om­bros cur­va­dos, o quei­xo pa­ra a fren­te, o jei­to de se­gu­rar o ca­ja­do co­mo quem se­gu­ra uma opi­ni­ão. Mas era só o for­ma­to. Pre­to, cha­pa­do, sem ros­to, sem cor, co­mo uma som­bra que ti­nha es­que­ci­do de fi­car pre­sa no chão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou na fren­te de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ze­no."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A si­lhu­e­ta le­van­tou a ca­be­ça. Não pa­ra ele. Pa­ra um pon­to um pou­co à es­quer­da de­le, on­de ele es­ta­ria se ti­ves­se che­ga­do um se­gun­do an­tes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Dur­ma um pou­co no ban­co. Ve­lhos sa­bem des­sas coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E abai­xou a ca­be­ça de no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct es­pe­rou. Dis­se o no­me mais uma vez. Dis­se uma gros­se­ria, das bo­as, do ti­po que fa­zia o ve­lho ba­ter o ca­ja­do no chão. A si­lhu­e­ta não se me­xeu. Ti­nha di­to o que ti­nha pa­ra di­zer, e não ti­nha mais na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era uma das coi­sas que Ze­no ti­nha di­to a ele. Só is­so. Na­da que ele não ti­ves­se ou­vi­do an­tes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele de­mo­rou um se­gun­do pa­ra en­ten­der. De­pois en­ten­deu, e não gos­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Só sa­bem o que eu já ou­vi."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ir­mã Lí­via es­ta­va per­to do lu­gar on­de fi­ca­va a por­ta da ca­sa de­la, as mãos jun­tas na fren­te do cor­po, es­pe­ran­do, sem me­do, co­mo es­pe­ra­va sem­pre."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="— Nin­guém pe­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Fo­ras­tei­ro an­da­va de um la­do pa­ra o ou­tro, oi­to pas­sos pa­ra cá, oi­to pa­ra lá, o cha­péu de aba lar­ga vi­ran­do a ca­da vol­ta, sem nun­ca sair do lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Veio pe­la es­tra­da?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Brom es­ta­va na fren­te de uma for­ja que não ti­nha fo­go, o bra­ço le­van­ta­do, o mar­te­lo pa­ra­do no al­to, sem des­cer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­ta in­tei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E per­to do po­ço, on­de a vi­la re­al ti­nha o ban­co, ha­via uma fi­gu­ra pe­que­na, de bra­ços cru­za­dos, en­ro­la­da nu­ma man­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou olhan­do pa­ra ela mais tem­po do que ti­nha fi­ca­do olhan­do pa­ra os ou­tros."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Des­sa vez vo­cê apa­re­ceu — dis­se a si­lhu­e­ta de Tes­sa, pa­ra o pon­to à es­quer­da de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não res­pon­deu. Não adi­an­ta­va. Ela não ia ou­vir. Ela ia fi­car ali, na­que­la pra­ça de ca­be­ça pa­ra bai­xo, di­zen­do "/>
                <ITEXT CPARENT="c_it" CH="des­sa vez vo­cê apa­re­ceu"/>
                <ITEXT CH=" pa­ra nin­guém, pa­ra sem­pre, com a voz cer­ta e o for­ma­to cer­to e na­da den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era is­so que a por­ta fa­zia. Guar­da­va o for­ma­to das pes­so­as. Não as pes­so­as."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele pen­sou na Tes­sa de ver­da­de. Lá em ci­ma, ou lá em­bai­xo, ou do ou­tro la­do, no ban­co de Pe­dra­ve­lha, co­chi­lan­do na pon­ta es­quer­da, es­pe­ran­do do jei­to que ele ti­nha man­da­do. Pen­sou que ela es­ta­va mais lon­ge ago­ra do que em qual­quer ou­tro mo­men­to des­de que ele a ti­rou da car­ro­ça, no bos­que."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E pen­sou, sem que­rer, que a si­lhu­e­ta era mais fácil. Que a si­lhu­e­ta não fa­zia per­gun­tas de­mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se afas­tou de­la de­pres­sa, an­tes que o pen­sa­men­to ter­mi­nas­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O ban­co es­ta­va lá."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não o ban­co da es­ta­ção. O da pra­ça. O mes­mo fer­ro es­cu­ro, as mes­mas tá­bu­as gas­tas, a mes­ma pe­dri­nha ver­me­lha in­crus­ta­da no al­to do en­cos­to, apa­ga­da. Ele es­ta­va in­tei­ro, de pé, no meio de uma pla­ta­for­ma sol­ta, co­mo se al­guém ti­ves­se ar­ran­ca­do o ban­co do chão e de­ci­di­do que era a úni­ca coi­sa que va­lia a pe­na tra­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os dois la­dos es­ta­vam va­zi­os."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou na fren­te de­le. As per­nas, por con­ta pró­pria, já iam do­bran­do. Era o que elas fa­zi­am di­an­te de um ban­co, ha­via anos. Sen­tar na pon­ta da di­rei­ta, dei­xar a ou­tra li­vre, fe­char os olhos, con­tar até a dor fi­car do ta­ma­nho de um dia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não sen­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Aqui não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou de pé. Era o pri­mei­ro ban­co que ele re­cu­sa­va sem fu­gir de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Foi an­dan­do na di­re­ção de on­de a vi­la re­al ti­nha a tri­lha da ser­ra que ele no­tou o que fal­ta­va."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="As ra­po­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na Pe­dra­ve­lha de ver­da­de elas apa­re­ci­am nos can­tos, de ma­nhã ce­do, nas bor­das dos te­lha­dos, atrás do po­ço, sem­pre de lon­ge, sem­pre olhan­do pa­ra ele com aque­les olhos de bra­sa que ele nun­ca en­ca­ra­va de vol­ta. Ele ti­nha se acos­tu­ma­do com elas sem per­ce­ber. Do mes­mo jei­to que ti­nha se acos­tu­ma­do com a fi­ta no pul­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Aqui não ha­via ne­nhu­ma. Ne­nhu­ma som­bra de ra­bo, ne­nhum par de olhos no es­cu­ro. As bor­das dos te­lha­dos de ca­be­ça pa­ra bai­xo es­ta­vam va­zi­as."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nem as ra­po­sas vi­e­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Dis­se bai­xo. E não sou­be di­rei­to por que aqui­lo do­eu mais do que as si­lhu­e­tas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="As pe­ga­das co­me­ça­vam no po­ço."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Pe­que­nas. Car­me­sim. Bri­lhan­do de le­ve na pe­dra das pla­ta­for­mas, co­mo bra­sas que al­guém pi­sou e es­que­ceu de apa­gar. Sa­í­am da bor­da da pla­ta­for­ma bem de­bai­xo da bo­ca do po­ço, co­mo se al­guém ti­ves­se ca­í­do lá de ci­ma e co­me­ça­do a an­dar, e iam em­bo­ra nu­ma li­nha só. Um pé de­pois do ou­tro. Sem vol­tar. Sem he­si­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se aga­chou ao la­do da pri­mei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era pe­que­na. Me­nor que a bo­ta de­le. De bo­ta, com o cal­ca­nhar um pou­co mais fun­do do la­do es­quer­do, do jei­to tor­to que ela pi­sa­va quan­do es­ta­va com pres­sa e não que­ria ad­mi­tir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele co­nhe­cia aque­la pe­ga­da. Ti­nha vis­to aque­la pe­ga­da na la­ma da es­ta­ção, in­do, só in­do, anos de­pois da ma­nhã do bi­lhe­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Vo­cê pas­sou por aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fe­chou os olhos. En­cos­tou dois de­dos na mar­ca, mui­to de le­ve, co­mo quem en­cos­ta nu­ma coi­sa que po­de su­mir. Ela es­ta­va quen­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois se le­van­tou e se­guiu as pe­ga­das."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Elas atra­ves­sa­vam a pra­ça de ca­be­ça pa­ra bai­xo. Pas­sa­vam pe­la si­lhu­e­ta de Ze­no, pe­la for­ja sem fo­go, pe­lo ban­co va­zio, sem pa­rar em ne­nhum de­les. Pu­la­vam de pla­ta­for­ma em pla­ta­for­ma so­bre o abis­mo ver­me­lho, e Noct pu­la­va atrás, e não olha­va pa­ra bai­xo nem uma vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No fim da vi­la, on­de na Pe­dra­ve­lha re­al a es­tra­da co­me­ça­va, as pla­ta­for­mas aca­ba­vam. E as pe­ga­das pa­ra­vam di­an­te de uma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via pa­re­de em vol­ta de­la. Não ha­via ca­sa. Era só uma por­ta, de pé, so­zi­nha, no meio da úl­ti­ma pla­ta­for­ma, de ma­dei­ra es­cu­ra e fer­ra­gens ver­me­lhas, com uma fres­ta de luz dou­ra­da em­bai­xo. Uma por­ta co­mum, do ti­po que se en­con­tra em qual­quer ca­sa de qual­quer vi­la. Não era ou­tra por­ta. Não exis­tia ou­tra. Era a mes­ma de an­tes, vis­ta do la­do de den­tro, e ti­nha guar­da­do o for­ma­to de uma por­ta co­mum, co­mo guar­da­va o for­ma­to de tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de trás de­la vi­nha um zum­bi­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Bai­xo. Cons­tan­te. Qua­se uma voz. "/>
                <ITEXT CPARENT="c_it" CH="Pa­re­ce al­guém cha­man­do do ou­tro la­do de uma por­ta"/>
                <ITEXT CH=", ela ti­nha di­to, nu­ma das úl­ti­mas noi­tes, e ele ti­nha res­pon­di­do que era can­sa­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ou­via ago­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra a fi­ta car­me­sim no pul­so. Aper­tou o nó, uma vez, do jei­to que fa­zia an­tes de qual­quer lu­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E abriu a por­ta."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="66500.0000000001" OwnPage="192" ItemID="1090477785" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="66500.0000000001" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1090883161" BACKITEM="959074889"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="67191.9685039371" OwnPage="193" ItemID="1090883161" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="67191.9685039371" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1090896649" BACKITEM="1090477785"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="67191.9685039371" OwnPage="194" ItemID="1090896649" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="67191.9685039371" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1091001913" BACKITEM="1090883161"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="67883.9370078741" OwnPage="195" ItemID="1091001913" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="67883.9370078741" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1093508937" BACKITEM="1090896649"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="67883.9370078741" OwnPage="196" ItemID="1093508937" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="67883.9370078741" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1091001913"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="68660.9448818898" OwnPage="197" ItemID="1058072313" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="68660.9448818898" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1102455401" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 27"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Ela não es­ta­va com me­do"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="D"/>
                <ITEXT CH="o ou­tro la­do da por­ta não ha­via ou­tra por­ta."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ha­via um sa­lão sem pa­re­des, e no fun­do de­le, a mes­ma por­ta ou­tra vez, do ta­ma­nho que ela ti­nha de ver­da­de. Ocu­pa­va o fun­do in­tei­ro, al­ta co­mo a fa­cha­da da ca­te­dral, de ma­dei­ra tão es­cu­ra que pa­re­cia mo­lha­da, com fer­ra­gens ver­me­lhas que pul­sa­vam no rit­mo do zum­bi­do. Es­ta­va fe­cha­da. Mas pe­la fres­ta de bai­xo es­cor­ria a mes­ma luz dou­ra­da, e o zum­bi­do vi­nha da­li, de trás de­la, mais al­to ago­ra. Tão al­to que ele sen­tia nos den­tes."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Al­guém cha­man­do do ou­tro la­do de uma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era uma ima­gem. Era uma por­ta de ver­da­de. Ela ti­nha di­to exa­ta­men­te o que ou­via, e ele ti­nha di­to que era can­sa­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na fren­te da por­ta, no meio do sa­lão, ha­via um ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no la­do es­quer­do do ban­co, al­guém sen­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era o for­ma­to de­la. Não co­mo as si­lhu­e­tas da pra­ça, cha­pa­das, pre­tas, pa­ra­das. Es­te se me­xia. Era fei­to de al­gu­ma coi­sa que fer­via de­va­gar, uma es­táti­ca ver­me­lha, co­mo a chu­va vis­ta pe­la ja­ne­la de um trem em mo­vi­men­to, e den­tro da es­táti­ca ha­via um ca­be­lo, e no ca­be­lo ha­via uma fi­ta. Sen­ta­va tor­ta, com um pé em ci­ma do ban­co, do jei­to que ela sa­bia que ele odi­a­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ti­nha ros­to. On­de o ros­to de­via es­tar, a es­táti­ca fi­ca­va mais den­sa, e o olho de­le es­cor­re­ga­va, e não con­se­guia pa­rar ali."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­gu­ra vi­rou a ca­be­ça pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Is­so era pra me as­sus­tar?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz. Era qua­se a voz. Ti­nha a al­tu­ra cer­ta, o tom cer­to, a pon­ti­nha de ri­so no fim. Era a fra­se cer­ta. A pri­mei­ra coi­sa que ela ti­nha di­to a ele, no pri­mei­ro dia em que ele foi gros­so com ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct sen­tiu o chão su­mir de no­vo. Des­sa vez, de ver­da­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou pa­ra­do mui­to tem­po. De­pois res­pi­rou. E fez uma coi­sa que não ti­nha pla­ne­ja­do, que veio de al­gum lu­gar mais ve­lho que ele, do fun­do de um ban­co de es­ta­ção, de uma noi­te de chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Men­tiu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Es­tou bem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Dei­xou a mão pa­ra­da. Lon­ge da so­bran­ce­lha. "/>
                <ITEXT CPARENT="c_it" CH="Ago­ra vo­cê es­tá men­tin­do com a mão pa­ra­da. É pi­or."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­gu­ra in­cli­nou a ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Que bom."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E foi só is­so. Ela não olhou pa­ra a so­bran­ce­lha de­le. Não es­trei­tou os olhos que não ti­nha. Não dis­se "/>
                <ITEXT CPARENT="c_it" CH="tá ven­do?"/>
                <ITEXT CH=". Só acre­di­tou, fácil, quen­te, co­mo quem acre­di­ta em tu­do por­que não tem na­da pa­ra com­pa­rar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Al­gu­ma coi­sa no pei­to de Noct, que ti­nha co­me­ça­do a abrir, fe­chou de no­vo. Com um cli­que."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Ela sa­be­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­gu­ra riu. Não pe­lo na­riz. Um ri­so re­don­do, bo­ni­to, er­ra­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ten­ta de no­vo ama­nhã — dis­se ela. E en­tão, mais bai­xo, com a voz es­cor­re­gan­do um pou­co pa­ra o la­do: — Ten­ta de no­vo pra sem­pre."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela se le­van­tou do ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a por­ta atrás de­la cha­mou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O cha­ma­do não era um som. Era uma on­da. Um anel de luz ver­me­lha que saiu da fres­ta da por­ta e atra­ves­sou o sa­lão in­tei­ro, ren­te ao chão, e on­de pas­sa­va o ar tre­mia e a pe­le de Noct ar­re­pi­a­va co­mo se al­guém ti­ves­se di­to o no­me de­le bem per­to do ou­vi­do. Ele pu­lou por ci­ma. O anel pas­sou de­bai­xo das bo­tas e foi se des­fa­zer no es­cu­ro atrás de­le."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ou­tro veio. Mais al­to. Ele se jo­gou pa­ra a fren­te, ren­te ao chão, por bai­xo, e sen­tiu o ca­lor de­le na nu­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­gu­ra não ata­ca­va. An­da­va. De­va­gar, em vol­ta de­le, fa­lan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um dia de ca­da vez — dis­se ela, com a voz de­la. E de­pois, com a ou­tra: — ...não. Fi­ca. To­dos os di­as. Aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct cor­reu pa­ra ela. O pri­mei­ro so­co en­trou na es­táti­ca e atra­ves­sou, e a es­táti­ca se fe­chou em vol­ta do pu­nho co­mo água fria. A fi­gu­ra re­cuou, on­du­lou, e vol­tou a ser in­tei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­to lo­go — dis­se ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele a acer­tou de no­vo. E de no­vo. Ca­da gol­pe ar­ran­ca­va fa­ís­cas ver­me­lhas da for­ma de­la, e ca­da fa­ís­ca, ao cair no chão, vi­ra­va uma si­lhu­e­ta. Pe­que­nas, pre­tas, cha­pa­das. Ze­no, sem o ca­ja­do. O Fo­ras­tei­ro, sem o cha­péu. Uma fi­gu­ra mi­ú­da en­ro­la­da nu­ma man­ta. Vi­nham até ele de bra­ços es­ten­di­dos, re­pe­tin­do uma fra­se qual­quer, e ele as der­ru­ba­va com o an­te­bra­ço, sem olhar pa­ra elas, e elas se des­fa­zi­am em fu­ma­ça ao to­car o chão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê co­ça a so­bran­ce­lha quan­do men­te — dis­se a fi­gu­ra, do ou­tro la­do do sa­lão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pa­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê co­ça a so­bran­ce­lha quan­do men­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— "/>
                <ITEXT CPARENT="c_it" CH="Pa­ra de usar as fra­ses de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela pa­rou. In­cli­nou a ca­be­ça de no­vo. E quan­do fa­lou, foi com ou­tra voz. Uma que ele co­nhe­cia ain­da me­lhor que a de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu cha­mei ela com a sua voz — dis­se a por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O sa­lão in­tei­ro es­tre­me­ceu."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A por­ta, lá no fun­do, se abriu um pal­mo. A luz dou­ra­da en­trou de uma vez, quen­te, den­sa, e o chão de pe­dra co­me­çou a se des­fa­zer em pe­da­ços, que flu­tu­a­vam e ca­í­am de­va­gar no es­cu­ro, um de ca­da vez, do jei­to que ca­em as coi­sas que nin­guém vai jun­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não se me­xeu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou nas noi­tes em que ela fi­cou acor­da­da. Em to­das as ve­zes que olhou pe­la ja­ne­la. Na por­ta cha­man­do por ela, de noi­te, e ela sem di­zer na­da. Pen­sou, pe­la pri­mei­ra vez, no que a por­ta po­dia ter di­to pa­ra ela. Com que voz."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ra­po­si­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to de­le acen­deu in­tei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Es­sa voz tam­bém não é sua."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os anéis vi­nham dos dois la­dos ago­ra. Da por­ta e do es­cu­ro. Ele pu­la­va de pe­da­ço em pe­da­ço de chão en­quan­to eles ca­í­am, e os anéis pas­sa­vam por ci­ma e por bai­xo, e a es­táti­ca ver­me­lha pis­ca­va pe­lo sa­lão, su­min­do aqui e apa­re­cen­do ali, rápi­da de­mais pa­ra os pu­nhos de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Até que ela apa­re­ceu no ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­ta­da. No la­do es­quer­do. Com o pé em ci­ma do as­sen­to. Qui­e­ta, de re­pen­te, co­mo se a lu­ta ti­ves­se aca­ba­do e ela só es­ti­ves­se es­pe­ran­do o trem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele en­ten­deu sem que nin­guém ex­pli­cas­se. Era ali que a fi­gu­ra fi­ca­va in­tei­ra. Era ali que a por­ta se se­gu­ra­va ne­la. No úni­co lu­gar on­de ele nun­ca, em ne­nhum ban­co, em ne­nhu­ma noi­te, ti­nha ti­do co­ra­gem de en­cos­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O la­do es­quer­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct atra­ves­sou o sa­lão. Pa­rou na fren­te do ban­co. A fi­gu­ra le­van­tou a ca­be­ça pa­ra ele, sem ros­to, com a fi­ta no ca­be­lo, e por um se­gun­do foi tão pa­re­ci­da que ele sen­tiu os jo­e­lhos ce­de­rem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Sen­ta — dis­se ela, com a voz qua­se cer­ta. — Tem lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ba­teu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não com rai­va. Ele mes­mo se sur­preen­deu com is­so, de­pois. Não ha­via rai­va no gol­pe. Ha­via uma coi­sa mais can­sa­da e mais fir­me, uma coi­sa que di­zia "/>
                <ITEXT CPARENT="c_it" CH="não"/>
                <ITEXT CH=" do jei­to que se diz não pa­ra al­guém que se ama e que es­tá pe­din­do uma coi­sa er­ra­da. "/>
                <ITEXT CPARENT="c_it" CH="Não abre com rai­va."/>
                <ITEXT CH=" O pu­nho en­trou na es­táti­ca bem no meio do pei­to, e a es­táti­ca não se fe­chou em vol­ta de­le des­sa vez. Abriu. Ras­gou. E a luz dou­ra­da que va­zou de den­tro não era quen­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ba­teu de no­vo. E de no­vo. Até a fi­gu­ra sair do ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A fi­gu­ra não mor­reu."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="En­co­lheu. A es­táti­ca foi se re­co­lhen­do, fi­can­do me­nor, mais trans­pa­ren­te, per­den­do o ca­be­lo, per­den­do a fi­ta, per­den­do o for­ma­to de­la pe­da­ço por pe­da­ço, até ser só um bor­rão ver­me­lho do ta­ma­nho de uma mão, tre­men­do no ar en­tre Noct e a por­ta. E de­pois nem is­so. Só uma voz, atrás da ma­dei­ra es­cu­ra, fra­ca, qua­se sem fô­le­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Ela tam­bém não fi­cou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct es­ta­va de jo­e­lhos. Não lem­bra­va de ter ca­í­do. Os pu­nhos san­gra­vam de no­vo, por den­tro das lu­vas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra o ban­co. Os dois la­dos es­ta­vam va­zi­os."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não — dis­se ele. — Ela foi. Por mim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A por­ta não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O lu­gar on­de a fi­gu­ra ti­nha sen­ta­do ain­da bri­lha­va. Uma mar­ca fra­ca, car­me­sim, na ma­dei­ra gas­ta do ban­co, do ta­ma­nho de uma mão es­pal­ma­da."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct es­ten­deu a mão e en­cos­tou ne­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E lem­brou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era uma lem­bran­ça de­le. Ele nun­ca ti­nha es­ta­do ali. Era de­la. Fi­cou guar­da­da no ban­co, ou na por­ta, ou no ar da­que­le sa­lão, co­mo um bi­lhe­te es­que­ci­do num bol­so, es­pe­ran­do al­guém que pre­ci­sas­se ler."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Na­que­le dia, ela pa­rou di­an­te da por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela es­ta­va de pé do ou­tro la­do da­que­la mes­ma ma­dei­ra, di­an­te da por­ta. A fi­ta no ca­be­lo. Um xa­le ve­lho jo­ga­do nos om­bros, ain­da mo­lha­do da chu­va. As bo­tas com a la­ma da es­ta­ção já se­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="A por­ta cha­mou com a voz de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Cha­mou bai­xi­nho. "/>
                <ITEXT CPARENT="c_it" CH="Ra­po­si­nha."/>
                <ITEXT CH=" Cha­mou do jei­to que ele cha­ma­va quan­do que­ria ir­ri­tar, e do jei­to que ele nun­ca ad­mi­ti­ria que cha­ma­va quan­do não que­ria. Cha­mou com o can­sa­ço de­le, com a gros­se­ria de­le, com o sar­cas­mo de­le, com tu­do cer­ti­nho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ela riu. Pe­lo na­riz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê não é ele — dis­se Mi­ra pa­ra a por­ta. — Ele nun­ca me cha­ma­ria pra lon­ge de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela não es­ta­va com me­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era is­so que ele nun­ca ti­nha con­se­gui­do ima­gi­nar, em to­dos aque­les anos. Ele ti­nha ima­gi­na­do aque­la ma­nhã de mil jei­tos. Ela so­zi­nha, ela cho­ran­do, ela cha­man­do por ele. Ela com me­do. Sem­pre com me­do. E ele dor­min­do, de ver­da­de, lon­ge de­mais pa­ra ou­vir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não es­ta­va com me­do. Es­ta­va com pres­sa. Com pres­sa de aca­bar lo­go com aqui­lo e vol­tar pa­ra ca­sa an­tes de ele per­ce­ber, an­tes de ele fa­zer al­gu­ma coi­sa idi­o­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela sa­bia o que a por­ta que­ria. Ti­nha pas­sa­do se­ma­nas des­co­brin­do, so­zi­nha, no po­ço, na pe­dra, nas noi­tes acor­da­da. A por­ta não cha­ma­va ela por ela. Cha­ma­va por­que ela ia fi­car sem ele. Era ele que a por­ta ron­da­va: a rai­va de­le, a vi­da de mer­ce­ná­rio, o jei­to de en­trar em qual­quer bri­ga por di­nhei­ro. Ce­do ou tar­de ele ia ou­vir. E ia abrir com rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E sa­bia que só um no­me fe­cha­va aqui­lo. Um no­me da­do de li­vre von­ta­de. Um no­me que fi­zes­se fal­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Por is­so não con­tou na­da a ele. Ele te­ria vin­do no lu­gar de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Amar­rou o pró­prio no­me na fe­cha­du­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele viu ela fa­zer is­so. Viu ela pe­gar al­gu­ma coi­sa que não era um ob­je­to, al­gu­ma coi­sa que era "/>
                <ITEXT CPARENT="c_it" CH="ela"/>
                <ITEXT CH=", e pas­sar pe­la ar­go­la de fer­ro ver­me­lho da por­ta, e dar um nó. Um nó fir­me. O mes­mo nó que ti­nha da­do na fi­ta, no pul­so de­le, nu­ma noi­te de chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­to lo­go — dis­se ela, pa­ra nin­guém. Pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E de­pois não so­brou nin­guém di­an­te da por­ta. Só o nó. E uma fa­gu­lha, pe­que­na, que es­ca­pou do nó e saiu pe­la fres­ta de bai­xo, pro­cu­ran­do al­guém que dor­mia lon­ge da­li."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a lem­bran­ça aca­bou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Noct fi­cou de jo­e­lhos di­an­te do ban­co por mui­to tem­po."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="De­pois pas­sou o po­le­gar pe­la fi­ta no pul­so. Pe­lo nó. Ele ti­nha aper­ta­do aque­le nó tan­tas ve­zes, nos ban­cos, nas ca­ver­nas, no la­go, sem nun­ca en­ten­der por que as mãos de­le sa­bi­am aper­tar exa­ta­men­te aque­le, e mais ne­nhum."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Ela tam­bém sa­bia quan­do era men­ti­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Riu. Um ri­so cur­to, que­bra­do, pe­lo na­riz. Do jei­to de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois se le­van­tou e saiu pe­la mes­ma por­ta, de vol­ta pa­ra a pra­ça de ca­be­ça pa­ra bai­xo, e pas­sou pe­las si­lhu­e­tas sem olhar, e pe­lo ban­co va­zio sem sen­tar, e se­guiu as pe­ga­das car­me­sim ao con­trá­rio, até o po­ço. E dei­xou o Eco pu­xá-lo de vol­ta, do mes­mo jei­to que ti­nha pu­xa­do pa­ra den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Aves­so es­ta­va do mes­mo jei­to."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A ra­cha­du­ra no ar. As bor­das ver­me­lhas. A luz dou­ra­da lá den­tro, ba­lan­çan­do, con­vi­da­ti­va, e den­tro de­la o ban­co de dois lu­ga­res, e no la­do es­quer­do, a fi­gu­ra de fi­ta no ca­be­lo, com o pé em ci­ma do as­sen­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Fi­que — re­pe­tiu a voz da por­ta, co­mo se ele nun­ca ti­ves­se sa­í­do. — Aqui den­tro, ela ain­da es­tá es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra a fi­gu­ra no ban­co. E des­sa vez o olho de­le não es­cor­re­gou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não es­tá — dis­se ele, cal­mo. — Ela nun­ca te­ve me­do de vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A voz não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Aves­so in­tei­ro fi­cou em si­lên­cio. A por­ta res­pi­ra­va de­va­gar. A luz dou­ra­da ba­lan­ça­va lá den­tro, quen­te, co­mo uma ja­ne­la ace­sa nu­ma noi­te de chu­va."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct olhou pa­ra a fi­ta car­me­sim no pul­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou na pe­dra. "/>
                <ITEXT CPARENT="c_it" CH="Se eu res­pon­der com rai­va."/>
                <ITEXT CH=" Pen­sou no bi­lhe­te. "/>
                <ITEXT CPARENT="c_it" CH="Não faz na­da idi­o­ta."/>
                <ITEXT CH=" Pen­sou nu­ma noi­te de chu­va no te­lha­do, nu­ma voz no es­cu­ro di­zen­do "/>
                <ITEXT CPARENT="c_it" CH="se eu de­mo­rar pra vol­tar, vo­cê con­ti­nua an­dan­do"/>
                <ITEXT CH=", e nu­ma so­bran­ce­lha que não ti­nha co­ça­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou nu­ma por­ta de ma­dei­ra es­cu­ra, e num nó, e nu­ma ri­sa­da pe­lo na­riz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E pen­sou, por úl­ti­mo, nu­ma pra­ça de ma­nhã ce­do. Num ban­co de Pe­dra­ve­lha. Em Tes­sa, co­chi­lan­do no la­do es­quer­do, com uma man­ta que não era de­la nos om­bros. A Tes­sa de ver­da­de, que fa­zia per­gun­tas de­mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ha­via dois ca­mi­nhos. A por­ta aber­ta, com a luz e o ban­co lá den­tro. E, atrás de­le, o cor­re­dor por on­de ti­nha des­ci­do, es­cu­ro e lon­go, que le­va­va de vol­ta a um mun­do on­de ela não es­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era uma es­co­lha. Tal­vez a úni­ca de ver­da­de que ele ti­nha fei­to em anos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou pa­ra­do, olhan­do pa­ra a fi­ta, por mui­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="— Ela fe­chou es­sa por­ta pra eu po­der ir em­bo­ra."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Dis­se bai­xo. Mais pa­ra ele do que pa­ra a por­ta. A voz lá den­tro se ca­lou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não vou des­per­di­çar is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele le­vou a mão ao pul­so. De­sa­mar­rou a fi­ta. De­va­gar. O nó que ele ti­nha aper­ta­do tan­tas ve­zes, nos ban­cos, nas ca­ver­nas, no Aves­so, se des­fez en­tre os de­dos de­le. O nó de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Por um se­gun­do, pa­re­ceu que ele ia dei­xá-la ali. Pen­du­ra­da na bor­da da por­ta. Pa­ra ela. Pa­ra a fi­gu­ra no ban­co. Um adeus."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fi­cou com a fi­ta en­tre os de­dos, olhan­do pa­ra a luz dou­ra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E amar­rou de no­vo. Mais fir­me."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não abre com rai­va. Abre lem­bran­do de mim."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="E fe­cha tam­bém"/>
                <ITEXT CH=", pen­sou ele. "/>
                <ITEXT CPARENT="c_it" CH="Fe­cha lem­bran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se apro­xi­mou da por­ta. Es­ten­deu a mão aber­ta até a bor­da ver­me­lha, on­de o ar era quen­te co­mo pe­le. Em al­gum lu­gar do ou­tro la­do, pre­so nu­ma ar­go­la de fer­ro, es­ta­va o nó de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa acor­dou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não do­eu. Pe­la pri­mei­ra vez, não do­eu. Su­biu do pei­to de­va­gar, pe­lo om­bro, pe­lo bra­ço, quen­te co­mo uma mão se­gu­ran­do a de­le, e acen­deu na pon­ta dos de­dos. Ele sem­pre ti­nha acha­do que aqui­lo era de­le. A rai­va de­le, a dor de­le, a coi­sa que cres­cia nos ban­cos e nas lu­tas. Não era. Nun­ca ti­nha si­do. Era a fa­gu­lha que ti­nha es­ca­pa­do do nó, nu­ma ma­nhã de chu­va, pro­cu­ran­do al­guém que dor­mia lon­ge da­li. Era o pe­da­ço do se­lo que não sou­be fi­car sem ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A cha­ve."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A cha­ve gi­rou uma úl­ti­ma vez. Pa­ra o ou­tro la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O car­me­sim saiu da mão de­le e en­trou na por­ta, e do ou­tro la­do al­gu­ma coi­sa res­pon­deu. Ele sen­tiu an­tes de en­ten­der. O nó na ar­go­la se aper­tou so­zi­nho, fir­me, do jei­to tor­to e cer­to que só ela sa­bia dar, e as du­as pon­tas do se­lo se en­con­tra­ram de­pois de tan­tos anos, a de­le e a de­la, e se amar­ra­ram uma na ou­tra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era mais só o no­me de­la se­gu­ran­do a por­ta. Era o no­me de­la e a fal­ta que ele sen­tia, jun­tos. Do jei­to que sem­pre de­ve­ri­am ter si­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pron­to, ra­po­si­nha — dis­se ele, bai­xi­nho, com a tes­ta qua­se en­cos­ta­da na luz. — Ago­ra a gen­te fe­cha jun­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A por­ta se fe­chou de­va­gar, co­mo quem de­sis­te de cha­mar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não hou­ve ex­plo­são. Não hou­ve es­tron­do. As bor­das ver­me­lhas fo­ram se apro­xi­man­do uma da ou­tra, sem pres­sa, co­mo pál­pe­bras pe­sa­das, e a luz dou­ra­da lá den­tro foi fi­can­do me­nor, e me­nor, e o ban­co de dois lu­ga­res su­miu, e a fi­gu­ra de fi­ta no ca­be­lo su­miu, e por úl­ti­mo su­miu a voz, que não dis­se adeus por­que nun­ca ti­nha si­do ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão não ha­via mais na­da no cen­tro do sa­lão. Só ar. Só um ra­paz de pu­nhos san­gran­do, so­zi­nho, no fun­do do Aves­so, com uma fi­ta ver­me­lha amar­ra­da no pul­so. E o pei­to qui­e­to. Pe­la pri­mei­ra vez em anos, só pei­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá em ci­ma, mui­to lon­ge, em Pe­dra­ve­lha, a ra­cha­du­ra na bei­ra da vi­la pa­rou de res­pi­rar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se vi­rou. E co­me­çou a su­bir pe­lo cor­re­dor."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="68575.9055118111" OwnPage="198" ItemID="1102455401" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="68575.9055118111" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1102483033" BACKITEM="1058072313"/>
