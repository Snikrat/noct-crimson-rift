        <PAGEOBJECT XPOS="768.976377952756" YPOS="1023.77952755906" OwnPage="2" ItemID="826765833" PTYPE="2" WIDTH="39.6850393700787" HEIGHT="39.6850393700787" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.0413385826771654" LOCALSCY="0.0413385826771654" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="emblema_cinza.png" IRENDER="0" EMBEDDED="0" path="M0 0 L39.685 0 L39.685 39.685 L0 39.685 L0 0 Z" copath="M0 0 L39.685 0 L39.685 39.685 L0 39.685 L0 0 Z" gXpos="768.976377952756" gYpos="1023.77952755906" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="1545.66929133858" OwnPage="4" ItemID="824753561" PTYPE="4" WIDTH="334.488188976378" HEIGHT="255.118110236221" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 255.118 L0 255.118 L0 0 Z" copath="M0 0 L334.488 0 L334.488 255.118 L0 255.118 L0 0 Z" gXpos="621.574803149606" gYpos="1545.66929133858" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Para quem ainda espera do outro lado."/>
                <para PARENT="dedic"/>
                <ITEXT CH="Toda porta que chama de noite já foi, um dia, alguém esperando do outro lado."/>
                <trail PARENT="dedic_epi"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="2231.96850393701" OwnPage="6" ItemID="824471817" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="2231.96850393701" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="830967017" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Pró­lo­go"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="A ga­ro­ta que con­ta­va ra­po­sas"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="E"/>
                <ITEXT CH="ra uma vez uma ga­ro­ta que con­ta­va ra­po­sas."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não era um hábi­to que ela ex­pli­ca­va. Sen­ta­va no ban­co da es­ta­ção, sem­pre do la­do es­quer­do, e en­quan­to o trem se atra­sa­va ela olha­va a bei­ra dos tri­lhos, on­de o ma­to cres­cia al­to e a luz dos lam­pi­ões ter­mi­na­va. E lá, qua­se to­da noi­te, al­gu­ma coi­sa rui­va pa­ra­va e olha­va de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma. Du­as. Às ve­zes três."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Elas vêm por mim — di­zia ela, co­mo quem co­men­ta o tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ho­mem sen­ta­do do la­do di­rei­to do ban­co nun­ca acre­di­tou nis­so. Mas tam­bém nun­ca dis­se que não acre­di­ta­va, o que, pa­ra ele, era qua­se uma de­cla­ra­ção de amor."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­ta his­tó­ria não vai des­cre­ver o ros­to de­la. Não por­que ele te­nha es­que­ci­do. Por­que é a úni­ca coi­sa que ele ain­da guar­da in­tei­ra, e há coi­sas que um ho­mem só con­se­gue car­re­gar se nin­guém mais olhar pa­ra elas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O que se po­de con­tar é is­to: ela era pe­que­na o bas­tan­te pa­ra en­cos­tar a ca­be­ça no om­bro de­le sem pre­ci­sar se cur­var, e tei­mo­sa o bas­tan­te pa­ra fa­zer is­so quan­do ele es­ta­va de mau hu­mor. Di­zia que era por cau­sa do frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não es­ta­va frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Na úl­ti­ma noi­te, cho­veu."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não uma chu­va de tem­pes­ta­de, des­sas que fa­zem ba­ru­lho pa­ra se­rem no­ta­das. Uma chu­va pa­ci­en­te, que ba­tia no te­lha­do co­mo al­guém que tem a noi­te in­tei­ra e sa­be que vai ser aten­di­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela es­ta­va acor­da­da. Ele tam­bém, ca­la­do, de cos­tas pa­ra ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Há se­ma­nas ela ou­via ou­tra coi­sa por bai­xo da chu­va. Um zum­bi­do que nin­guém mais ou­via, fi­no co­mo um fio es­ti­ca­do. "/>
                <ITEXT CPARENT="c_it" CH="Pa­re­ce al­guém cha­man­do do ou­tro la­do de uma por­ta"/>
                <ITEXT CH=", ela ti­nha di­to a ele uma vez, e ele ti­nha res­pon­di­do que era can­sa­ço. Ela sor­riu da­que­le jei­to que sor­ria quan­do ele es­ta­va er­ra­do e ela não ia dis­cu­tir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E já não era só ou­vir. Al­gu­mas ma­dru­ga­das, en­quan­to ele dor­mia, o la­do es­quer­do da ca­ma es­fri­a­va, e a por­ta da ca­sa ran­gia bai­xi­nho, uma vez pa­ra sair e, ho­ras de­pois, ou­tra pa­ra vol­tar. Ele nun­ca acor­dou. Nun­ca sou­be. O que ele via eram os di­as: ela mais qui­e­ta, mais lon­ge, com olhei­ras que ne­nhu­ma noi­te cu­ra­va, as bo­tas su­jas de uma la­ma que não era da es­tra­da de­les, uma fo­lha do­bra­da no bol­so que ela guar­da­va an­tes que ele vis­se. Es­ta­va ali e não es­ta­va. Ele re­pa­ra­va, e acha­va que era can­sa­ço. O mes­mo can­sa­ço que ele ti­nha man­da­do ela cu­rar dor­min­do. Pen­sa­va que ia pas­sar, co­mo pas­sa­vam as se­ma­nas ru­ins, e que um dia ela ia con­tar, do jei­to de­la, na ho­ra de­la. Não per­gun­tou. Não por me­do da res­pos­ta. Por­que nun­ca lhe pas­sou pe­la ca­be­ça que hou­ves­se uma per­gun­ta a fa­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O que os dois dis­se­ram na­que­la noi­te per­ten­ce a ele. Um pou­co mais adi­an­te nes­te li­vro, al­guém vai ten­tar ti­rar is­so de­le, e ele vai pre­ci­sar lu­tar pa­ra lem­brar. Por en­quan­to, bas­ta sa­ber que ele fez uma pro­mes­sa, e que a mão de­le não foi até a so­bran­ce­lha quan­do pro­me­teu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="An­tes de ama­nhe­cer, ela se le­van­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ves­tiu-se no es­cu­ro, de­va­gar, pa­ra não acor­dá-lo. Ele ti­nha dor­mi­do, en­fim, co­mo dor­mia em to­das as ou­tras ma­dru­ga­das em que ela sa­ía. Só que des­ta vez ela não ia vol­tar an­tes do sol. Há des­pe­di­das que só ca­bem no si­lên­cio, e ela era ge­ne­ro­sa de­mais pa­ra acor­dá-lo pa­ra uma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na me­sa, dei­xou um bi­lhe­te. Do­bra­do uma vez só, por­que ela não ti­nha pa­ciên­cia pa­ra do­brar coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Vol­to lo­go. Não faz na­da idi­o­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois saiu pa­ra a chu­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Na es­ta­ção, o qua­dro de ho­rá­rios ain­da es­ta­va in­tei­ro. Nin­guém ti­nha ris­ca­do na­da. O pri­mei­ro trem da ma­nhã che­gou no ho­rá­rio, o que nun­ca acon­te­cia, e, no fim da li­nha, o si­na­lei­ro ano­tou na pa­re­de da ca­bi­ne de­le, com a le­tra tor­ta de quem es­tá com so­no:"/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CPARENT="c_it" CH="Pri­mei­ro trem da ma­nhã. Um pas­sa­gei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na la­ma da pla­ta­for­ma fi­ca­ram pe­ga­das pe­que­nas. Iam até a bei­ra dos tri­lhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ne­nhu­ma vol­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na mar­gem do ma­to, on­de a luz ter­mi­na­va, uma ra­po­sa as­sis­tiu ao trem par­tir. Fi­cou ali mui­to de­pois de o ba­ru­lho su­mir, co­mo quem es­pe­ra al­guém que pro­me­teu vol­tar lo­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Is­to não é a his­tó­ria de­la."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ela te­ria ri­do des­sa fra­se. Te­ria di­to que ele sem­pre foi péssi­mo em con­tar as coi­sas na or­dem cer­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Is­to é a his­tó­ria do ho­mem que fi­cou. Do ho­mem que acor­dou com um bi­lhe­te na me­sa e uma fi­ta car­me­sim no pul­so, e que pas­sou anos acre­di­tan­do que ti­nha de­sis­ti­do de tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não ti­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele con­ti­nuou an­dan­do."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="2838.89763779528" OwnPage="7" ItemID="830967017" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="2838.89763779528" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="828679641" BACKITEM="824471817"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="2838.89763779528" OwnPage="8" ItemID="828679641" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="2838.89763779528" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="830967017"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="3635.74803149606" OwnPage="10" ItemID="831127209" PTYPE="4" WIDTH="334.488188976378" HEIGHT="226.771653543307" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" copath="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" gXpos="621.574803149606" gYpos="3635.74803149606" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Parte I"/>
                <para PARENT="parte_num"/>
                <ITEXT CH="Pedravelha"/>
                <para PARENT="parte"/>
                <ITEXT CH="Existem lugares que não são lar de ninguém, mas que guardam as coisas que as pessoas esquecem de levar quando vão embora. Pedravelha era um deles. Guardava silêncio, principalmente."/>
                <trail PARENT="parte_epi"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="771.811023622047" YPOS="3890.86614173228" OwnPage="10" ItemID="832604953" PTYPE="2" WIDTH="34.0157480314961" HEIGHT="34.0157480314961" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.0354330708661417" LOCALSCY="0.0354330708661417" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="emblema_cinza.png" IRENDER="0" EMBEDDED="0" path="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" copath="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" gXpos="771.811023622047" gYpos="3890.86614173228" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="4307.87401574803" OwnPage="12" ItemID="826266361" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="4307.87401574803" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="842298585" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 1"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Du­as sa­í­das, uma tor­re"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH=" es­tra­da que le­va­va a Pe­dra­ve­lha não que­ria ser en­con­tra­da."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Su­bia e des­cia por en­tre pe­dras cin­zen­tas, su­mia de­bai­xo de ma­to al­to, re­a­pa­re­cia do ou­tro la­do de um ri­a­cho que não ti­nha pon­te. Qual­quer vi­a­jan­te sen­sa­to te­ria de­sis­ti­do na ter­cei­ra cur­va. Noct não era um vi­a­jan­te sen­sa­to. Era só um ho­mem de lu­vas de cou­ro gas­tas nos pu­nhos, uma man­ta de vi­a­gem es­cu­ra en­ro­la­da nas cos­tas e ne­nhum mo­ti­vo par­ti­cu­lar pa­ra es­tar em ou­tro lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Di­nhei­ro pa­ga co­mi­da"/>
                <ITEXT CH=", pen­sou, por­que era o que sem­pre pen­sa­va quan­do al­guém lhe per­gun­ta­va por que ven­dia os pu­nhos a quem pa­gas­se. Nin­guém ti­nha per­gun­ta­do. Ele pen­sou mes­mo as­sim. Era um bom hábi­to ter a res­pos­ta pron­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O que ele não pen­sa­va, nun­ca de pro­pósi­to, era no res­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No co­me­ço, ele pen­sou. No co­me­ço, ele só pen­sa­va ne­la. Pro­cu­rou em to­das as es­ta­ções da li­nha, me­nos na de­les. Nas fei­ras, nas ta­ver­nas, nas tri­lhas on­de nin­guém ti­nha vis­to nin­guém. Mos­trou o bi­lhe­te a es­tra­nhos, co­mo se o pa­pel pu­des­se res­pon­der por ela. Nin­guém sa­bia. Nin­guém nun­ca sa­bia. E por bai­xo da pro­cu­ra, o tem­po to­do, ha­via a per­gun­ta que ele nun­ca dis­se em voz al­ta: se ela sim­ples­men­te ti­nha ido em­bo­ra. Uma dúvi­da que só nas­ceu de­pois do bi­lhe­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois de um tem­po, pa­rou de per­gun­tar. De­pois de mais um tem­po, pa­rou de pro­cu­rar. Os anos fo­ram se em­pi­lhan­do do jei­to que se em­pi­lham pa­ra quem não es­tá con­tan­do, um em ci­ma do ou­tro, to­dos iguais. Ele co­mia por­que o cor­po pe­dia. Dor­mia quan­do ca­ía. Vi­rou mer­ce­ná­rio por­que bri­ga ocu­pa­va as mãos. Es­col­ta de car­ro­ça, co­bran­ça, bi­cho em po­rão, ru­í­na que nin­guém que­ria abrir: qual­quer ser­vi­ço que pa­gas­se bem. Qua­se qual­quer um. Não ba­tia em quem não po­dia ba­ter de vol­ta. Não le­va­va nin­guém amar­ra­do pa­ra lu­gar ne­nhum. E nun­ca per­gun­ta­va o no­me de quem pa­ga­va. E ten­ta­va es­que­cer, to­dos os di­as, com uma dis­ci­pli­na que nun­ca ti­nha ti­do pa­ra mais na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só que, quan­to mais ele ten­ta­va es­que­cer, mais al­to al­gu­ma coi­sa cha­ma­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E o res­to, aque­le em que ele não pen­sa­va, era o zum­bi­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não o mes­mo que ela ou­via. Pe­lo me­nos era o que ele di­zia a si mes­mo. O de­le vi­nha de den­tro, de al­gum lu­gar atrás das cos­te­las, e se pa­re­cia me­nos com al­guém cha­man­do e mais com uma bra­sa que se re­cu­sa a apa­gar. Fa­zia anos que es­ta­va ali. Des­de de­pois. Ele não cha­ma­va aqui­lo de na­da, por­que dar no­me a uma coi­sa é ad­mi­tir que ela vai fi­car."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os ou­tros, os que não sen­ti­am na­da no pei­to, cha­ma­vam o que es­ta­va acon­te­cen­do com o mun­do de fen­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E quan­to mais per­to ele che­ga­va de Pe­dra­ve­lha, mais a bra­sa se acen­dia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele já ti­nha es­ta­do ali. Du­as ve­zes, tal­vez três, em dia de fei­ra, meio pas­so atrás de­la, car­re­gan­do as com­pras e re­cla­man­do do sol. Nun­ca por aque­la es­tra­da. Sem­pre pe­la tri­lha da ser­ra, do ou­tro la­do, a que des­cia até a es­ta­ção e até uma ca­sa on­de ele não en­tra­va fa­zia anos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não lem­bra­va de nin­guém da vi­la. Ti­nha cer­te­za de que nin­guém lem­bra­va de­le. Era a van­ta­gem de ter si­do, a vi­da in­tei­ra, o que an­da­va atrás."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era só mais um ser­vi­ço, re­pe­tiu pa­ra si mes­mo. Al­guém nu­ma ta­ver­na ti­nha di­to que em Pe­dra­ve­lha pa­ga­vam bem a quem en­tras­se nas ru­í­nas. Mer­ce­ná­rios iam aon­de pa­ga­vam. Não ti­nha na­da a ver com a bra­sa, nem com a di­re­ção pa­ra on­de ela pu­xa­va. Ti­nha pa­ra­do em Pe­dra­ve­lha por aca­so. Era o que ele acha­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A vi­la apa­re­ceu de uma vez, co­mo as coi­sas apa­re­cem em so­nhos: não es­ta­va, e en­tão es­ta­va."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ca­sas de pe­dra es­cu­ra com te­lha­dos que um dia ti­nham si­do ver­me­lhos. Lam­pi­ões de fer­ro ain­da ace­sos, em­bo­ra fos­se fim de tar­de e nin­guém na rua pa­re­ces­se pre­ci­sar de luz. Uma car­ro­ça pa­ra­da per­to de uma pi­lha de cai­xas, sem ca­va­lo. Um po­ço no meio da pra­ça, com a cor­da ain­da pre­sa na rol­da­na. E, mais al­to que tu­do, uma tor­re de si­no, fi­na e tor­ta, com a ca­ra de quem es­ta­va ali des­de an­tes de as ca­sas te­rem no­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou no co­me­ço da rua e fez o que sem­pre fa­zia an­tes de en­trar em qual­quer lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma tri­lha su­bin­do pa­ra a es­quer­da, em di­re­ção a uma ser­ra de pe­dra. Ou­tra des­cen­do à di­rei­ta, su­min­do num bos­que. A tor­re. As ja­ne­las. Atrás de qua­se to­das, uma som­bra que se afas­ta­va rápi­do de­mais quan­do ele vi­ra­va a ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pe­dra­ve­lha — mur­mu­rou. — Du­as sa­í­das, uma tor­re e gen­te de­mais olhan­do pe­la ja­ne­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ven­to pas­sou pe­la rua e não trou­xe ne­nhum som. Nem ca­chor­ro, nem cri­an­ça, nem pa­ne­la. Só o ran­gi­do da cor­da do po­ço, ba­lan­çan­do so­zi­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Qui­e­ta de­mais"/>
                <ITEXT CH=", pen­sou ele. E de­pois, em voz bai­xa, por­que cer­tas coi­sas so­am mais ver­da­dei­ras di­tas:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Qui­e­ta de­mais pra tão per­to da fen­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa atrás das cos­te­las con­cor­dou com ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela es­ta­va ali, a fen­da, ou um pe­da­ço de­la. Na bei­ra da vi­la, on­de a rua aca­ba­va con­tra a en­cos­ta, di­an­te da bo­ca ta­pa­da de uma mi­na ve­lha, ha­via uma ra­cha­du­ra na pe­dra. Fi­na, ver­ti­cal, ver­me­lha, co­mo uma por­ta que al­guém es­que­ceu en­cos­ta­da. Não bri­lha­va mui­to. Só res­pi­ra­va, de­va­gar, do jei­to que res­pi­ram as coi­sas que es­pe­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De ma­nhã qua­se não se via. Nas noi­tes de chu­va, con­ta­ria Ze­no de­pois, ela acen­dia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O pri­mei­ro mo­ra­dor a sair de ca­sa foi um ve­lho."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ti­nha as cos­tas cur­va­das co­mo um ga­lho que cres­ceu con­tra o ven­to e uma bar­ba que não via te­sou­ra há anos. An­da­va de­va­gar, mas não com cui­da­do; an­da­va de­va­gar co­mo quem sa­be que não vai per­der na­da que va­lha a pe­na cor­rer atrás. Pa­rou a três pas­sos de Noct, apoi­a­do num ca­ja­do, e o me­diu da ca­be­ça aos pés."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct dei­xou. Me­diu de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os olhos do ve­lho eram cla­ros, líqui­dos, e pa­ra­ram um se­gun­do a mais no pul­so de­le. Na fi­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não es­con­deu a mão. Es­con­der se­ria ad­mi­tir que ha­via al­go pa­ra es­con­der."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Se o ve­lho re­co­nhe­ceu al­gu­ma coi­sa, não dis­se. Só aper­tou um pou­co mais o ca­ja­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Mais um vi­a­jan­te — dis­se o ve­lho, en­fim, com a voz de quem fa­la mais com o tem­po do que com as pes­so­as. — O pân­ta­no a les­te en­go­liu mui­tos an­tes de vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um pân­ta­no com ape­ti­te. — Noct ajei­tou as lu­vas nos pu­nhos. — Óti­mo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ve­lho não riu. Mas al­gu­ma coi­sa no can­to da bo­ca de­le, es­con­di­da pe­la bar­ba, tal­vez te­nha con­si­de­ra­do rir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ze­no — dis­se, ba­ten­do no pró­prio pei­to com dois de­dos. — Mo­ro aqui des­de que a tor­re era re­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="A tor­re nun­ca foi re­ta"/>
                <ITEXT CH=", pen­sou Noct. Fi­cou ca­la­do. Era evi­den­te que o ve­lho sa­bia dis­so, e que a fra­se era uma pi­a­da que ele con­ta­va há cin­quen­ta anos pa­ra pes­so­as que nun­ca a en­ten­di­am."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ze­no apon­tou com o ca­ja­do pa­ra o meio da pra­ça, per­to do po­ço, on­de ha­via um ban­co de fer­ro es­cu­ro, com­pri­do o bas­tan­te pa­ra du­as pes­so­as."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Quan­do pe­sar de­mais, sen­ta ali. Aque­le ban­co já se­gu­rou mui­ta gen­te que acha­va que não ia le­van­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra o ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era só um ban­co. Pés de fer­ro tra­ba­lha­do, tá­bu­as de ma­dei­ra gas­ta no as­sen­to e no en­cos­to, on­de ge­ra­ções de cos­tas ti­nham se apoi­a­do, e no al­to do en­cos­to uma pe­dri­nha ver­me­lha que pe­ga­va a luz do lam­pi­ão. Du­as pon­tas. Dois lu­ga­res."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Al­gu­ma coi­sa se fe­chou den­tro de­le, de­va­gar e com fir­me­za, co­mo uma mão fe­chan­do uma ga­ve­ta que não de­ve­ria ter si­do aber­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E foi só is­so que dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O ve­lho não foi em­bo­ra. Ve­lhos ra­ra­men­te vão, quan­do per­ce­bem que en­con­tra­ram al­guém que va­le a pe­na ob­ser­var."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="— Vo­cê pa­re­ce can­sa­do — dis­se Ze­no."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Obri­ga­do. Eu me es­for­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Dur­ma um pou­co no ban­co. Ve­lhos sa­bem des­sas coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct vi­rou o ros­to pa­ra ele, só um pou­co, só o su­fi­ci­en­te pa­ra que o ve­lho per­ce­bes­se que es­ta­va sen­do vis­to de ver­da­de pe­la pri­mei­ra vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ve­lhos sa­bem de mui­ta coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era uma per­gun­ta. Ze­no tam­bém não a tra­tou co­mo uma. Ape­nas se apoi­ou me­lhor no ca­ja­do e olhou na mes­ma di­re­ção que Noct es­ta­va olhan­do: pa­ra além dos te­lha­dos, pa­ra les­te, on­de o céu ti­nha uma cor que não era bem do pôr do sol. Um ver­me­lho mais fun­do, qua­se es­cu­ro, co­mo uma fe­ri­da vis­ta por bai­xo da pe­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tem me­do do que tem lá fo­ra, ra­paz?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Cons­tan­te­men­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ve­lho pis­cou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê es­tá brin­can­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct dei­xou o si­lên­cio du­rar exa­ta­men­te o tem­po ne­ces­sá­rio pa­ra que o ou­tro co­me­ças­se a du­vi­dar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tal­vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão sor­riu. Um sor­ri­so de can­to, pe­que­no, que não che­ga­va aos olhos e não ti­nha a me­nor in­ten­ção de che­gar. Ze­no o ob­ser­vou com a pa­ciên­cia de quem já viu mui­tos sor­ri­sos as­sim, em mui­tos ros­tos, e sa­be exa­ta­men­te o que eles es­tão se­gu­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Mi­nha avó di­zia que a vi­la foi cons­tru­í­da em ci­ma de uma por­ta — dis­se Ze­no, ain­da olhan­do pa­ra o les­te. — E que de tem­pos em tem­pos ela lem­bra dis­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E ago­ra ela lem­brou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ve­lho não res­pon­deu. Não pre­ci­sa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm — fez o ve­lho, de­vol­ven­do a pa­la­vra a ele, co­mo quem de­vol­ve um tro­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E foi em­bo­ra, afi­nal, ba­ten­do o ca­ja­do nas pe­dras."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A noi­te che­gou em Pe­dra­ve­lha sem pres­sa e sem es­tre­las."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct com­prou um pe­da­ço de pão e um ca­ne­co de al­gu­ma coi­sa quen­te de uma mu­lher que não quis di­zer o no­me e não quis olhar pa­ra a fi­ta de­le. Co­meu de pé, en­cos­ta­do na pa­re­de de uma ca­sa, ob­ser­van­do a pra­ça se es­va­zi­ar das pou­cas som­bras que ain­da ha­via ne­la. As ja­ne­las fo­ram se fe­chan­do uma por uma. Os lam­pi­ões fi­ca­ram ace­sos. Nin­guém apa­re­ceu pa­ra apa­gá-los, e ele sus­pei­tou que nin­guém apa­ga­va aque­les lam­pi­ões ha­via mui­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do a rua fi­cou com­ple­ta­men­te va­zia, ele foi até o ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não por­que pe­sas­se. Não por­que acre­di­tas­se que um ban­co pu­des­se se­gu­rar al­guém. Por­que as per­nas es­ta­vam can­sa­das, e um ho­mem can­sa­do se sen­ta on­de tem lu­gar, e não há na­da mais nis­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­tou-se na pon­ta da di­rei­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ou­tro la­do fi­cou va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não olhou pa­ra lá. Nun­ca olha­va. Era uma re­gra tão an­ti­ga que já não pa­re­cia uma re­gra, só o jei­to co­mo o cor­po de­le fun­ci­o­na­va ago­ra: sen­ta­va nu­ma pon­ta, dei­xa­va a ou­tra, e o mun­do po­dia ti­rar as con­clu­sões que qui­ses­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O mun­do, na­que­la noi­te, ti­rou pou­cas. A pra­ça es­ta­va de­ser­ta. Só a cor­da do po­ço, ran­gen­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct apoi­ou os co­to­ve­los nos jo­e­lhos e fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Cin­co mi­nu­tos — dis­se pa­ra nin­guém. — De­pois o mun­do po­de vol­tar a ten­tar me ma­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os de­dos da mão es­quer­da en­con­tra­ram a fi­ta no pul­so di­rei­to. Ele não ti­nha man­da­do que en­con­tras­sem. Nun­ca man­da­va. Eles sim­ples­men­te iam até lá, co­mo a lín­gua vai até o lu­gar de um den­te que caiu, e fi­ca­vam ali, pas­san­do de­va­gar pe­lo nó, pe­lo te­ci­do gas­to, pe­la cor que nun­ca des­bo­ta­va di­rei­to por mais chu­va que le­vas­se."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Um dia de ca­da vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era o ti­po de fra­se que só ser­ve pa­ra uma coi­sa: che­gar até ama­nhã. Ele a re­pe­tia co­mo quem con­ta de­graus no es­cu­ro. Não pen­sa­va no que ela sig­ni­fi­ca­va. Não pen­sa­va em quem ti­nha di­to pri­mei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sa­va, mas não pen­sa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era uma ha­bi­li­da­de que ele ti­nha aper­fei­ço­a­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Foi quan­do abriu os olhos que viu a ra­po­sa."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Es­ta­va pa­ra­da na bei­ra da luz do lam­pi­ão, on­de as pe­dras da pra­ça ter­mi­na­vam e co­me­ça­va o es­cu­ro da tri­lha do bos­que. Pe­que­na, ma­gra, o pe­lo de um rui­vo tão pro­fun­do que pa­re­cia ace­so por den­tro. A cau­da bai­xa. As ore­lhas em pé."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhan­do pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não co­mo os ani­mais olham pa­ra as pes­so­as, ava­li­an­do se vão fu­gir ou ata­car. Olhan­do co­mo quem re­co­nhe­ce."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não se me­xeu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não res­pi­rou, tam­bém, ou tal­vez te­nha res­pi­ra­do e não te­nha per­ce­bi­do. A bra­sa atrás das cos­te­las deu um úni­co pul­so, for­te, quen­te, e de­pois fi­cou es­tra­nha­men­te qui­e­ta, co­mo se tam­bém es­ti­ves­se olhan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ra­po­sa in­cli­nou a ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sen­tiu a gar­gan­ta fe­char de um jei­to que não ti­nha na­da a ver com me­do e tu­do a ver com uma es­ta­ção de trem, com um ban­co de ma­dei­ra, com uma voz que con­ta­va "/>
                <ITEXT CPARENT="c_it" CH="uma, du­as, às ve­zes três"/>
                <ITEXT CH=" en­quan­to o trem se atra­sa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não"/>
                <ITEXT CH=", pen­sou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só is­so. "/>
                <ITEXT CPARENT="c_it" CH="Não."/>
                <ITEXT CH=" Co­mo quem fe­cha uma por­ta com o pé."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ra­po­sa fi­cou mais um ins­tan­te. De­pois se vi­rou, sem pres­sa, e su­miu no es­cu­ro da tri­lha, a pon­ta bran­ca da cau­da sen­do a úl­ti­ma coi­sa a de­sa­pa­re­cer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct con­ti­nuou sen­ta­do por mui­to tem­po. Tem­po de­mais pa­ra um ho­mem que só ti­nha se sen­ta­do pa­ra des­can­sar as per­nas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ar fi­cou cur­to. Não de re­pen­te: foi di­mi­nu­in­do, co­mo se a pra­ça es­ti­ves­se en­co­lhen­do em vol­ta de­le. O co­ra­ção su­biu pa­ra a gar­gan­ta e ba­teu ali, al­to de­mais, nos ou­vi­dos, nos den­tes. As mãos fi­ca­ram fri­as den­tro das lu­vas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele con­tou as pe­dras do chão até a bor­da da luz. Do­ze. Con­tou de no­vo. Do­ze. Aper­tou a bei­ra do ban­co até a ma­dei­ra mor­der a pal­ma, e es­pe­rou, por­que já sa­bia que aqui­lo pas­sa­va se ele es­pe­ras­se. Sem­pre pas­sa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só nun­ca pa­re­cia que ia pas­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Oi — dis­se, por fim, pa­ra o lu­gar on­de ela ti­nha es­ta­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pa­la­vra saiu tão bai­xa que nem a cor­da do po­ço a ou­viu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E do ou­tro la­do do ban­co, on­de nin­guém es­ta­va sen­ta­do, o si­lên­cio pa­re­ceu, só por um se­gun­do, um pou­co me­nos va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se le­van­tou an­tes de pen­sar nis­so. Pen­sar nis­so não era per­mi­ti­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ama­nhã ha­via ru­í­nas. Ama­nhã ha­via ser­vi­ço, mo­e­da e coi­sas com den­tes. Ama­nhã ha­via a fen­da, cha­man­do de al­gum lu­gar sob aque­la vi­la qui­e­ta de­mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ho­je pri­mei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ama­nhã de­pois."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="4914.8031496063" OwnPage="13" ItemID="842298585" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="4914.8031496063" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="841841721" BACKITEM="826266361"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="4914.8031496063" OwnPage="14" ItemID="841841721" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="4914.8031496063" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="842135705" BACKITEM="842298585"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="5606.77165354331" OwnPage="15" ItemID="842135705" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="5606.77165354331" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="842131593" BACKITEM="841841721"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="5606.77165354331" OwnPage="16" ItemID="842131593" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="5606.77165354331" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="845093977" BACKITEM="842135705"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="6298.74015748032" OwnPage="17" ItemID="845093977" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="6298.74015748032" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="845259257" BACKITEM="842131593"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="6298.74015748032" OwnPage="18" ItemID="845259257" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="6298.74015748032" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="844513225" BACKITEM="845093977"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="6990.70866141732" OwnPage="19" ItemID="844513225" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="6990.70866141732" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="845091113" BACKITEM="845259257"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="6990.70866141732" OwnPage="20" ItemID="845091113" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="6990.70866141732" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="844513225"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="7767.71653543307" OwnPage="21" ItemID="846940681" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="7767.71653543307" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="853283593" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 2"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Sau­da­de sem do­no"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="N"/>
                <ITEXT CH="a ma­nhã se­guin­te, Pe­dra­ve­lha ama­nhe­ceu co­mo se a noi­te não ti­ves­se acon­te­ci­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="As ja­ne­las se abri­ram. Al­guém var­reu uma so­lei­ra. Um ho­mem de bar­ba rui­va e bra­ços do ta­ma­nho de tran­cas de por­ta co­me­çou a ba­ter fer­ro nu­ma bi­gor­na do ou­tro la­do da pra­ça, e o som eco­ou pe­las ca­sas co­mo um co­ra­ção tei­mo­so. Brom, o fer­rei­ro, se­gun­do a mu­lher do pão. Ela dis­se is­so sem que Noct per­gun­tas­se, o que ele in­ter­pre­tou co­mo um pro­gres­so nas re­la­ções di­plo­máti­cas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ti­nha dor­mi­do pou­co e mal, e ti­nha so­nha­do com tri­lhos. Acor­dou com o pe­so de sem­pre no pei­to, um pe­so sem mo­ti­vo, que che­ga­va an­tes de ele abrir os olhos e só ia em­bo­ra quan­do que­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na bei­ra de um te­lha­do, do ou­tro la­do da pra­ça, al­gu­ma coi­sa rui­va pa­rou con­tra o céu cla­ro. Quan­do ele olhou di­rei­to, não ha­via na­da. Só te­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pen­sou nis­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A mu­lher que o en­con­trou per­to do po­ço usa­va um hábi­to cin­za, sim­ples, sem ne­nhum bor­da­do, e um ros­to que ti­nha apren­di­do a ser cal­mo à cus­ta de mui­to es­for­ço. Não era bo­ni­ta nem feia. Era aten­ta. E aque­la cal­ma não era na­tu­ral, era tra­ba­lho: Noct re­co­nhe­ceu na ho­ra, por­que ele fa­zia a mes­ma coi­sa com o sar­cas­mo. Uma ca­ra mon­ta­da to­do dia pa­ra nin­guém ver o que ti­nha em­bai­xo."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ela não dis­se bom-dia. Dis­se, olhan­do pa­ra as mãos de­le:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Is­so que so­be das cri­a­tu­ras quan­do elas ca­em. Vo­cê sa­be o que é?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct bai­xou os olhos pa­ra as pró­prias mãos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via na­da ne­las, ou na­da que um olho co­mum vis­se. Mas ele sa­bia do que ela es­ta­va fa­lan­do. Na es­tra­da até ali, as coi­sas que ti­nham pu­la­do do ma­to com den­tes de­mais e pe­le de me­nos ti­nham ca­í­do sob os pu­nhos de­le, e de ca­da uma ti­nha su­bi­do al­gu­ma coi­sa. Uma né­voa páli­da, fria, que não se dis­sol­via no ar. Que vi­nha até ele, co­mo água pro­cu­ran­do o pon­to mais bai­xo, e en­tra­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não ti­nha pe­di­do. Nin­guém ti­nha per­gun­ta­do se ele que­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu sei o que ela faz — dis­se. — Não pe­di por ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nin­guém pe­de. — A mu­lher in­cli­nou a ca­be­ça, e o véu do hábi­to caiu pa­ra o la­do co­mo uma asa can­sa­da. — Tu­do que a fen­da to­ca car­re­ga um pou­co do que al­guém per­deu. Quan­do cai, so­bra is­so. Sau­da­de sem do­no. — Olhou pa­ra o pei­to de­le. — Ela pro­cu­ra um lu­gar va­zio pra fi­car. Em vo­cê, en­con­trou."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Lu­gar va­zio"/>
                <ITEXT CH=", pen­sou ele. "/>
                <ITEXT CPARENT="c_it" CH="Não fal­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão que pro­cu­re ou­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não sor­riu, mas tam­bém não re­cuou. Apre­sen­tou-se co­mo Ir­mã Lí­via, sem di­zer de que or­dem, e en­si­nou a ele o que fa­zer com aqui­lo que se acu­mu­la­va no pei­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não aper­ta — dis­se. — Quan­do ela so­be, to­do mun­do aper­ta. Aí ela es­ca­pa por on­de não de­ve."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pôs a mão aber­ta a um pal­mo do pei­to de­le, sem to­car."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pu­xa o ar de­va­gar. Con­ta até qua­tro. Se­gu­ra. Ago­ra sol­ta, mais de­va­gar do que pu­xou. — Es­pe­rou. — De no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fez, por­que dis­cu­tir da­va mais tra­ba­lho. Na ter­cei­ra vez, a né­voa fria pa­rou de se de­ba­ter e as­sen­tou, qui­e­ta, no fun­do das cos­te­las. E ou­tra coi­sa, que não era a né­voa e que ele não ia no­me­ar, as­sen­tou jun­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— De­va­gar des­se jei­to, ela as­sen­ta — dis­se Lí­via. — Aper­ta­da, sem fô­le­go, ela vi­ra rai­va. A di­fe­ren­ça é só o ar. — Ti­rou a mão. — E ela não so­be só quan­do vo­cê bri­ga."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra ela. Ela já es­ta­va olhan­do pa­ra o po­ço, co­mo se não ti­ves­se di­to na­da de im­por­tan­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Res­pi­rar. — Noct fle­xi­o­nou os de­dos. A né­voa fria se me­xeu den­tro de­le, qui­e­ta. — Era es­se o gran­de se­gre­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nin­guém dis­se que era se­gre­do — res­pon­deu Lí­via, sem ti­rar os olhos do po­ço. — Eu dis­se que ser­via."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Ele achou que ela fos­se em­bo­ra de­pois dis­so. As pes­so­as cos­tu­ma­vam ir, de­pois que ele abria a bo­ca."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Lí­via não foi."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou pa­ra­da ao la­do de­le, olhan­do pa­ra o mes­mo na­da que ele olha­va, e por um tem­po os dois di­vi­di­ram aque­le si­lên­cio com a na­tu­ra­li­da­de es­tra­nha de du­as pes­so­as que en­ten­dem que não pre­ci­sam ser ami­gas pa­ra es­tar no mes­mo lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­tão ela dis­se:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Es­sa fi­ta no seu pul­so. De on­de veio?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os de­dos de­le já es­ta­vam ne­la. Ele não sa­bia há quan­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­rou a mão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— De al­gum lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Is­so não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Per­cep­ti­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lí­via es­pe­rou. Não com im­pa­ciên­cia, nem com aque­la pe­na que ele sen­tia nas pes­so­as e odi­a­va mais do que qual­quer in­sul­to. Es­pe­rou co­mo se ti­ves­se to­do o tem­po do mun­do e sou­bes­se que ele não ti­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O si­no da tor­re não to­cou. O mar­te­lo do fer­rei­ro pa­rou en­tre du­as ba­ti­das."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ..."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— É só uma fi­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fra­se fi­cou no ar en­tre os dois, pe­que­na e men­ti­ro­sa, e ne­nhum dos dois a tra­tou co­mo ver­da­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lí­via as­sen­tiu de­va­gar, co­mo quem acei­ta um pre­sen­te em­bru­lha­do de qual­quer jei­to por­que en­ten­de que o em­bru­lho foi o me­lhor que a pes­soa con­se­guiu fa­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê não é de fa­lar de vo­cê, é?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Es­tou fa­lan­do ago­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê sa­be o que eu quis di­zer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele abriu os olhos. Olhou de la­do pa­ra ela, só de la­do, e o que ha­via no ros­to de­le não era bem um sor­ri­so. Era o lu­gar on­de um sor­ri­so te­ria fi­ca­do, se ele ain­da sou­bes­se on­de guar­dá-los."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— In­fe­liz­men­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CPARENT="c_it" CH="Na pri­mei­ra vez que ele foi gros­so com ela, ela riu."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A lem­bran­ça veio sem pe­dir li­cen­ça, en­quan­to ele atra­ves­sa­va a pra­ça, co­mo vêm as coi­sas que a gen­te tran­ca mal. Tal­vez por cau­sa de Lí­via. Tal­vez por cau­sa da ma­nei­ra co­mo ela ti­nha es­pe­ra­do, sem me­do de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não lem­bra­va do que ti­nha di­to na­que­la pri­mei­ra vez. Al­gu­ma coi­sa afi­a­da, fei­ta pa­ra man­ter dis­tân­cia, do ti­po que ele usa­va com to­do mun­do e que sem­pre fun­ci­o­na­va. Era a úni­ca re­gra da vi­da de­le: quem não che­ga per­to não tem co­mo ir em­bo­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela riu."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Is­so era pra me as­sus­tar?"/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Fun­ci­o­nou?"/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não. Ten­ta de no­vo ama­nhã."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ten­tou. To­do dia. Nun­ca fun­ci­o­nou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi mais ou me­nos nes­sa épo­ca que ele co­me­çou a cha­mar Mi­ra de ra­po­si­nha. Pa­ra ir­ri­tar. Por­que ela fa­la­va das ra­po­sas co­mo quem fa­la de pa­ren­tes, e ele achou que ela fos­se odi­ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ado­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E nun­ca mais dei­xou ele pa­rar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou no meio da pra­ça, por­que as per­nas pa­ra­ram. Fi­cou ali um mo­men­to, um ho­mem de lu­vas gas­tas no meio de uma vi­la qui­e­ta, olhan­do pa­ra o chão co­mo se ti­ves­se dei­xa­do cair al­gu­ma coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E con­ti­nuou an­dan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Pre­ci­sa­va de ser­vi­ço. Per­gun­tou a Brom se al­guém na vi­la pa­ga­va por tra­ba­lho. O fer­rei­ro não pa­rou de ba­ter o fer­ro. Só er­gueu o mar­te­lo e apon­tou pa­ra ci­ma, pa­ra os te­lha­dos, on­de um cha­péu de aba lar­ga apa­re­cia na bei­ra de uma pla­ta­for­ma. De­pois vol­tou à bi­gor­na, co­mo quem já ti­nha fa­la­do de­mais. O ho­mem de cha­péu mo­ra­va no al­to da vi­la, num lu­gar on­de não ha­via es­ca­da pa­ra che­gar."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct che­gou mes­mo as­sim. Sal­tan­do de um te­lha­do bai­xo pa­ra um mu­ro, do mu­ro pa­ra uma vi­ga sol­ta, da vi­ga pa­ra uma pla­ta­for­ma de tá­bu­as que al­guém ti­nha pre­ga­do en­tre du­as ca­sas sem pen­sar em co­mo as pes­so­as su­bi­ri­am até ela. O cor­po de­le fa­zia es­se ti­po de coi­sa sem con­sul­tar a ca­be­ça. Era uma das pou­cas par­tes de­le que ain­da gos­ta­va de es­tar vi­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá em ci­ma, o do­no do cha­péu, de ca­sa­co em­po­ei­ra­do, es­ta­va sen­ta­do nu­ma cai­xa, co­men­do uma ma­çã com um ca­ni­ve­te. Er­gueu as so­bran­ce­lhas quan­do viu Noct apa­re­cer pe­la bei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Veio pe­la es­tra­da? — Mor­deu a ma­çã. — Hm. Vo­cê tem jei­to pa­ra is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não dis­se o pró­prio no­me. Noct não per­gun­tou. Gen­te que não diz o no­me ge­ral­men­te tem um bom mo­ti­vo, e ele res­pei­ta­va bons mo­ti­vos, prin­ci­pal­men­te os que se pa­re­ci­am com os de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A vi­la o cha­ma­va de Fo­ras­tei­ro, e nin­guém sa­bia di­zer por quê. Ele es­ta­va ali an­tes da for­ja de Brom, an­tes da mai­o­ria das ca­sas, e nin­guém lem­bra­va de ter vis­to ele che­gar. Se o no­me o in­co­mo­da­va, nun­ca dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tem um ser­vi­ço — dis­se ele, an­tes que Noct abris­se a bo­ca. — Pa­ga bem. Além do ce­mi­té­rio, mui­to além, mo­ra um bi­cho que a vi­la cha­ma de Ga­to In­fer­nal. Ele usa uma co­lei­ra. Na co­lei­ra tem uma joia. Eu que­ro a joia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não per­gun­tou pa­ra quê. Nun­ca per­gun­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Fo­ras­tei­ro co­nhe­cia a re­gi­ão co­mo quem co­nhe­ce as ru­gas da pró­pria mão, e apon­tou o ca­mi­nho com o ca­ni­ve­te: a tri­lha da ser­ra, que su­bia ao la­do da pra­ça; um ata­lho que um vi­gia ti­nha dei­xa­do do ou­tro la­do, útil pa­ra quem ti­ves­se pa­ciên­cia de abri-lo; o bos­que a les­te, on­de an­da­vam sa­que­a­do­res; o ce­mi­té­rio; e, de­pois de­le, a bo­ca de uma ca­ver­na que nin­guém vi­si­ta­va du­as ve­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct sen­tiu os can­tos da bo­ca se me­xe­rem an­tes que pu­des­se im­pe­dir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era ale­gria. Era ou­tra coi­sa, mais an­ti­ga e mais feia, que acor­da­va ne­le sem­pre que al­guém fa­la­va de uma coi­sa gran­de de­mais, pe­ri­go­sa de­mais, ca­paz de ocu­par a ca­be­ça in­tei­ra por al­guns mi­nu­tos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pe­ri­go­so? — dis­se. — ...Fi­nal­men­te al­gu­ma coi­sa in­te­res­san­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Fo­ras­tei­ro o ob­ser­vou por ci­ma da ma­çã com o in­te­res­se dis­tan­te de quem já viu mui­tos ho­mens sor­ri­rem as­sim e en­ter­rou al­guns de­les."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Di­zem que vo­cê en­tra nas ru­í­nas por di­nhei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Di­nhei­ro pa­ga co­mi­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E o res­to?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra les­te. Pa­ra o ver­me­lho es­cu­ro atrás da ser­ra, que de dia era só uma man­cha, qua­se uma nu­vem, qua­se na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— O res­to ocu­pa a ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Fo­ras­tei­ro riu bai­xo, sem mal­da­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê sem­pre é tão in­su­por­tá­vel?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se vi­rou pa­ra ir em­bo­ra. Pa­rou na bei­ra da pla­ta­for­ma. Olhou pa­ra trás por ci­ma do om­bro, por tem­po de­mais, do jei­to que fa­zia quan­do que­ria que a ou­tra pes­soa per­ce­bes­se que ti­nha si­do pe­ga."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê con­ti­nua aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E sal­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A tor­re não ti­nha es­ca­da."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="De lon­ge, ele ti­nha acha­do que ti­nha. De per­to, viu que al­guém, em al­gum mo­men­to, ti­nha ar­ran­ca­do to­dos os de­graus de den­tro, dei­xan­do só as vi­gas, as sa­liên­cias da pe­dra e um bu­ra­co de luz lá no al­to, on­de fi­ca­va o si­no. Por um se­gun­do, Noct te­ve cer­te­za de que já ti­nha su­bi­do aque­la es­ca­da. De­pois o se­gun­do pas­sou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Es­ca­da ne­nhu­ma — dis­se Noct, olhan­do pa­ra ci­ma. — Cla­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Aper­tou a man­ta nas cos­tas e as lu­vas nos pu­nhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Bom. Es­ca­da é pra quem tem pa­ciên­cia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sal­tou pa­ra a pri­mei­ra sa­liên­cia. De­pois pa­ra a se­gun­da. Na ter­cei­ra, a pe­dra aca­bou: da­li pa­ra ci­ma a pa­re­de era li­sa, po­li­da por anos de chu­va en­tran­do pe­lo bu­ra­co do si­no, sem uma fres­ta on­de en­fi­ar os de­dos. Ele ten­tou du­as ve­zes. Na se­gun­da, es­cor­re­gou de vol­ta até o chão de ter­ra ba­ti­da e fi­cou ali, olhan­do pa­ra o bu­ra­co de luz lá no al­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá em ci­ma, o si­no ra­cha­do ba­lan­çou com o ven­to e não to­cou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm — dis­se Noct."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era uma der­ro­ta. Era um adi­a­men­to. Ele ti­nha mui­ta práti­ca em adi­ar coi­sas."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="7682.67716535433" OwnPage="22" ItemID="853283593" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="7682.67716535433" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="853545433" BACKITEM="846940681"/>
