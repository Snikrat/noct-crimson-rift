        <PAGEOBJECT XPOS="151.023622047244" YPOS="69959.8425196851" OwnPage="201" ItemID="941804169" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="69959.8425196851" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1105580265" BACKITEM="1063546265"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="69959.8425196851" OwnPage="202" ItemID="1105580265" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="69959.8425196851" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1105419817" BACKITEM="941804169"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="70651.8110236221" OwnPage="203" ItemID="1105419817" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="70651.8110236221" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1105458681" BACKITEM="1105580265"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="70651.8110236221" OwnPage="204" ItemID="1105458681" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="70651.8110236221" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1105709801" BACKITEM="1105419817"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="71343.7795275591" OwnPage="205" ItemID="1105709801" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="71343.7795275591" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1108572217" BACKITEM="1105458681"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="71343.7795275591" OwnPage="206" ItemID="1108572217" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="71343.7795275591" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1105709801"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="72120.7874015749" OwnPage="207" ItemID="1108388841" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="72120.7874015749" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1112651305" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Epí­lo­go"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Um dia de ca­da vez"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_epi_rom" CH="To­da his­tó­ria so­bre uma por­ta ter­mi­na com al­guém do la­do de fo­ra de­la. A per­gun­ta nun­ca é se a por­ta fe­cha. É quem fi­ca es­pe­ran­do do ou­tro la­do, e se a pes­soa que saiu tem co­ra­gem de sen­tar."/>
                <para PARENT="epigrafe"/>
                <ITEXT CH="Di­as de­pois, em Pe­dra­ve­lha, não ha­via mais ra­cha­du­ra na bei­ra da vi­la."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ha­via uma mar­ca. Uma li­nha fi­na, es­cu­ra, nas pe­dras do chão, co­mo uma ci­ca­triz que fe­chou mas não su­miu. As cri­an­ças pu­la­vam por ci­ma de­la sem sa­ber por quê. O Ve­lho Ze­no di­zia que da­va azar pi­sar ali, e nin­guém acre­di­ta­va, e to­do mun­do des­vi­a­va mes­mo as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os de­mô­nios ti­nham ido em­bo­ra. Não to­dos, não de uma vez. Ain­da apa­re­ci­am, de vez em quan­do, na ser­ra ou no pân­ta­no, per­di­dos, co­mo ca­chor­ros que não sa­bem que o do­no se mu­dou. Mas as pa­re­des ver­me­lhas ti­nham es­cu­re­ci­do. A água do la­go ti­nha vol­ta­do a ser só água. E à noi­te, quan­do o ven­to ba­tia nas ja­ne­las, ne­nhu­ma por­ta cha­ma­va nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct es­ta­va sen­ta­do nu­ma pon­ta do ban­co da pra­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pon­ta da di­rei­ta. Ele não ti­nha es­co­lhi­do. Só fi­cou as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O cor­po ain­da do­ía em lu­ga­res que ele nem sa­bia que exis­ti­am. Os nós dos de­dos es­ta­vam en­fai­xa­dos, por Ir­mã Lí­via, que ti­nha fei­to is­so sem per­gun­tar na­da e co­bra­do o do­bro pe­lo si­lên­cio. Brom ti­nha olha­do pa­ra as lu­vas de­le, des­tru­í­das, e di­to "/>
                <ITEXT CPARENT="c_it" CH="de no­vo?"/>
                <ITEXT CH=" com uma voz que era qua­se ca­ri­nho. Ze­no ti­nha pas­sa­do pe­lo ban­co de ma­nhã, ba­ti­do o ca­ja­do no chão e di­to, sem pa­rar de an­dar: "/>
                <ITEXT CPARENT="c_it" CH="dor­miu, fi­nal­men­te."/>
                <ITEXT CH=" O pei­to es­ta­va qui­e­to. Às ve­zes a mão de­le ain­da ia até ali, por hábi­to, pro­cu­ran­do a bra­sa, e não acha­va na­da. E não do­ía não achar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­ta es­ta­va amar­ra­da no pul­so. Fir­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na vés­pe­ra, ele ti­nha pas­sa­do na for­ja do Brom. Ti­rou do bol­so de den­tro a lis­ta dos sa­que­a­do­res, a da le­tra ca­pri­cha­da e fria que man­da­va en­tre­gar ao Cus­tó­dio quem ou­vis­se a fen­da. Leu os no­mes uma úl­ti­ma vez, um por um, in­tei­ros. De­pois jo­gou a fo­lha no fo­go e fi­cou olhan­do até não so­brar na­da. Brom não per­gun­tou. Só ba­teu o fer­ro mais de­va­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Al­guém se sen­tou na ou­tra pon­ta do ban­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não olhou lo­go. Sa­bia quem era pe­lo jei­to de sen­tar. Pe­lo ba­ru­lho da man­ta de lã, que era de­le, e que ela não ti­nha de­vol­vi­do, e que ele não ti­nha pe­di­do de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Es­se lu­gar es­ta­va li­vre — dis­se, olhan­do de la­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu per­ce­bi — dis­se Tes­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­ca­ram em si­lên­cio. Uma car­ro­ça pas­sou do ou­tro la­do da pra­ça. Al­guém gri­tou um pre­ço de pão. O ra­paz da ser­ra atra­ves­sou a pra­ça com dois pães de­bai­xo do bra­ço, viu os dois no ban­co e ace­nou de lon­ge. Noct le­van­tou dois de­dos. Uma cri­an­ça pu­lou por ci­ma da ci­ca­triz nas pe­dras."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê qua­se mor­reu — dis­se Tes­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Acon­te­ce."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela sol­tou o ar, cur­to. Não era o ri­so pe­lo na­riz da Mi­ra. Ou­tro jei­to. Um jei­to que era só de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê não pre­ci­sa fa­zer tu­do so­zi­nho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não res­pon­deu. Os de­dos de­le en­con­tra­ram a fi­ta no pul­so. O po­le­gar pas­sou por ci­ma do te­ci­do, de­va­gar, de um la­do pa­ra o ou­tro, do jei­to que ele fa­zia quan­do não sa­bia o que fa­zer com as mãos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Pre­ci­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Por quê?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="E por um se­gun­do, pa­re­ceu que ele ia res­pon­der."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pa­re­ceu de ver­da­de. A bo­ca abriu. Os olhos fo­ram pa­ra a ci­ca­triz nas pe­dras, de­pois pa­ra a fi­ta, de­pois pa­ra o la­do es­quer­do do ban­co, on­de ela es­ta­va sen­ta­da. Ha­via uma res­pos­ta in­tei­ra ali den­tro. Uma res­pos­ta so­bre uma es­ta­ção de trem e um bi­lhe­te do­bra­do em qua­tro e uma por­ta fe­cha­da com o no­me de al­guém. So­bre co­mo é di­fícil dei­xar ou­tra pes­soa sen­tar do seu la­do quan­do o úl­ti­mo lu­gar va­zio era de quem não vol­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fe­chou a bo­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê faz per­gun­tas de­mais — dis­se, com o sar­cas­mo de sem­pre."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa não riu. Mas tam­bém não foi em­bo­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela fi­cou. Ele tam­bém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ne­nhum dos dois dis­se mais na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ele não pe­diu que ela fos­se em­bo­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pou­co de­pois, o Fo­ras­tei­ro pas­sou pe­la pra­ça, o cha­péu de aba lar­ga, a joia do Ga­to gi­ran­do en­tre os de­dos. Di­mi­nuiu o pas­so na fren­te do ban­co. Olhou pa­ra a fi­ta no pul­so de Noct, de­pois pa­ra a joia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ain­da é a mes­ma — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E se­guiu pe­la es­tra­da sem es­pe­rar res­pos­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O sol foi bai­xan­do so­bre Pe­dra­ve­lha. As som­bras da pra­ça fi­ca­ram com­pri­das. Al­guém acen­deu o pri­mei­ro lam­pi­ão. Do ou­tro la­do do ban­co, Tes­sa co­chi­lou, a ca­be­ça pen­den­do pa­ra o la­do, e Noct não a acor­dou. Fi­cou mais qui­e­to, pa­ra ela dor­mir."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ele olhou pa­ra o céu. Ain­da ti­nha um ver­me­lho no ho­ri­zon­te. Não o da fen­da. O do fim da tar­de. O de sem­pre."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou nu­ma por­ta de ma­dei­ra es­cu­ra, e em al­guém de bo­tas su­jas de la­ma rin­do pe­lo na­riz di­an­te de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela não es­ta­va com me­do — dis­se, pa­ra nin­guém. — Eu tam­bém não vou ter."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fi­cou um tem­po ca­la­do. De­pois, mais bai­xo:"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um dia de ca­da vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era a fra­se de­la. Ele ti­nha re­pe­ti­do aqui­lo mil ve­zes nos úl­ti­mos anos. Nos ban­cos, nas ca­ver­nas, no fun­do de po­ços e de la­gos. Sem­pre do mes­mo jei­to: co­mo uma or­dem. Co­mo al­guém que se se­gu­ra nu­ma cor­da pa­ra não cair. "/>
                <ITEXT CPARENT="c_it" CH="Aguen­ta ho­je. Ama­nhã a gen­te vê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas des­sa vez, pe­la pri­mei­ra vez, a fra­se não so­ou co­mo so­bre­vi­ver até ama­nhã."/>
                <para PARENT="corpo"/>
                <ITEXT CH="So­ou co­mo ou­tra coi­sa. Uma coi­sa que ele não sa­bia no­me­ar ain­da, e que não ti­nha pres­sa de no­me­ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os olhos. O lam­pi­ão pis­cou e se fir­mou. Na ou­tra pon­ta do ban­co, al­guém res­pi­ra­va de­va­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não es­ta­va frio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Tal­vez ama­nhã va­lha a pe­na."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Fim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <trail PARENT="cena"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="72035.7480314961" OwnPage="208" ItemID="1112651305" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="72035.7480314961" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1112404441" BACKITEM="1108388841"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="72727.7165354332" OwnPage="209" ItemID="1112404441" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="72727.7165354332" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1112281273" BACKITEM="1112651305"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="72727.7165354332" OwnPage="210" ItemID="1112281273" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="72727.7165354332" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1112404441"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="73504.7244094489" OwnPage="211" ItemID="1114227033" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="73504.7244094489" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1118103385" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="O ou­tro fi­nal"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Eco"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_epi_rom" CH="To­da his­tó­ria tem um ou­tro fi­nal, guar­da­do atrás de uma por­ta que nin­guém de­ve­ria abrir. Es­te é o de Noct. Não é o que acon­te­ceu. É o que qua­se acon­te­ceu, na­que­le se­gun­do in­tei­ro, no fun­do do Aves­so, di­an­te de uma luz dou­ra­da."/>
                <para PARENT="epigrafe"/>
                <ITEXT CH="Noct olhou pa­ra a fi­ta car­me­sim no pul­so."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="E de­pois olhou pa­ra o ban­co lá den­tro da por­ta. Pa­ra o la­do es­quer­do, ocu­pa­do. Pa­ra o pé em ci­ma do as­sen­to, do jei­to que ele odi­a­va. Do jei­to que ele ti­nha pas­sa­do anos in­tei­ros que­ren­do ver de no­vo, só mais uma vez, só pa­ra po­der re­cla­mar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Atrás de­le fi­ca­va o cor­re­dor por on­de ti­nha des­ci­do. Es­cu­ro, lon­go. Lá em ci­ma, a vi­la. A pra­ça. O ban­co de fer­ro com a pon­ta es­quer­da va­zia, to­das as noi­tes, pa­ra sem­pre. Uma vi­da in­tei­ra de "/>
                <ITEXT CPARENT="c_it" CH="um dia de ca­da vez"/>
                <ITEXT CH=", con­tan­do até qua­tro, aper­tan­do um nó que nin­guém mais ia aper­tar com ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na fren­te, a luz dou­ra­da. Quen­te. Pa­ra­da. Sem chu­va, sem frio, sem trem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Bo­bo — dis­se a fi­gu­ra, lá de den­tro, com a voz qua­se cer­ta. — Vem. Tem lu­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sa­bia. Sa­bia com ca­da pe­da­ço do cor­po que aqui­lo não era ela. Sa­bia que ela ti­nha atra­ves­sa­do aque­la mes­ma por­ta pa­ra que ele nun­ca pre­ci­sas­se atra­ves­sar. Sa­bia que, se en­tras­se, o nó de­la não ia ter ser­vi­do pa­ra na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E sa­bia tam­bém que es­ta­va can­sa­do. Can­sa­do de um jei­to que não ca­bia em ne­nhum ban­co. Can­sa­do de pro­cu­rar em to­das as es­ta­ções, de acor­dar do la­do di­rei­to da ca­ma, de olhar pa­ra o lu­gar va­zio e cha­mar aqui­lo de vi­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pé de­le deu meio pas­so so­zi­nho. Ele não pu­xou de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Des­cul­pa — dis­se. Pa­ra ela. Pa­ra a de ver­da­de. Pa­ra o nó. — Eu não con­si­go mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to la­te­jou uma vez, fra­ca, co­mo quem cha­ma pe­lo no­me. Ele não res­pon­deu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E deu um pas­so pa­ra den­tro da por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Lá den­tro ha­via uma voz que se pa­re­cia com a de­la. E um ban­co com dois lu­ga­res."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="A luz era dou­ra­da e não mu­da­va nun­ca. Não ha­via chu­va, nem frio, nem trem. Só o ban­co, e a es­ta­ção em vol­ta, bor­ra­da nas bor­das co­mo uma lem­bran­ça que al­guém guar­dou por tem­po de­mais."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se sen­tou. À di­rei­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pe­la pri­mei­ra vez em mui­to tem­po, o ou­tro la­do não es­ta­va va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela es­ta­va ali. A fi­ta no ca­be­lo. O jei­to tor­to de sen­tar. Ela vi­rou o ros­to pa­ra ele, e ele não con­se­guiu ver o ros­to, e is­so não im­por­tou. Ela es­ta­va ali. Ela ti­nha vol­ta­do. Ou ele ti­nha ido. Tan­to fa­zia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Oi — dis­se ele. E a voz que­brou na pri­mei­ra le­tra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Oi — dis­se ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele riu. Um ri­so cur­to, mo­lha­do, que não era bem ri­so. Pas­sou as cos­tas da mão no ros­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu te­nho tan­ta coi­sa pra te con­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E con­tou. Con­tou tu­do, de­pres­sa, atro­pe­lan­do as pa­la­vras, do jei­to que nun­ca ti­nha fa­la­do com nin­guém, do jei­to que só fa­la­va com ela. Con­tou da es­ta­ção, da ma­nhã do bi­lhe­te, da ca­ma va­zia do la­do es­quer­do. Con­tou que ti­nha pro­cu­ra­do em to­das as es­ta­ções me­nos na de­les. Con­tou da pra­ça de Pe­dra­ve­lha, e do po­ço, e de um ve­lho cha­to que ba­tia o ca­ja­do no chão, e de um ga­to do ta­ma­nho de uma car­ro­ça, e de um cei­fa­dor que men­tiu que ela ti­nha gri­ta­do o no­me de­le. Con­tou do la­go. Con­tou que ti­nha apren­di­do a res­pi­rar con­tan­do até qua­tro. Con­tou de uma mo­ça que fa­zia per­gun­tas de­mais e que ago­ra an­da­va por aí com a man­ta de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê ia gos­tar de­la — dis­se. — Ela é cha­ta igual vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E es­pe­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­gu­ra sor­riu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Que bom."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só is­so. "/>
                <ITEXT CPARENT="c_it" CH="Que bom."/>
                <ITEXT CH=" Do jei­to que se res­pon­de a um es­tra­nho na fi­la do pão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou olhan­do pa­ra ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Fa­la co­mi­go — pe­diu. — Me con­ta da fei­ra. Do que vo­cê viu. De qual­quer coi­sa. Vo­cê sem­pre ti­nha al­gu­ma coi­sa pra con­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu es­tou aqui — dis­se ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu sei que tá. Fa­la co­mi­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu es­tou aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fez uma pi­a­da, en­tão. Uma pi­a­da idi­o­ta e se­ca, das pi­o­res, do jei­to que ela gos­ta­va, só pa­ra ou­vir ela rir pe­lo na­riz. Só pa­ra ou­vir aque­le ba­ru­lhi­nho que ele ti­nha guar­da­do no fun­do do pei­to du­ran­te anos, sem co­ra­gem de lem­brar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não riu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sor­riu, sim. Dis­se que era en­gra­ça­do, sim. Mas não riu. Não da­que­le jei­to. Não com o na­riz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ri — dis­se ele, bai­xi­nho. — Por fa­vor. Só uma vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela sor­riu de no­vo. O mes­mo sor­ri­so. Exa­ta­men­te o mes­mo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­tão ele men­tiu. Pa­ra tes­tar. Uma men­ti­ra pe­que­na, bo­ba, que ela te­ria pe­ga­do no ar an­tes de ele ter­mi­nar a fra­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu tô bem. Ju­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a mão de­le foi até a so­bran­ce­lha. So­zi­nha. Co­çou. Ele dei­xou. Dei­xou de pro­pósi­to, de­va­gar, bem na fren­te de­la, co­mo quem es­ten­de a mão no es­cu­ro es­pe­ran­do que al­guém se­gu­re."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Tá ven­do? Co­çou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não dis­se. Não olhou pa­ra a so­bran­ce­lha. Não es­trei­tou os olhos. Só acre­di­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Que bom."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct abai­xou a mão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­ten­deu, en­tão. De­va­gar, do jei­to que se en­ten­de uma coi­sa que a gen­te sa­bia des­de o co­me­ço e pas­sou o tem­po to­do em­pur­ran­do pa­ra lon­ge. Aqui­lo não era ela. Era o for­ma­to de­la. Era o eco. A por­ta ti­nha apren­di­do a for­ma da fal­ta que ela fa­zia e ti­nha fei­to uma pes­soa do ta­ma­nho exa­to do bu­ra­co. Com a fi­ta cer­ta, o jei­to de sen­tar cer­to, e na­da den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não — dis­se ele. — Não, não, não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Se­gu­rou a mão de­la. Era mor­na. Não aper­tou de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­ta. Por fa­vor. Eu não li­go se for men­ti­ra. Me olha do jei­to que vo­cê olha­va. Me cha­ma de bo­bo. Bri­ga co­mi­go. Diz que eu tô men­tin­do. Qual­quer coi­sa. Eu fa­ço o que vo­cê qui­ser. Eu fi­co qui­e­to, eu es­cu­to, eu dur­mo ce­do, eu pa­ro de ser gros­so com to­do mun­do. Só vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fi­gu­ra in­cli­nou a ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu es­tou aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele cho­rou. Não co­mo na ca­te­dral, nem co­mo na es­ta­ção. Cho­rou co­mo cri­an­ça, com a tes­ta en­cos­ta­da no om­bro de­la, um om­bro que ti­nha o for­ma­to cer­to e não ti­nha chei­ro de na­da. E ela não fez ca­ri­nho no ca­be­lo de­le, por­que não sa­bia que de­via."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do aca­bou, fi­cou ali, en­cos­ta­do, res­pi­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E não se le­van­tou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pen­sou nos anos de ban­co. Na pon­ta da di­rei­ta, e na ou­tra pon­ta va­zia, to­das as noi­tes, em to­das as es­ta­ções. Pen­sou que ti­nha pas­sa­do a vi­da in­tei­ra olhan­do pa­ra um lu­gar va­zio do ta­ma­nho de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Es­se lu­gar ago­ra es­ta­va ocu­pa­do. Por pou­co. Por qua­se na­da. Por um for­ma­to que sor­ria e não ria, que ou­via e não res­pon­dia, que acre­di­ta­va em tu­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era me­nos que ela. Era mui­to me­nos que ela."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas era mais que na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Tu­do bem — dis­se ele, bai­xi­nho, con­tra o om­bro que não era de­la. — Tu­do bem. Eu fi­co."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Que bom — dis­se a voz."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ele fe­chou os olhos, e fi­cou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Em Pe­dra­ve­lha, a fen­da con­ti­nuou res­pi­ran­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Nin­guém mais a fe­chou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os de­mô­nios con­ti­nu­a­ram sain­do, de noi­te, de­va­gar, co­mo quem tem to­do o tem­po do mun­do. As pa­re­des ver­me­lhas con­ti­nu­a­ram cres­cen­do. A água do la­go con­ti­nuou pa­ra­da. E no ban­co da pra­ça, to­da ma­nhã, uma mo­ça co­chi­la­va nu­ma man­ta que não era de­la, sen­ta­da na pon­ta es­quer­da, es­pe­ran­do al­guém que não ia vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ain­da não sa­bia que nin­guém ia vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Fim?"/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="73419.6850393702" OwnPage="212" ItemID="1118103385" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="73419.6850393702" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1118232297" BACKITEM="1114227033"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="74111.6535433072" OwnPage="213" ItemID="1118232297" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="74111.6535433072" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1118557737" BACKITEM="1118103385"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="74111.6535433072" OwnPage="214" ItemID="1118557737" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="74111.6535433072" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1118750841" BACKITEM="1118232297"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="74803.6220472442" OwnPage="215" ItemID="1118750841" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="74803.6220472442" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="1118557737"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="74803.6220472442" OwnPage="216" ItemID="1121026313" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="74803.6220472442" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Agradecimentos"/>
                <para PARENT="agrad_tit"/>
                <ITEXT CH="A quem perdeu alguém e, mesmo assim, continuou acordando."/>
                <para PARENT="agrad"/>
                <ITEXT CH="A quem já se sentou na ponta de um banco deixando o outro lado livre, só por via das dúvidas."/>
                <para PARENT="agrad"/>
                <ITEXT CH="A quem guarda um bilhete, uma fita, uma voz, e já não sabe se lembra ou se inventa."/>
                <para PARENT="agrad"/>
                <ITEXT CH="A quem esperou tanto que esqueceu o que esperava, e esperou mesmo assim."/>
                <para PARENT="agrad"/>
                <ITEXT CH="E a quem, mesmo de longe, nunca deixou de chamar."/>
                <para PARENT="agrad"/>
                <ITEXT CH="Esta história é de vocês. Eu só a escrevi."/>
