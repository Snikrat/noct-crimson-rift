        <PAGEOBJECT XPOS="151.023622047244" YPOS="9066.61417322835" OwnPage="25" ItemID="853724361" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="9066.61417322835" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="856319881" BACKITEM="841934185"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="9066.61417322835" OwnPage="26" ItemID="856319881" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="9066.61417322835" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="856850761" BACKITEM="853724361"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="9758.58267716536" OwnPage="27" ItemID="856850761" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="9758.58267716536" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="856309817" BACKITEM="856319881"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="9758.58267716536" OwnPage="28" ItemID="856309817" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="9758.58267716536" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="856850761"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="10535.5905511811" OwnPage="29" ItemID="857984105" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="10535.5905511811" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="862262905" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 3"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Al­guém des­ceu"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="O"/>
                <ITEXT CH=" ser­vi­ço do Fo­ras­tei­ro fi­ca­va lon­ge, além do bos­que e do ce­mi­té­rio, e a tri­lha do bos­que co­me­ça­va do ou­tro la­do da pra­ça. Noct atra­ves­sou a pra­ça pa­ra pe­gá-la. Pas­sou pe­lo po­ço sem olhar."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Três pas­sos de­pois, a bra­sa atrás das cos­te­las pu­xou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não do­eu. Pu­xou, co­mo uma mão se­gu­ran­do a man­ga de al­guém que vai em­bo­ra ce­do de­mais. Ele pa­rou. Lí­via ti­nha pas­sa­do a con­ver­sa in­tei­ra olhan­do pa­ra aque­le po­ço, lem­brou, co­mo se es­pe­ras­se al­gu­ma coi­sa sair da­li."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Dis­se a si mes­mo que era cu­ri­o­si­da­de de mer­ce­ná­rio. Lu­gar fe­cha­do às ve­zes guar­da coi­sa de va­lor. E vol­tou os três pas­sos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O po­ço de Pe­dra­ve­lha não da­va água de be­ber."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct des­co­briu is­so do jei­to mais sim­ples: jo­gou uma pe­dra e con­tou. Con­tou até qua­tro an­tes de ou­vir o ba­ru­lho, e o ba­ru­lho não foi de água es­pir­ran­do. Foi um "/>
                <ITEXT CPARENT="c_it" CH="plop"/>
                <ITEXT CH=" mo­le, aba­fa­do, co­mo uma pe­dra cain­do num pra­to de so­pa ve­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A cor­da es­ta­va pre­sa na rol­da­na. Fir­me. No­va de­mais pa­ra um po­ço que nin­guém usa­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Hm."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele des­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Lá em­bai­xo, o mun­do chei­ra­va a pe­dra mo­lha­da e a tem­po pa­ra­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O fun­do do po­ço não era um fun­do. Era uma en­tra­da. Al­guém, há mui­to tem­po, ti­nha ca­va­do ga­le­ri­as a par­tir da­li, cor­re­do­res es­trei­tos que se abri­am pa­ra os la­dos e des­ci­am mais, sem­pre mais, nu­ma es­cu­ri­dão que não de­vol­via eco. A água co­bria o chão até os tor­no­ze­los, pre­ta e imó­vel, e não se me­xia nem quan­do ele pi­sa­va ne­la. Fa­zia on­das, sim. Mas as on­das mor­ri­am rápi­do de­mais, co­mo se a água ti­ves­se ver­go­nha de ser vis­ta se mo­ven­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Água pa­ra­da — dis­se ele, pa­ra ou­vir uma voz. — Nin­guém ti­ra água da­qui faz tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="En­tão viu as mar­cas na pa­re­de de pe­dra. Ar­ra­nhões, na al­tu­ra de uma mão. De al­guém que ti­nha se apoi­a­do pa­ra não cair. Vá­rias mãos, em vá­rios mo­men­tos. As mais an­ti­gas es­ta­vam co­ber­tas de li­mo. As mais re­cen­tes, não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa atrás das cos­te­las deu um pul­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Mas al­guém des­ceu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="An­dou pe­las ga­le­ri­as até en­con­trar a ins­cri­ção."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Es­ta­va nu­ma pe­dra li­sa, mais cla­ra que as ou­tras, on­de al­guém ti­nha de­ci­di­do que va­lia a pe­na dei­xar uma men­sa­gem. As le­tras ti­nham si­do ris­ca­das com a pon­ta de uma fa­ca, ou de um pre­go, e a mão que as ti­nha es­cri­to tre­mia. Não de frio. De pres­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela des­ceu aqui an­tes de nós. Dis­se que o ba­ru­lho vi­nha de bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct leu du­as ve­zes. Na ter­cei­ra, não leu; só olhou pa­ra as le­tras, co­mo se elas pu­des­sem mu­dar se ele es­pe­ras­se tem­po su­fi­ci­en­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ba­ru­lho — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pa­la­vra não sig­ni­fi­ca­va na­da. Ba­ru­lho po­dia ser qual­quer coi­sa. Bi­cho, ven­to, uma in­fil­tra­ção. "/>
                <ITEXT CPARENT="c_it" CH="Ela"/>
                <ITEXT CH=" po­dia ser qual­quer pes­soa. Ha­via mi­lha­res de mu­lhe­res no mun­do que des­ci­am lu­ga­res es­cu­ros an­tes dos ou­tros, por­que eram tei­mo­sas, ou co­ra­jo­sas, ou idi­o­tas, ou as três coi­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sa­bia dis­so. Sa­bia com a par­te da ca­be­ça que fa­zia con­tas e lia ma­pas e sa­bia de que la­do um sa­que­a­dor ia ata­car."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ou­tra par­te, a que ele não dei­xa­va fa­lar, só ou­via uma fra­se. Di­ta nu­ma voz que con­ta­va ra­po­sas."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Pa­re­ce al­guém cha­man­do do ou­tro la­do de uma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ti­nha di­to que era can­sa­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct apoi­ou a mão na pe­dra, ao la­do da ins­cri­ção, exa­ta­men­te on­de uma mão an­te­ri­or ti­nha dei­xa­do sua mar­ca. A pe­dra es­ta­va fria. Por bai­xo do frio, lá no fun­do, co­mo um re­ló­gio do ou­tro la­do de uma pa­re­de, ele sen­tiu a vi­bra­ção. Fi­na. Per­sis­ten­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um zum­bi­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não o de­le. Ou não só o de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Ela tam­bém ou­via da­qui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ti­nha cer­te­za de por que ti­nha di­to "/>
                <ITEXT CPARENT="c_it" CH="tam­bém"/>
                <ITEXT CH=". Não ti­nha cer­te­za de qual "/>
                <ITEXT CPARENT="c_it" CH="ela"/>
                <ITEXT CH=" es­ta­va di­zen­do. Ti­rou a mão da pe­dra co­mo quem ti­ra a mão de um fo­gão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No fim da ga­le­ria mais fun­da, a pe­dra mu­da­va de cor."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não era li­mo, nem fer­ru­gem, nem ne­nhu­ma das coi­sas que nor­mal­men­te mu­dam a cor das pe­dras. Era ver­me­lho. Um ver­me­lho pro­fun­do, trans­lúci­do, co­mo vi­dro so­bre bra­sa, que for­ma­va uma pa­re­de in­tei­ra de um la­do ao ou­tro do cor­re­dor. Pul­sa­va, de­va­gar. Quan­do Noct se apro­xi­mou, pul­sou mais rápi­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele es­ten­deu a mão."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pa­re­de não o dei­xou pas­sar. Não o em­pur­rou, tam­bém. Fi­cou ali, sóli­da, quen­te, e ele te­ve a sen­sa­ção ab­sur­da de que ela o es­ta­va re­co­nhe­cen­do e de­ci­din­do que ain­da não era ho­ra. Co­mo quem guar­da uma por­ta e co­nhe­ce seu ros­to, mas não tem seu no­me na lis­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to de­le res­pon­deu à pa­re­de. Pe­la pri­mei­ra vez des­de que ti­nha che­ga­do a Pe­dra­ve­lha, ele sen­tiu as du­as coi­sas con­ver­sa­rem, a fen­da lá fo­ra e a fen­da aqui den­tro, num idi­o­ma que ele não fa­la­va e não que­ria apren­der."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­tiu ou­tra coi­sa, tam­bém. Uma coi­sa que ele nun­ca con­ta­ria a nin­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Sen­tiu que gos­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Gos­ta­va do ca­lor. Da ma­nei­ra co­mo o pul­so da pa­re­de ace­le­ra­va quan­do ele che­ga­va per­to, co­mo um ca­chor­ro fe­liz em ver o do­no. Da sen­sa­ção de que ha­via, em al­gum lu­gar do mun­do, uma coi­sa que res­pon­dia a ele com tan­ta for­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct ti­rou a mão da pa­re­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela con­ti­nuou pul­san­do, mais de­va­gar, até vol­tar ao rit­mo de an­tes. Es­pe­ran­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não ho­je — dis­se ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E su­biu a cor­da sem olhar pa­ra trás."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Na­que­la noi­te, ele não foi até o ban­co."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Fi­cou sen­ta­do no bei­ral de um te­lha­do bai­xo, as per­nas pen­du­ra­das pa­ra fo­ra, olhan­do pa­ra a pra­ça va­zia. O ban­co es­ta­va lá em­bai­xo, as du­as pon­tas ilu­mi­na­das pe­lo mes­mo lam­pi­ão. Ele não des­ceu. Ti­nha a im­pres­são de que, se sen­tas­se ali na­que­la noi­te, a ou­tra pon­ta não ia fi­car va­zia o su­fi­ci­en­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A lem­bran­ça veio mes­mo as­sim. Elas sem­pre vi­nham quan­do ele ten­ta­va não dei­xar."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Vo­cê tem me­do de al­gu­ma coi­sa?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ti­nha si­do nu­ma noi­te pa­re­ci­da. Ela dei­ta­da com a ca­be­ça no co­lo de­le, olhan­do pa­ra o te­to, fa­zen­do per­gun­tas co­mo quem jo­ga pe­dri­nhas num la­go só pa­ra ver até on­de vão as on­das."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não dis­se na­da. Só le­van­tou os olhos e olhou pa­ra a so­bran­ce­lha de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A mão de­le es­ta­va pa­ra­da. Ele ti­nha apren­di­do a dei­xar a mão pa­ra­da. Mas ela tam­bém ti­nha apren­di­do, e sa­bia que mão pa­ra­da, ne­le, era pi­or."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O si­lên­cio du­rou o tem­po de uma res­pi­ra­ção in­tei­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="...De per­der vo­cê."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi a úni­ca vez que ele dis­se em voz al­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não res­pon­deu. Não fez pi­a­da, não riu, não o cha­mou de idi­o­ta. Só pe­gou a mão de­le, a que de­ve­ria ter ido até a so­bran­ce­lha e não foi, e fi­cou se­gu­ran­do até os dois dor­mi­rem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No te­lha­do de Pe­dra­ve­lha, Noct fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu de­via ter di­to mais ve­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ven­to não res­pon­deu. Nem a pra­ça, nem o ban­co, nem a bra­sa no pei­to, que por uma vez fi­cou qui­e­ta, co­mo quem sa­be que há mo­men­tos em que até o fo­go de­ve fa­zer si­lên­cio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Lá em­bai­xo, lá mui­to em­bai­xo, por bai­xo da água pa­ra­da e das pa­re­des ver­me­lhas, al­guém con­ti­nu­a­va cha­man­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na ma­nhã se­guin­te, ele pe­gou a tri­lha do bos­que."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="10450.5511811024" OwnPage="30" ItemID="862262905" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="10450.5511811024" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="862012745" BACKITEM="857984105"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="11142.5196850394" OwnPage="31" ItemID="862012745" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="11142.5196850394" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="862566553" BACKITEM="862262905"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="11142.5196850394" OwnPage="32" ItemID="862566553" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="11142.5196850394" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="862439049" BACKITEM="862012745"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="11834.4881889764" OwnPage="33" ItemID="862439049" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="11834.4881889764" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="862566553"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="11939.3700787402" OwnPage="34" ItemID="864943193" PTYPE="4" WIDTH="334.488188976378" HEIGHT="226.771653543307" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" copath="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" gXpos="621.574803149606" gYpos="11939.3700787402" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Parte II"/>
                <para PARENT="parte_num"/>
                <ITEXT CH="A Trilha dos Desgarrados"/>
                <para PARENT="parte"/>
                <ITEXT CH="Os contos de fadas avisam que não se deve sair da trilha. Eles nunca dizem o que fazer quando a trilha está cheia de lobos que andam em duas pernas, cobram pedágio e têm uma lista de nomes no bolso."/>
                <trail PARENT="parte_epi"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="771.811023622047" YPOS="12194.4881889764" OwnPage="34" ItemID="865046825" PTYPE="2" WIDTH="34.0157480314961" HEIGHT="34.0157480314961" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.0354330708661417" LOCALSCY="0.0354330708661417" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="emblema_cinza.png" IRENDER="0" EMBEDDED="0" path="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" copath="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" gXpos="771.811023622047" gYpos="12194.4881889764" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="12611.4960629921" OwnPage="36" ItemID="861995129" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="12611.4960629921" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="873213929" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 4"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Ne­nhu­ma vol­tan­do"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="O"/>
                <ITEXT CH=" bos­que co­me­ça­va de re­pen­te, co­mo uma fra­se in­ter­rom­pi­da."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Num pas­so, Noct es­ta­va na tri­lha de ter­ra que sa­ía de Pe­dra­ve­lha, com o céu cin­zen­to em ci­ma e o ba­ru­lho do mar­te­lo de Brom ain­da nas cos­tas. No pas­so se­guin­te, as ár­vo­res ti­nham se fe­cha­do em vol­ta de­le co­mo de­dos, e a luz che­ga­va ao chão ver­de e par­ti­da, e o úni­co som era o das fo­lhas con­ver­san­do en­tre si nu­ma lín­gua de sus­sur­ros."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele se aga­chou per­to de um tre­cho de la­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mar­cas de bo­tas. Mui­tas. Pe­sa­das, de so­la­do gros­so, do ti­po que se com­pra com di­nhei­ro que não se ga­nhou ho­nes­ta­men­te. Iam to­das na mes­ma di­re­ção: pa­ra den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele pro­cu­rou as que vol­ta­vam."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Mar­cas de bo­tas — dis­se bai­xo. — Ne­nhu­ma vol­tan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era ne­ces­sa­ri­a­men­te ruim. Po­dia sig­ni­fi­car que ha­via ou­tra sa­í­da. Po­dia sig­ni­fi­car um acam­pa­men­to. Po­dia sig­ni­fi­car que quem en­tra­va gos­ta­va tan­to do bos­que que de­ci­dia fi­car pa­ra sem­pre, o que, no ti­po de lu­gar que ele cos­tu­ma­va vi­si­tar, ra­ra­men­te acon­te­cia por von­ta­de pró­pria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um ga­lho es­ta­lou adi­an­te. Não co­mo ga­lhos es­ta­lam so­zi­nhos. Co­mo ga­lhos es­ta­lam sob o pe­so de al­guém que acha que es­tá sen­do si­len­ci­o­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se le­van­tou de­va­gar e fe­chou os pu­nhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Al­guém es­tá es­pe­ran­do na tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Eram três, no co­me­ço."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Dois ma­gros e rápi­dos, com fa­cas cur­vas e len­ços amar­ra­dos no ros­to. Um gran­de, len­to, com um por­re­te cra­ve­ja­do de pre­gos e a con­fi­an­ça de quem nun­ca en­con­trou um pro­ble­ma que não pu­des­se re­sol­ver ba­ten­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não dis­se­ram na­da. Sa­que­a­do­res ra­ra­men­te per­dem tem­po com dis­cur­sos. Sim­ples­men­te sa­í­ram do ma­to ao mes­mo tem­po, co­mo se ti­ves­sem en­sai­a­do, e tal­vez ti­ves­sem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E o mun­do fi­cou sim­ples."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era is­so que Noct nun­ca con­se­gui­ria ex­pli­car a nin­guém, e que por­tan­to nun­ca ten­ta­va: a ma­nei­ra co­mo tu­do fi­ca­va "/>
                <ITEXT CPARENT="c_it" CH="sim­ples"/>
                <ITEXT CH=" quan­do ha­via uma fa­ca vin­do na di­re­ção de­le. Não ha­via es­ta­ção. Não ha­via bi­lhe­te. Não ha­via ban­co com uma pon­ta va­zia, nem fi­ta, nem "/>
                <ITEXT CPARENT="c_it" CH="e se fui eu que fiz ela ir em­bo­ra"/>
                <ITEXT CH=". Ha­via dis­tân­cia, ve­lo­ci­da­de, o pe­so do pé de trás, o bri­lho de uma fa­ca vin­do da es­quer­da um quar­to de se­gun­do an­tes do que de­ve­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ha­via res­pi­ra­ção."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele gi­rou. O an­te­bra­ço de­le en­con­trou o pul­so que se­gu­ra­va a pri­mei­ra fa­ca e a ar­ran­cou do ca­mi­nho com um es­ta­lo se­co. O sa­que­a­dor ma­gro tro­pe­çou pa­ra a fren­te, de­se­qui­li­bra­do, e Noct o dei­xou pas­sar e o acer­tou nas cos­tas com o co­to­ve­lo, sem to­da a for­ça, por­que não ha­via ne­ces­si­da­de, ain­da. O se­gun­do veio por bai­xo. Noct sal­tou. Por um ins­tan­te fi­cou no ar, a man­ta ba­ten­do nas cos­tas co­mo uma asa es­cu­ra, e viu o bos­que in­tei­ro de ci­ma, a luz ver­de, a la­ma, os ros­tos mas­ca­ra­dos olhan­do pa­ra ci­ma com sur­pre­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Des­ceu com o pu­nho na fren­te, e uma fa­gu­lha car­me­sim es­ta­lou nos nós dos de­dos no ins­tan­te do im­pac­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Dos dois ho­mens ma­gros su­biu aque­la né­voa fria, páli­da, que en­trou ne­le sem pe­dir. Sau­da­de sem do­no, ti­nha di­to Lí­via, pro­cu­ran­do lu­gar va­zio. Ele a sen­tiu se aco­mo­dar no pei­to, ao la­do da bra­sa, e as du­as coi­sas se olha­ram co­mo ga­tos es­tra­nhos di­vi­din­do uma sa­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O gran­de foi o úl­ti­mo. O por­re­te pas­sou tão per­to da ca­be­ça de Noct que ele sen­tiu o ven­to nos brin­cos. E en­tão acon­te­ceu a coi­sa que sem­pre acon­te­cia, a coi­sa que ele mais odi­a­va em si mes­mo e que mais es­pe­ra­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O can­to da bo­ca de­le su­biu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era um sor­ri­so de fe­li­ci­da­de. Era o sor­ri­so de quem es­tá se afo­gan­do há mui­to tem­po e, por um se­gun­do, sen­te o ar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O gran­de caiu co­mo uma ár­vo­re cai: de­va­gar, de­pois de uma vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O bos­que vol­tou a fa­zer ba­ru­lho. As fo­lhas, os pás­sa­ros, o ven­to. Noct fi­cou pa­ra­do no meio da tri­lha, os pu­nhos ain­da fe­cha­dos, res­pi­ran­do fun­do, e sen­tiu o mun­do fi­car com­pli­ca­do de no­vo, uma coi­sa de ca­da vez, co­mo rou­pas mo­lha­das sen­do ves­ti­das de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="En­con­trou a car­ro­ça mais adi­an­te, nu­ma cla­rei­ra."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Es­ta­va pa­ra­da de la­do, uma ro­da afun­da­da na la­ma, sem ca­va­lo. E pre­sa a ela, com as mãos amar­ra­das pa­ra trás em vol­ta de uma das tra­ves, ha­via uma mo­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou na bei­ra da cla­rei­ra e olhou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela era jo­vem, mas não mui­to. O ca­be­lo es­cu­ro es­ta­va pre­so de qual­quer jei­to, com fi­os sol­tos gru­da­dos no ros­to pe­lo suor. A rou­pa era sim­ples, de gen­te da es­tra­da. As cor­das nos pul­sos de­la eram no­vas, ás­pe­ras, aper­ta­das de­mais, e a pe­le em vol­ta já es­ta­va ver­me­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela tam­bém o olhou. Sem me­do, ou com um me­do tão bem guar­da­do que pa­re­cia ou­tra coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vai me sol­tar — dis­se ela — ou vai fi­car olhan­do?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct in­cli­nou a ca­be­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pen­san­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela abriu a bo­ca pa­ra res­pon­der, pro­va­vel­men­te com al­gu­ma coi­sa que ele me­re­ce­ria, e fe­chou de no­vo quan­do ele atra­ves­sou a cla­rei­ra em três pas­sos e cor­tou as cor­das com a fa­ca cur­va que ti­nha re­co­lhi­do da tri­lha. Ela es­fre­gou os pul­sos, en­co­lhen­do os om­bros de dor, e não ti­rou os olhos de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eles iam me en­tre­gar pro Cus­tó­dio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Quem?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Um ho­mem na ca­te­dral. Guar­da al­gu­ma coi­sa lá em­bai­xo. — Ela en­go­liu. — Pa­ga quem le­va gen­te pra ele. Gen­te que ou­ve a fen­da. Dis­se­ram que eu ou­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E o que ele faz com quem ou­ve?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não sei. — Ela es­fre­gou os pul­sos de no­vo. — Nin­guém que foi vol­tou pra con­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra ela de la­do. Era o olhar que ele usa­va quan­do que­ria sa­ber se al­guém es­ta­va men­tin­do, e ge­ral­men­te sa­bia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— E ou­ve?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela he­si­tou. Olhou pa­ra o chão, de­pois pa­ra o les­te, pa­ra o lu­gar on­de, por en­tre as ár­vo­res, o céu ti­nha aque­la cor sem no­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Às ve­zes. — A voz de­la bai­xou, co­mo se ti­ves­se ver­go­nha. — Pa­re­ce al­guém cha­man­do do ou­tro la­do de uma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O bos­que pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não de ver­da­de. As fo­lhas con­ti­nu­a­ram se me­xen­do, os pás­sa­ros con­ti­nu­a­ram can­tan­do. Mas pa­ra Noct, por um ins­tan­te, tu­do pa­rou, co­mo se al­guém ti­ves­se se­gu­ra­do o mun­do pe­la go­la."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Pa­re­ce al­guém cha­man­do do ou­tro la­do de uma por­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As mes­mas pa­la­vras. Na mes­ma or­dem. Di­tas por uma bo­ca que não era a de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não dis­se na­da. Não ha­via na­da que pu­des­se ser di­to sem que al­gu­ma coi­sa den­tro de­le se abris­se. A mão es­quer­da foi até a fi­ta e ele a dei­xou ir, por­que não ti­nha for­ça, na­que­le se­gun­do, pa­ra cha­má-la de vol­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A mo­ça per­ce­beu. Ele viu que ela per­ce­beu. Os olhos de­la fo­ram até o pul­so de­le e vol­ta­ram pa­ra o ros­to, e ela te­ve o bom sen­so, ou a gen­ti­le­za, de não per­gun­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas ele per­gun­tou. Por den­tro, on­de ela não ou­via."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Um ho­mem nu­ma ca­te­dral que pa­ga­va pa­ra re­ce­ber gen­te que ou­via a fen­da. Gen­te que ou­via aque­le cha­ma­do. Por quê? O que um ho­mem quer com es­se ti­po de gen­te, a pon­to de pa­gar sa­que­a­dor pa­ra bus­cá-la amar­ra­da?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mi­ra ou­via."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A per­gun­ta veio so­zi­nha, fria, e en­con­trou lu­gar num can­to que ele acha­va que já es­ta­va cheio: se al­guém, um dia, tam­bém ti­nha ido atrás de­la. Se o jei­to dis­tan­te de­la na­que­las úl­ti­mas se­ma­nas, a la­ma nas bo­tas, a fo­lha do­bra­da no bol­so ti­nham al­gu­ma coi­sa a ver com um ho­mem nu­ma ca­te­dral."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Anos achan­do que ela ti­nha ido em­bo­ra. E se al­guém ti­ves­se le­va­do?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Aí veio a rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não su­biu de­va­gar, co­mo as ou­tras coi­sas. Veio in­tei­ra, de uma vez, quen­te, de um lu­gar abai­xo das cos­te­las que ele não sa­bia que ain­da es­ta­va ace­so. A bra­sa res­pon­deu jun­to, e por um se­gun­do os nós dos de­dos de­le bri­lha­ram ver­me­lhos den­tro das lu­vas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Se al­guém ti­ves­se en­cos­ta­do um de­do ne­la. Um só. Se al­guém ti­ves­se amar­ra­do aque­les pul­sos, do jei­to que ti­nham amar­ra­do os des­sa mo­ça."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Eu ma­to"/>
                <ITEXT CH=", pen­sou. Não co­mo ame­a­ça. Co­mo quem faz uma con­ta sim­ples. "/>
                <ITEXT CPARENT="c_it" CH="O ho­mem da ca­te­dral. Quem pa­gou. Quem car­re­gou. Quem viu e fi­cou ca­la­do. To­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os pu­nhos es­ta­vam fe­cha­dos. Ele não lem­bra­va de ter fe­cha­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Abriu as mãos de­va­gar, um de­do de ca­da vez, e não ter­mi­nou o pen­sa­men­to. Guar­dou pa­ra de­pois, jun­to com o res­to. Mas guar­dou mal, co­mo guar­da­va tu­do, e o pen­sa­men­to fi­cou ali, aber­to, co­mo uma por­ta que não fe­cha di­rei­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se vi­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vai pra Pe­dra­ve­lha — dis­se, e a voz saiu mais du­ra do que ele pre­ten­dia, ou exa­ta­men­te tão du­ra quan­to pre­ten­dia. — Fi­ca lon­ge da tri­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela não se me­xeu de ime­di­a­to. Fi­cou olhan­do as cos­tas de­le, es­fre­gan­do os pul­sos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Obri­ga­da — dis­se. — Eu sou Tes­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Não per­gun­te o no­me"/>
                <ITEXT CH=", pen­sou ele. "/>
                <ITEXT CPARENT="c_it" CH="Nun­ca per­gun­te o no­me. No­mes são co­mo cor­das. Vo­cê pe­ga uma e de re­pen­te es­tá amar­ra­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tar­de de­mais. Ela já ti­nha di­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não trans­for­ma is­so nu­ma coi­sa sen­ti­men­tal."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela riu. Uma ri­sa­da cur­ta, sur­pre­sa, qua­se ofen­di­da, e ele odi­ou o quan­to o som se pa­re­cia com uma coi­sa que ele não ou­via há mui­to tem­po."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do olhou pa­ra trás, ela já ti­nha su­mi­do en­tre as ár­vo­res, na di­re­ção da vi­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele fi­cou pa­ra­do até não ou­vir mais os pas­sos de­la. Só en­tão se­guiu em fren­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pen­sou no mo­ti­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O es­con­de­ri­jo dos sa­que­a­do­res fi­ca­va num tron­co oco, no al­to de uma su­bi­da, dis­far­ça­do com ga­lhos."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ti­nha o que es­con­de­ri­jos de sa­que­a­do­res cos­tu­mam ter: pro­vi­sões rou­ba­das, sa­cos de grãos com o se­lo de fa­zen­das di­fe­ren­tes, uma gar­ra­fa de al­gu­ma coi­sa for­te pe­la me­ta­de. E, en­ro­la­do nu­ma ti­ra de cou­ro, um pa­pel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct o de­sen­ro­lou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era uma lis­ta de no­mes. Al­guns ris­ca­dos. Al­guns com uma mar­ca ao la­do, um pe­que­no cír­cu­lo, co­mo quem mar­ca uma en­tre­ga fei­ta. Em­bai­xo, nu­ma le­tra di­fe­ren­te, mais ca­pri­cha­da, mais fria, uma or­dem:"/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="En­tre­gar os que ou­vi­rem a fen­da ao Cus­tó­dio da ca­te­dral."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele leu a lis­ta in­tei­ra. Pro­cu­rou um no­me que sa­bia que não ia es­tar ali, por­que o tem­po não fe­cha­va, por­que a ge­o­gra­fia não fe­cha­va. Pro­cu­rou mes­mo as­sim, li­nha por li­nha, du­as ve­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não es­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O alí­vio que sen­tiu foi tão gran­de que o dei­xou com rai­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não era só rou­bo — dis­se, e a voz saiu sé­ria, sem ne­nhu­ma das ares­tas que ele cos­tu­ma­va dei­xar ne­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No can­to do pa­pel ha­via um de­se­nho rústi­co, fei­to a car­vão: uma ca­vei­ra, e em­bai­xo de­la uma se­ta apon­tan­do pa­ra ci­ma. Uma por­ta. Uma ru­í­na no al­to de uma ca­te­dral."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct do­brou a lis­ta em qua­tro e a guar­dou no bol­so de den­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Jun­to do bi­lhe­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O bol­so es­ta­va fi­can­do pe­sa­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Na­que­la noi­te ele acam­pou no bos­que, sem fo­go, en­cos­ta­do nu­ma ár­vo­re lar­ga o bas­tan­te pa­ra pro­te­ger as cos­tas."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não dor­miu. Fi­cou ou­vin­do os sons da noi­te e se­pa­ran­do ca­da um: co­ru­ja, ven­to, um bi­cho pe­que­no no ma­to, na­da, na­da, na­da. Era um exer­cí­cio que acal­ma­va. Fa­zia a ca­be­ça tra­ba­lhar em coi­sas que não ma­chu­ca­vam."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mas a ca­be­ça de­le ti­nha su­as pró­prias idei­as."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Es­tou bem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele ti­nha di­to is­so a ela uma vez, nu­ma noi­te em que não es­ta­va. Não lem­bra­va mais por quê. Lem­bra­va da co­zi­nha pe­que­na, do chei­ro de chá quei­ma­do, de­la en­cos­ta­da no ba­ten­te olhan­do pa­ra ele com os bra­ços cru­za­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Vo­cê co­ça a so­bran­ce­lha quan­do men­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele pa­rou de co­çar. Na ho­ra. Dei­xou a mão cair ao la­do do cor­po, pa­ra­da, per­fei­ta­men­te con­tro­la­da, e olhou pa­ra ela com a ca­ra mais neu­tra que ti­nha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela es­trei­tou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ago­ra vo­cê es­tá men­tin­do com a mão pa­ra­da. É pi­or."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No bos­que es­cu­ro, en­cos­ta­do na ár­vo­re, Noct sol­tou o ar pe­lo na­riz. Não era bem uma ri­sa­da. Era o fan­tas­ma de uma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ela era in­su­por­tá­vel — dis­se pa­ra a noi­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A co­ru­ja não con­cor­dou nem dis­cor­dou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a mão de­le, sem que ele per­ce­bes­se, es­ta­va pa­ra­da."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="13218.4251968504" OwnPage="37" ItemID="873213929" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="13218.4251968504" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="873912953" BACKITEM="861995129"/>
