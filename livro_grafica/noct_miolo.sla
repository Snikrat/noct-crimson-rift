        <PAGEOBJECT XPOS="621.574803149606" YPOS="20934.9606299213" OwnPage="60" ItemID="845379865" PTYPE="4" WIDTH="334.488188976378" HEIGHT="226.771653543307" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" copath="M0 0 L334.488 0 L334.488 226.772 L0 226.772 L0 0 Z" gXpos="621.574803149606" gYpos="20934.9606299213" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Parte III"/>
                <para PARENT="parte_num"/>
                <ITEXT CH="As Terras Esquecidas"/>
                <para PARENT="parte"/>
                <ITEXT CH="Há terras que o mundo esquece de propósito, do mesmo jeito que uma pessoa esquece um nome que dói. Mas a terra não esquece. A terra guarda tudo o que se enterra nela, e espera."/>
                <trail PARENT="parte_epi"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="771.811023622047" YPOS="21190.0787401575" OwnPage="60" ItemID="902803305" PTYPE="2" WIDTH="34.0157480314961" HEIGHT="34.0157480314961" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.0354330708661417" LOCALSCY="0.0354330708661417" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="emblema_cinza.png" IRENDER="0" EMBEDDED="0" path="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" copath="M0 0 L34.0157 0 L34.0157 34.0157 L0 34.0157 L0 0 Z" gXpos="771.811023622047" gYpos="21190.0787401575" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="21607.0866141732" OwnPage="62" ItemID="845167097" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="21607.0866141732" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="906572809" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 7"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Um pân­ta­no com ape­ti­te"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="Z"/>
                <ITEXT CH="e­no ti­nha avi­sa­do. O pân­ta­no a les­te en­go­liu mui­tos."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct en­ten­deu o que o ve­lho quis di­zer as­sim que pi­sou ne­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não era um lu­gar. Era uma di­ges­tão. A ter­ra ce­dia sob as bo­tas com um sus­pi­ro mo­lha­do, e a água es­cu­ra su­bia pe­las bor­das da pe­ga­da co­mo quem pro­va o gos­to. As ár­vo­res não ti­nham fo­lhas, só bar­bas de mus­go cin­zen­to pen­du­ra­das dos ga­lhos, e o ar era tão pe­sa­do que pa­re­cia ser res­pi­ra­do du­as ve­zes an­tes de che­gar ao pul­mão. Bo­lhas su­bi­am do lo­do e es­tou­ra­vam de­va­gar, sem pres­sa, sol­tan­do um chei­ro do­ce e po­dre."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Chei­ra a coi­sa mor­ta — dis­se ele, co­brin­do o na­riz com o an­te­bra­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou em vol­ta. Pa­ra a água pa­ra­da, os tron­cos mor­tos, a luz ver­de e do­en­te que vi­nha de lu­gar ne­nhum."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Com­bi­na co­mi­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pân­ta­no não achou gra­ça. Pân­ta­nos ra­ra­men­te acham."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A coi­sa co­me­çou a se­gui-lo na pri­mei­ra ho­ra."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Ele não a viu de ca­ra. Ou­viu. Um cha­pe-cha­pe do ou­tro la­do de uma moi­ta, sem­pre na mes­ma dis­tân­cia, pa­ran­do quan­do ele pa­ra­va. Quan­do ele su­bia num tron­co, o ba­ru­lho su­bia jun­to. Quan­do ele des­cia, des­cia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na ter­cei­ra vez que acon­te­ceu, ele se vi­rou de uma vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os mo­ra­do­res de Pe­dra­ve­lha nun­ca ti­nham da­do um no­me àqui­lo. Cha­ma­vam de "/>
                <ITEXT CPARENT="c_it" CH="a coi­sa"/>
                <ITEXT CH=", ou de "/>
                <ITEXT CPARENT="c_it" CH="aqui­lo do pân­ta­no"/>
                <ITEXT CH=", abai­xan­do a voz. Era al­ta e ma­gra e fei­ta do mes­mo ma­te­ri­al que o lo­do, co­mo se o pân­ta­no ti­ves­se se le­van­ta­do e ten­ta­do se lem­brar de co­mo era ter per­nas. On­de de­ve­ria ha­ver um ros­to ha­via só dois bu­ra­cos úmi­dos. Olhan­do pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na mes­ma al­tu­ra que ele. Sem­pre na mes­ma al­tu­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê tam­bém não tem pa­ra on­de ir — dis­se Noct."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A coi­sa avan­çou. Ele tam­bém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi uma lu­ta sem gló­ria, cheia de la­ma e de gol­pes que afun­da­vam em ma­té­ria mo­le sem sa­ber se ti­nham acer­ta­do al­gu­ma coi­sa im­por­tan­te. Quan­do ter­mi­nou, Noct es­ta­va co­ber­to de lo­do até o pes­co­ço e a coi­sa ti­nha se des­fei­to de vol­ta no pân­ta­no, sem gri­to, co­mo um pen­sa­men­to ruim que fi­nal­men­te can­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­la não su­biu na­da. Nem a né­voa fria, nem um fio. Ne­nhu­ma sau­da­de."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tal­vez aqui­lo ti­ves­se es­que­ci­do até o que ti­nha per­di­do, e só con­ti­nu­as­se an­dan­do por hábi­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não gos­tou de pen­sar nis­so. Pas­sa­va os di­as ten­tan­do es­que­cer. Nun­ca ti­nha pen­sa­do em co­mo se­ria con­se­guir."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Cho­veu no meio da tar­de."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não uma chu­va de lim­par coi­sas. O pân­ta­no não per­mi­tia es­se ti­po de chu­va. Era uma ga­roa mor­na, gru­den­ta, que só ser­via pa­ra dei­xar a la­ma mais mo­le e o mun­do mais cin­za."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se abri­gou em­bai­xo de uma ár­vo­re ca­í­da, on­de o tron­co fa­zia um te­to tor­to, e fi­cou olhan­do a água cair na água."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ba­ru­lho era o mes­mo."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="O mes­mo de um te­lha­do"/>
                <ITEXT CH=", pen­sou, an­tes de con­se­guir não pen­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão já era tar­de de­mais, por­que a lem­bran­ça ti­nha atra­ves­sa­do a por­ta an­tes que ele con­se­guis­se fe­chá-la, e es­ta­va ali, sen­ta­da ao la­do de­le em­bai­xo do tron­co, mo­lha­da e rin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Nu­ma noi­te de chu­va, ela amar­rou a fi­ta car­me­sim no pul­so de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Eles ti­nham se atra­sa­do pa­ra al­gu­ma coi­sa. Ele não lem­bra­va mais o quê. Ti­nham cor­ri­do os úl­ti­mos me­tros até a co­ber­tu­ra da es­ta­ção, ela na fren­te, ele atrás, re­cla­man­do, e che­ga­ram en­char­ca­dos, ela com o ca­be­lo gru­da­do no ros­to e as mãos ge­la­das."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ti­rou a fi­ta do pró­prio ca­be­lo. A de to­do dia. Ele co­nhe­cia aque­la fi­ta co­mo co­nhe­cia tu­do ne­la: o nó sem­pre um pou­co tor­to, do la­do es­quer­do, a pon­ta des­fi­a­da que ela mor­dia quan­do pen­sa­va de­mais. Nun­ca ti­nha ima­gi­na­do aque­la fi­ta fo­ra do ca­be­lo de­la."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Pe­gou o pul­so de­le, sem pe­dir, co­mo pe­ga­va tu­do de­le sem pe­dir, e co­me­çou a amar­rar."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="O que é is­so?"/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Pra vo­cê lem­brar de vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele olhou pa­ra a fi­ta. Ver­me­lha. Não um ver­me­lho bo­ni­to, de vi­tri­ne. Um ver­me­lho es­cu­ro, qua­se mar­rom de tão pro­fun­do, co­mo uma bra­sa que es­que­ceu de apa­gar."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Lem­brar de quê?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela ter­mi­nou o nó. Pu­xou fir­me. Olhou pa­ra ele por bai­xo da fran­ja mo­lha­da, com aque­la ex­pres­são que di­zia que ele es­ta­va sen­do len­to de pro­pósi­to e que ela ia ter pa­ciên­cia, des­ta vez, mas só des­ta vez."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="De mim, idi­o­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em­bai­xo do tron­co, no pân­ta­no, Noct fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não dis­se na­da. Não ha­via na­da que pu­des­se ser di­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Os de­dos de­le es­ta­vam no nó. O mes­mo nó. Ele nun­ca ti­nha de­sa­mar­ra­do. Nem pa­ra la­var, nem pa­ra dor­mir, nem nas noi­tes em que a fi­ta ti­nha fi­ca­do tão en­char­ca­da de san­gue que ele achou que nun­ca mais sai­ria a cor. Saiu. A cor de­la sem­pre vol­ta­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ga­roa con­ti­nuou cain­do. A água con­ti­nuou cain­do na água."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E du­ran­te mui­to tem­po, em­bai­xo de uma ár­vo­re mor­ta, num pân­ta­no que co­mia gen­te, um ho­mem fi­cou pa­ra­do se­gu­ran­do o pró­prio pul­so co­mo quem se­gu­ra a mão de al­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Quan­do a chu­va pa­rou, ele se le­van­tou e se­guiu pa­ra les­te."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="An­dou pen­san­do na lis­ta. Não que­ria, mas ela pe­sa­va no bol­so de den­tro, jun­to do bi­lhe­te, e a ca­da pas­so ro­ça­va no pei­to. No­mes ris­ca­dos. Pe­que­nos cír­cu­los de en­tre­gue. Uma le­tra fria man­dan­do le­var ao Cus­tó­dio quem ou­vis­se a fen­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mi­ra ou­via. Ele sa­bia dis­so ago­ra, por cau­sa de uma pe­dra no al­to da ser­ra. Ela ou­via, e sa­ía de ma­dru­ga­da atrás do que ou­via, nu­ma ter­ra on­de um ho­mem de ca­te­dral pa­ga­va por gen­te as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Ela não es­ta­va na lis­ta"/>
                <ITEXT CH=", dis­se a si mes­mo. Era a ter­cei­ra vez que di­zia. Não fi­ca­va mais ver­da­dei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pân­ta­no foi fi­can­do mais ra­so, mais fir­me. As bar­bas de mus­go de­ram lu­gar a ga­lhos se­cos. O chei­ro do­ce e po­dre deu lu­gar a ou­tro chei­ro, mais se­co, mais frio, de pe­dra e de ter­ra re­vi­ra­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Adi­an­te, so­bre uma co­li­na bai­xa, apa­re­ce­ram as pri­mei­ras cru­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tor­tas. Al­gu­mas ca­í­das. Mui­tas sem no­me."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou no pé da co­li­na e olhou pa­ra ci­ma."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to de­le, que ti­nha fi­ca­do qui­e­ta du­ran­te to­do o pân­ta­no, deu um pul­so. De­pois ou­tro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Co­mo al­guém que re­co­nhe­ce um lu­gar."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="22214.0157480315" OwnPage="63" ItemID="906572809" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="22214.0157480315" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="905996601" BACKITEM="845167097"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="22214.0157480315" OwnPage="64" ItemID="905996601" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="22214.0157480315" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="906127641" BACKITEM="906572809"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="22905.9842519685" OwnPage="65" ItemID="906127641" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="22905.9842519685" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="905996601"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="22991.0236220473" OwnPage="66" ItemID="910217385" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="621.574803149606" gYpos="22991.0236220473" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="915096409" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 8"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="O la­do es­quer­do"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="O"/>
                <ITEXT CH=" Ce­mi­té­rio Es­que­ci­do ti­nha es­se no­me por­que al­guém, um dia, ti­nha se lem­bra­do de­le o su­fi­ci­en­te pa­ra ba­ti­zá-lo. De­pois dis­so, nin­guém mais vol­tou."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="As lápi­des se es­pa­lha­vam pe­la co­li­na sem or­dem, co­mo den­tes nu­ma bo­ca ve­lha. Al­gu­mas eram de pe­dra boa, en­ta­lha­das, com an­jos de asas que­bra­das no to­po. A mai­o­ria era só uma la­je fin­ca­da na ter­ra, ou uma cruz de ma­dei­ra tão gas­ta que já não se dis­tin­guia dos ga­lhos se­cos em vol­ta. O ven­to pas­sa­va en­tre elas as­so­bi­an­do bai­xo, uma músi­ca sem me­lo­dia que pa­re­cia sem­pre a pon­to de vi­rar uma can­ção e nun­ca vi­ra­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou no por­tão, que não ti­nha mais por­ta, só dois pi­la­res."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Ce­mi­té­rio — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a pa­la­vra fi­cou ali, no ar frio, pe­san­do mais do que de­ve­ria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não gos­ta­va de ce­mi­té­rios. Não por me­do dos mor­tos. Os mor­tos eram, na ex­pe­riên­cia de­le, a par­te me­nos pro­ble­máti­ca da po­pu­la­ção. Não gos­ta­va de ce­mi­té­rios por­que ce­mi­té­rios eram lu­ga­res on­de as pes­so­as iam vi­si­tar al­guém."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E ele nem sa­bia se ti­nha al­guém pa­ra vi­si­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via cor­po. Não ha­via lápi­de. Não ha­via nem a cer­te­za de que de­via ha­ver uma. Ha­via um bi­lhe­te, uma fi­ta e um ban­co de es­ta­ção com um la­do va­zio. Era tu­do o que ela ti­nha dei­xa­do, e ele car­re­ga­va tu­do con­si­go, por­que não ha­via on­de pou­sar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os olhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Pas­so rápi­do por aqui."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Não pas­sou rápi­do."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O chão não dei­xou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na me­ta­de da su­bi­da, a ter­ra tre­meu. Não co­mo um ter­re­mo­to. Co­mo uma res­pi­ra­ção. Um tre­mor cur­to, car­me­sim, que acen­deu as ra­cha­du­ras en­tre as lápi­des com uma luz ver­me­lha que vi­nha de bai­xo, e Noct sen­tiu a bra­sa no pei­to res­pon­der an­tes mes­mo de en­ten­der o que es­ta­va acon­te­cen­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão os mor­tos se le­van­ta­ram."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Mãos pri­mei­ro. De­dos de os­so abrin­do ca­mi­nho pe­la ter­ra co­mo ra­í­zes ao con­trá­rio. De­pois bra­ços, crâ­nios, cos­te­las pre­sas por res­tos de rou­pa que um dia al­guém ti­nha es­co­lhi­do com cui­da­do pa­ra um en­ter­ro. Es­que­le­tos, uma dú­zia de­les, er­guen­do-se das co­vas com a len­ti­dão de quem acor­da de um so­no mui­to lon­go e não es­tá na­da sa­tis­fei­to com is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fe­chou os pu­nhos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Bom dia — dis­se. — Des­cul­pa o ba­ru­lho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Eles não fa­la­vam. Não ti­nham co­mo. Mas avan­ça­ram, e ca­da vez que o chão res­pi­ra­va ver­me­lho, ou­tros vi­nham."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele lu­tou su­bin­do a co­li­na. Os­sos es­ta­la­vam sob os so­cos e os chu­tes, se des­mon­ta­vam, ca­í­am em pi­lhas que às ve­zes, se ele não fos­se rápi­do o su­fi­ci­en­te, ten­ta­vam se mon­tar de no­vo. Era um tra­ba­lho can­sa­ti­vo e sem sen­ti­do, co­mo var­rer fo­lhas num dia de ven­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a ca­da vez que a ter­ra pul­sa­va, a bra­sa no pei­to de­le pul­sa­va jun­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No mes­mo rit­mo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi is­so que o as­sus­tou. Não os mor­tos. Os mor­tos eram só os­sos. Foi per­ce­ber que a coi­sa que os fa­zia le­van­tar e a coi­sa que mo­ra­va nas cos­te­las de­le ba­ti­am jun­tas, co­mo dois co­ra­ções no mes­mo pei­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="No al­to da co­li­na, per­to de uma la­je ra­cha­da, ele en­con­trou a lápi­de sem no­me."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não era que não ti­ves­se no­me. Ti­nha ti­do. Al­guém ti­nha ras­pa­do as le­tras com tan­ta for­ça que a pe­dra es­ta­va fun­da ali, uma ca­vi­da­de li­sa on­de an­tes ha­via uma pes­soa. Em­bai­xo, nu­ma le­tra me­nor, que o ras­pa­dor não ti­nha al­can­ça­do ou não ti­nha que­ri­do al­can­çar, ha­via uma fra­se:"/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Os mor­tos não dor­mem quan­do a fen­da res­pi­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra a fra­se. De­pois pa­ra as pi­lhas de os­sos es­pa­lha­das pe­la co­li­na atrás de­le, ain­da tre­men­do de le­ve, ten­tan­do lem­brar de co­mo fi­car de pé."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nem os vi­vos — dis­se bai­xo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Na ba­se da lápi­de, qua­se apa­ga­da pe­la chu­va, uma se­ta ris­ca­da apon­ta­va pa­ra ci­ma, pa­ra les­te. Pa­ra o pon­to mais al­to do ce­mi­té­rio, on­de uma es­tá­tua de pe­dra se er­guia con­tra o céu cin­zen­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="A es­tá­tua era de um vi­gia."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não o Vi­gia do bos­que. Ou­tro: um ho­mem de pe­dra com uma lan­ter­na na mão er­gui­da e o ros­to vol­ta­do pa­ra o va­le, de on­de vi­nha a es­tra­da de Pe­dra­ve­lha. Mus­go cres­cia nos om­bros de­le. Um pás­sa­ro ti­nha fei­to ni­nho na lan­ter­na."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em­bai­xo, pre­sa en­tre a ba­se e uma pe­dra sol­ta, ha­via uma car­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O pa­pel es­ta­va ama­re­la­do e du­ro, mas pro­te­gi­do da chu­va. Noct a des­do­brou com cui­da­do."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Fe­cha­mos os tú­mu­los. Não fe­cha­mos aqui­lo que ou­viu nos­sos no­mes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— En­tão é por is­so que o chão se me­xe — dis­se ele, bai­xo, pa­ra a es­tá­tua."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Aqui­lo que ou­viu nos­sos no­mes."/>
                <ITEXT CH=" Pen­sou na lis­ta. Pen­sou num ho­mem que guar­da­va al­gu­ma coi­sa em­bai­xo de uma ca­te­dral e pa­ga­va por quem ou­vis­se a fen­da, e em quan­tos da­que­les tú­mu­los sem no­me ti­nham si­do gen­te que ou­viu de­mais. Pen­sou ne­la, de pé nu­ma tri­lha de ma­dru­ga­da, es­cu­tan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa deu um pul­so. Ele aper­tou a car­ta até o pa­pel es­ta­lar, e de­pois a ali­sou de no­vo, com cui­da­do, por­que não era cul­pa do pa­pel."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Leu o res­to."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="A pas­sa­gem pe­la ser­ra abre do la­do do vi­gia. Vol­tem pa­ra ca­sa an­tes que a noi­te lem­bre de vo­cês."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra o ho­ri­zon­te. O sol es­ta­va bai­xo, ver­me­lho, ou tal­vez fos­se só a fen­da man­chan­do o céu co­mo sem­pre."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="An­tes que a noi­te lem­bre de vo­cês."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele pen­sou em quan­tas noi­tes ti­nham se lem­bra­do de­le. To­das, pro­va­vel­men­te. A noi­te era a par­te do dia em que as lem­bran­ças ti­nham co­ra­gem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Atrás da es­tá­tua, en­tre as pe­dras, ele en­con­trou a pas­sa­gem que o Fo­ras­tei­ro ti­nha men­ci­o­na­do: uma bre­cha es­trei­ta na ro­cha, blo­que­a­da por uma ala­van­ca en­fer­ru­ja­da que só se al­can­ça­va da­que­le la­do. Ele a pu­xou. A pe­dra ran­geu, ce­deu, e de re­pen­te ha­via um ca­mi­nho di­re­to de vol­ta pa­ra a ser­ra, pa­ra Pe­dra­ve­lha, pa­ra ca­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ca­sa. Ele riu da pa­la­vra, sem som."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Na ba­se da es­tá­tua, a pe­dra for­ma­va um de­grau lar­go, com­pri­do o bas­tan­te pa­ra du­as pes­so­as."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não era um ban­co, mas fun­ci­o­na­va co­mo um. O mun­do ti­nha um sen­so de hu­mor cru­el e con­sis­ten­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tal­vez ti­ves­se si­do fei­to pa­ra quem vi­es­se vi­si­tar os mor­tos e pre­ci­sas­se des­can­sar as per­nas, ou o co­ra­ção. Du­as pon­tas. Dois lu­ga­res."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se sen­tou nu­ma pon­ta. O ou­tro la­do fi­cou va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E des­ta vez a lem­bran­ça não pre­ci­sou for­çar a por­ta. Ele mes­mo a abriu, por­que es­ta­va can­sa­do de­mais pa­ra se­gu­rar."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="No ban­co da es­ta­ção, ela sem­pre sen­ta­va à es­quer­da. Ele, à di­rei­ta."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Nun­ca ti­nham com­bi­na­do. Na pri­mei­ra vez, ela sen­tou pri­mei­ro, e es­co­lheu a es­quer­da sem pen­sar. Na se­gun­da, ele che­gou pri­mei­ro, e sen­tou na di­rei­ta, e dei­xou a es­quer­da li­vre sem per­ce­ber que es­ta­va dei­xan­do. Na ter­cei­ra, já era as­sim. Na déci­ma, era lei."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Só fi­cou as­sim."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela con­ta­va as ra­po­sas na bei­ra dos tri­lhos. Ele con­ta­va os mi­nu­tos de atra­so do trem. Os dois eram péssi­mos em fin­gir que es­ta­vam fa­zen­do ou­tra coi­sa além de es­pe­rar jun­tos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E quan­do o trem atra­sa­va mui­to, ela en­cos­ta­va a ca­be­ça no om­bro de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="É por cau­sa do frio"/>
                <ITEXT CH=", ela di­zia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele nun­ca dis­cu­tiu. Nun­ca dis­se na­da. Só fi­ca­va mui­to qui­e­to, mui­to pa­ra­do, do jei­to que se fi­ca quan­do um pás­sa­ro pou­sa per­to e vo­cê não quer que ele vá em­bo­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No ce­mi­té­rio, no de­grau da es­tá­tua, Noct olhou pa­ra bai­xo. Pa­ra as pró­prias mãos, pa­ra a fi­ta, pa­ra o chão en­tre os pés."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não olhou pa­ra a es­quer­da. Nun­ca olha­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Não es­ta­va frio — dis­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O ven­to pas­sou en­tre as lápi­des, e a músi­ca sem me­lo­dia qua­se vi­rou uma can­ção."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Qua­se."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="23597.9527559055" OwnPage="67" ItemID="915096409" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="23597.9527559055" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="914954057" BACKITEM="910217385"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="23597.9527559055" OwnPage="68" ItemID="914954057" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="23597.9527559055" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="914758313" BACKITEM="915096409"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="24289.9212598425" OwnPage="69" ItemID="914758313" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="24289.9212598425" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="914633801" BACKITEM="914954057"/>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="24289.9212598425" OwnPage="70" ItemID="914633801" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="24289.9212598425" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="914758313"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="25066.9291338583" OwnPage="71" ItemID="917604857" PTYPE="4" WIDTH="334.488188976378" HEIGHT="458.96062992126" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" copath="M0 0 L334.488 0 L334.488 458.961 L0 458.961 L0 0 Z" gXpos="151.023622047244" gYpos="25066.9291338583" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="924164921" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ca­pí­tu­lo 9"/>
                <para PARENT="rotulo"/>
                <ITEXT CH="Fi­nal­men­te"/>
                <para PARENT="titulo"/>
                <ITEXT CPARENT="c_inicial" CH="A"/>
                <ITEXT CH="lém do ce­mi­té­rio, a ter­ra des­cia pa­ra uma ra­vi­na, e a ra­vi­na ter­mi­na­va nu­ma bo­ca."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Não ha­via ou­tro no­me pa­ra aqui­lo. Era uma aber­tu­ra na en­cos­ta, lar­ga e bai­xa, com pe­dras pon­tu­das em ci­ma e em­bai­xo co­mo den­tes, e de den­tro de­la sa­ía um ca­lor se­co que fa­zia o ar tre­mer. As plan­tas em vol­ta es­ta­vam quei­ma­das. Não mor­tas de in­ver­no, nem de do­en­ça. Quei­ma­das, as pon­tas pre­tas e re­tor­ci­das, co­mo se al­guém ti­ves­se pas­sa­do com uma to­cha mui­tas e mui­tas ve­zes."/>
                <para PARENT="corpo"/>
                <ITEXT CH="No chão, na en­tra­da, ha­via mar­cas de gar­ra. Ca­da uma do ta­ma­nho de um an­te­bra­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct se aga­chou e pas­sou os de­dos por uma de­las. A pe­dra ain­da es­ta­va mor­na."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Uma ca­ver­na que nin­guém vi­si­ta du­as ve­zes"/>
                <ITEXT CH=", ti­nha di­to o Fo­ras­tei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não ti­nha vin­do de mãos va­zi­as. An­tes da ra­vi­na, ti­nha vol­ta­do a Pe­dra­ve­lha pe­lo ata­lho do vi­gia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não pre­ten­dia fi­car. Dis­se is­so a si mes­mo na des­ci­da da ser­ra, e de no­vo quan­do as pri­mei­ras lu­zes da vi­la apa­re­ce­ram lá em­bai­xo, e de no­vo quan­do os pés, sem pe­dir li­cen­ça, di­mi­nu­í­ram o pas­so na en­tra­da da pra­ça. Os lam­pi­ões es­ta­vam ace­sos, co­mo sem­pre. O ban­co es­ta­va no mes­mo lu­gar. Ze­no es­ta­va sen­ta­do no de­grau de ca­sa e le­van­tou a mão de­va­gar, sem sur­pre­sa ne­nhu­ma, co­mo quem cum­pri­men­ta al­guém que já es­pe­ra­va ver vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi is­so que o pe­gou des­pre­ve­ni­do. Não o can­sa­ço, nem os os­sos do ce­mi­té­rio. Pe­dra­ve­lha ele co­nhe­cia. Du­as ou três tar­des de fei­ra, meio pas­so atrás de­la, car­re­gan­do as com­pras. Mas nun­ca ti­nha re­pa­ra­do na vi­la. Re­pa­ra­va ne­la. Ago­ra, sem ela, a vi­la es­ta­va ali, in­tei­ra, e ha­via gen­te que re­pa­ra­va quan­do ele não es­ta­va. Fa­zia anos que ne­nhum lu­gar fa­zia is­so com ele, e ele sa­bia co­mo es­se ti­po de coi­sa ter­mi­na­va."/>
                <para PARENT="corpo"/>
                <ITEXT CPARENT="c_it" CH="Quem não che­ga per­to não tem co­mo ir em­bo­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Per­to do po­ço, uma fi­gu­ra pe­que­na pu­xa­va o bal­de com as du­as mãos. Tes­sa. Os pul­sos ain­da ver­me­lhos das cor­das. Ela o viu, lar­gou a cor­da do bal­de, e ele viu a bo­ca de­la co­me­çar a for­mar al­gu­ma coi­sa."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não sen­tou no ban­co. Não es­pe­rou pa­ra ou­vir. Atra­ves­sou a pra­ça de ca­be­ça bai­xa e foi di­re­to pa­ra a for­ja."/>
                <para PARENT="corpo"/>
                <ITEXT CH="As lu­vas ve­lhas es­ta­vam aca­ba­das: o cou­ro aber­to nos nós dos de­dos, a cos­tu­ra sol­ta, uma man­cha es­cu­ra do Ca­pi­tão que ne­nhu­ma água ti­nha ti­ra­do. Noct pôs no bal­cão qua­se to­das as mo­e­das do Vi­gia Er­ran­te e apon­tou pa­ra um par no­vo pen­du­ra­do na pa­re­de. Cou­ro gros­so, pla­cas de fer­ro ba­ti­do so­bre os nós dos de­dos. Era tu­do de que pre­ci­sa­va. Não com­prou mais na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Brom não dis­se uma pa­la­vra. Ajus­tou as ti­ras, aper­tou as pla­cas até as lu­vas ca­í­rem nas mãos de­le co­mo uma se­gun­da pe­le. Olhou pa­ra as mãos de­le, de­pois pa­ra Noct, de­pois de no­vo pa­ra as mãos, e ba­lan­çou a ca­be­ça co­mo quem não apro­va na­da, mas faz mes­mo as­sim. Noct já es­ta­va na por­ta quan­do o mar­te­lo pa­rou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vol­ta in­tei­ro — dis­se Brom."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Foi só is­so."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Tes­sa es­ta­va do la­do de fo­ra, en­cos­ta­da na pa­re­de da for­ja, de bra­ços cru­za­dos. Ti­nha es­pe­ra­do o ser­vi­ço in­tei­ro."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Vo­cê vai pra on­de ago­ra?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pro Co­vil. Além do ce­mi­té­rio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ela fi­cou um tem­po qui­e­ta. Ele viu que ela sa­bia o que ha­via além do ce­mi­té­rio. To­do mun­do na vi­la sa­bia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Nin­guém vol­ta de lá."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu vol­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Pro­me­te?"/>
                <para PARENT="corpo"/>
                <ITEXT CH="A pa­la­vra o acer­tou num lu­gar que ne­nhu­ma fa­ca ti­nha al­can­ça­do. Al­guém já ti­nha pro­me­ti­do vol­tar pa­ra ele, uma vez, num bi­lhe­te. "/>
                <ITEXT CPARENT="c_it" CH="Vol­to lo­go."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Eu não pro­me­to na­da pra nin­guém — dis­se, e saiu an­tes que ela res­pon­des­se."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Su­biu a ser­ra mais rápi­do do que pre­ci­sa­va, com as lu­vas no­vas ran­gen­do a ca­da pas­so, co­mo quem fo­ge de al­gu­ma coi­sa que não es­tá atrás."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ago­ra, na bo­ca do Co­vil, as lu­vas no­vas ain­da ran­gi­am. Noct se le­van­tou. Ajei­tou a fi­ta no pul­so. En­trou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Lá den­tro era mai­or do que pa­re­cia."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Uma ca­ver­na re­don­da, de te­to al­to, ilu­mi­na­da por vei­os de al­gu­ma coi­sa in­can­des­cen­te que cor­ri­am pe­las pa­re­des co­mo san­gue em vei­as. Os­sos es­pa­lha­dos pe­lo chão, não de gen­te, ou não só: cer­vos, ja­va­lis, coi­sas que ele não sou­be iden­ti­fi­car. O ca­lor era tan­to que o suor se­ca­va an­tes de es­cor­rer."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E no cen­tro, en­ro­la­da so­bre si mes­ma co­mo uma bra­sa do ta­ma­nho de uma car­ro­ça, dor­mia a fe­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ga­to In­fer­nal."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Era um ga­to do jei­to que um in­cên­dio é uma ve­la. O for­ma­to es­ta­va ali, as ore­lhas pon­tu­das, a cau­da lon­ga en­ro­la­da no fo­ci­nho, as pa­tas gran­des do­bra­das sob o pei­to. Mas o pe­lo não era pe­lo. Era fo­go, ou al­gu­ma coi­sa que ti­nha apren­di­do a ser fo­go, e se me­xia so­zi­nho com a res­pi­ra­ção da fe­ra, su­bin­do e des­cen­do em on­das la­ran­ja e ver­me­lhas. On­de as pa­tas to­ca­vam a pe­dra, a pe­dra es­ta­va pre­ta. No pes­co­ço, meio afun­da­da no fo­go, ha­via uma co­lei­ra de cou­ro es­cu­ro, ve­lha de­mais pa­ra ter nas­ci­do com a fe­ra, e no meio de­la uma joia que guar­da­va uma luz pró­pria."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct pa­rou na en­tra­da da ca­ver­na e fi­cou olhan­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Uma par­te de­le, a par­te que fa­zia con­tas, dis­se com to­da a cal­ma: "/>
                <ITEXT CPARENT="c_it" CH="Is­so vai te ma­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ou­tra par­te não dis­se na­da."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A ou­tra par­te sor­riu."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sen­tiu acon­te­cer. Sen­tiu o can­to da bo­ca su­bir so­zi­nho, de­va­gar, co­mo uma cor­ti­na se abrin­do. Não era ale­gria. Nun­ca era ale­gria. Era a coi­sa que acor­da­va ne­le di­an­te de al­go gran­de o bas­tan­te pa­ra ocu­par a ca­be­ça in­tei­ra, gran­de o bas­tan­te pa­ra em­pur­rar pa­ra fo­ra tu­do o que não fos­se "/>
                <ITEXT CPARENT="c_it" CH="ago­ra"/>
                <ITEXT CH=". A es­ta­ção. O bi­lhe­te. A fi­ta. O la­do es­quer­do. Tu­do is­so ia su­mir, por al­guns mi­nu­tos, por­que não ia ha­ver es­pa­ço."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Fa­zia anos que ele não sen­tia a ca­be­ça va­zia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A fe­ra abriu um olho. Ama­re­lo, ver­ti­cal, do ta­ma­nho de um pu­nho fe­cha­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Fi­nal­men­te — dis­se Noct."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O Ga­to não ru­giu. Ga­tos não ru­gem. Ele se le­van­tou, se es­pre­gui­çou com a pre­gui­ça in­so­len­te de to­dos os ga­tos do mun­do, as cos­tas se ar­que­an­do, as gar­ras sain­do das pa­tas com um som de fa­cas sen­do de­sem­bai­nha­das na pe­dra. E en­tão, sem ne­nhum avi­so, atra­ves­sou a ca­ver­na in­tei­ra num úni­co sal­to."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="Noct se jo­gou pa­ra o la­do. Sen­tiu o ca­lor pas­sar a um pal­mo das cos­tas, sen­tiu a pon­ta da man­ta cha­mus­car. Ro­lou, le­van­tou, e a fe­ra já es­ta­va vi­ran­do, a cau­da chi­co­te­an­do o ar e dei­xan­do um ras­tro de fa­gu­lhas."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não ha­via dan­ça com o Ga­to. Não ha­via con­ver­sa. Ha­via ve­lo­ci­da­de e fo­go e um ani­mal que não es­ta­va com rai­va, que não es­ta­va com fo­me, que es­ta­va ape­nas "/>
                <ITEXT CPARENT="c_it" CH="brin­can­do"/>
                <ITEXT CH=", do jei­to que ga­tos brin­cam com coi­sas pe­que­nas que se me­xem."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct era a coi­sa pe­que­na que se me­xia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele apren­deu a fe­ra em pe­da­ços. A in­ves­ti­da vi­nha sem­pre de­pois de ela bai­xar o cor­po, as pa­tas de trás tre­men­do. O sal­to vi­nha quan­do ela olha­va pa­ra ci­ma. Quan­do a cau­da pa­ra­va de me­xer, ela ia cus­pir fo­go. Ca­da li­ção cus­tou al­gu­ma coi­sa: um cor­te, uma quei­ma­du­ra, um tom­bo con­tra a pa­re­de que dei­xou um gos­to de fer­ro na bo­ca."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E a ca­da gol­pe que ele con­se­guia acer­tar, a ca­da so­co que as lu­vas de Brom afun­da­vam na­que­le pe­lo de cha­mas, su­bia da fe­ra al­gu­ma coi­sa que não era né­voa fria. Não era sau­da­de. O Ga­to não ti­nha de quem sen­tir fal­ta. Era só ca­lor, vi­da crua, mui­ta, e en­tra­va ne­le co­mo uma be­bi­da for­te en­tra num es­tô­ma­go va­zio."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A bra­sa no pei­to de­le acor­dou e olhou pa­ra o Ga­to co­mo quem olha pa­ra um pa­ren­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct não dei­xou ela to­mar con­ta. Nem uma vez. Quan­do o fo­go che­ga­va per­to de­mais, pu­xa­va o ar de­va­gar e con­ta­va até qua­tro, co­mo Lí­via ti­nha en­si­na­do, e a bra­sa as­sen­ta­va um pou­co. Se­gu­rou as ré­deas da bra­sa com as du­as mãos e lu­tou com o que era de­le: os pés, os olhos, os pu­nhos, a tei­mo­sia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Em al­gum mo­men­to, no meio de tu­do, ele per­ce­beu que es­ta­va rin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Bai­xo, sem som qua­se, só o ar sain­do em gol­fa­das cur­tas en­tre os den­tes. Co­ber­to de fu­li­gem, san­gran­do de três lu­ga­res di­fe­ren­tes, en­cur­ra­la­do por uma fe­ra de fo­go nu­ma ca­ver­na que fe­dia a os­so quei­ma­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Rin­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele não sou­be di­zer quan­do ti­nha si­do a úl­ti­ma vez."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="O úl­ti­mo gol­pe não foi bo­ni­to."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O Ga­to sal­tou. Noct não se jo­gou pa­ra o la­do, des­sa vez. Fi­cou. Es­pe­rou até o úl­ti­mo ins­tan­te, até sen­tir o ca­lor no ros­to, até ver o pró­prio re­fle­xo no olho ama­re­lo da fe­ra. E en­tão se abai­xou, e o pu­nho su­biu num up­per­cut car­re­ga­do de to­do o car­me­sim que ele vi­nha se­gu­ran­do, e acer­tou a fe­ra em cheio no pei­to en­quan­to ela pas­sa­va por ci­ma de­le."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O Ga­to In­fer­nal caiu do ou­tro la­do da ca­ver­na. Ten­tou se le­van­tar uma vez. As cha­mas do pe­lo fi­ca­ram mais bai­xas, mais ver­me­lhas, e de­pois mais es­cu­ras, até vi­ra­rem só bra­sas, até vi­ra­rem só cin­za. No meio da cin­za, in­tei­ra, fi­cou a co­lei­ra. A joia nem es­ta­va quen­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct fi­cou de pé no meio da ca­ver­na, res­pi­ran­do fun­do, as lu­vas fu­me­gan­do, os nós dos de­dos em car­ne vi­va."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E en­tão a es­sên­cia da fe­ra veio até ele."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Não co­mo a né­voa fria dos ou­tros, em fi­os, pro­cu­ran­do lu­gar va­zio. Veio de uma vez, uma on­da quen­te que o atra­ves­sou da ca­be­ça aos pés e o dei­xou de jo­e­lhos. Por um ins­tan­te ele sen­tiu tu­do o que o Ga­to ti­nha si­do: a pre­gui­ça, a fo­me, o sol nas cos­tas, o pra­zer sim­ples e fe­roz de ser gran­de e rápi­do e nin­guém con­se­guir al­can­çar. Ne­nhum pen­sa­men­to. Ne­nhu­ma lem­bran­ça. Só um cor­po vi­ven­do no pre­sen­te."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct qua­se in­ve­jou."/>
                <para PARENT="corpo"/>
                <ITEXT CH="De­pois a fi­ta ro­çou o pul­so, mo­lha­da de suor, e a in­ve­ja pas­sou. "/>
                <ITEXT CPARENT="c_it" CH="Um bi­cho sem lem­bran­ça não tem pra quem vol­tar."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Quan­do a on­da pas­sou, ele es­ta­va mais for­te. Sen­tia is­so no pei­to, nas per­nas. E nas mãos al­gu­ma coi­sa ti­nha mu­da­do. Ele as vi­rou pa­ra ci­ma. Na pon­ta de ca­da de­do, por ci­ma do cou­ro das lu­vas, o car­me­sim ti­nha se jun­ta­do em ris­cos fi­nos e cur­vos, qua­se na­da, co­mo bra­sa de­se­nha­da no ar. Não eram unhas. Não eram de nin­guém. Era a bra­sa, que ti­nha apren­di­do al­gu­ma coi­sa na­que­la ca­ver­na e guar­da­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Co­mo as de um ga­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct tes­tou. Fin­cou os de­dos na pa­re­de da ca­ver­na. Os ris­cos ver­me­lhos acen­de­ram um pou­co mais, en­tra­ram na pe­dra co­mo em ma­dei­ra ma­cia e se­gu­ra­ram o pe­so de­le in­tei­ro sem es­for­ço. Quan­do ele sol­tou, apa­ga­ram, e as lu­vas eram só lu­vas de no­vo."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele olhou pa­ra o mon­te de cin­zas do ou­tro la­do da ca­ver­na, on­de a fe­ra ti­nha ca­í­do. Dei­xou o sor­ri­so de can­to vol­tar, can­sa­do, tor­to."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— Bom ga­ti­nho."/>
                <para PARENT="corpo"/>
                <ITEXT CH="* * *"/>
                <para PARENT="cena"/>
                <ITEXT CH="Saiu do Co­vil quan­do já era noi­te."/>
                <para PARENT="corpo_inicio"/>
                <ITEXT CH="O céu es­ta­va lim­po, pe­la pri­mei­ra vez des­de que ele ti­nha che­ga­do àque­la re­gi­ão, e ha­via es­tre­las. Não mui­tas. Al­gu­mas. O su­fi­ci­en­te pa­ra que ele pa­ras­se na bo­ca da ca­ver­na e fi­cas­se olhan­do pa­ra ci­ma por um tem­po, as mãos pen­du­ra­das ao la­do do cor­po, um bri­lho ver­me­lho ain­da es­fri­an­do na pon­ta dos de­dos."/>
                <para PARENT="corpo"/>
                <ITEXT CH="O si­lên­cio vol­tou. E com ele, de­va­gar, tu­do o que o Ga­to ti­nha em­pur­ra­do pa­ra fo­ra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A es­ta­ção. O bi­lhe­te. A fi­ta. O la­do es­quer­do."/>
                <para PARENT="corpo"/>
                <ITEXT CH="A lis­ta. A ca­te­dral. Um ho­mem cha­ma­do Cus­tó­dio que pa­ga­va por quem ou­vis­se a fen­da. E ela, que ou­via, e que sa­ía de ma­dru­ga­da en­quan­to ele dor­mia."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Por al­guns mi­nu­tos, den­tro da­que­la ca­ver­na, ele ti­nha es­que­ci­do tu­do is­so. Ago­ra vol­ta­va tu­do jun­to, e ele não sa­bia se ti­nha si­do des­can­so ou fu­ga."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Ele sen­tiu ca­da coi­sa vol­tar pa­ra o seu lu­gar, co­mo pes­so­as vol­tan­do pa­ra uma ca­sa de­pois de uma tem­pes­ta­de, e não fi­cou tris­te. Não exa­ta­men­te. Fi­cou só can­sa­do, de um jei­to que não ti­nha na­da a ver com as fe­ri­das."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Olhou pa­ra oes­te. Lá lon­ge, de­pois do ce­mi­té­rio e da ser­ra, uma luz pe­que­na bri­lha­va. Um lam­pi­ão, tal­vez. Pe­dra­ve­lha."/>
                <para PARENT="corpo"/>
                <ITEXT CH="E mais al­to que tu­do, uma som­bra fi­na e tor­ta con­tra as es­tre­las. A tor­re."/>
                <para PARENT="corpo"/>
                <ITEXT CH="Noct olhou pa­ra a tor­re. De­pois pa­ra as pró­prias mãos, pa­ra os de­dos que ago­ra agar­ra­vam pe­dra."/>
                <para PARENT="corpo"/>
                <ITEXT CH="— ...Ago­ra aque­la tor­re fi­ca in­te­res­san­te."/>
                <trail PARENT="corpo"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="621.574803149606" YPOS="24981.8897637795" OwnPage="72" ItemID="924164921" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="621.574803149606" gYpos="24981.8897637795" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="924407129" BACKITEM="917604857"/>
        <PAGEOBJECT XPOS="151.023622047244" YPOS="25673.8582677166" OwnPage="73" ItemID="924407129" PTYPE="4" WIDTH="334.488188976378" HEIGHT="544" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" copath="M0 0 L334.488 0 L334.488 544 L0 544 L0 0 Z" gXpos="151.023622047244" gYpos="25673.8582677166" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="924373801" BACKITEM="924164921"/>
